    },
    {
      "path": "src/coordinators/trade-workflows/sale-measure.ts",
      "content": "The Hold cutoff depends on the first member's date, although execution members need not be chronologically ordered and the Position Change uses its earliest economic time. For executions spanning Monday and Tuesday with a Monday Hold, placing Tuesday's execution first counts that Hold as held-past; reversing the same members excludes it. This can change whether PlanDepartureReasonRequired is returned for otherwise identical executions. Derive the cutoff from the Position Change's earliest economic time (or measure each execution against its own date), and add a regression test that reverses cross-date members.",
      "existing_code": "  const holds = actions.filter((a) =\u003e a.action === 'Hold' \u0026\u0026 a.reviewDate \u003c saleDate);",
