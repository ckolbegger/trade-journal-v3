    {
      "path": "src/ui/screens/now-box.props.ts",
      "content": "Zero realized P\u0026L does not mean no sale occurred: a break-even partial sale, or multiple sales whose gains and losses cancel, also produces zero (the domain sums lot-match results). This hides the required “Realized, open” breakdown after those sales. Gate the row on disposal/sale activity for the displayed session rather than on a nonzero realized amount, and add a zero-net partial-sale test.",
      "existing_code": "  if (realized.kind !== 'Value' || realized.value.compare(ZERO) === 0) return [];",
