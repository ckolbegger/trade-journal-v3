      "path": "src/ui/cockpit/rail/identity.props.ts",
      "content": "`daysText` uses a nested ternary, which is explicitly prohibited by the review checklist. Use early returns for the undefined and zero cases, then return the pluralized day count; this keeps the three display cases explicit.",
      "suggestion_code": "const daysText = (days: number | undefined): string =\u003e {\n  if (days === undefined) return '';\n  if (days === 0) return ' (today)';\n  return ` (${plural(days, 'day', 'days')})`;\n};",
