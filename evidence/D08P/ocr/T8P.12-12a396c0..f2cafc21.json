    {
      "path": "src/ui/cockpit/rail/identity.props.ts",
      "content": "The countdown is never shown with real Detail data: `expirationLineOf` in `src/coordinators/trade-views/trade-views.ts` returns only `{ status, date }` for both Planned and Open trades, so `expiration.days` is always undefined. The adapter tests inject `days` manually and therefore do not catch this integration gap. Populate `ContractExpiration.days` from the View Moment's exchange-local date for `Expires` views and add a test using a coordinator-produced view, so the required `(36 days)`, `(1 day)`, and `(today)` labels actually appear.",
      "existing_code": "    ...(expiration ? [`${expiration.status} ${expirationDate(expiration.date)}${daysText(expiration.days)}`] : []),",
      "start_line": 28,
      "end_line": 28,
      "category": "bug",
      "severity": "medium"
    }
