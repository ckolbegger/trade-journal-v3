      "path": "src/ui/screens/ReviewCard.tsx",
      "content": "This handler also snapshots drafts on Ctrl/Cmd-click, when React Router leaves the current Review mounted and opens Price History in another tab. Saving or discarding the Action afterward only removes the live draft; the set-aside snapshot remains. Reopening the same Review via a replay=open URL can therefore resurrect obsolete input after Save or abandonment. Snapshot only for an actual same-tab navigation, and invalidate any retained snapshot when its Action is saved or abandoned. Add a modified-click regression test.",
      "existing_code": "          \u003cReplayDrawer replay={trade.replay} {...(params.get('session') !== null \u0026\u0026 { initialSession: params.get('session')! })} onSessionChange={onSliderMove} links={({ date }) =\u003e \u003cLink to={`/trades/${trade.tradeId}?drawer=price-history\u0026session=${date}\u0026from=review`} onClick={setDraftsAside}\u003ePrice History\u003c/Link\u003e} /\u003e",
