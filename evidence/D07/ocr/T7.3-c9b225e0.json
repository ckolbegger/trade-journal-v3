    {
      "path": "src/domain/trade-analysis/payoff.ts",
      "content": "The exported API accepts multiple option legs, but never verifies that they share an underlying and expiration before returning a single curve. For example, options expiring in November and December are treated as settling at the same price, producing unsupported extrema and break-evens. ADR 0007 explicitly requires mixed-expiration payoff to be unavailable. Validate the common anchor for both planned legs and current lots before constructing a view, or restrict the input contract so unsupported structures cannot reach this calculation.",
      "existing_code": "  const planned = { kind: 'Value', value: viewOf(plannedLegs, ZERO, ZERO) } as const;",
      "start_line": 190,
      "end_line": 190,
      "category": "bug",
      "severity": "medium"
    },
    {
      "path": "src/domain/trade-analysis/payoff.ts",
      "content": "This nested ternary violates the checklist's prohibition on nested ternary expressions. Use a switch on `a.kind` to make the Point, Interval, and Ray upper bounds explicit.",
      "suggestion_code": "const covers = (a: Attainment, price: Rational): boolean =\u003e {\n  switch (a.kind) {\n    case 'Point':\n      return price.equals(a.at);\n    case 'Interval':\n      return within(price, a.from, a.to);\n    case 'Ray':\n      return within(price, a.from, null);\n  }\n};",
      "existing_code": "const covers = (a: Attainment, price: Rational) =\u003e within(price, startOf(a), a.kind === 'Interval' ? a.to : a.kind === 'Ray' ? null : a.at);",
