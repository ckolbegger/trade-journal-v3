    {
      "path": "src/domain/trade-analysis/derive.ts",
      "content": "Removing all requirements for an expired open option breaks the current Daily Review consumer. `observationNeeds` builds its frame requests solely from these requirements, but `reviewItem` still requires a frame for every eligible open trade and throws if none exists. With an expired option and no other trade requesting its underlying, opening Daily Review therefore throws instead of displaying Settlement Due. Update the evaluation orchestration to supply the review date without requiring a Mark/frame for expired positions, alongside this change; do not restore an unnecessary post-expiration Mark requirement.",
      "existing_code": "    .filter((p) =\u003e p.instrument.kind === 'Stock' || valuationDate \u003c= p.instrument.expiration)",
