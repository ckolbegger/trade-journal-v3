{
  "permissions": {
    "allow": [
      "Bash(npm run build:releases)",
      "Bash(npm run build:faults)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/filter-test-output.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-shell-writes.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
