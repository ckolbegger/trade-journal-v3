{
  "name": "trade-journal-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "verify:release": "node tools/verify-release.ts",
    "lint:deps": "node tools/lint-deps.ts",
    "verify:capabilities": "node tools/verify-capabilities.ts",
    "build:releases": "node tools/build-releases.ts",
    "verify:releases": "node tools/verify-releases.ts",
    "serve:releases": "node tools/release-server.ts",
    "build:faults": "vite build --mode faults --outDir dist-faults",
    "verify:no-fault-hooks": "node tools/verify-no-fault-hooks.ts",
    "preview:faults": "vite preview --outDir dist-faults",
    "measure:capacity": "node tools/measure-capacity.ts",
    "verify:capacity": "node tools/verify-capacity.ts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build:faults && npm run build:releases && playwright test e2e/d1",
    "fixtures:freeze": "node tools/fixtures-freeze.ts",
    "verify:fixtures": "node tools/verify-fixtures.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "temporal-polyfill": "1.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.3"
  }
}
