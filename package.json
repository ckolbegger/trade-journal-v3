{
  "name": "trade-journal-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:6": "tsc6 --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
