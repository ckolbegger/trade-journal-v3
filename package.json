{
  "name": "trade-journal-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.12.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "build": "npm run typecheck && vite build && node tools/inventory.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test",
    "test:benchmark": "playwright test --config playwright.benchmark.config.ts",
    "pretest:unit": "node tools/build-d1-fixture.mjs",
    "test:benchmark:d2": "playwright test --config playwright.d02-benchmark.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "decimal.js": "10.6.0",
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  }
}
