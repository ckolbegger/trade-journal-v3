yError, TradeRecord, type TradeSnapshot } from '../../domain/trade-record';\nimport { Journal } from '../../domain/journal';\nimport { queryPlanningCatalog } from '../../domain/reference-catalog';\nimport { derive } from '../../domain/trade-analysis';\nimport type { Store } from '../../infrastructure/storage';\nfunction analyze(trade: TradeSnapshot) {\n  return derive({ candidateId: trade.opening ? trade.tradeId : trade.planFactId, digest: JSON.stringify(trade.plan), revision: trade.revision, plan: trade.plan, storedLifecycle: trade.lifecycle, exposureFacts: [], opening: trade.opening });\n}\nexport class TradeViewsAndReporting {\n  constructor(readonly store: Store) {}\n  async browseTrades(request: { cursor?: string; accountIds?: string[]; symbols?: string[]; lifecycle?: 'Planned' | 'Open' } = {}) {\n    try { return await this.store.transaction('r', [this.store.roots, this.store.versions, this.store.lifecycle], async () => {\n      const root = await this.store.roots.get('active');\n      const query = JSON.stringify({ lifecycle: request.lifecycle ?? 'Planned', accountIds: [...(request.accountIds ?? [])].sort(), symbols: [...(request.symbols ?? [])].sort() });\n      const cursor = request.cursor ? JSON.parse(request.cursor) as { revision: string; query: string; after: { time: string; sequence: number } } : undefined;\n      if (cursor && (cursor.revision !== root?.revision || cursor.query !== query)) return { status: 'ChangedDuringAssembly' as const };\n      const page = await new TradeRecord(this.store).queryRecords({ ...request, after: cursor?.after });\n      const trades = page.trades;\n      return { status: trades.length ? 'Ready' as const : 'Empty' as const, items: trades.map(trade => ({ trade, ...analyze(trade) })), totalInPage: trades.length, nextCursor: page.next ? JSON.stringify({ revision: root?.revision, query, after: page.next }) : undefined, binding: { workspaceRevision: root?.revision } };\n    }); } catch (error) { if (error instanceof RecordIntegrityError) return { status: 'IntegrityBlocked' as const, findings: error.findings }; return { status: 'Error' as const, reason: 'StorageReadFailed' }; }\n  }\n  async getTradeDetail(tradeId: string, expectedWorkspaceRevision?: string) {\n    try { return await this.store.transaction('r', [this.store.roots, this.store.versions, this.store.lifecycle], async () => {\n      if (expectedWorkspaceRevision && (await this.store.roots.get('active'))?.revision !== expectedWorkspaceRevision) return { status: 'ChangedDuringAssembly' as const };\n      const records = new TradeRecord(this.store);\n      const trade = await records.getRecord(tradeId);\n      if (!trade) return { status: 'NotFound' as const };\n      const root = await this.store.roots.get('active');\n      const lifecycle = root ? await this.store.lifecycle.get(`${root.generation}:${tradeId}`) : undefined;\n      const derived = derive({ candidateId: trade.opening ? trade.tradeId : trade.planFactId, digest: JSON.stringify(trade.plan), revision: trade.revision, plan: trade.plan, storedLifecycle: lifecycle?.lifecycle ?? 'Missing', exposureFacts: [], opening: trade.opening });\n      if (derived.status === 'IntegrityBlocked') return derived;\n      const journalModule = new Journal(this.store);\n      const journal = await journalModule.query({ tradeId, scope: 'History' });\n      const entries = journal.entries;\n      const anchorResolutions = await records.resolveAnchors(entries.map(entry => entry.anchor));\n      const history = await records.history(tradeId);\n      const catalog = await queryPlanningCatalog(this.store);\n      const account = catalog.records.find(record => record.id === trade.accountId);\n      return { ...derived, status: 'Ready' as const, trade, entries, history, journal, anchorResolutions, binding: { generation: root?.generation, workspaceRevision: root?.revision, catalogRevision: root?.catalogRevision }, openingDefinition: await journalModule.getDefinitions('PositionChange'), labels: { account: account?.label, institution: catalog.records.find(record => record.id === account?.parentId)?.label, strategy: catalog.records.find(record => record.id === trade.strategyId)?.label } };\n    }); } catch (error) { if (error instanceof RecordIntegrityError) return { status: 'IntegrityBlocked' as const, findings: error.findings }; return { status: 'Error' as const, reason: 'StorageReadFailed' }; }\n  }\n}\n","src/application/trade-workflows/index.ts":"import type { PositionChangeCommand } from './opening-types';\nimport { Temporal } from '@js-temporal/polyfill';\nimport { queryPlanningCatalog } from '../../domain/reference-catalog';\nimport { RecordIntegrityError, TradeRecord } from '../../domain/trade-record';\nimport { Journal } from '../../domain/journal';\nimport { assessPlan, assessChange, derive, type PlanInput } from '../../domain/trade-analysis';\nimport { addedRecords, type Runtime } from '../../infrastructure/storage';\nexport interface ConfirmPlanCommand {\n  generation: string; expectedCatalogRevision: string; definitionRevision: string;\n  accountId: string; strategyId: string; economicTime: string;\n  plan: Omit<PlanInput, 'thesis' | 'invalidation'>;\n  reflection: { thesis: string; invalidation: string; conviction?: string; emotion?: string };\n}\nexport class TradeWorkflows {\n  constructor(readonly runtime: Runtime, readonly saveClock: () => string = () => new Date().toISOString()) {}\n  async recordPositionChange(command: PositionChangeCommand) {\n    const readiness = await this.runtime.establish();\n    if (readiness.status !== 'Writable') return readiness;\n    const store = this.runtime.store; const records = new TradeRecord(store); const journal = new Journal(store);\n    try {\n      const context = await store.transaction('r', [store.roots, store.versions, store.lifecycle], async () => ({ root: await store.roots.get('active'), trade: await records.getRecord(command.tradeId), catalog: await queryPlanningCatalog(store), definition: await journal.getDefinitions('PositionChange') }));\n      const { root, trade, catalog, definition } = context;\n      if (!root || !trade) return { status: 'Rejected' as const, issues: ['TradeRequired'] };\n      const conflicts: string[] = [];\n      if (root.generation !== command.generation) conflicts.push('GenerationChanged');\n      if (root.revision !== command.expectedWorkspaceRevision) conflicts.push('WorkspaceChanged');\n      if (root.catalogRevision !== command.expectedCatalogRevision) conflicts.push('CatalogChanged');\n      if (trade.revision !== command.expectedTradeRevision) conflicts.push('TradeChanged');\n      if (definition?.revision !== command.definitionRevision) conflicts.push('DefinitionChanged');\n      if (conflicts.length) return { status: 'Conflict' as const, issues: conflicts };\n      if (!definition || root.schema !== 2) return { status: 'Rejected' as const, issues: ['MigrationRequired'] };\n      const issues: string[] = [];\n      if (command.kind !== 'InitialStockEntry' || trade.lifecycle !== 'Planned' || trade.opening) issues.push('InitialStockEntryRequiresPlannedTrade');\n      if (command.plannedLegId !== trade.plannedLegId) issues.push('PlannedLegIntentMismatch');\n      if (!catalog.records.some(record => record.id === trade.accountId && record.kind === 'Account') || !catalog.records.some(record => record.id === trade.strategyId && record.kind === 'Strategy')) issues.push('RetainedReferenceRequired');\n      try {\n        if (Temporal.Instant.compare(command.economicTime, trade.economicTime) < 0 || command.executions.some(execution => Temporal.Instant.compare(execution.economicTime, trade.economicTime) < 0)) issues.push('EntryBeforePlan');\n      } catch { issues.push('InvalidExecutionTime'); }\n      const saveTime = this.saveClock();\n      const candidate = records.prepareChange({ kind: 'InitialStockEntry', trade, command: { economicTime: command.economicTime, executions: command.executions }, root, saveTime });\n      const assessment = assessChange(candidate.candidate);\n      const effects = journal.prepareEffects({ kind: 'PositionChange', definition, disposition: command.reflection });\n      if (assessment.status === 'Rejected') issues.push(...assessment.issues);\n      if (effects.status === 'Rejected') issues.push(...effects.issues);\n      if (issues.length || assessment.status !== 'Accepted' || effects.status !== 'Prepared') return { status: 'Rejected' as const, issues: [...new Set(issues)] };\n      if (JSON.stringify(assessment.derivation.baseline) !== JSON.stringify(trade.baseline)) return { status: 'IntegrityBlocked' as const, findings: ['PlanBaselineDisagreement'] };\n      return await this.runtime.mutate(command.generation, async current => {\n        if (!current || current.revision !== root.revision || current.catalogRevision !== command.expectedCatalogRevision) return { status: 'Conflict' as const, issues: ['WorkspaceChanged'] };\n        const currentDefinition = await journal.getDefinitions('PositionChange');\n        if (JSON.stringify(currentDefinition) !== JSON.stringify(definition)) return { status: 'Conflict' as const, issues: ['DefinitionChanged'] };\n        const applied = await records.applyPreparedChange(candidate, assessment.derivation, current, saveTime);\n        const journalOutcome = await journal.applyPreparedEffects(effects, { tradeId: trade.tradeId, positionChangeId: applied.positionChange.id, economicTime: command.economicTime, saveTime, sequence: applied.positionChange.sequence }, current);\n        const workspaceRevision = crypto.randomUUID();\n        await store.roots.put({ ...current, revision: workspaceRevision, recordedSequence: applied.lastSequence, commitOrdinal: current.commitOrdinal + 1, recordCounts: addedRecords(current, applied.addedRecords + journalOutcome.addedRecords) });\n        const account = catalog.records.find(record => record.id === trade.accountId);\n        return { status: 'Recorded' as const, trade: applied.trade, derivation: applied.derivation, journalOutcome, workspaceRevision, labels: { account: account?.label, institution: catalog.records.find(record => record.id === account?.parentId)?.label, strategy: catalog.records.find(record => record.id === trade.strategyId)?.label }, receipt: { tradeId: trade.tradeId, factRevision: applied.trade.revision, positionChangeId: applied.positionChange.id, executionIds: applied.executions.map(execution => execution.id), lifecycle: 'Open' as const, obligationId: journalOutcome.obligation.id, obligationRevision: journalOutcome.obligation.revision, workspaceRevision } };\n      });\n    } catch (error) {\n      if (error instanceof RecordIntegrityError) return { status: 'IntegrityBlocked' as const, findings: error.findings };\n      if (error instanceof Error && (error.message === 'ReconciliationConflict' || error.message === 'ObligationConflict')) return { status: 'Conflict' as const, issues: [error.message] };\n      this.runtime.invalidate('transaction');\n      return { status: 'StorageFailure' as const };\n    }\n  }\n  async confirmPlan(command: ConfirmPlanCommand) {\n    const readiness = await this.runtime.establish();\n    if (readiness.status !== 'Writable') return readiness;\n    const store = this.runtime.store;\n    const root = await store.roots.get('active');\n    if (!root) return { status: 'Rejected' as const, issues: ['WorkspaceRequired'] };\n    const conflicts: string[] = [];\n    if (root.catalogRevision !== command.expectedCatalogRevision) conflicts.push('CatalogChanged');\n    if (root.definitionRevision !== command.definitionRevision) conflicts.push('DefinitionChanged');\n    if (root.generation !== command.generation) conflicts.push('GenerationChanged');\n    if (conflicts.length) return { status: 'Conflict' as const, issues: conflicts };\n    const catalog = await queryPlanningCatalog(store);\n    const issues: string[] = [];\n    if (!catalog.records.some(record => record.id === command.accountId && record.kind === 'Account' && record.active)) issues.push('SelectableAccountRequired');\n    if (command.strategyId !== 'long-stock' || !catalog.records.some(record => record.id === command.strategyId && record.kind === 'Strategy' && record.active)) issues.push('SelectableLongStockRequired');\n    try { Temporal.Instant.from(command.economicTime); } catch { issues.push('EconomicTimeRequired'); }\n    const assessment = assessPlan({ ...command.plan, thesis: command.reflection.thesis, invalidation: command.reflection.invalidation });\n    if (assessment.status !== 'Accepted') return { status: 'Rejected' as const, issues: [...issues, ...assessment.issues] };\n    if (issues.length) return { status: 'Rejected' as const, issues };\n    const journal = new Journal(store);\n    const definition = await journal.getDefinitions();\n    if (!definition) return { status: 'Rejected' as const, issues: ['DefinitionRequired'] };\n    const effects = journal.prepareEffects(definition, command.reflection);\n    if (effects.status === 'Rejected') return effects;\n    const records = new TradeRecord(store);\n    const candidate = records.prepareChange({ accountId: command.accountId, strategyId: command.strategyId, economicTime: command.economicTime, assessment, revision: root.revision });\n    const reconciliation = derive(candidate);\n    try { return await this.runtime.mutate(command.generation, async current => {\n      if (!current || current.revision !== root.revision || current.catalogRevision !== command.expectedCatalogRevision || current.definitionRevision !== command.definitionRevision) return { status: 'Conflict' as const, issues: ['WorkspaceChanged'] };\n      const trade = await records.applyPreparedChange(candidate, reconciliation, current, this.saveClock());\n      const entry = await journal.applyPreparedEffects(effects, trade, current);\n      const next = { ...current, revision: crypto.randomUUID(), recordedSequence: trade.sequence, recordCounts: addedRecords(current, 2, 1), commitOrdinal: current.commitOrdinal + 1 };\n      await store.roots.put(next);\n      const account = catalog.records.find(record => record.id === command.accountId);\n      return { status: 'Confirmed' as const, labels: { account: account?.label, institution: catalog.records.find(record => record.id === account?.parentId)?.label, strategy: catalog.records.find(record => record.id === command.strategyId)?.label }, trade, entry, assessment, workspaceRevision: next.revision, reconciliation, receipt: { tradeId: trade.tradeId, factRevision: trade.revision, factId: trade.planFactId, factVersionId: trade.planVersionId, entryId: entry.id, entryVersion: entry.version, lifecycle: trade.lifecycle, workspaceRevision: next.revision } };\n    }); } catch (error) {\n      if (error instanceof Error && error.message === 'ReconciliationConflict') return { status: 'Conflict' as const, issues: ['ReconciliationChanged'] };\n      this.runtime.invalidate('transaction');\n      return { status: 'StorageFailure' as const };\n    }\n  }\n}\n","src/application/trade-workflows/opening-types.ts":"import type { ExecutionInput } from '../../domain/trade-record/opening-types';\nimport type { ReflectionDisposition } from '../../domain/journal/position-change-types';\nexport interface PositionChangeCommand {\n  kind: 'InitialStockEntry'; generation: string; expectedWorkspaceRevision: string;\n  expectedCatalogRevision: string; tradeId: string; expectedTradeRevision: string;\n  plannedLegId: string; definitionRevision: string; economicTime: string;\n  executions: ExecutionInput[]; reflection: ReflectionDisposition;\n}\n","src/application/workspace/index.ts":"import { migrateD1 } from './migration';\nimport capabilities from '../../../public/capabilities.json';\nimport { Temporal } from '@js-temporal/polyfill';\nimport { ReferenceCatalog, longStock, queryPlanningCatalog } from '../../domain/reference-catalog';\nimport { Journal, planDefinition } from '../../domain/journal';\nimport { Runtime, rootHeaderFailure, type Root } from '../../infrastructure/storage';\nexport class Workspace {\n  constructor(readonly runtime: Runtime) {}\n  private async validRoot(root: Root) {\n    if (rootHeaderFailure(root)) return false;\n    const store = this.runtime.store;\n    const [seeds, versions, plans, entries, membership] = await Promise.all([\n      store.versions.bulkGet([`${root.generation}:long-stock-v1`, `${root.generation}:${root.definitionRevision}`, `${root.generation}:plan-confirmation-v1`]),\n      store.versions.where('[generation+kind]').between([root.generation, ''], [root.generation, '\\uffff']).count(),\n      store.versions.where('[generation+kind]').equals([root.generation, 'Plan']).count(),\n      store.versions.where('[generation+kind]').equals([root.generation, 'JournalEntry']).count(),\n      store.lifecycle.where('[generation+lifecycle+economicOrder+sequence]').between([root.generation, 'Planned', '', 0], [root.generation, 'Planned', '\\uffff', Number.MAX_SAFE_INTEGER]).count(),\n    ]);\n    if (root.schema === 2) {\n      const openingSeeds = await store.versions.bulkGet([`${root.generation}:position-change-reflection-v1`, `${root.generation}:position-change-v1`]);\n      const allMembership = await store.lifecycle.where('[generation+tradeId]').between([root.generation, ''], [root.generation, '\\uffff']).count();\n      return seeds[0]?.kind === 'Strategy' && seeds[1]?.kind === 'Definition' && seeds[2]?.kind === 'Source' && openingSeeds[0]?.kind === 'Definition' && openingSeeds[1]?.kind === 'Source' && versions === root.recordCounts?.versions && allMembership === root.recordCounts.lifecycle && allMembership === plans && entries >= plans;\n    }\n    return seeds[0]?.kind === 'Strategy' && seeds[1]?.kind === 'Definition' && seeds[2]?.kind === 'Source' && versions === root.commitOrdinal + root.recordedSequence + 2 && plans === root.recordedSequence && entries === plans && membership === plans;\n  }\n  private async migrationRecovery(previous: Root) {\n    try { return await this.runtime.store.transaction('r', [this.runtime.store.roots, this.runtime.store.versions, this.runtime.store.lifecycle], async () => {\n      const root = await this.runtime.store.roots.get('active');\n      if (!root || root.revision !== previous.revision || !await this.validRoot(root)) return undefined;\n      return { root, catalog: await queryPlanningCatalog(this.runtime.store), definition: await new Journal(this.runtime.store).getDefinitions() };\n    }); } catch { return undefined; }\n  }\n  async requestDurability() {\n    const before = await this.runtime.host.check(this.runtime.store);\n    if (before.protection === 'Protected') return { status: 'AlreadyProtected', currentProtection: 'Protected' };\n    const protection = await this.runtime.host.requestDurability();\n    return { status: protection === 'Protected' ? 'Improved' : 'NotImproved', currentProtection: protection };\n  }\n  async initialize(request: { openingInstant: string; timeZone?: string }) {\n    const readiness = await this.runtime.establish();\n    if (readiness.status !== 'Writable') return readiness;\n    const inspected = await this.runtime.store.inspect();\n    let previous = inspected.status === 'Readable' ? inspected.root : undefined;\n    if (previous) {\n      if (previous.schema !== 1 && previous.schema !== 2) return { status: 'MigrationBlocked' as const, reason: 'UnsupportedSchema' };\n      try { Temporal.Instant.from(request.openingInstant).toZonedDateTimeISO(previous.timeZone); }\n      catch { return { status: 'IntegrityBlocked' as const }; }\n    }\n    if (!previous) {\n      try {\n        if (!request.timeZone || /^[+-]/.test(request.timeZone)) return { status: 'TimeZoneSelectionRequired' as const };\n        Temporal.Instant.from(request.openingInstant).toZonedDateTimeISO(request.timeZone);\n      } catch { return { status: 'TimeZoneSelectionRequired' as const }; }\n    }\n    let migration: Extract<Awaited<ReturnType<typeof migrateD1>>, { status: 'Migrated' }>['migration'] | undefined;\n    if (previous?.schema === 1) {\n      try {\n        const result = await migrateD1(this.runtime, previous, request.openingInstant);\n        if (result.status !== 'Migrated') return result.status === 'MigrationBlocked' && result.reason !== 'InvalidSource' ? { ...result, recovery: await this.migrationRecovery(previous) } : result;\n        previous = result.root; migration = result.migration;\n      } catch { this.runtime.invalidate('transaction'); return { status: 'MigrationBlocked' as const, reason: 'StorageFailure', unchangedRevision: previous.revision, recovery: await this.migrationRecovery(previous) }; }\n    }\n    try { return await this.runtime.mutate(previous?.generation, async current => {\n      if (current) {\n        if (!await this.validRoot(current)) return { status: 'IntegrityBlocked' as const };\n        const catalog = await queryPlanningCatalog(this.runtime.store);\n        const definition = await new Journal(this.runtime.store).getDefinitions();\n        return { status: 'Opened' as const, root: current, catalog, definition, onboarding: catalog.records.some(record => record.kind === 'Account' && record.active) ? 'ReadyForTradePlanning' : 'NeedsInstitutionAndAccount', receipt: { fresh: false, candidateSealed: true, authoritativeCount: current.recordCounts?.versions ?? current.commitOrdinal + current.recordedSequence + 2, seeds: migration ? ['position-change-reflection', 'position-change'] : [], migration } };\n      }\n      const root: Root = { key: 'active', generation: crypto.randomUUID(), revision: crypto.randomUUID(), schema: 2, recordCounts: { versions: 5, lifecycle: 0 }, timeZone: request.timeZone ?? 'UTC', catalogRevision: crypto.randomUUID(), definitionRevision: 'plan-reflection-v1', commitOrdinal: 1, recordedSequence: 0 };\n      await new ReferenceCatalog(this.runtime.store).seedDefaults(root, request.openingInstant);\n      await new Journal(this.runtime.store).seedDefaults(root, request.openingInstant);\n      const candidate = await this.runtime.store.versions.where('[generation+kind]').between([root.generation, ''], [root.generation, '\\uffff']).toArray();\n      if (candidate.length !== 5 || !candidate.some(row => row.kind === 'Definition') || !candidate.some(row => row.kind === 'Source') || !candidate.some(row => row.kind === 'Strategy')) throw new Error('SeedConflict');\n      await this.runtime.store.roots.put(root);\n      return { status: 'Opened' as const, root, catalog: { status: 'Ready' as const, records: [{ ...longStock, version: `${root.generation}:long-stock-v1` }], catalogRevision: root.catalogRevision, generation: root.generation }, definition: structuredClone(planDefinition), onboarding: 'NeedsInstitutionAndAccount', receipt: { fresh: true, candidateSealed: true, authoritativeCount: candidate.length, seeds: ['long-stock', 'plan-reflection', 'plan-confirmation', 'position-change-reflection', 'position-change'] } };\n    }); } catch (error) {\n      if (error instanceof Error && error.message === 'SeedConflict') return { status: 'SeedConflict' as const };\n      this.runtime.invalidate('transaction');\n      return { status: 'StorageFailure' as const };\n    }\n  }\n  async getStatus() {\n    const readiness = await this.runtime.establish();\n    if (readiness.status === 'RuntimeNotWritable' && readiness.runtimeReadiness === 'RecoveryOnly') {\n      try {\n        const recovery = await this.runtime.store.transaction('r', [this.runtime.store.roots, this.runtime.store.versions, this.runtime.store.lifecycle], async () => {\n          const root = await this.runtime.store.roots.get('active');\n          if (!root || !await this.validRoot(root)) return { valid: false as const };\n          return { valid: true as const, root, catalog: await queryPlanningCatalog(this.runtime.store), definition: await new Journal(this.runtime.store).getDefinitions() };\n        });\n        if (recovery.valid) return { ...readiness, recovery };\n        this.runtime.invalidate('InvalidRoot');\n        return { ...readiness, runtimeReadiness: 'Unsupported' as const, workspaceStatus: 'IntegrityBlocked' as const, failedChecks: [...readiness.failedChecks, 'InvalidRoot'] };\n      } catch {\n        this.runtime.invalidate('UnreadableRoot');\n        return { ...readiness, runtimeReadiness: 'Unsupported' as const, workspaceStatus: 'IntegrityBlocked' as const, failedChecks: [...readiness.failedChecks, 'UnreadableRoot'] };\n      }\n    }\n    if (readiness.status === 'Writable') {\n      try {\n        return await this.runtime.store.transaction('r', [this.runtime.store.roots, this.runtime.store.versions, this.runtime.store.lifecycle, this.runtime.store.projections], async () => {\n          const root = await this.runtime.store.roots.get('active');\n          if (root && !await this.validRoot(root)) {\n            this.runtime.invalidate('InvalidRoot');\n            return { status: 'RuntimeNotWritable' as const, runtimeReadiness: 'Unsupported' as const, workspaceStatus: 'IntegrityBlocked' as const, failedChecks: ['InvalidRoot'], safeActions: ['Retry'] };\n          }\n          return { ...readiness, workspaceStatus: root ? root.schema === 1 ? 'MigrationRequired' as const : 'Ready' as const : 'InitializationRequired' as const, root, capabilities, storageMeasurement: await this.runtime.store.storageMeasurement(root) };\n        });\n      } catch {\n        this.runtime.invalidate('UnreadableRoot');\n        return { status: 'RuntimeNotWritable' as const, runtimeReadiness: 'Unsupported' as const, workspaceStatus: 'IntegrityBlocked' as const, failedChecks: ['UnreadableRoot'], safeActions: ['Retry'] };\n      }\n    }\n    return { ...readiness, capabilities };\n  }\n}\n","src/application/workspace/migration.ts":"import type { Envelope, LifecycleRow, Root, Runtime } from '../../infrastructure/storage';\nimport { Journal, planDefinition } from '../../domain/journal';\nimport { assessPlan } from '../../domain/trade-analysis';\nimport type { TradeSnapshot } from '../../domain/trade-record';\nimport type { JournalEntry } from '../../domain/journal';\nimport { longStock, type CatalogRecord } from '../../domain/reference-catalog';\n\n// Migration alone scans history. Ordinary startup uses the bounded count receipt.\nexport function validateD1(rows: Envelope[], membership: LifecycleRow[], root: Root) {\n  try {\n  if (rows.some(row => !['Plan', 'JournalEntry', 'Institution', 'Account', 'Strategy', 'Definition', 'Source'].includes(row.kind) || !Number.isSafeInteger(row.commitOrdinal) || row.commitOrdinal < 1 || row.commitOrdinal > root.commitOrdinal)) return false;\n  const plans = rows.filter(row => row.kind === 'Plan');\n  const entries = rows.filter(row => row.kind === 'JournalEntry');\n  const catalog = rows.filter(row => ['Institution', 'Account', 'Strategy'].includes(row.kind)).map(row => row.value as CatalogRecord);\n  if (rows.length !== root.commitOrdinal + root.recordedSequence + 2 || plans.length !== root.recordedSequence || entries.length !== plans.length || membership.length !== plans.length) return false;\n  if (new Set(rows.map(row => row.version)).size !== rows.length || new Set(plans.map(row => row.tradeId)).size !== plans.length) return false;\n  if (new Set(plans.map(row => row.sequence)).size !== plans.length || plans.some(row => !Number.isSafeInteger(row.sequence) || row.sequence < 1 || row.sequence > root.recordedSequence)) return false;\n  const members = new Map(membership.map(row => [row.tradeId, row]));\n  const reflectionsByTrade = new Map<string, Envelope[]>();\n  for (const row of entries) reflectionsByTrade.set(row.tradeId, [...(reflectionsByTrade.get(row.tradeId) ?? []), row]);\n  const references = new Map(catalog.map(row => [row.id, row]));\n  for (const row of plans) {\n    const trade = row.value as TradeSnapshot;\n    const assessment = assessPlan(trade.plan);\n    const member = members.get(trade.tradeId);\n    const reflections = reflectionsByTrade.get(trade.tradeId) ?? [];\n    const entry = reflections[0]?.value as JournalEntry | undefined;\n    const account = references.get(trade.accountId);\n    if (entry?.definition.id !== 'plan-reflection' || JSON.stringify(entry.definition) !== JSON.stringify(planDefinition) || entry.source.id !== 'plan-confirmation' || entry.momentTime !== trade.economicTime || entry.responses.thesis?.kind !== 'Text' || entry.responses.thesis.value !== trade.plan.thesis || entry.responses.invalidation?.kind !== 'Text' || entry.responses.invalidation.value !== trade.plan.invalidation) return false;\n    if (member?.sequence !== trade.sequence || member.economicTime !== trade.economicTime || entry.saveTime !== trade.saveTime || entry.firstAuthoredTime !== trade.saveTime || row.economicTime !== trade.economicTime || row.saveTime !== trade.saveTime || JSON.stringify(references.get(trade.strategyId)?.shape) !== JSON.stringify(longStock.shape)) return false;\n    if (assessment.status !== 'Accepted' || JSON.stringify(assessment.baseline) !== JSON.stringify(trade.baseline) || trade.lifecycle !== 'Planned' || row.id !== trade.planFactId || row.version !== trade.planVersionId || row.sequence !== trade.sequence || member?.version !== row.version || member.revision !== trade.revision || member.lifecycle !== 'Planned' || reflections.length !== 1 || entry?.origin.factId !== trade.planFactId || entry.anchor.tradeId !== trade.tradeId || !account || account.kind !== 'Account' || references.get(account.parentId ?? '')?.kind !== 'Institution' || references.get(trade.strategyId)?.kind !== 'Strategy') return false;\n  }\n  return true;\n  } catch { return false; }\n}\nexport async function migrateD1(runtime: Runtime, source: Root, saveTime: string) {\n  const store = runtime.store;\n  const abandoned = await store.projections.where('key').startsWith('migration-staging:').toArray();\n  for (const receipt of abandoned) {\n    const staged = receipt.value as { generation: string };\n    await store.transaction('rw', [store.roots, store.versions, store.lifecycle, store.projections], async () => {\n      if ((await store.roots.get('active'))?.generation === staged.generation) return;\n      await store.versions.where('[generation+kind]').between([staged.generation, ''], [staged.generation, '\\uffff']).delete();\n      await store.lifecycle.where('[generation+tradeId]').between([staged.generation, ''], [staged.generation, '\\uffff']).delete();\n      await store.projections.delete(`migration-seal:${staged.generation}`);\n      await store.projections.delete(receipt.key);\n    });\n  }\n  const snapshot = await store.transaction('r', [store.roots, store.versions, store.lifecycle], async () => ({\n    root: await store.roots.get('active'),\n    rows: await store.versions.where('[generation+kind]').between([source.generation, ''], [source.generation, '\\uffff']).toArray(),\n    membership: await store.lifecycle.where('[generation+tradeId]').between([source.generation, ''], [source.generation, '\\uffff']).toArray(),\n  }));\n  if (snapshot.root?.revision !== source.revision) return { status: 'Conflict' as const, issues: ['WorkspaceChanged'] };\n  if (!validateD1(snapshot.rows, snapshot.membership, source)) return { status: 'MigrationBlocked' as const, reason: 'InvalidSource', unchangedRevision: source.revision };\n  const bytes = new TextEncoder().encode(JSON.stringify(snapshot)).byteLength;\n  if (!await runtime.host.migrationCapacity?.(bytes * 2)) return { status: 'MigrationBlocked' as const, reason: 'MigrationCapacity', unchangedRevision: source.revision };\n  const generation = crypto.randomUUID();\n  const key = (old: string) => old.startsWith(`${source.generation}:`) ? generation + old.slice(source.generation.length) : `${generation}:${old}`;\n  const rows = snapshot.rows.map(row => ({ ...row, generation, domainVersion: row.domainVersion ?? row.version, version: key(row.version) }));\n  const membership = snapshot.membership.map(row => ({ ...row, generation, key: `${generation}:${row.tradeId}`, version: key(row.version) }));\n  const candidate: Root = { ...source, schema: 2, generation, commitOrdinal: source.commitOrdinal + 1, revision: crypto.randomUUID(), recordCounts: { versions: rows.length + 2, lifecycle: membership.length } };\n  await store.projections.put({ key: `migration-staging:${generation}`, value: { generation, sourceRevision: source.revision } });\n  // Bounded writes yield between chunks; none can select this generation publicly.\n  for (let offset = 0; offset < rows.length; offset += 500) await store.versions.bulkAdd(rows.slice(offset, offset + 500));\n  for (let offset = 0; offset < membership.length; offset += 500) await store.lifecycle.bulkAdd(membership.slice(offset, offset + 500));\n  await store.transaction('rw', store.versions, () => new Journal(store).seedDefaults(candidate, saveTime));\n  const sealedRows = await store.versions.where('[generation+kind]').between([generation, ''], [generation, '\\uffff']).toArray();\n  const sealedByVersion = new Map(sealedRows.map(row => [row.version, row]));\n  if (sealedRows.length !== candidate.recordCounts?.versions || !rows.every(row => JSON.stringify(sealedByVersion.get(row.version)) === JSON.stringify(row))) return { status: 'MigrationBlocked' as const, reason: 'CandidateValidation', unchangedRevision: source.revision };\n  const seal = JSON.stringify(sealedRows);\n  await store.projections.put({ key: `migration-seal:${generation}`, value: { sourceRevision: source.revision, candidate, seal } });\n  return runtime.mutate(source.generation, async current => {\n    if (current?.revision !== source.revision) return { status: 'Conflict' as const, issues: ['WorkspaceChanged'] };\n    const durableSeal = await store.projections.get(`migration-seal:${generation}`);\n    const staged = await store.versions.where('[generation+kind]').between([generation, ''], [generation, '\\uffff']).toArray();\n    const stagedMembership = await store.lifecycle.where('[generation+tradeId]').between([generation, ''], [generation, '\\uffff']).toArray();\n    if (JSON.stringify(durableSeal?.value) !== JSON.stringify({ sourceRevision: source.revision, candidate, seal }) || JSON.stringify(staged) !== seal || JSON.stringify(stagedMembership) !== JSON.stringify(membership)) return { status: 'MigrationBlocked' as const, reason: 'CandidateChanged', unchangedRevision: source.revision };\n    await store.roots.put(candidate);\n    await store.projections.delete(`migration-staging:${generation}`);\n    return { status: 'Migrated' as const, root: candidate, migration: { from: 1, to: 2, sourceGeneration: source.generation, candidateGeneration: generation, sourceRevision: source.revision, sourceRows: snapshot.rows.length, candidateRows: sealedRows.length, serializedSourceBytes: bytes, candidateSealed: true } };\n  }, 'Migration');\n}\n","src/domain/journal/index.ts":"import Dexie from 'dexie';\nimport { positionChangeDefinition, type ReflectionDisposition, type JournalObligation, type JournalDecline, type ResolveDebtCommand } from './position-change-types';\nimport type { TradeSnapshot } from '../trade-record';\nimport { Runtime, addedRecords, type Store, type Envelope, type Root } from '../../infrastructure/storage';\nexport const planDefinition = {\n  id: 'plan-reflection', revision: 'plan-reflection-v1', label: 'Plan Reflection',\n  prompts: [\n    { id: 'thesis', wording: 'Why this trade, why now?', kind: 'Text', required: true, role: 'Thesis' },\n    { id: 'invalidation', wording: 'What would invalidate the thesis?', kind: 'Text', required: true, role: 'Invalidation' },\n    { id: 'conviction', wording: 'Conviction', kind: 'Scale', required: false, minimum: 1, maximum: 5 },\n    { id: 'emotion', wording: 'Primary emotion', kind: 'SingleSelect', required: false, options: ['Calm', 'Eager', 'Anxious', 'FOMO', 'Revenge', 'Relieved', 'Frustrated', 'Other'].map(label => ({ id: label.toLowerCase(), label })) },\n  ],\n};\nexport interface ReflectionAnswers { thesis: string; invalidation: string; conviction?: string; emotion?: string }\nexport interface JournalEntry {\n  id: string; version: string; definition: typeof planDefinition | typeof positionChangeDefinition;\n  anchor: { kind: 'Trade'; tradeId: string }; origin: { kind: 'Plan' | 'PositionChange'; factId: string };\n  source: { id: 'plan-confirmation' | 'position-change'; label: string };\n  obligationKey?: string; settledDebtId?: string;\n  momentTime: string; firstAuthoredTime: string; saveTime: string;\n  responses: Record<string, { kind: 'Text' | 'Scale' | 'SingleSelect'; value: string } | { kind: 'Unanswered' }>;\n}\ninterface PositionRequest { kind: 'PositionChange'; definition: typeof positionChangeDefinition; disposition: ReflectionDisposition }\ninterface PreparedPosition extends PositionRequest { status: 'Prepared' }\ninterface PreparedPlan { status: 'Prepared'; definition: typeof planDefinition; answers: ReflectionAnswers }\nexport interface PositionTrigger { tradeId: string; positionChangeId: string; economicTime: string; saveTime: string; sequence: number }\nexport interface PositionEffects { obligation: JournalObligation; entry?: JournalEntry; decline?: JournalDecline; addedRecords: number }\nexport interface JournalQuery { status: 'Ready'; generation?: string; workspaceRevision?: string; obligations: JournalObligation[]; obligationHistory: JournalObligation[]; entries: JournalEntry[]; declines: JournalDecline[] }\nexport class Journal {\n  constructor(readonly store: Store, readonly runtime?: Runtime) {}\n  async query(tradeId: string): Promise<JournalEntry[]>;\n  async query(request: { tradeId?: string; obligationId?: string; scope?: 'Outstanding' | 'History' }): Promise<JournalQuery>;\n  async query(request: string | { tradeId?: string; obligationId?: string; scope?: 'Outstanding' | 'History' }): Promise<JournalEntry[] | JournalQuery> {\n    return this.store.transaction('r', [this.store.roots, this.store.versions], async () => {\n      const root = await this.store.roots.get('active');\n      const tradeId = typeof request === 'string' ? request : request.tradeId;\n      const obligationId = typeof request === 'string' ? undefined : request.obligationId;\n      const rows = !root ? [] : obligationId ? await this.store.versions.where('[generation+id]').equals([root.generation, obligationId]).filter(row => row.kind === 'JournalObligation').toArray() : tradeId ? await this.store.versions.where('[generation+tradeId]').equals([root.generation, tradeId]).toArray() : (await Promise.all((typeof request !== 'string' && request.scope === 'Outstanding' ? ['JournalObligation'] : ['JournalEntry', 'JournalDecline', 'JournalObligation']).map(kind => this.store.versions.where('[generation+kind]').equals([root.generation, kind]).toArray()))).flat();\n      rows.sort((a, b) => a.commitOrdinal - b.commitOrdinal || a.sequence - b.sequence);\n      const entries = rows.filter(row => row.kind === 'JournalEntry').map(row => row.value as JournalEntry);\n      if (typeof request === 'string') return entries;\n      const obligationHistory = rows.filter(row => row.kind === 'JournalObligation').map(row => row.value as JournalObligation);\n      const current = new Map(obligationHistory.map(obligation => [obligation.id, obligation]));\n      return { status: 'Ready', generation: root?.generation, workspaceRevision: root?.revision, obligations: [...current.values()].filter(obligation => request.scope !== 'Outstanding' || obligation.status === 'Outstanding'), obligationHistory, entries, declines: rows.filter(row => row.kind === 'JournalDecline').map(row => row.value as JournalDecline) };\n    });\n  }\n  async getDefinitions(): Promise<typeof planDefinition | undefined>;\n  async getDefinitions(kind: 'PositionChange'): Promise<typeof positionChangeDefinition | undefined>;\n  async getDefinitions(kind?: 'PositionChange'): Promise<typeof planDefinition | typeof positionChangeDefinition | undefined> {\n    const root = await this.store.roots.get('active');\n    if (!root) return undefined;\n    const revision = kind === 'PositionChange' ? positionChangeDefinition.revision : root.definitionRevision;\n    const row = await this.store.versions.get(`${root.generation}:${revision}`);\n    return row?.value as typeof planDefinition | typeof positionChangeDefinition | undefined;\n  }\n  async save(command: ResolveDebtCommand) {\n    if (!this.runtime) throw new Error('Coordinator runtime required');\n    try { return await this.runtime.mutate(command.generation, async root => {\n      if (!root) return { status: 'NotFound' as const };\n      if (root.revision !== command.expectedWorkspaceRevision) return { status: 'Conflict' as const, reason: 'WorkspaceChanged' };\n      const rows = await this.store.versions.where('[generation+id]').equals([root.generation, command.obligationId]).filter(row => row.kind === 'JournalObligation').toArray();\n      rows.sort((a, b) => a.commitOrdinal - b.commitOrdinal);\n      const original = rows.at(-1)?.value as JournalObligation | undefined;\n      if (!original) return { status: 'NotFound' as const };\n      if (original.revision !== command.expectedRevision || original.status !== 'Outstanding') return { status: 'Conflict' as const, reason: 'ObligationChanged' };\n      if (original.route.kind === 'TradeWorkflow') return { status: 'NeedsTradeWorkflow' as const, route: structuredClone(original.route) };\n      const prepared = this.prepareEffects({ kind: 'PositionChange', definition: original.definition, disposition: command.disposition });\n      if (prepared.status === 'Rejected') return prepared;\n      const saveTime = new Date().toISOString();\n      const result = await this.completeObligation({ ...original, saveTime }, command.disposition, root, root.recordedSequence);\n      const workspaceRevision = crypto.randomUUID();\n      await this.store.roots.put({ ...root, revision: workspaceRevision, recordCounts: addedRecords(root, result.addedRecords), commitOrdinal: root.commitOrdinal + 1 });\n      return { status: 'Saved' as const, ...result, debt: result.obligation, workspaceRevision, receipt: { generation: root.generation, workspaceRevision, commitOrdinal: root.commitOrdinal + 1, saveTime } };\n    }); } catch {\n      this.runtime.invalidate('transaction');\n      return { status: 'StorageFailure' as const };\n    }\n  }\n  prepareEffects(request: PositionRequest): PreparedPosition | { status: 'Rejected'; issues: string[] };\n  prepareEffects(definition: typeof planDefinition, answers: ReflectionAnswers): PreparedPlan | { status: 'Rejected'; issues: string[] };\n  prepareEffects(definition: typeof planDefinition | PositionRequest, answers?: ReflectionAnswers): PreparedPlan | PreparedPosition | { status: 'Rejected'; issues: string[] } {\n    if ('kind' in definition) {\n      const issues: string[] = [];\n      if (definition.disposition.kind === 'Complete') {\n        const responses = definition.disposition.answers;\n        for (const prompt of definition.definition.prompts) {\n          const value = responses[prompt.id as keyof typeof responses];\n          if (prompt.required && !value?.trim()) issues.push(`${prompt.id}:Required`);\n          else if (value && prompt.kind === 'SingleSelect' && !prompt.options?.some(option => option.id === value)) issues.push(`${prompt.id}:UnknownOption`);\n          else if (value && prompt.kind === 'Scale' && !/^[1-5]$/.test(value)) issues.push(`${prompt.id}:InvalidScale`);\n        }\n      }\n      return issues.length ? { status: 'Rejected', issues } : { ...structuredClone(definition), status: 'Prepared' };\n    }\n    if (!answers) return { status: 'Rejected', issues: ['AnswersRequired'] };\n    const issues: string[] = [];\n    if (answers.conviction && !/^[1-5]$/.test(answers.conviction)) issues.push('InvalidConviction');\n    if (answers.emotion && !definition.prompts.some(prompt => prompt.id === 'emotion' && prompt.options?.some(option => option.id === answers.emotion))) issues.push('UnknownEmotion');\n    if (issues.length) return { status: 'Rejected' as const, issues };\n    return { status: 'Prepared' as const, definition: structuredClone(definition), answers: structuredClone(answers) };\n  }\n  async applyPreparedEffects(prepared: PreparedPosition, trade: PositionTrigger, root: Root): Promise<PositionEffects>;\n  async applyPreparedEffects(prepared: PreparedPlan, trade: TradeSnapshot, root: Root): Promise<JournalEntry>;\n  async applyPreparedEffects(prepared: PreparedPlan | PreparedPosition, trade: TradeSnapshot | PositionTrigger, root: Root): Promise<JournalEntry | PositionEffects> {\n    if ('kind' in prepared) {\n      if (!Dexie.currentTransaction) throw new Error('SemanticTransactionRequired');\n      if (!('positionChangeId' in trade)) throw new Error('PositionChangeRequired');\n      const key = `${trade.positionChangeId}:position-change-reflection`;\n      const existing = await this.store.versions.where('[generation+id]').equals([root.generation, key]).toArray();\n      if (existing.length) throw new Error('ObligationAlreadyExists');\n      const obligation: JournalObligation = { id: key, revision: crypto.randomUUID(), key, status: 'Outstanding', definition: structuredClone(prepared.definition), anchor: { kind: 'Trade', tradeId: trade.tradeId }, origin: { kind: 'PositionChange', factId: trade.positionChangeId }, source: { id: 'position-change', label: 'Position Change' }, dueTime: trade.economicTime, momentTime: trade.economicTime, saveTime: trade.saveTime, route: { kind: 'Journal' }, debtId: crypto.randomUUID() };\n      if (prepared.disposition.kind !== 'Defer') {\n        delete obligation.debtId;\n        return this.completeObligation(obligation, prepared.disposition, root, trade.sequence);\n      }\n      await this.writeObligation(obligation, root, trade.sequence);\n      return { obligation, addedRecords: 1 };\n    }\n    if (!('planFactId' in trade)) throw new Error('PlanRequired');\n    if (!Dexie.currentTransaction) throw new Error('SemanticTransactionRequired');\n    const entry: JournalEntry = { id: crypto.randomUUID(), version: crypto.randomUUID(), definition: structuredClone(prepared.definition), anchor: { kind: 'Trade', tradeId: trade.tradeId }, origin: { kind: 'Plan', factId: trade.planFactId }, source: { id: 'plan-confirmation', label: 'Plan Confirmation' }, momentTime: trade.economicTime, firstAuthoredTime: trade.saveTime, saveTime: trade.saveTime, responses: { thesis: { kind: 'Text', value: prepared.answers.thesis }, invalidation: { kind: 'Text', value: prepared.answers.invalidation }, conviction: prepared.answers.conviction ? { kind: 'Scale', value: prepared.answers.conviction } : { kind: 'Unanswered' }, emotion: prepared.answers.emotion ? { kind: 'SingleSelect', value: prepared.answers.emotion } : { kind: 'Unanswered' } } };\n    await this.store.versions.add({ version: entry.version, id: entry.id, generation: root.generation, kind: 'JournalEntry', tradeId: trade.tradeId, economicTime: trade.economicTime, saveTime: trade.saveTime, sequence: trade.sequence, commitOrdinal: root.commitOrdinal + 1, value: entry });\n    return entry;\n  }\n  private async completeObligation(original: JournalObligation, disposition: Exclude<ReflectionDisposition, { kind: 'Defer' }>, root: Root, sequence: number): Promise<PositionEffects> {\n    const obligation: JournalObligation = { ...structuredClone(original), revision: crypto.randomUUID(), status: disposition.kind === 'Complete' ? 'Completed' : 'Declined' };\n    let entry: JournalEntry | undefined;\n    let decline: JournalDecline | undefined;\n    if (disposition.kind === 'Complete') {\n      const responses: JournalEntry['responses'] = {};\n      for (const prompt of original.definition.prompts) {\n        const value = disposition.answers[prompt.id as keyof typeof disposition.answers];\n        responses[prompt.id] = value ? { kind: prompt.kind as 'Text' | 'Scale' | 'SingleSelect', value } : { kind: 'Unanswered' };\n      }\n      entry = { id: crypto.randomUUID(), version: crypto.randomUUID(), definition: structuredClone(original.definition), anchor: original.anchor, origin: original.origin, source: original.source, obligationKey: original.key, ...(original.debtId ? { settledDebtId: original.debtId } : {}), momentTime: original.momentTime, firstAuthoredTime: obligation.saveTime, saveTime: obligation.saveTime, responses };\n      obligation.entryId = entry.id;\n    } else {\n      decline = { id: crypto.randomUUID(), version: crypto.randomUUID(), obligationKey: original.key, ...(original.debtId ? { debtId: original.debtId } : {}), ...(disposition.reason ? { reason: disposition.reason } : {}), anchor: original.anchor, origin: original.origin, definition: original.definition, source: original.source, momentTime: original.momentTime, saveTime: obligation.saveTime };\n      obligation.declineId = decline.id;\n    }\n    const fact = entry ?? decline;\n    if (!fact) throw new Error('OutcomeRequired');\n    await this.store.versions.add({ version: fact.version, id: fact.id, generation: root.generation, kind: entry ? 'JournalEntry' : 'JournalDecline', tradeId: original.anchor.tradeId, economicTime: original.momentTime, saveTime: obligation.saveTime, sequence, commitOrdinal: root.commitOrdinal + 1, value: fact });\n    await this.writeObligation(obligation, root, sequence);\n    return { obligation, ...(entry ? { entry } : {}), ...(decline ? { decline } : {}), addedRecords: 2 };\n  }\n  private async writeObligation(obligation: JournalObligation, root: Root, sequence: number) {\n    await this.store.versions.add({ version: obligation.revision, id: obligation.id, generation: root.generation, kind: 'JournalObligation', tradeId: obligation.anchor.tradeId, economicTime: obligation.momentTime, saveTime: obligation.saveTime, sequence, commitOrdinal: root.commitOrdinal + 1, value: obligation });\n  }\n  async seedDefaults(root: Root, saveTime: string) {\n    const seeds = [\n      { id: 'plan-reflection', version: planDefinition.revision, kind: 'Definition', value: planDefinition },\n      { id: 'plan-confirmation', version: 'plan-confirmation-v1', kind: 'Source', value: { id: 'plan-confirmation', label: 'Plan Confirmation' } },\n      ...(root.schema === 2 ? [\n        { id: 'position-change-reflection', version: positionChangeDefinition.revision, kind: 'Definition', value: positionChangeDefinition },\n        { id: 'position-change', version: 'position-change-v1', kind: 'Source', value: { id: 'position-change', label: 'Position Change' } },\n      ] : []),\n    ];\n    for (const seed of seeds) {\n      const existing = await this.store.versions.get(`${root.generation}:${seed.version}`);\n      if (existing) { if (JSON.stringify(existing.value) !== JSON.stringify(seed.value)) throw new Error('SeedConflict'); continue; }\n      const row: Envelope = { ...seed, version: `${root.generation}:${seed.version}`, generation: root.generation, tradeId: '', economicTime: saveTime, saveTime, sequence: 0, commitOrdinal: root.commitOrdinal };\n      await this.store.versions.add(row);\n    }\n  }\n}\n","src/domain/journal/position-change-types.ts":"export const positionChangeDefinition = {\n  id: 'position-change-reflection', revision: 'position-change-reflection-v1', label: 'Position Change Reflection',\n  prompts: [\n    { id: 'decision-mode', wording: 'Decision mode', kind: 'SingleSelect', required: true, options: ['As Planned', 'Deliberate Adjustment', 'Reactive', 'Externally Imposed'].map(label => ({ id: label.toLowerCase().replaceAll(' ', '-'), label })) },\n    { id: 'emotion', wording: 'Primary emotion', kind: 'SingleSelect', required: true, options: ['Calm', 'Eager', 'Anxious', 'FOMO', 'Revenge', 'Relieved', 'Frustrated', 'Other'].map(label => ({ id: label.toLowerCase(), label })) },\n    { id: 'confidence', wording: 'Decision confidence', kind: 'Scale', required: true, minimum: 1, maximum: 5 },\n    { id: 'note', wording: 'Note', kind: 'Text', required: false },\n  ],\n};\nexport interface PositionReflectionAnswers { 'decision-mode': string; emotion: string; confidence: string; note?: string }\nexport type ReflectionDisposition = { kind: 'Complete'; answers: PositionReflectionAnswers } | { kind: 'Defer' } | { kind: 'Decline'; reason?: string };\nexport interface JournalObligation {\n  id: string; revision: string; key: string; status: 'Outstanding' | 'Completed' | 'Declined';\n  definition: typeof positionChangeDefinition;\n  anchor: { kind: 'Trade'; tradeId: string }; origin: { kind: 'PositionChange'; factId: string };\n  source: { id: 'position-change'; label: 'Position Change' };\n  dueTime: string; momentTime: string; saveTime: string;\n  route: { kind: 'Journal' } | { kind: 'TradeWorkflow'; tradeId: string; operation: string };\n  debtId?: string; entryId?: string; declineId?: string;\n}\nexport interface JournalDecline {\n  id: string; version: string; obligationKey: string; debtId?: string; reason?: string;\n  anchor: JournalObligation['anchor']; origin: JournalObligation['origin'];\n  definition: typeof positionChangeDefinition; source: JournalObligation['source']; momentTime: string; saveTime: string;\n}\nexport interface ResolveDebtCommand {\n  kind: 'ResolveDebt'; generation: string; expectedWorkspaceRevision: string;\n  obligationId: string; expectedRevision: string; disposition: Exclude<ReflectionDisposition, { kind: 'Defer' }>;\n}\n","src/domain/reference-catalog/index.ts":"import { addedRecords, Runtime, type Store, type Root } from '../../infrastructure/storage';\nexport interface CatalogRecord {\n  id: string; version: string; kind: string; label: string; active: boolean; origin: string; parentId?: string;\n  shape?: { roles: { kind: string; direction: string; relativeQuantity: string }[] };\n}\nexport const longStock = { id: 'long-stock', kind: 'Strategy', label: 'Long Stock', active: true, shape: { roles: [{ kind: 'Stock', direction: 'Long', relativeQuantity: '1' }] }, origin: 'Default' };\nexport class ReferenceCatalog {\n  constructor(readonly store: Store, readonly runtime?: Runtime) {}\n  async save(command: { kind: 'Institution' | 'Account'; label: string; parentId?: string; generation: string; expectedCatalogRevision: string }) {\n    if (!this.runtime) throw new Error('Coordinator runtime required');\n    try { return await this.runtime.mutate(command.generation, async root => {\n      if (!root) throw new Error('WorkspaceRequired');\n      if (root.catalogRevision !== command.expectedCatalogRevision) return { status: 'Conflict' as const, reason: 'CatalogChanged' };\n      const rows = (await Promise.all(['Institution', 'Account'].map(kind => this.store.versions.where('[generation+kind]').equals([root.generation, kind]).toArray()))).flat();\n      const records = rows.map(row => row.value as CatalogRecord);\n      const normalize = (label: string) => label.normalize('NFC').trim().replace(/\\s+/g, ' ').toLowerCase();\n      const issues: string[] = [];\n      if (!normalize(command.label)) issues.push('LabelRequired');\n      if (records.some(record => record.kind === command.kind && record.parentId === command.parentId && normalize(record.label) === normalize(command.label))) issues.push('DuplicateLabel');\n      if (command.kind === 'Account' && !records.some(record => record.id === command.parentId && record.kind === 'Institution' && record.active)) issues.push('SelectableInstitutionRequired');\n      if (issues.length) return { status: 'Rejected' as const, issues };\n      const version = crypto.randomUUID();\n      const record: CatalogRecord = { id: crypto.randomUUID(), version, kind: command.kind, label: command.label, active: true, origin: 'Trader', ...(command.parentId ? { parentId: command.parentId } : {}) };\n      const saveTime = new Date().toISOString();\n      await this.store.versions.add({ version, id: record.id, generation: root.generation, kind: command.kind, value: record, tradeId: '', economicTime: saveTime, saveTime, sequence: 0, commitOrdinal: root.commitOrdinal + 1 });\n      const catalogRevision = crypto.randomUUID();\n      await this.store.roots.put({ ...root, revision: crypto.randomUUID(), catalogRevision, recordCounts: addedRecords(root, 1), commitOrdinal: root.commitOrdinal + 1 });\n      return { status: 'Saved' as const, record, catalogRevision, onboarding: command.kind === 'Account' ? 'ReadyForTradePlanning' : 'NeedsInstitutionAndAccount' };\n    }); } catch {\n      this.runtime.invalidate('transaction');\n      return { status: 'StorageFailure' as const };\n    }\n  }\n  async query(request: { family: 'Strategy' | 'Institution' | 'Account' }) {\n    return this.store.transaction('r', [this.store.roots, this.store.versions], async () => {\n      const root = await this.store.roots.get('active');\n      if (!root) return { status: 'NotInitialized' as const, records: [] };\n      const rows = await this.store.versions.where('[generation+kind]').equals([root.generation, request.family]).toArray();\n      return { status: 'Ready' as const, records: rows.map(row => ({ ...(row.value as Omit<CatalogRecord, 'version'>), version: (row.value as CatalogRecord).version ?? row.domainVersion ?? row.version })).sort((a, b) => a.label.localeCompare(b.label) || a.id.localeCompare(b.id)), catalogRevision: root.catalogRevision, generation: root.generation };\n    });\n  }\n  async resolve(request: { ids: string[]; expectedCatalogRevision: string; use: 'NewSelection' | 'DisplayOnly' | 'RetainedReference' }) {\n    const catalog = await queryPlanningCatalog(this.store);\n    if (catalog.status !== 'Ready' || catalog.catalogRevision !== request.expectedCatalogRevision) return { status: 'Conflict' as const };\n    const records = request.ids.map(id => catalog.records.find(record => record.id === id));\n    if (records.some(record => !record || (request.use === 'NewSelection' && !record.active))) return { status: 'Rejected' as const, issues: ['InactiveOrUnknownReference'] };\n    return { status: 'Resolved' as const, records: records as CatalogRecord[], catalogRevision: catalog.catalogRevision };\n  }\n  async seedDefaults(root: Root, saveTime: string) {\n    const version = `${root.generation}:long-stock-v1`;\n    const existing = await this.store.versions.get(version);\n    if (existing) { if (JSON.stringify(existing.value) !== JSON.stringify(longStock)) throw new Error('SeedConflict'); return; }\n    await this.store.versions.add({ version, id: longStock.id, generation: root.generation, kind: 'Strategy', value: longStock, tradeId: '', economicTime: saveTime, saveTime, sequence: 0, commitOrdinal: root.commitOrdinal });\n  }\n}\n\n// Current coordinators need all three planning families from one read snapshot.\nexport async function queryPlanningCatalog(store: Store) {\n  return store.transaction('r', [store.roots, store.versions], async () => {\n    const families = await Promise.all((['Strategy', 'Institution', 'Account'] as const).map(family => new ReferenceCatalog(store).query({ family })));\n    const binding = families[0];\n    return { ...binding, records: families.flatMap(family => family.records) };\n  });\n}\n","src/domain/trade-analysis/index.ts":"import type { Execution, OpeningAgreement, PositionChange } from '../trade-record/opening-types';\nimport Decimal from 'decimal.js';\nimport { Temporal } from '@js-temporal/polyfill';\nexport interface PlanInput {\n  instrument?: { kind: string; symbol: string; currency: string };\n  quantity: string;\n  entry: string;\n  stop: string;\n  target: string;\n  thesis: string;\n  invalidation: string;\n}\nexport interface Baseline {\n  risk: string;\n  oneR: string;\n  reward: string;\n  ratio: { numerator: string; denominator: string };\n  conditions: { kind: 'Stop' | 'Target'; price: string; amount: string }[];\n}\nexport type Assessment = { status: 'Accepted'; plan: PlanInput; baseline: Baseline; expirationMethod: { status: 'NotApplicable'; reason: 'NoOptionExpirationAnchor' } } | { status: 'Rejected'; issues: string[] };\nexport function assessPlan(input: PlanInput): Assessment {\n  const issues: string[] = [];\n  const instrument = input.instrument;\n  if (!instrument || instrument.kind !== 'Stock' || instrument.currency !== 'USD' || !instrument.symbol.trim()) issues.push('ExactStockRequired');\n  const quantity = parseDecimal(input.quantity);\n  if (!quantity || !quantity.isFinite() || quantity.lte(0)) issues.push('PositiveQuantityRequired');\n  if (!input.thesis.trim()) issues.push('ThesisRequired');\n  if (!input.invalidation.trim()) issues.push('InvalidationRequired');\n  for (const key of ['entry', 'stop', 'target'] as const) {\n    const value = parseDecimal(input[key]);\n    if (!value || !value.isFinite() || value.lt(0)) issues.push(`Invalid${key[0]?.toUpperCase()}${key.slice(1)}`);\n  }\n  if (!issues.some(issue => issue.startsWith('Invalid') && issue !== 'InvalidationRequired')) {\n    if (new Decimal(input.entry).lte(input.stop)) issues.push('PositiveRiskRequired');\n    if (new Decimal(input.target).lte(input.entry)) issues.push('ForwardRewardRequired');\n  }\n  if (issues.length) return { status: 'Rejected', issues };\n  input = { ...input, instrument: input.instrument ? { ...input.instrument, symbol: input.instrument.symbol.trim().toUpperCase() } : undefined, ...Object.fromEntries((['quantity', 'entry', 'stop', 'target'] as const).map(key => [key, new Decimal(input[key]).isZero() ? '0' : new Decimal(input[key]).toFixed()])) };\n  const values = [input.entry, input.stop, input.target, input.quantity].map(value => new Decimal(value));\n  const precision = values.reduce((total, value) => total + value.sd() + value.dp() + Math.abs(value.e), 16);\n  const Exact = Decimal.clone({ precision, rounding: Decimal.ROUND_HALF_EVEN });\n  const risk = new Exact(input.entry).minus(input.stop).times(input.quantity).toFixed();\n  const reward = new Exact(input.target).minus(input.entry).times(input.quantity).toFixed();\n  return { status: 'Accepted', expirationMethod: { status: 'NotApplicable', reason: 'NoOptionExpirationAnchor' }, plan: structuredClone(input), baseline: { risk, oneR: risk, reward, ratio: { numerator: ratio(reward, risk).numerator, denominator: ratio(reward, risk).denominator }, conditions: [{ kind: 'Stop', price: input.stop, amount: risk }, { kind: 'Target', price: input.target, amount: reward }] } };\n}\n\nfunction ratio(numerator: string, denominator: string): { numerator: string; denominator: string } {\n  const scale = Math.max(new Decimal(numerator).dp(), new Decimal(denominator).dp());\n  const Exact = Decimal.clone({ precision: numerator.length + denominator.length + scale * 2 + 16 });\n  let n = new Exact(numerator).times(new Exact(10).pow(scale));\n  let d = new Exact(denominator).times(new Exact(10).pow(scale));\n  let a = n.abs();\n  let b = d.abs();\n  while (!b.isZero()) { const remainder = a.mod(b); a = b; b = remainder; }\n  n = n.div(a); d = d.div(a);\n  return { numerator: n.toFixed(), denominator: d.toFixed() };\n}\nexport interface OpeningInput {\n  plannedLegId: string;\n  positionChange: PositionChange;\n  executions: Execution[];\n  recordedAgreement?: OpeningAgreement;\n}\nexport interface PlannedCandidate {\n  candidateId: string;\n  revision: string;\n  digest: string;\n  plan: PlanInput;\n  storedLifecycle: string;\n  exposureFacts: unknown[];\n  opening?: OpeningInput;\n}\nexport function derive(candidate: PlannedCandidate) {\n  const assessment = assessPlan(candidate.plan);\n  if (assessment.status === 'Rejected') return { status: 'IntegrityBlocked' as const, findings: assessment.issues };\n  if (candidate.opening) return deriveOpening(candidate, assessment.baseline, candidate.opening);\n  if (candidate.storedLifecycle !== 'Planned' || candidate.exposureFacts.length) return { status: 'IntegrityBlocked' as const, findings: ['LifecycleDisagreement'] };\n  return { status: 'Derived' as const, reconciliation: { candidateId: candidate.candidateId, revision: candidate.revision, digest: candidate.digest, expectedLifecycle: 'Planned' as const }, baseline: assessment.baseline, entryReadiness: 'Unfilled' as const, positions: [], lotMatches: [], deviations: [], terminalDisposition: null };\n}\n\nfunction parseDecimal(value: string): Decimal | undefined {\n  if (!/^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?$/i.test(value)) return undefined;\n  try { return new Decimal(value); } catch { return undefined; }\n}\n\nfunction exactEngine(values: string[]) {\n  return Decimal.clone({ precision: values.reduce((total, value) => { const decimal = new Decimal(value); return total + decimal.sd() + decimal.dp() + Math.abs(decimal.e); }, 32), rounding: Decimal.ROUND_HALF_EVEN });\n}\nfunction deriveOpening(candidate: PlannedCandidate, baseline: Baseline, opening: OpeningInput, verifyAgreement = true) {\n  const findings: string[] = [];\n  const change = opening.positionChange;\n  if (candidate.storedLifecycle !== 'Open') findings.push('LifecycleDisagreement');\n  if (candidate.exposureFacts.length) findings.push('UnexpectedExposureFacts');\n  if (change.tradeId !== candidate.candidateId || change.originTradeId !== candidate.candidateId) findings.push('PositionChangeOwnershipMismatch');\n  if (change.kind !== 'InitialStockEntry') findings.push('InitialStockEntryRequired');\n  if (!validInstant(change.economicTime) || !validInstant(change.saveTime)) findings.push('InvalidPositionChangeTime');\n  if (!Number.isSafeInteger(change.sequence) || change.sequence < 1) findings.push('InvalidRecordedSequence');\n  if (!opening.plannedLegId || !change.id || !change.version || !opening.executions.length) findings.push('OpeningIdentityRequired');\n  const ids = new Set<string>(); const sequences = new Set<number>([change.sequence]);\n  for (const execution of opening.executions) {\n    const quantity = parseDecimal(execution.quantity); const price = parseDecimal(execution.price); const fee = parseDecimal(execution.fee);\n    if (!quantity?.isFinite() || quantity.lte(0)) findings.push('PositiveExecutionQuantityRequired');\n    if (!price?.isFinite() || price.lt(0)) findings.push('NonnegativeExecutionPriceRequired');\n    if (!fee?.isFinite() || fee.lt(0)) findings.push('NonnegativeExecutionFeeRequired');\n    if (!validInstant(execution.economicTime) || !validInstant(execution.saveTime)) findings.push('InvalidExecutionTime');\n    if (execution.tradeId !== candidate.candidateId || execution.positionChangeId !== change.id) findings.push('ExecutionOwnershipMismatch');\n    if (execution.plannedLegId !== opening.plannedLegId) findings.push('PlannedLegIntentMismatch');\n    if (execution.action !== 'Buy') findings.push('BuyExecutionRequired');\n    if (execution.instrument.kind !== 'Stock' || !execution.instrument.symbol.trim() || !execution.instrument.currency.trim()) findings.push('ExactStockRequired');\n    if (!execution.id || !execution.version || ids.has(execution.id)) findings.push('DuplicateExecutionOwnership');\n    ids.add(execution.id);\n    if (!Number.isSafeInteger(execution.sequence) || execution.sequence < 1 || sequences.has(execution.sequence)) findings.push('InvalidRecordedSequence');\n    sequences.add(execution.sequence);\n  }\n  if (change.executionIds.length !== ids.size || new Set(change.executionIds).size !== ids.size || change.executionIds.some(id => !ids.has(id))) findings.push('PositionChangeMembershipMismatch');\n  if (findings.length) return { status: 'IntegrityBlocked' as const, findings: [...new Set(findings)] };\n\n  const Exact = exactEngine([candidate.plan.stop, candidate.plan.target, baseline.risk, baseline.reward, ...opening.executions.flatMap(execution => [execution.quantity, execution.price, execution.fee])]);\n  let quantity = new Exact(0); let grossBasis = new Exact(0); let fees = new Exact(0);\n  for (const execution of opening.executions) {\n    quantity = quantity.plus(execution.quantity);\n    grossBasis = grossBasis.plus(new Exact(execution.quantity).times(execution.price));\n    fees = fees.plus(execution.fee);\n  }\n  if (!quantity.eq(candidate.plan.quantity)) return { status: 'IntegrityBlocked' as const, findings: ['CompletePlannedQuantityRequired'] };\n  const risk = grossBasis.minus(quantity.times(candidate.plan.stop)).plus(fees).toFixed();\n  const reward = quantity.times(candidate.plan.target).minus(grossBasis).minus(fees).toFixed();\n  const comparison = new Exact(reward).times(baseline.risk).comparedTo(new Exact(risk).times(baseline.reward));\n  const mismatches = (['kind', 'symbol', 'currency'] as const).filter(key => opening.executions.some(execution => execution.instrument[key] !== candidate.plan.instrument?.[key]));\n  const deviations: OpeningAgreement['deviations'] = mismatches.length ? [{ kind: 'PlannedLegTerms', plannedLegId: opening.plannedLegId, mismatches }] : [];\n  const entryResolution = { positionChangeId: opening.positionChange.id, economicTime: opening.positionChange.economicTime };\n  const agreement = opening.recordedAgreement;\n  if (verifyAgreement && !agreement) return { status: 'IntegrityBlocked' as const, findings: ['MissingOpeningAgreement'] };\n  if (verifyAgreement && agreement && (agreement.factRevision !== candidate.revision || agreement.lotMatches.length !== 0 || agreement.entryResolution.positionChangeId !== entryResolution.positionChangeId || !validInstant(agreement.entryResolution.economicTime) || Temporal.Instant.compare(agreement.entryResolution.economicTime, entryResolution.economicTime) !== 0 || agreement.deviations.length !== deviations.length || agreement.deviations.some((deviation, index) => { const expected = deviations[index]; return !expected || deviation.kind !== expected.kind || deviation.plannedLegId !== expected.plannedLegId || deviation.mismatches.join(',') !== expected.mismatches.join(','); }))) return { status: 'IntegrityBlocked' as const, findings: ['OpeningAgreementDisagreement'] };\n  const fulfillment = deviations.length ? 'FilledWithDeviation' as const : 'FilledAsPlanned' as const;\n  const positions: { instrument: Execution['instrument']; quantity: string; lots: { openingId: string; quantity: string; price: string; openingFees: string; feePerShare: { numerator: string; denominator: string } }[] }[] = [];\n  for (const execution of [...opening.executions].sort((a, b) => Temporal.Instant.compare(a.economicTime, b.economicTime) || a.sequence - b.sequence)) {\n    let position = positions.find(item => item.instrument.kind === execution.instrument.kind && item.instrument.symbol === execution.instrument.symbol && item.instrument.currency === execution.instrument.currency);\n    if (!position) { position = { instrument: structuredClone(execution.instrument), quantity: '0', lots: [] }; positions.push(position); }\n    position.quantity = new Exact(position.quantity).plus(execution.quantity).toFixed();\n    position.lots.push({ openingId: execution.id, quantity: new Exact(execution.quantity).toFixed(), price: new Exact(execution.price).toFixed(), openingFees: new Exact(execution.fee).toFixed(), feePerShare: ratio(execution.fee, execution.quantity) });\n  }\n  return { status: 'Derived' as const, fulfillment, entryReadiness: fulfillment, weightedEntry: ratio(grossBasis.toFixed(), quantity.toFixed()), entryQuality: { status: 'Resolved' as const, comparison: new Exact(risk).lte(0) ? 'Unavailable' as const : comparison < 0 ? 'BelowPlan' as const : comparison > 0 ? 'AbovePlan' as const : 'AsPlanned' as const, risk, reward, ratio: new Exact(risk).lte(0) ? { status: 'Unavailable' as const, reason: 'NonpositiveEntryRisk' as const } : ratio(reward, risk) }, entryResolution: { positionChangeId: opening.positionChange.id, economicTime: opening.positionChange.economicTime }, reconciliation: { candidateId: candidate.candidateId, revision: candidate.revision, digest: candidate.digest, expectedLifecycle: 'Open' as const }, baseline, quantity: quantity.toFixed(), grossBasis: grossBasis.toFixed(), openingFees: fees.toFixed(), realizedResult: { status: 'NotApplicable' as const, reason: 'NoDisposal' as const }, positions, lotMatches: [], deviations, terminalDisposition: null };\n}\n\nexport function assessChange(candidate: PlannedCandidate) {\n  if (candidate.storedLifecycle !== 'Planned' || !candidate.opening) return { status: 'Rejected' as const, issues: ['InitialStockEntryRequiresPlannedTrade'] };\n  const assessment = assessPlan(candidate.plan);\n  if (assessment.status === 'Rejected') return assessment;\n  const derivation = deriveOpening({ ...candidate, storedLifecycle: 'Open' }, assessment.baseline, candidate.opening, false);\n  if (derivation.status !== 'Derived') return { status: 'Rejected' as const, issues: derivation.findings };\n  if ('fulfillment' in derivation && derivation.fulfillment === 'FilledWithDeviation') return { status: 'Rejected' as const, issues: ['MissingManagementCoverage'] };\n  return { status: 'Accepted' as const, derivation };\n}\n\nfunction validInstant(value: string) { try { Temporal.Instant.from(value); return true; } catch { return false; } }\n","src/domain/trade-record/index.ts":"import { prepareOpening, applyOpening, type OpeningPreparation, type PreparedOpening, type TradeHead } from './opening';\nimport type { OpeningInput } from '../trade-analysis';\nimport Dexie from 'dexie';\nimport { Temporal } from '@js-temporal/polyfill';\nimport { derive, type Assessment, type Baseline, type PlanInput, type PlannedCandidate } from '../trade-analysis';\nimport type { Envelope, Root, Store } from '../../infrastructure/storage';\nexport interface TradeSnapshot {\n  tradeId: string; revision: string; planFactId: string; planVersionId: string;\n  plannedLegId: string; stopId: string; targetId: string;\n  accountId: string; strategyId: string; lifecycle: 'Planned' | 'Open';\n  opening?: OpeningInput; stateVersionId?: string;\n  plan: PlanInput; baseline: Baseline;\n  economicTime: string; saveTime: string; sequence: number;\n}\nexport interface PreparedPlan extends PlannedCandidate { accountId: string; strategyId: string; economicTime: string; assessment: Extract<Assessment, { status: 'Accepted' }> }\nexport class TradeRecord {\n  constructor(readonly store: Store) {}\n  async resolveAnchors(anchors: ({ kind: 'Trade'; tradeId: string } | { kind: 'Execution'; executionId: string })[]) {\n    if (anchors.length > 50) return { status: 'Rejected' as const, issues: ['AnchorBatchTooLarge'] };\n    return this.store.transaction('r', [this.store.roots, this.store.lifecycle, this.store.versions], async () => {\n      const root = await this.store.roots.get('active');\n      const tradeIds = anchors.flatMap(anchor => anchor.kind === 'Trade' ? [anchor.tradeId] : []);\n      const executionIds = anchors.flatMap(anchor => anchor.kind === 'Execution' ? [anchor.executionId] : []);\n      const rows = root ? await this.store.lifecycle.bulkGet(tradeIds.map(id => `${root.generation}:${id}`)) : [];\n      const executions = root && executionIds.length ? await this.store.versions.where('[generation+id]').anyOf(executionIds.map(id => [root.generation, id])).filter(row => row.kind === 'Execution').toArray() : [];\n      const trades = new Map(rows.filter(row => !!row).map(row => [row.tradeId, row.tradeId]));\n      const owners = new Map(executions.map(row => [row.id, row.tradeId]));\n      return { status: 'Ready' as const, workspaceRevision: root?.revision, resolutions: anchors.map(anchor => {\n        const owningTradeId = anchor.kind === 'Trade' ? trades.get(anchor.tradeId) : owners.get(anchor.executionId);\n        return owningTradeId ? { anchor, status: 'Effective' as const, owningTradeId } : { anchor, status: 'Unknown' as const };\n      }) };\n    });\n  }\n  async getRecord(tradeId: string): Promise<TradeSnapshot | undefined> {\n    return this.store.transaction('r', [this.store.roots, this.store.lifecycle, this.store.versions], async () => {\n      const root = await this.store.roots.get('active');\n      if (!root) return undefined;\n      const row = await this.store.lifecycle.get(`${root.generation}:${tradeId}`);\n      if (!row) return undefined;\n      const head = await this.store.versions.get(row.version);\n      if (!head) throw new RecordIntegrityError(['MissingTradeHead']);\n      const trade = (await this.assemble([head], root.generation))[0];\n      if (trade?.revision !== row.revision) throw new RecordIntegrityError(['FactRevisionDisagreement']);\n      return trade;\n    });\n  }\n  async history(tradeId: string): Promise<TradeSnapshot[]> {\n    return this.store.transaction('r', [this.store.roots, this.store.versions], async () => {\n      const root = await this.store.roots.get('active');\n      if (!root) return [];\n      const rows = await this.store.versions.where('[generation+tradeId]').equals([root.generation, tradeId]).filter(row => row.kind === 'Plan' || row.kind === 'TradeState').toArray();\n      return this.assemble(rows.sort((a, b) => a.commitOrdinal - b.commitOrdinal), root.generation);\n    });\n  }\n  async queryRecords(request: { after?: { time: string; sequence: number }; accountIds?: string[]; symbols?: string[]; lifecycle?: 'Planned' | 'Open' } = {}) {\n    const root = await this.store.roots.get('active');\n    if (!root) return { trades: [], next: undefined };\n    const rows = await this.store.lifecycle.where('[generation+lifecycle+economicOrder+sequence]').between([root.generation, request.lifecycle ?? 'Planned', '', 0], [root.generation, request.lifecycle ?? 'Planned', request.after?.time ?? '\\uffff', request.after?.sequence ?? Number.MAX_SAFE_INTEGER], true, !request.after).reverse().filter(row => (!request.accountIds?.length || request.accountIds.includes(row.accountId)) && (!request.symbols?.length || request.symbols.includes(row.symbol))).limit(51).toArray();\n    const more = rows.length > 50;\n    if (more) rows.pop();\n    const versions = await this.store.versions.bulkGet(rows.map(row => row.version));\n    const last = rows.at(-1);\n    if (versions.some(row => !row)) throw new RecordIntegrityError(['MissingTradeHead']);\n    const trades = await this.assemble(versions as Envelope[], root.generation);\n    if (trades.some((trade, index) => trade.lifecycle !== rows[index]?.lifecycle)) throw new RecordIntegrityError(['LifecycleDisagreement']);\n    if (trades.some((trade, index) => trade.revision !== rows[index]?.revision)) throw new RecordIntegrityError(['FactRevisionDisagreement']);\n    return { trades, next: more && last ? { time: last.economicOrder, sequence: last.sequence } : undefined };\n  }\n  private async assemble(heads: Envelope[], generation: string): Promise<TradeSnapshot[]> {\n    const references = heads.filter(row => row.kind === 'TradeState').flatMap(row => { const head = row.value as TradeHead; return [head.planEnvelopeVersion, head.positionChangeVersion, ...head.executionVersions, head.agreementVersion]; });\n    const facts = new Map((await this.store.versions.bulkGet([...new Set(references)])).filter((row): row is Envelope => !!row).map(row => [row.version, row]));\n    return heads.map(row => {\n      if (row.generation !== generation) throw new RecordIntegrityError(['GenerationDisagreement']);\n      if (row.kind === 'Plan') return row.value as TradeSnapshot;\n      if (row.kind !== 'TradeState') throw new RecordIntegrityError(['InvalidTradeHead']);\n      const head = row.value as TradeHead;\n      const resolve = (version: string, kind: string) => {\n        const fact = facts.get(version);\n        if (!fact || fact.kind !== kind || fact.generation !== generation || fact.tradeId !== head.tradeId) throw new RecordIntegrityError(['OpeningFactDisagreement']);\n        return fact.value;\n      };\n      const plan = resolve(head.planEnvelopeVersion, 'Plan') as TradeSnapshot;\n      return { ...plan, revision: head.revision, lifecycle: head.lifecycle, stateVersionId: row.domainVersion ?? row.version, opening: { plannedLegId: plan.plannedLegId, positionChange: resolve(head.positionChangeVersion, 'PositionChange') as NonNullable<OpeningInput>['positionChange'], executions: head.executionVersions.map(version => resolve(version, 'Execution') as NonNullable<OpeningInput>['executions'][number]), recordedAgreement: resolve(head.agreementVersion, 'Agreement') as NonNullable<OpeningInput>['recordedAgreement'] } };\n    });\n  }\n  prepareChange(input: OpeningPreparation): PreparedOpening;\n  prepareChange(input: PlanPreparation): PreparedPlan;\n  prepareChange(input: OpeningPreparation | PlanPreparation): PreparedOpening | PreparedPlan {\n    if ('kind' in input) return prepareOpening(input);\n    return this.preparePlan(input);\n  }\n  private preparePlan(input: { accountId: string; strategyId: string; economicTime: string; assessment: Extract<Assessment, { status: 'Accepted' }>; revision: string }): PreparedPlan {\n    const digest = JSON.stringify({ accountId: input.accountId, strategyId: input.strategyId, economicTime: input.economicTime, assessment: input.assessment, revision: input.revision });\n    return { candidateId: digest, digest, plan: input.assessment.plan, storedLifecycle: 'Planned', exposureFacts: [], ...input };\n  }\n  applyPreparedChange(candidate: PreparedOpening, reconciliation: ReturnType<typeof derive>, root: Root, saveTime: string): ReturnType<typeof applyOpening>;\n  applyPreparedChange(candidate: PreparedPlan, reconciliation: ReturnType<typeof derive>, root: Root, saveTime: string): Promise<TradeSnapshot>;\n  async applyPreparedChange(candidate: PreparedPlan | PreparedOpening, reconciliation: ReturnType<typeof derive>, root: Root, saveTime: string) {\n    if ('kind' in candidate) return applyOpening(this.store, candidate, reconciliation, root);\n    return this.applyPlan(candidate, reconciliation, root, saveTime);\n  }\n  private async applyPlan(candidate: PreparedPlan, reconciliation: ReturnType<typeof derive>, root: Root, saveTime: string) {\n    if (JSON.stringify(candidate.plan) !== JSON.stringify(candidate.assessment.plan) || candidate.digest !== JSON.stringify({ accountId: candidate.accountId, strategyId: candidate.strategyId, economicTime: candidate.economicTime, assessment: candidate.assessment, revision: candidate.revision })) throw new Error('ReconciliationConflict');\n    if (!Dexie.currentTransaction) throw new Error('SemanticTransactionRequired');\n    if (reconciliation.status !== 'Derived' || reconciliation.reconciliation.expectedLifecycle !== 'Planned' || reconciliation.reconciliation.candidateId !== candidate.candidateId || reconciliation.reconciliation.digest !== candidate.digest || reconciliation.reconciliation.revision !== root.revision || candidate.revision !== root.revision) throw new Error('ReconciliationConflict');\n    if (JSON.stringify(candidate.assessment.baseline) !== JSON.stringify(reconciliation.baseline)) throw new Error('ReconciliationConflict');\n    const trade: TradeSnapshot = { tradeId: crypto.randomUUID(), revision: crypto.randomUUID(), planFactId: crypto.randomUUID(), planVersionId: crypto.randomUUID(), plannedLegId: crypto.randomUUID(), stopId: crypto.randomUUID(), targetId: crypto.randomUUID(), accountId: candidate.accountId, strategyId: candidate.strategyId, lifecycle: 'Planned', plan: structuredClone(candidate.plan), baseline: structuredClone(candidate.assessment.baseline), economicTime: candidate.economicTime, saveTime, sequence: root.recordedSequence + 1 };\n    await this.store.versions.add({ version: trade.planVersionId, id: trade.planFactId, generation: root.generation, kind: 'Plan', tradeId: trade.tradeId, economicTime: trade.economicTime, saveTime, sequence: trade.sequence, commitOrdinal: root.commitOrdinal + 1, value: trade });\n    await this.store.lifecycle.add({ key: `${root.generation}:${trade.tradeId}`, generation: root.generation, tradeId: trade.tradeId, lifecycle: reconciliation.reconciliation.expectedLifecycle, accountId: trade.accountId, symbol: trade.plan.instrument?.symbol ?? '', economicTime: trade.economicTime, economicOrder: (Temporal.Instant.from(trade.economicTime).epochNanoseconds + 8640000000000000000000n).toString().padStart(23, '0'), sequence: trade.sequence, version: trade.planVersionId, revision: trade.revision });\n    return trade;\n  }\n}\n\ninterface PlanPreparation { accountId: string; strategyId: string; economicTime: string; assessment: Extract<Assessment, { status: 'Accepted' }>; revision: string }\n\nexport class RecordIntegrityError extends Error { constructor(readonly findings: string[]) { super(findings.join(', ')); } }\n","src/domain/trade-record/opening-types.ts":"import type { PlanInput } from '../trade-analysis';\nexport interface ExecutionInput {\n  instrument: NonNullable<PlanInput['instrument']>; action: 'Buy';\n  quantity: string; price: string; fee: string; economicTime: string;\n  plannedLegId: string;\n}\nexport interface Execution extends ExecutionInput {\n  id: string; version: string; tradeId: string; positionChangeId: string;\n  sequence: number; saveTime: string;\n}\nexport interface PositionChange {\n  id: string; version: string; tradeId: string; originTradeId: string;\n  kind: 'InitialStockEntry'; economicTime: string; saveTime: string;\n  sequence: number; executionIds: string[];\n}\nexport interface OpeningAgreement {\n  factRevision: string; lotMatches: { openingId: string; disposingId: string; quantity: string }[];\n  deviations: { kind: 'PlannedLegTerms'; plannedLegId: string; mismatches: string[] }[];\n  entryResolution: { positionChangeId: string; economicTime: string };\n}\n","src/domain/trade-record/opening.ts":"import Dexie from 'dexie';\nimport { Temporal } from '@js-temporal/polyfill';\nimport { assessChange, derive, type OpeningInput } from '../trade-analysis';\nimport type { Envelope, Root, Store } from '../../infrastructure/storage';\nimport type { TradeSnapshot } from './index';\nimport type { ExecutionInput, Execution, OpeningAgreement, PositionChange } from './opening-types';\nexport interface TradeHead { tradeId: string; revision: string; lifecycle: 'Open'; planEnvelopeVersion: string; positionChangeVersion: string; executionVersions: string[]; agreementVersion: string }\nexport interface OpeningPreparation { kind: 'InitialStockEntry'; trade: TradeSnapshot; command: { economicTime: string; executions: ExecutionInput[] }; root: Root; saveTime: string }\nexport interface PreparedOpening { kind: 'InitialStockEntry'; input: OpeningPreparation; digest: string; candidate: { candidateId: string; revision: string; digest: string; plan: TradeSnapshot['plan']; storedLifecycle: string; exposureFacts: never[]; opening: OpeningInput } }\nexport function prepareOpening(input: OpeningPreparation): PreparedOpening {\n  const change: PositionChange = { id: 'candidate:initial', version: 'candidate:initial-version', kind: 'InitialStockEntry', tradeId: input.trade.tradeId, originTradeId: input.trade.tradeId, economicTime: input.command.economicTime, saveTime: input.saveTime, sequence: input.root.recordedSequence + 1, executionIds: input.command.executions.map((_, index) => `candidate:execution:${index}`) };\n  const executions: Execution[] = input.command.executions.map((execution, index) => ({ ...structuredClone(execution), id: change.executionIds[index] ?? '', version: `candidate:execution-version:${index}`, tradeId: input.trade.tradeId, positionChangeId: change.id, saveTime: input.saveTime, sequence: change.sequence + index + 1 }));\n  const digest = JSON.stringify(input);\n  return { kind: 'InitialStockEntry', input: structuredClone(input), digest, candidate: { candidateId: input.trade.tradeId, revision: input.root.revision, digest, plan: structuredClone(input.trade.plan), storedLifecycle: 'Planned', exposureFacts: [], opening: { plannedLegId: input.trade.plannedLegId, positionChange: change, executions } } };\n}\nexport async function applyOpening(store: Store, prepared: PreparedOpening, reconciliation: ReturnType<typeof derive>, root: Root) {\n  if (!Dexie.currentTransaction) throw new Error('SemanticTransactionRequired');\n  if (JSON.stringify(prepared) !== JSON.stringify(prepareOpening(prepared.input)) || prepared.digest !== JSON.stringify(prepared.input) || prepared.candidate.digest !== prepared.digest || prepared.candidate.revision !== root.revision || reconciliation.status !== 'Derived' || reconciliation.reconciliation.digest !== prepared.digest || reconciliation.reconciliation.expectedLifecycle !== 'Open' || reconciliation.reconciliation.candidateId !== prepared.input.trade.tradeId || reconciliation.reconciliation.revision !== root.revision) throw new Error('ReconciliationConflict');\n  const old = await store.lifecycle.get(`${root.generation}:${prepared.input.trade.tradeId}`);\n  if (!old || old.revision !== prepared.input.trade.revision || old.lifecycle !== 'Planned') throw new Error('ReconciliationConflict');\n  const positionChange: PositionChange = { ...prepared.candidate.opening.positionChange, id: crypto.randomUUID(), version: crypto.randomUUID(), executionIds: [] };\n  const executions = prepared.candidate.opening.executions.map(execution => ({ ...execution, id: crypto.randomUUID(), version: crypto.randomUUID(), positionChangeId: positionChange.id }));\n  positionChange.executionIds = executions.map(execution => execution.id);\n  const assessment = assessChange({ ...prepared.candidate, opening: { plannedLegId: prepared.input.trade.plannedLegId, positionChange, executions } });\n  if (assessment.status !== 'Accepted' || assessment.derivation.reconciliation.expectedLifecycle !== 'Open' || !('entryResolution' in assessment.derivation)) throw new Error('ReconciliationConflict');\n  const revision = crypto.randomUUID();\n  const agreement: OpeningAgreement = { factRevision: revision, lotMatches: assessment.derivation.lotMatches, deviations: assessment.derivation.deviations, entryResolution: assessment.derivation.entryResolution };\n  const trade: TradeSnapshot = { ...prepared.input.trade, lifecycle: 'Open', revision, opening: { plannedLegId: prepared.input.trade.plannedLegId, positionChange, executions, recordedAgreement: agreement }, stateVersionId: crypto.randomUUID() };\n  const derivation = derive({ ...prepared.candidate, revision, storedLifecycle: 'Open', opening: trade.opening });\n  if (derivation.status !== 'Derived' || derivation.reconciliation.expectedLifecycle !== 'Open') throw new Error('ReconciliationConflict');\n  const agreementVersion = crypto.randomUUID();\n  const head: TradeHead = { tradeId: trade.tradeId, revision, lifecycle: 'Open', planEnvelopeVersion: old.version, positionChangeVersion: positionChange.version, executionVersions: executions.map(execution => execution.version), agreementVersion };\n  const envelope = (version: string, id: string, kind: string, economicTime: string, sequence: number, value: unknown): Envelope => ({ version, id, kind, generation: root.generation, tradeId: trade.tradeId, economicTime, saveTime: prepared.input.saveTime, sequence, commitOrdinal: root.commitOrdinal + 1, value });\n  await store.versions.add(envelope(positionChange.version, positionChange.id, 'PositionChange', positionChange.economicTime, positionChange.sequence, positionChange));\n  for (const execution of executions) await store.versions.add(envelope(execution.version, execution.id, 'Execution', execution.economicTime, execution.sequence, execution));\n  await store.versions.add(envelope(agreementVersion, trade.tradeId, 'Agreement', positionChange.economicTime, positionChange.sequence, agreement));\n  await store.versions.add(envelope(trade.stateVersionId ?? '', trade.tradeId, 'TradeState', positionChange.economicTime, positionChange.sequence, head));\n  await store.lifecycle.put({ ...old, lifecycle: 'Open', version: trade.stateVersionId ?? '', revision, economicTime: positionChange.economicTime, economicOrder: (Temporal.Instant.from(positionChange.economicTime).epochNanoseconds + 8640000000000000000000n).toString().padStart(23, '0'), sequence: positionChange.sequence });\n  return { trade, derivation, positionChange, executions, lastSequence: executions.at(-1)?.sequence ?? positionChange.sequence, addedRecords: executions.length + 3 };\n}\n","src/infrastructure/browser-host.ts":"import type { RuntimeHost, Store, HostChecks, CapacityEvidence } from './storage';\n// Installed D2 envelope: 25,000 Plans/reflections and 200 two-Execution Open Trades.\n// Measured budgets and provenance: implementation/plan/d02-capacity-evidence.md.\n// Future operations must preflight their own additional storage requirements.\nconst installedBudget = 2 * (25000 * 4096 + 25000 * 4096 + 64 * 1024 * 1024 + 200 * 24576);\nexport class BrowserHost implements RuntimeHost {\n  private registration?: Promise<ServiceWorkerRegistration>;\n  async check(store: Store): Promise<HostChecks> {\n    const [transaction, controlAndInventory, protection] = await Promise.all([\n      store.diagnosticTransaction(), this.release(), this.protection(),\n    ]);\n    const capacity = await this.capacity(store);\n    return { transaction, ...capacity, ...controlAndInventory, protection };\n  }\n  async getUpdate() {\n    try {\n      const registration = await this.registration;\n      if (!registration) return { available: false };\n      await registration.update();\n      const installing = registration.installing;\n      if (installing) await new Promise<void>(resolve => {\n        const timeout = setTimeout(resolve, 6000);\n        installing.addEventListener('statechange', () => { if (installing.state === 'installed' || installing.state === 'redundant') { clearTimeout(timeout); resolve(); } });\n      });\n      const worker = registration.waiting;\n      if (!worker) return { available: false };\n      return await new Promise<{ available: boolean; release?: string }>(resolve => {\n        const channel = new MessageChannel();\n        const timeout = setTimeout(() => { channel.port1.close(); resolve({ available: false }); }, 3000);\n        channel.port1.onmessage = (event: MessageEvent<{ release: string; verified: boolean }>) => { clearTimeout(timeout); channel.port1.close(); resolve({ available: event.data.verified && event.data.release !== __RELEASE_ID__, release: event.data.release }); };\n        worker.postMessage('VERIFY_RELEASE', [channel.port2]);\n      });\n    } catch { return { available: false }; }\n  }\n  async activateUpdate() {\n    const registration = await this.registration;\n    if (!registration?.waiting) return;\n    let onChanged = () => {};\n    const changed = new Promise<void>(resolve => { onChanged = resolve; navigator.serviceWorker.addEventListener('controllerchange', onChanged, { once: true }); });\n    const permission = await new Promise<string>(resolve => {\n      const channel = new MessageChannel();\n      const timeout = setTimeout(() => { channel.port1.close(); resolve('Unavailable'); }, 3000);\n      channel.port1.onmessage = (event: MessageEvent<string>) => { clearTimeout(timeout); channel.port1.close(); resolve(event.data); };\n      registration.waiting?.postMessage('ACTIVATE_AT_SAFE_RELOAD', [channel.port2]);\n    });\n    if (permission !== 'Activating') { navigator.serviceWorker.removeEventListener('controllerchange', onChanged); return permission; }\n    await changed;\n    location.reload();\n  }\n  private async capacity(store: Store): Promise<{ capacity: boolean; capacityEvidence?: CapacityEvidence }> {\n    try {\n      const estimate = await navigator.storage.estimate();\n      const usage = estimate.usage; const quota = estimate.quota;\n      const cacheNames = await caches.keys();\n      let cacheBytes = 0;\n      for (const name of cacheNames.filter(name => name.startsWith('trade-journal-release-'))) {\n        const cache = await caches.open(name);\n        const manifest = await cache.match('/offline-inventory.json');\n        if (manifest) {\n          const inventoryBytes = (await manifest.clone().arrayBuffer()).byteLength;\n          const inventory = await manifest.json() as { assets: { bytes: number }[] };\n          const receiptResponse = await cache.match('/__release-size');\n          const receipt = receiptResponse ? await receiptResponse.clone().json() as { observedBytes?: number } : undefined;\n          const observed = receipt?.observedBytes;\n          cacheBytes = Math.max(cacheBytes, inventory.assets.reduce((sum, asset) => sum + asset.bytes, inventoryBytes), typeof observed === 'number' && Number.isFinite(observed) && observed >= 0 ? observed + (receiptResponse ? (await receiptResponse.arrayBuffer()).byteLength : 0) : 0);\n        }\n      }\n      if (typeof usage !== 'number' || typeof quota !== 'number' || !Number.isFinite(usage) || !Number.isFinite(quota) || usage < 0 || quota < 0) return { capacity: false };\n      const measurement = await store.transaction('r', [store.roots, store.projections], async () => store.storageMeasurement(await store.roots.get('active')));\n      // Credit measured active serialized bytes once. Unmeasured index/allocation\n      // overhead remains conservatively reserved; retired data/cache usage is never L.\n      const live = Math.min(measurement.activeSerializedBytes, usage);\n      const required = (Math.max(0, installedBudget - live) + cacheBytes) * 1.25;\n      const capacityEvidence = { M: installedBudget, L: live, C: cacheBytes, Q: quota - usage, H: required, quota, usage, method: measurement.method };\n      return { capacity: quota - usage >= required, capacityEvidence };\n    } catch { return { capacity: false }; }\n  }\n  private async protection(): Promise<HostChecks['protection']> {\n    try { return typeof navigator.storage.persisted === 'function' ? await navigator.storage.persisted() ? 'Protected' : 'BestEffort' : 'Unavailable'; }\n    catch { return 'Unavailable'; }\n  }\n  async migrationCapacity(candidateBytes: number) {\n    try { const { quota, usage } = await navigator.storage.estimate(); return typeof quota === 'number' && typeof usage === 'number' && Number.isFinite(quota) && Number.isFinite(usage) && quota >= usage && quota - usage >= candidateBytes * 1.25; } catch { return false; }\n  }\n  async requestDurability(): Promise<HostChecks['protection']> {\n    try { return typeof navigator.storage.persist === 'function' ? await navigator.storage.persist() ? 'Protected' : 'BestEffort' : 'Unavailable'; }\n    catch { return 'Unavailable'; }\n  }\n  private async release(): Promise<{ control: boolean; inventory: boolean }> {\n    if (!isSecureContext || !('serviceWorker' in navigator)) return { control: false, inventory: false };\n    try {\n      this.registration ??= navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });\n      const registration = await this.registration;\n      if (!navigator.serviceWorker.controller) {\n        await Promise.race([\n          new Promise<void>(resolve => navigator.serviceWorker.addEventListener('controllerchange', () => resolve(), { once: true })),\n          new Promise<void>(resolve => setTimeout(resolve, 4000)),\n        ]);\n      }\n      const controller = navigator.serviceWorker.controller;\n      const worker = controller ?? registration.active;\n      if (!worker) return { control: false, inventory: false };\n      const result = await new Promise<{ release: string; verified: boolean } | undefined>(resolve => {\n        const channel = new MessageChannel();\n        const timeout = setTimeout(() => { channel.port1.close(); resolve(undefined); }, 3000);\n        channel.port1.onmessage = (event: MessageEvent<{ release: string; verified: boolean }>) => { clearTimeout(timeout); channel.port1.close(); resolve(event.data); };\n        worker.postMessage('VERIFY_RELEASE', [channel.port2]);\n      });\n      return { control: !!controller && result?.release === __RELEASE_ID__, inventory: result?.release === __RELEASE_ID__ && result.verified };\n    } catch { return { control: false, inventory: false }; }\n  }\n}\n","src/infrastructure/storage.ts":"import Dexie, { type Table, type Transaction } from 'dexie';\nimport { Temporal } from '@js-temporal/polyfill';\nconst serializedBytes = (value: unknown) => new TextEncoder().encode(JSON.stringify(value)).byteLength;\ninterface SizeReceipt { revision: string; serializedRowsBytes: number }\nexport interface Root {\n  key: 'active'; generation: string; revision: string; schema: number;\n  timeZone: string; catalogRevision: string; definitionRevision: string;\n  commitOrdinal: number; recordedSequence: number; recordCounts?: { versions: number; lifecycle: number };\n}\nexport function rootHeaderFailure(root: Root) {\n  if (root.schema !== 1 && root.schema !== 2) return 'UnsupportedSchema';\n  if (!root.generation || !root.revision || !root.catalogRevision || !root.definitionRevision || !Number.isSafeInteger(root.commitOrdinal) || root.commitOrdinal < 1 || !Number.isSafeInteger(root.recordedSequence) || root.recordedSequence < 0 || (root.schema === 1 && root.commitOrdinal <= root.recordedSequence) || /^[+-]/.test(root.timeZone)) return 'InvalidRoot';\n  try { Temporal.Instant.from('2026-01-01T00:00:00Z').toZonedDateTimeISO(root.timeZone); } catch { return 'InvalidRoot'; }\n  return undefined;\n}\nexport interface Envelope {\n  version: string; domainVersion?: string; id: string; generation: string; kind: string;\n  tradeId: string; economicTime: string; saveTime: string; sequence: number; commitOrdinal: number;\n  value: unknown;\n}\nexport interface LifecycleRow { key: string; generation: string; tradeId: string; lifecycle: string; accountId: string; symbol: string; economicTime: string; economicOrder: string; sequence: number; version: string; revision: string }\nexport class Store extends Dexie {\n  private upgradeBlocked = false;\n  private measured = new WeakMap<Transaction, number>();\n  roots!: Table<Root, string>;\n  versions!: Table<Envelope, string>;\n  lifecycle!: Table<LifecycleRow, string>;\n  projections!: Table<{ key: string; value: unknown }, string>;\n  diagnostic!: Table<{ key: string; value: string }, string>;\n  constructor(name: string) {\n    super(name);\n    this.version(1).stores({ roots: 'key', versions: 'version, [generation+kind], [generation+id], [generation+tradeId], [generation+kind+economicTime+sequence]', lifecycle: 'key, [generation+lifecycle+economicOrder+sequence], [generation+tradeId]', projections: 'key', diagnostic: 'key' });\n    this.version(2).stores({ versions: 'version, [generation+kind], [generation+id], [generation+tradeId], [generation+kind+economicTime+sequence], [generation+kind+id+commitOrdinal]' });\n    const observe = (_key: unknown, row: unknown, transaction: Transaction) => {\n      const prior = this.measured.get(transaction);\n      if (prior !== undefined) this.measured.set(transaction, prior + serializedBytes(row));\n    };\n    this.versions.hook('creating', observe);\n    this.lifecycle.hook('creating', observe);\n    this.on('blocked', () => { this.upgradeBlocked = true; this.close(); });\n    this.on('versionchange', () => this.close());\n  }\n  async storageMeasurement(root: Root | undefined) {\n    const hint = root ? await this.projections.get(`active-size:${root.generation}`) : undefined;\n    const value = hint?.value as SizeReceipt | undefined;\n    if (!root || !value || value.revision !== root.revision || !Number.isSafeInteger(value.serializedRowsBytes) || value.serializedRowsBytes < 0) return { activeSerializedBytes: 0, method: 'UnmeasuredConservative' as const };\n    return { activeSerializedBytes: value.serializedRowsBytes + serializedBytes(root) + serializedBytes(hint), method: 'SerializedActiveLowerBound' as const };\n  }\n  async measureMutation<T>(root: Root | undefined, effect: () => Promise<T>): Promise<T> {\n    const transaction = Dexie.currentTransaction;\n    if (!transaction) throw new Error('SemanticTransactionRequired');\n    this.measured.set(transaction, 0);\n    try {\n      const old = root ? await this.projections.get(`active-size:${root.generation}`) : undefined;\n      const result = await effect();\n      const added = this.measured.get(transaction) ?? 0;\n      if (added > 0) {\n        const next = await this.roots.get('active');\n        const prior = old?.value as SizeReceipt | undefined;\n        if (next) await this.projections.put({ key: `active-size:${next.generation}`, value: { revision: next.revision, serializedRowsBytes: (prior?.revision === root?.revision && Number.isSafeInteger(prior?.serializedRowsBytes) && (prior?.serializedRowsBytes ?? -1) >= 0 ? prior?.serializedRowsBytes ?? 0 : 0) + added } satisfies SizeReceipt });\n      }\n      return result;\n    } finally { this.measured.delete(transaction); }\n  }\n  async inspect() {\n    if (this.upgradeBlocked) return { status: 'IntegrityBlocked' as const };\n    try { return { status: 'Readable' as const, root: await this.roots.get('active') }; }\n    catch { return { status: 'IntegrityBlocked' as const }; }\n  }\n  async diagnosticTransaction(): Promise<boolean> {\n    const retryBlockedOpen = this.upgradeBlocked;\n    this.upgradeBlocked = false;\n    try {\n      if (retryBlockedOpen) await this.open();\n      await this.transaction('rw', this.diagnostic, async () => {\n        await this.diagnostic.put({ key: 'probe', value: 'probe' });\n        if ((await this.diagnostic.get('probe'))?.value !== 'probe') throw new Error('Diagnostic read mismatch');\n        await this.diagnostic.delete('probe');\n      });\n      return true;\n    } catch { return false; }\n  }\n}\nexport interface CapacityEvidence { M: number; L: number; C: number; Q: number; H: number; quota: number; usage: number; method: 'SerializedActiveLowerBound' | 'UnmeasuredConservative' }\nexport interface HostChecks { transaction: boolean; capacity: boolean; control: boolean; inventory: boolean; protection: 'Protected' | 'BestEffort' | 'Unavailable'; capacityEvidence?: CapacityEvidence }\nexport interface RuntimeHost {\n  check(store: Store): Promise<HostChecks>;\n  migrationCapacity?(candidateBytes: number): Promise<boolean>;\n  requestDurability(): Promise<HostChecks['protection']>;\n}\nexport interface RuntimeNotWritable {\n  status: 'RuntimeNotWritable'; runtimeReadiness: 'RecoveryOnly' | 'Unsupported';\n  failedChecks: string[]; workspaceStatus: 'RecoveryOnly' | 'IntegrityBlocked' | 'None'; safeActions: string[];\n  capacityEvidence?: CapacityEvidence;\n}\nexport type Readiness = { status: 'Writable'; protection: HostChecks['protection']; epoch: number; capacityEvidence?: CapacityEvidence } | RuntimeNotWritable;\nexport class Runtime {\n  private state: Readiness = { status: 'RuntimeNotWritable', runtimeReadiness: 'Unsupported', failedChecks: ['NotChecked'], workspaceStatus: 'None', safeActions: ['Retry'] };\n  private epoch = 0;\n  constructor(readonly store: Store, readonly host: RuntimeHost) {}\n  async establish(): Promise<Readiness> {\n    const checks = await this.host.check(this.store);\n    const inspection = await this.store.inspect();\n    const rootProblem = inspection.status === 'Readable' && inspection.root ? rootHeaderFailure(inspection.root) : undefined;\n    const integrityBlocked = inspection.status === 'IntegrityBlocked' || !!rootProblem;\n    const readable = inspection.status === 'Readable' && !!inspection.root && !rootProblem;\n    const failedChecks: string[] = (['transaction', 'capacity', 'control', 'inventory'] as const).filter(key => !checks[key]);\n    if (inspection.status === 'IntegrityBlocked') failedChecks.push('UnreadableRoot');\n    if (rootProblem) failedChecks.push(rootProblem);\n    this.state = failedChecks.length\n      ? { status: 'RuntimeNotWritable', runtimeReadiness: readable ? 'RecoveryOnly' : 'Unsupported', failedChecks, workspaceStatus: integrityBlocked ? 'IntegrityBlocked' : readable ? 'RecoveryOnly' : 'None', safeActions: ['Retry', 'Try another browser; its storage is separate'], capacityEvidence: checks.capacityEvidence }\n      : { status: 'Writable', protection: checks.protection, epoch: ++this.epoch, capacityEvidence: checks.capacityEvidence };\n    return this.state;\n  }\n  invalidate(failure: string): void {\n    ++this.epoch;\n    this.state = { status: 'RuntimeNotWritable', runtimeReadiness: 'Unsupported', failedChecks: [failure], workspaceStatus: 'None', safeActions: ['Retry'] };\n  }\n  current() { return this.state; }\n  async mutate<T>(expectedGeneration: string | undefined, effect: (root: Root | undefined) => Promise<T>, purpose: 'Ordinary' | 'Migration' = 'Ordinary'): Promise<T | RuntimeNotWritable | { status: 'Conflict'; reason: 'GenerationChanged' }> {\n    const readiness = await this.establish();\n    if (readiness.status !== 'Writable') return readiness;\n    return this.store.transaction('rw', [this.store.roots, this.store.versions, this.store.lifecycle, this.store.projections], async () => {\n      if (this.state.status !== 'Writable' || this.state.epoch !== readiness.epoch) return this.state as RuntimeNotWritable;\n      const root = await this.store.roots.get('active');\n      if (root?.generation !== expectedGeneration) return { status: 'Conflict' as const, reason: 'GenerationChanged' as const };\n      if (root?.schema === 1 && purpose !== 'Migration') {\n        this.state = { status: 'RuntimeNotWritable', runtimeReadiness: 'RecoveryOnly', failedChecks: ['MigrationRequired'], workspaceStatus: 'RecoveryOnly', safeActions: ['Retry startup to migrate', 'Read retained history; backup is not installed'] };\n        return this.state;\n      }\n      const rootProblem = root && rootHeaderFailure(root);\n      if (rootProblem) {\n        ++this.epoch;\n        this.state = { status: 'RuntimeNotWritable', runtimeReadiness: 'Unsupported', workspaceStatus: 'IntegrityBlocked', failedChecks: [rootProblem], safeActions: ['Retry'] };\n        return this.state;\n      }\n      return this.store.measureMutation(root, () => effect(root));\n    });\n  }\n}\n\nexport function addedRecords(root: Root, versions: number, lifecycle = 0) {\n  return root.recordCounts ? { versions: root.recordCounts.versions + versions, lifecycle: root.recordCounts.lifecycle + lifecycle } : undefined;\n}\n","src/main.tsx":"import { Journal } from './domain/journal';\nimport { createRoot } from 'react-dom/client';\nimport { Store, Runtime } from './infrastructure/storage';\nimport { BrowserHost } from './infrastructure/browser-host';\nimport { Workspace } from './application/workspace';\nimport { ReferenceCatalog } from './domain/reference-catalog';\nimport { TradeWorkflows } from './application/trade-workflows';\nimport { TradeViewsAndReporting } from './application/trade-views-and-reporting';\nimport { App } from './presentation/App';\nconst store = new Store('trade-journal-v3');\nconst host = new BrowserHost();\nconst runtime = new Runtime(store, host);\nconst services = { workspace: new Workspace(runtime), catalog: new ReferenceCatalog(store, runtime), workflows: new TradeWorkflows(runtime), views: new TradeViewsAndReporting(store), journal: new Journal(store, runtime) };\nconst root = document.getElementById('root');\nif (root) createRoot(root).render(<App services={services} delivery={host} />);\n","src/presentation/App.module.css":"@font-face { font-family: Journal; src: url('/fonts/Rubik-Regular.ttf') format('truetype'); font-weight: 400; font-display: swap; }\n@font-face { font-family: Journal; src: url('/fonts/Rubik-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }\n@font-face { font-family: JournalCondensed; src: url('/fonts/LiberationSansNarrow-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }\n:global(*) { box-sizing: border-box; }\n:global(html) { scroll-padding-bottom: 100px; }\n:global(body) { margin: 0; background: #f4f1eb; color: #161713; font: 14px/1.5 Journal, sans-serif; overflow-wrap: anywhere; }\n:global(button), :global(input), :global(select), :global(textarea) { font: inherit; }\n:global(button) { border-radius: 12px; background: white; color: #25251f; padding: 10px 16px; border: 1px solid #c9c5bb; cursor: pointer; min-height: 44px; }\n:global(button:hover:not(:disabled)) { border-color: #545348; }\n:global(button[type=submit]), .primary { background: #10110d; color: white; border-color: #10110d; }\n:global(button:disabled) { opacity: .55; cursor: default; }\n:global(:focus-visible) { outline: 3px solid #4b64be; outline-offset: 3px; }\n:global(input:not([type=radio])), :global(select), :global(textarea) { display: block; width: 100%; min-width: 0; min-height: 42px; border: 1px solid #8b887f; border-radius: 10px; padding: 10px 12px; margin-top: 5px; background: white; color: #161713; }\n:global(input[aria-invalid=true]), :global(textarea[aria-invalid=true]) { border: 2px solid #a02d26; }\n:global(label) { display: block; margin: 12px 0; color: #514f46; font-size: 12px; }\n:global(label input), :global(label textarea), :global(label select) { font-size: 14px; }\n:global(textarea) { min-height: 82px; resize: vertical; scroll-margin-block: 90px; }\n:global(fieldset) { min-inline-size: 0; margin: 16px 0; padding: 12px; border: 1px solid #d6d2c8; border-radius: 12px; }\n:global(legend) { font-size: 12px; color: #514f46; padding: 0 5px; }\n:global(fieldset:has(> label > input[type=radio])) { border: 0; padding: 0; display: flex; gap: 6px; flex-wrap: wrap; }\n:global(fieldset:has(> label > input[type=radio]) > legend) { margin-bottom: 6px; padding: 0; }\n:global(label:has(> input[type=radio])) { display: inline-flex; align-items: center; gap: 6px; position: relative; border: 1px solid #c9c5bb; border-radius: 999px; padding: 10px 12px; min-height: 44px; margin: 0; background: white; cursor: pointer; color: #33342b; }\n:global(label:has(> input[type=radio]:checked)) { color: white; background: #10110d; border-color: #10110d; }\n:global(label:has(> input[type=radio]:focus-visible)) { outline: 3px solid #4b64be; outline-offset: 3px; }\n:global(input[type=radio]) { position: absolute; width: 1px; height: 1px; opacity: 0; }\n:global(h1) { font-size: 22px; line-height: 1.2; letter-spacing: -.5px; margin: 0; }\n:global(h2) { font-size: 16px; line-height: 1.3; margin: 0 0 12px; }\n:global(h3) { font-size: 13px; margin: 14px 0 6px; }\n:global(p) { margin: 8px 0; }\n:global(small) { font-size: 11px; color: #625f55; }\n:global(summary) { cursor: pointer; min-height: 44px; align-content: center; }\n.shell { display: grid; grid-template-columns: 240px minmax(0, 1fr); min-height: 100dvh; background: #fafaf8; }\n.shell nav { padding: 24px 16px; display: flex; flex-direction: column; align-items: stretch; gap: 6px; border-right: 1px solid #e4dfd5; background: white; }\n.shell nav strong { font-size: 20px; margin: 0 4px 24px; letter-spacing: -.6px; }\n.shell nav button { text-align: left; border-color: transparent; border-radius: 10px; padding-inline: 14px; background: transparent; }\n.shell nav button[aria-current=page] { background: #10110d; color: white; }\n.shell nav button:nth-of-type(2) { border: 1px dashed #bcb8ad; margin-block: 12px; }\n.shell nav button::before { display: inline-block; width: 24px; font-size: 18px; line-height: 1; }\n.shell nav button:nth-of-type(1)::before { content: '⌂'; }\n.shell nav button:nth-of-type(2)::before { content: '+'; }\n.shell nav button:nth-of-type(3)::before { content: '▤'; }\n.shell nav button:nth-of-type(4)::before { content: '⚙'; }\n.shell main { padding: 32px 24px 60px; max-width: 868px; width: 100%; margin: 0 auto; min-width: 0; }\n.shell main > header { margin-bottom: 20px; }\n.eyebrow { font-size: 11px; color: #625f55; font-weight: 700; letter-spacing: .05em; margin: 0 0 4px; }\n.card { background: #fff; border: 1px solid #e1dcd1; border-radius: 15px; padding: 16px; margin: 12px 0; overflow-wrap: anywhere; }\n.card form + form { margin-top: 20px; border-top: 1px solid #e1dcd1; padding-top: 16px; }\n.warning { padding: 10px 12px; border: 1px solid #bb9b48; background: #fff5d9; border-radius: 10px; font-size: 11px; margin: 12px 0; color: #51441f; }\n.warning button { padding: 7px 10px; font-size: 11px; margin-left: 6px; }\n.warning h2 { margin-bottom: 4px; }\n.errors { padding: 12px; border-left: 3px solid #a02d26; background: #fff2ee; margin-block: 12px; }\n.errors ul { padding-left: 20px; }\n.errors button { font-size: 12px; }\n.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }\n.actions button:first-child { color: white; background: #10110d; border-color: #10110d; }\n.actions button + button { color: #25251f; background: white; }\n.badge { display: inline-block; background: #efeee7; color: #4e5045; padding: 3px 8px; border-radius: 999px; font-size: 11px; }\n.card dl { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px 20px; }\n.card dt { color: #625f55; font-size: 12px; }\n.card dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }\n.tradeList { padding: 0; list-style: none; margin: 12px 0; }\n.tradeList li + li { margin-top: 9px; }\n.tradeList button { width: 100%; min-height: 70px; text-align: left; border: 1px solid #e1dcd1; border-radius: 15px; background: white; color: #161713; padding: 12px 16px; display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; column-gap: 12px; }\n.tradeList button::before { content: attr(data-symbol); grid-row: 1 / 3; background: #f4f1eb; border-radius: 12px; width: 40px; height: 40px; text-align: center; align-content: center; font-size: 11px; }\n.tradeList span { display: block; font-size: 11px; color: #625f55; font-variant-numeric: tabular-nums; }\n.tradeList strong { font-family: JournalCondensed, sans-serif; font-size: 17px; }\n.browse { margin-top: 24px; }\n.filters { display: flex; gap: 8px; margin: 12px 0; }\n.filters button { border-radius: 999px; font-size: 12px; }\n.filters button[aria-pressed=true] { background: #10110d; color: white; }\n.startup { max-width: 480px; margin: 10vh auto; padding: 24px; }\n.startup h1 { margin-bottom: 16px; }\n.backdrop { position: fixed; inset: 0; z-index: 10; background: #17171355; display: flex; justify-content: flex-end; padding: 24px; }\n.panel { background: white; border: 1px solid #e1dcd1; border-radius: 20px; width: 440px; max-width: 100%; overflow-y: auto; overscroll-behavior: contain; padding: 20px; scroll-padding-block: 90px; }\n.panelHeader { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; background: white; }\n.panelHeader h2 { font-size: 22px; }\n.panelHeader button { border: 0; background: #f4f1eb; border-radius: 50%; font-size: 22px; padding: 0; width: 44px; flex-shrink: 0; }\n.panel .card { padding: 0; margin: 12px 0 0; border: 0; border-radius: 0; }\n.panel .actions { position: sticky; bottom: -20px; padding-block: 12px; background: white; border-top: 1px solid #e1dcd1; z-index: 1; }\n.panel .actions button:first-child { flex: 1; }\n.fieldGrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; }\n.fieldGrid label:last-child:nth-child(odd) { grid-column: 1 / -1; }\n.planForm { max-width: 448px; margin-inline: auto; }\n.planForm > .card { margin-block: 12px; }\n.hero { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }\n.hero p { color: #625f55; font-size: 11px; }\n.hero strong { display: block; color: #161713; font: 700 24px/1.2 JournalCondensed, sans-serif; font-variant-numeric: tabular-nums; }\n.recorded { padding: 12px; border-radius: 10px; background: #f4f1eb; margin: 8px 0; }\n.install { font-size: 12px; color: #625f55; }\n@media (max-width: 1023px) {\n  .shell { display: block; background: #f4f1eb; }\n  .shell nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 2; flex-direction: row; justify-content: space-around; gap: 4px; padding: 6px max(8px, env(safe-area-inset-right)) max(6px, env(safe-area-inset-bottom)); border-top: 1px solid #e1dcd1; border-right: 0; background: white; }\n  .shell nav strong { display: none; }\n  .shell nav button { min-width: 0; flex: 1; text-align: center; font-size: 10px; padding: 4px 2px; line-height: 1.2; }\n  .shell nav button::before { display: block; width: auto; font-size: 18px; margin-bottom: 4px; }\n  .shell nav button:nth-of-type(2) { margin: 0; border: 0; }\n  .shell main { padding: 24px 16px 110px; max-width: 480px; }\n  .backdrop { padding: 24px 0 0; align-items: flex-end; }\n  .panel { width: 100%; max-width: none; max-height: calc(100dvh - 24px); border-radius: 20px 20px 0 0; min-height: calc(100dvh - 24px); padding: 20px 20px max(20px, env(safe-area-inset-bottom)); }\n}\n@media (max-width: 420px) {\n  .hero { grid-template-columns: 1fr 1fr; }\n  .fieldGrid { gap: 0 8px; }\n}\n.formFields { border: 0; padding: 0; margin: 0; }\n.formFields > legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }\n.panel .actions p { width: 100%; font-size: 11px; margin: 0; color: #625f55; }\n.actions button[type=submit] { color: white; background: #10110d; border-color: #10110d; }\n.planForm .actions button:first-child:not([type=submit]) { color: #25251f; background: white; }\n.planForm .actions button[type=submit] { flex: 1; }\n.updateCheck { display: block; margin: -6px 0 12px auto; font-size: 11px; padding: 6px 10px; }\n","src/presentation/App.tsx":"import { ContextPanel } from './ContextPanel';\nimport { DebtForm, type DebtDraft } from './DebtForm';\nimport type { JournalObligation } from '../domain/journal/position-change-types';\nimport { OpeningForm, type OpeningDraft } from './OpeningForm';\nimport type { Journal, JournalQuery } from '../domain/journal';\nimport type { positionChangeDefinition } from '../domain/journal/position-change-types';\nimport type { derive } from '../domain/trade-analysis';\nimport { useEffect, useRef, useState, type FormEvent } from 'react';\nimport Decimal from 'decimal.js';\nimport { Temporal } from '@js-temporal/polyfill';\nimport type { Workspace } from '../application/workspace';\nimport type { ReferenceCatalog, CatalogRecord } from '../domain/reference-catalog';\nimport type { TradeWorkflows } from '../application/trade-workflows';\nimport type { TradeViewsAndReporting } from '../application/trade-views-and-reporting';\nimport type { Root } from '../infrastructure/storage';\nimport type { TradeSnapshot } from '../domain/trade-record';\nimport type { JournalEntry, planDefinition } from '../domain/journal';\nimport styles from './App.module.css';\nexport interface Services { workspace: Workspace; catalog: ReferenceCatalog; workflows: TradeWorkflows; views: TradeViewsAndReporting; journal: Journal }\ninterface Detail { analysis?: ReturnType<typeof derive>; journal?: JournalQuery; binding?: { generation?: string; workspaceRevision?: string; catalogRevision?: string };  trade: TradeSnapshot; entries: JournalEntry[]; history: TradeSnapshot[]; labels: { account?: string; institution?: string; strategy?: string } }\nconst emptyPlan = { symbol: '', quantity: '', entry: '', stop: '', target: '', thesis: '', invalidation: '', conviction: '', emotion: '' };\nconst issueMessages: Record<string, string> = {\n  CompletePlannedQuantityRequired: 'Executions must total exactly the frozen planned quantity.',\n  PositiveExecutionQuantityRequired: 'Enter a quantity greater than zero for every Execution.',\n  NonnegativeExecutionPriceRequired: 'Enter a valid nonnegative USD price for every Execution.',\n  NonnegativeExecutionFeeRequired: 'Enter the actual nonnegative USD fee for every Execution.',\n  InvalidExecutionTime: 'Enter valid ISO 8601 instants with an offset for the decision and every Execution.',\n  InvalidPositionChangeTime: 'Enter a valid ISO 8601 decision instant with an offset.',\n  EntryBeforePlan: 'Initial entry cannot precede the confirmed Plan.',\n  'decision-mode:Required': 'Choose the decision mode, or explicitly Defer or Decline the reflection.',\n  'emotion:Required': 'Choose the primary emotion.', 'confidence:Required': 'Choose decision confidence from 1 to 5.',\n  TradeChanged: 'This Trade changed in another tab. Review the current Trade before saving again.',\n  InitialStockEntryRequiresPlannedTrade: 'This Trade already has an initial entry. No additional Executions were recorded.',\n  MigrationRequired: 'This update could not finish migrating the Workspace. Retained history is readable; writing is disabled. Retry startup when the migration problem is resolved.',\n  TimeZoneRequired: 'Enter a rules-based time zone, such as America/New_York.',\n  ExactStockRequired: 'Enter an exact USD Stock symbol.', PositiveQuantityRequired: 'Enter a quantity greater than zero.',\n  ThesisRequired: 'Explain why this trade, why now.', InvalidationRequired: 'Explain what would invalidate the thesis.',\n  InvalidEntry: 'Enter a valid nonnegative intended entry.', InvalidStop: 'Enter a valid nonnegative Stop price.', InvalidTarget: 'Enter a valid nonnegative Target price.',\n  PositiveRiskRequired: 'Stop must be below intended entry so Planned risk is positive.', ForwardRewardRequired: 'Target must be above intended entry.',\n  InvalidConviction: 'Choose a Conviction from 1 to 5, or leave it unanswered.', UnknownEmotion: 'Choose a listed emotion, or leave it unanswered.',\n  CatalogChanged: 'Brokerage records changed in another tab. Review your selections before confirming again.', WorkspaceChanged: 'The Workspace changed. Review current references before confirming again.',\n  DefinitionChanged: 'Plan Reflection changed. Reopen the form before confirming again.', GenerationChanged: 'The active Workspace changed. Retry startup before saving.',\n  LabelRequired: 'Enter a name.', DuplicateLabel: 'That name is already in use.', SelectableInstitutionRequired: 'Choose an available Institution.', SelectableAccountRequired: 'Choose an available Account.', SelectableLongStockRequired: 'The Long Stock Strategy is not available for this Plan.',\n  transaction: 'Browser storage could not complete a test transaction.', capacity: 'This browser does not have the required available storage capacity.',\n  control: 'The verified application is not controlling this tab.', inventory: 'The offline application files are missing or damaged.',\n  UnreadableRoot: 'This browser could not read the existing Workspace. Its data has not been replaced.', InvalidRoot: 'This Workspace could not be validated. Its data has not been replaced.',\n  UnsupportedSchema: 'This Workspace needs a newer application version. Its data has not been changed.',\n  StorageFailure: 'Saving failed. Nothing was recorded. Your entered values are preserved. Retry startup before saving again.',\n};\nconst fieldIssues: Partial<Record<keyof typeof emptyPlan, string[]>> = { symbol: ['ExactStockRequired'], quantity: ['PositiveQuantityRequired'], entry: ['InvalidEntry'], stop: ['InvalidStop', 'PositiveRiskRequired'], target: ['InvalidTarget', 'ForwardRewardRequired'], thesis: ['ThesisRequired'], invalidation: ['InvalidationRequired'] };\nfunction quotientText(value: { numerator: string; denominator: string }, places?: number) { const display = new Decimal(value.numerator).div(value.denominator); return places === undefined ? display.toSignificantDigits(12).toString() : display.toFixed(places, Decimal.ROUND_HALF_EVEN); }\nfunction money(value: string) { return `$${new Decimal(value).toFixed(2, Decimal.ROUND_HALF_EVEN)}`; }\nexport interface Delivery { getUpdate(): Promise<{ available: boolean; release?: string }>; activateUpdate(): Promise<string | void> }\nexport function App({ services, delivery }: { services: Services; delivery?: Delivery }) {\n  const [debtReturnRoute, setDebtReturnRoute] = useState('Journal Debt');\n  const [debtPage, setDebtPage] = useState<JournalQuery>();\n  const [debtError, setDebtError] = useState(false);\n  const [debtDrafts, setDebtDrafts] = useState<Record<string, DebtDraft>>({});\n  const [selectedDebtId, setSelectedDebtId] = useState('');\n  const [debtOutcome, setDebtOutcome] = useState<Extract<Awaited<ReturnType<Journal['save']>>, { status: 'Saved' }>>();\n  const [openingDefinition, setOpeningDefinition] = useState<typeof positionChangeDefinition>();\n  const [openingDrafts, setOpeningDrafts] = useState<Record<string, OpeningDraft>>({});\n  const [lifecycle, setLifecycle] = useState<'Planned' | 'Open'>('Planned');\n  const [planStage, setPlanStage] = useState(1);\n  const [planDirty, setPlanDirty] = useState(false);\n  const [updateAvailable, setUpdateAvailable] = useState(false);\n  const [readOnly, setReadOnly] = useState(false);\n  const [phase, setPhase] = useState('Loading');\n  const [root, setRoot] = useState<Root>();\n  const [records, setRecords] = useState<CatalogRecord[]>([]);\n  const [definition, setDefinition] = useState<typeof planDefinition>();\n  const [catalogRevision, setCatalogRevision] = useState('');\n  const [timeZone, setTimeZone] = useState('');\n  const [institution, setInstitution] = useState('');\n  const [account, setAccount] = useState('');\n  const dirty = planDirty || Object.keys(openingDrafts).length > 0 || Object.keys(debtDrafts).length > 0 || institution !== '' || account !== '';\n  const [parentId, setParentId] = useState('');\n  const [accountId, setAccountId] = useState('');\n  const [route, setRoute] = useState('Trades');\n  const [plan, setPlan] = useState(emptyPlan);\n  const [issues, setIssues] = useState<string[]>([]);\n  const [message, setMessage] = useState('');\n  const [protection, setProtection] = useState('BestEffort');\n  const [detail, setDetail] = useState<Detail>();\n  const [page, setPage] = useState<Awaited<ReturnType<TradeViewsAndReporting['browseTrades']>>>();\n  const [saving, setSaving] = useState(false);\n  const errorHeading = useRef<HTMLHeadingElement>(null);\n  const heading = useRef<HTMLHeadingElement>(null);\n  async function open(zone?: string) {\n    setPhase('Loading'); setIssues([]);\n    try {\n      const readiness = await services.workspace.getStatus();\n      if (readiness.status !== 'Writable') {\n        if ('recovery' in readiness && readiness.recovery.root) {\n          setReadOnly(true); setRoot(readiness.recovery.root); setRecords(readiness.recovery.catalog.records); setDefinition(readiness.recovery.definition); setCatalogRevision(readiness.recovery.root.catalogRevision); setPage(await services.views.browseTrades()); setPhase('Ready'); setIssues(readiness.failedChecks); return;\n        }\n        setIssues(readiness.failedChecks); setPhase(readiness.workspaceStatus === 'IntegrityBlocked' ? 'IntegrityBlocked' : readiness.runtimeReadiness); return; }\n      setProtection(readiness.protection);\n      const result = await services.workspace.initialize({ openingInstant: new Date().toISOString(), timeZone: zone });\n      if (result.status === 'Opened') {\n        setOpeningDefinition(await services.journal.getDefinitions('PositionChange')); setRoot(result.root); setRecords(result.catalog.records); setDefinition(result.definition); setCatalogRevision(result.root.catalogRevision);\n        setParentId(result.catalog.records.find(record => record.kind === 'Institution')?.id ?? '');\n        setAccountId(result.catalog.records.find(record => record.kind === 'Account')?.id ?? '');\n        setPage(await services.views.browseTrades()); setReadOnly(false); setPhase('Ready');\n      } else if ('recovery' in result && result.recovery) {\n        setReadOnly(true); setRoot(result.recovery.root); setRecords(result.recovery.catalog.records); setDefinition(result.recovery.definition); setCatalogRevision(result.recovery.root.catalogRevision); setPage(await services.views.browseTrades({ lifecycle })); setIssues(['MigrationRequired']); setPhase('Ready');\n      } else { setPhase(result.status); if (result.status === 'TimeZoneSelectionRequired' && zone !== undefined) setIssues(['TimeZoneRequired']); else if ('failedChecks' in result) setIssues(result.failedChecks); }\n    } catch { setPhase('Error'); setIssues(['Startup could not be verified. Your data has not been replaced.']); }\n  }\n  useEffect(() => { void open(); }, []);\n  async function checkUpdate() { if (delivery) setUpdateAvailable((await delivery.getUpdate()).available); }\n  useEffect(() => {\n    if (!delivery) return;\n    const timer = setInterval(() => { void checkUpdate(); }, 10000);\n    return () => clearInterval(timer);\n  }, [delivery]);\n  useEffect(() => { heading.current?.focus(); }, [route, phase]);\n  useEffect(() => { if (issues.length) errorHeading.current?.focus(); }, [issues]);\n  async function browse(cursor?: string, selected: 'Planned' | 'Open' = lifecycle) { setLifecycle(selected); setIssues([]); setRoute('Trades'); setPage(undefined); setPage(await services.views.browseTrades({ cursor, lifecycle: selected })); }\n  async function saveReference(event: FormEvent, kind: 'Institution' | 'Account') {\n    event.preventDefault(); if (!root) return; setSaving(true); setIssues([]);\n    try {\n      const result = await services.catalog.save({ kind, label: kind === 'Institution' ? institution : account, parentId: kind === 'Account' ? parentId : undefined, generation: root.generation, expectedCatalogRevision: catalogRevision });\n      if (result.status === 'Saved') { setRecords(previous => [...previous, result.record]); setCatalogRevision(result.catalogRevision); if (kind === 'Institution') { setParentId(result.record.id); setInstitution(''); } else { setAccountId(result.record.id); setAccount(''); setRoute('Trades'); setMessage('Account saved. You can now confirm a Plan.'); } }\n      else {\n        if (result.status === 'StorageFailure') setReadOnly(true);\n        if (result.status === 'RuntimeNotWritable') {\n          if (result.runtimeReadiness === 'RecoveryOnly') setReadOnly(true);\n          else setPhase(result.workspaceStatus === 'IntegrityBlocked' ? 'IntegrityBlocked' : 'Unsupported');\n        }\n        setIssues('issues' in result ? result.issues ?? [] : 'failedChecks' in result ? result.failedChecks : 'reason' in result ? [result.reason] : [result.status]);\n      }\n    } finally { setSaving(false); }\n  }\n  async function confirm(event: FormEvent) {\n    event.preventDefault(); if (!root || !definition || saving) return; if (planStage === 1) { setPlanStage(2); return; } setSaving(true); setMessage(''); setIssues([]);\n    try {\n      const result = await services.workflows.confirmPlan({ generation: root.generation, expectedCatalogRevision: catalogRevision, definitionRevision: definition.revision, accountId, strategyId: 'long-stock', economicTime: new Date().toISOString(), plan: { instrument: { kind: 'Stock', symbol: plan.symbol.trim().toUpperCase(), currency: 'USD' }, quantity: plan.quantity, entry: plan.entry, stop: plan.stop, target: plan.target }, reflection: { thesis: plan.thesis, invalidation: plan.invalidation, conviction: plan.conviction, emotion: plan.emotion } });\n      if (result.status === 'Confirmed') { setRoot({ ...root, revision: result.workspaceRevision }); setPlanDirty(false); setPlanStage(1); setDetail({ trade: result.trade, entries: [result.entry], history: [result.trade], labels: result.labels }); setRoute('Detail'); setPlan(emptyPlan); setMessage('Plan confirmed and saved on this device.'); }\n      else {\n        if (result.status === 'StorageFailure') setReadOnly(true);\n        if (result.status === 'RuntimeNotWritable') {\n          if (result.runtimeReadiness === 'RecoveryOnly') setReadOnly(true);\n          else setPhase(result.workspaceStatus === 'IntegrityBlocked' ? 'IntegrityBlocked' : 'Unsupported');\n        }\n        setIssues('issues' in result ? result.issues ?? [] : 'failedChecks' in result ? result.failedChecks : 'reason' in result ? [result.reason] : [result.status]);\n      }\n    } catch { setIssues(['Save failed. Your entered values are preserved. Retry after checking readiness.']); }\n    finally { setSaving(false); }\n  }\n  async function showTrade(tradeId: string) {\n    const result = await services.views.getTradeDetail(tradeId);\n    if (result.status === 'Ready') { setDetail({ ...result, analysis: { ...result, status: 'Derived' } }); setRoot(previous => previous ? { ...previous, revision: result.binding.workspaceRevision ?? previous.revision, generation: result.binding.generation ?? previous.generation, catalogRevision: result.binding.catalogRevision ?? previous.catalogRevision } : previous); setRoute('Detail'); }\n    else setIssues([result.status]);\n  }\n  function startOpening() {\n    if (!detail || !root || !openingDefinition) return;\n    const trade = detail.trade; const now = new Date().toISOString();\n    if (!openingDrafts[trade.tradeId]) setOpeningDrafts(previous => ({ ...previous, [trade.tradeId]: { definition: openingDefinition, rowIds: [crypto.randomUUID()], answers: { 'decision-mode': '', emotion: '', confidence: '', note: '' }, command: { kind: 'InitialStockEntry', generation: root.generation, expectedWorkspaceRevision: detail.binding?.workspaceRevision ?? root.revision, expectedCatalogRevision: detail.binding?.catalogRevision ?? catalogRevision, tradeId: trade.tradeId, expectedTradeRevision: trade.revision, plannedLegId: trade.plannedLegId, definitionRevision: openingDefinition.revision, economicTime: now, executions: [{ instrument: { kind: 'Stock', symbol: trade.plan.instrument?.symbol ?? '', currency: 'USD' }, action: 'Buy', quantity: '', price: '', fee: '0', economicTime: now, plannedLegId: trade.plannedLegId }], reflection: { kind: 'Defer' } } } }));\n    setIssues(openingDrafts[trade.tradeId]?.issues ?? []); setMessage(''); setRoute('Opening');\n  }\n  async function saveOpening(event: FormEvent) {\n    event.preventDefault(); if (!detail || !root || saving) return;\n    const draft = openingDrafts[detail.trade.tradeId]; if (!draft) return;\n    setSaving(true); setIssues([]); setMessage('');\n    try {\n      const result = await services.workflows.recordPositionChange(draft.command);\n      if (result.status === 'Recorded') {\n        const prior = detail.journal;\n        setDetail({ trade: result.trade, labels: result.labels, entries: result.journalOutcome.entry ? [...detail.entries, result.journalOutcome.entry] : detail.entries, history: [...detail.history, result.trade], analysis: result.derivation, journal: { status: 'Ready', generation: root.generation, workspaceRevision: result.workspaceRevision, entries: result.journalOutcome.entry ? [...detail.entries, result.journalOutcome.entry] : detail.entries, obligations: [...(prior?.obligations ?? []), result.journalOutcome.obligation], obligationHistory: [...(prior?.obligationHistory ?? []), result.journalOutcome.obligation], declines: result.journalOutcome.decline ? [...(prior?.declines ?? []), result.journalOutcome.decline] : prior?.declines ?? [] }, binding: { generation: root.generation, workspaceRevision: result.workspaceRevision, catalogRevision: draft.command.expectedCatalogRevision } });\n        setRoot({ ...root, revision: result.workspaceRevision }); setOpeningDrafts(previous => { const next = { ...previous }; delete next[result.trade.tradeId]; return next; }); setRoute('Detail'); setMessage(`Opening entry saved · ${result.trade.opening?.executions.length ?? 0} Executions`);\n      } else {\n        if (result.status === 'StorageFailure' || result.status === 'RuntimeNotWritable') setReadOnly(true);\n        if (result.status === 'RuntimeNotWritable' && result.runtimeReadiness === 'Unsupported') setPhase(result.workspaceStatus === 'IntegrityBlocked' ? 'IntegrityBlocked' : 'Unsupported');\n        const missingFields = Object.fromEntries(draft.rowIds.map((id, index) => [id, (['quantity', 'price'] as const).filter(key => !draft.command.executions[index]?.[key].trim())]));\n        const rejectedIssues = ('issues' in result ? result.issues : 'failedChecks' in result ? result.failedChecks : 'findings' in result ? result.findings : 'reason' in result ? [result.reason] : [result.status]) ?? [result.status];\n        setIssues(rejectedIssues); setOpeningDrafts(previous => ({ ...previous, [draft.command.tradeId]: { ...draft, issues: rejectedIssues, missingFields } }));\n      }\n    } catch { setIssues(['StorageFailure']); setOpeningDrafts(previous => ({ ...previous, [draft.command.tradeId]: { ...draft, issues: ['StorageFailure'] } })); setReadOnly(true); }\n    finally { setSaving(false); }\n  }\n  async function reviewOpening() {\n    if (!detail) return;\n    const result = await services.views.getTradeDetail(detail.trade.tradeId);\n    if (result.status !== 'Ready' || !result.binding.generation || !result.binding.workspaceRevision || !result.binding.catalogRevision) { setIssues([result.status]); return; }\n    const binding = result.binding;\n    setDetail({ ...result, analysis: { ...result, status: 'Derived' } });\n    setOpeningDrafts(previous => { const draft = previous[result.trade.tradeId]; return draft ? { ...previous, [result.trade.tradeId]: { ...draft, command: { ...draft.command, generation: binding.generation ?? draft.command.generation, expectedWorkspaceRevision: binding.workspaceRevision ?? draft.command.expectedWorkspaceRevision, expectedCatalogRevision: binding.catalogRevision ?? draft.command.expectedCatalogRevision, expectedTradeRevision: result.trade.revision } } } : previous; });\n    setIssues([]); setMessage(result.trade.lifecycle === 'Planned' ? 'Current Trade reviewed. Your entered Executions are preserved; review and Save again.' : 'This Trade is already Open. Your unsaved Executions have not been recorded. Cancel to inspect the saved Trade.');\n  }\n  async function reviewDebt() {\n    const draft = debtDrafts[selectedDebtId]; if (!draft) return;\n    try {\n      const current = await services.journal.query({ obligationId: draft.obligation.id, scope: 'History' });\n      const obligation = current.obligations[0];\n      if (!obligation || !current.generation || !current.workspaceRevision) { setIssues(['The original Debt could not be resolved. Retry startup before saving.']); return; }\n      setDebtDrafts(previous => ({ ...previous, [selectedDebtId]: { ...draft, obligation, generation: current.generation ?? draft.generation, workspaceRevision: current.workspaceRevision ?? draft.workspaceRevision } }));\n      setIssues([]); setMessage(obligation.status === 'Outstanding' ? 'Current Debt reviewed. Your answers are preserved; review and Save again.' : 'This obligation was already settled in another tab. Your unsaved answers have not been recorded.');\n    } catch { setIssues(['Journal Debt could not be read. Retry before saving.']); }\n  }\n  async function showDebtQueue() {\n    setRoute('Journal Debt'); setDebtPage(undefined); setDebtError(false); setIssues([]);\n    try { setDebtPage(await services.journal.query({ scope: 'Outstanding' })); } catch { setDebtError(true); }\n  }\n  function beginDebt(obligation: JournalObligation, binding = { generation: debtPage?.generation ?? root?.generation, workspaceRevision: debtPage?.workspaceRevision ?? root?.revision }) {\n    if (!binding.generation || !binding.workspaceRevision) return;\n    const generation = binding.generation; const workspaceRevision = binding.workspaceRevision;\n    setDebtDrafts(previous => previous[obligation.id] ? previous : { ...previous, [obligation.id]: { obligation, generation, workspaceRevision, answers: { 'decision-mode': '', emotion: '', confidence: '', note: '' }, disposition: 'Complete', reason: '' } });\n    setDebtReturnRoute(['Detail', 'Trade Journal'].includes(route) ? 'Detail' : 'Journal Debt'); setSelectedDebtId(obligation.id); setIssues(debtDrafts[obligation.id]?.issues ?? []); setMessage(''); setRoute('Answer Journal Debt');\n  }\n  async function saveDebt(event: FormEvent) {\n    event.preventDefault(); const draft = debtDrafts[selectedDebtId]; if (!draft || saving) return;\n    setSaving(true); setIssues([]); setMessage('');\n    try {\n      const result = await services.journal.save({ kind: 'ResolveDebt', generation: draft.generation, expectedWorkspaceRevision: draft.workspaceRevision, obligationId: draft.obligation.id, expectedRevision: draft.obligation.revision, disposition: draft.disposition === 'Complete' ? { kind: 'Complete', answers: draft.answers } : { kind: 'Decline', reason: draft.reason } });\n      if (result.status === 'Saved') {\n        setDebtOutcome(result); setRoot(previous => previous ? { ...previous, revision: result.workspaceRevision } : previous);\n        setDebtDrafts(previous => { const next = { ...previous }; delete next[selectedDebtId]; return next; }); setRoute('Debt outcome');\n        setMessage(result.entry ? 'Reflection completed. Journal Debt settled.' : 'Reflection explicitly declined. Journal Debt settled.');\n      } else {\n        if (result.status === 'StorageFailure' || result.status === 'RuntimeNotWritable') setReadOnly(true);\n        if (result.status === 'RuntimeNotWritable' && result.runtimeReadiness === 'Unsupported') setPhase(result.workspaceStatus === 'IntegrityBlocked' ? 'IntegrityBlocked' : 'Unsupported');\n        const rejectedIssues = 'issues' in result ? result.issues : 'failedChecks' in result ? result.failedChecks : 'reason' in result ? [result.reason ?? result.status] : result.status === 'NeedsTradeWorkflow' ? [`Resolve this Debt through ${result.route.operation} for Trade ${result.route.tradeId}.`] : [result.status];\n        setIssues(rejectedIssues); setDebtDrafts(previous => ({ ...previous, [selectedDebtId]: { ...draft, issues: rejectedIssues } }));\n      }\n    } catch { setIssues(['StorageFailure']); setDebtDrafts(previous => ({ ...previous, [selectedDebtId]: { ...draft, issues: ['StorageFailure'] } })); setReadOnly(true); }\n    finally { setSaving(false); }\n  }\n  const accounts = records.filter(record => record.kind === 'Account' && record.active);\n  const institutions = records.filter(record => record.kind === 'Institution' && record.active);\n  function displayInstant(instant: string) {\n    const zone = root?.timeZone ?? 'UTC';\n    return `${Temporal.Instant.from(instant).toZonedDateTimeISO(zone).toPlainDateTime().toString().replace('T', ' ')} ${zone}`;\n  }\n  function textField(key: keyof typeof plan, label: string, multiline = false) {\n    const invalid = fieldIssues[key]?.some(issue => issues.includes(issue)) ?? false;\n    const validation = { 'aria-required': true, 'aria-invalid': invalid, 'aria-describedby': invalid ? 'plan-issues' : undefined } as const;\n    return <label key={key}>{label}{multiline ? <textarea {...validation} value={plan[key]} onChange={event => setPlan({ ...plan, [key]: event.target.value })} /> : <input {...validation} value={plan[key]} onChange={event => setPlan({ ...plan, [key]: event.target.value })} inputMode={['quantity', 'entry', 'stop', 'target'].includes(key) ? 'decimal' : 'text'} />}</label>;\n  }\n  if (phase === 'Loading') return <main className={styles.startup}><h1>Trade Journal</h1><p role=\"status\">Verifying startup and local storage…</p></main>;\n  if (phase === 'TimeZoneSelectionRequired') return <main className={styles.startup}><h1 ref={heading} tabIndex={-1}>Your device-local Workspace</h1><p>Choose a rules-based time zone. This journal stays in this browser on this device.</p><form className={styles.card} onSubmit={event => { event.preventDefault(); if (!timeZone.trim()) { setIssues(['TimeZoneRequired']); return; } void open(timeZone); }}><label>Workspace time zone<input value={timeZone} aria-invalid={issues.length > 0 || undefined} aria-describedby={issues.length ? 'time-zone-error' : undefined} placeholder=\"e.g. America/New_York\" onChange={event => setTimeZone(event.target.value)} /></label><button>Create Workspace</button></form>{issues.length > 0 && <div role=\"alert\" id=\"time-zone-error\"><h2 ref={errorHeading} tabIndex={-1}>Choose your time zone</h2>{issues.map(issue => <p key={issue}>{issueMessages[issue] ?? issue}</p>)}</div>}</main>;\n  if (phase !== 'Ready') return <main className={styles.startup}><h1 ref={heading} tabIndex={-1}>{phase}</h1><p>We could not verify safe writing in this environment.</p><ul>{issues.map(issue => <li key={issue} data-issue={issue}>{issueMessages[issue] ?? issue}</li>)}</ul><button onClick={() => void open()}>Retry startup</button>{phase === 'Unsupported' && <p>Try another browser that meets the readiness requirements.</p>}<p>Another browser has separate storage and does not transfer this Workspace. Backup and Restore are not installed in this release.</p></main>;\n  const errorSummary = issues.length > 0 && <div role=\"alert\" id=\"plan-issues\" className={styles.errors}><h2 ref={errorHeading} tabIndex={-1}>Review before continuing</h2>{['Opening', 'Answer Journal Debt'].includes(route) && <p>Nothing saved. Your draft is preserved.</p>}<ul>{route === 'Opening' && detail && openingDrafts[detail.trade.tradeId]?.rowIds.map((id, index) => { const missing = openingDrafts[detail.trade.tradeId]?.missingFields?.[id] ?? []; return missing.length ? <li key={id}><p>Nothing saved — Execution {index + 1} needs a {missing.join(' and ')}</p>{missing.map(key => <button key={key} type=\"button\" onClick={() => document.getElementById(`execution-${id}-${key}`)?.focus()}>Go to Execution {index + 1} {key}</button>)}</li> : null; })}{issues.map(issue => <li key={issue} data-issue={issue}>{issueMessages[issue] ?? issue}</li>)}</ul>{route === 'Answer Journal Debt' && issues.some(issue => ['WorkspaceChanged', 'ObligationChanged'].includes(issue)) && <button onClick={() => void reviewDebt()}>Review current Debt</button>}{route === 'Opening' && issues.some(issue => ['CatalogChanged', 'WorkspaceChanged', 'TradeChanged'].includes(issue)) && <button onClick={() => void reviewOpening()}>Review current Trade</button>}{route !== 'Opening' && route !== 'Answer Journal Debt' && issues.some(issue => issue === 'CatalogChanged' || issue === 'WorkspaceChanged') && <button onClick={() => { void services.workspace.initialize({ openingInstant: new Date().toISOString() }).then(result => { if (result.status === 'Opened') { setRoot(result.root); setRecords(result.catalog.records); setCatalogRevision(result.root.catalogRevision); setIssues([]); setMessage('References refreshed. Review your selections and confirm again.'); } }); }}>Review current references</button>}</div>;\n  const panelOpen = route === 'Opening' || route === 'Answer Journal Debt' || route === 'Trade Journal';\n  const viewRoute = route === 'Opening' || route === 'Trade Journal' ? 'Detail' : route === 'Answer Journal Debt' ? debtReturnRoute : route;\n  return <><div className={styles.shell} inert={panelOpen} aria-hidden={panelOpen || undefined}>\n    <nav aria-label=\"Primary\"><strong>TRADE JOURNAL</strong><button aria-current={['Trades', 'Detail'].includes(viewRoute) ? 'page' : undefined} onClick={() => void browse()}>Trades</button><button aria-current={viewRoute === 'New Plan' ? 'page' : undefined} disabled={readOnly || !accounts.length} onClick={() => { setRoute('New Plan'); setIssues([]); }}>New Plan</button><button aria-current={['Journal Debt', 'Debt outcome'].includes(viewRoute) ? 'page' : undefined} onClick={() => void showDebtQueue()}>Journal Debt</button><button aria-current={viewRoute === 'Workspace' ? 'page' : undefined} onClick={() => { setIssues([]); setRoute('Workspace'); }}>Workspace</button></nav>\n    <main>{viewRoute === 'Detail' && <button onClick={() => { setIssues([]); setMessage(''); setRoute('Trades'); }}>‹ Back to Trades</button>}<header><p className={styles.eyebrow}>AFTER-CLOSE JOURNAL · USD</p><h1 ref={heading} tabIndex={-1}>{viewRoute === 'Detail' && detail ? `${detail.trade.plan.instrument?.symbol} · ${detail.trade.lifecycle}` : viewRoute}</h1></header>\n      {delivery && <button className={styles.updateCheck} onClick={() => void checkUpdate()}>Check for application updates</button>}\n      {updateAvailable && <aside aria-label=\"Update available\" className={styles.warning}><h2>Update available</h2><p>{dirty ? 'Update deferred while this form has unsaved values. Save or Cancel before reloading.' : 'The complete new release is verified. Reload when you are ready.'}</p><button disabled={dirty || saving} onClick={() => { if (!dirty && !saving) void delivery?.activateUpdate().then(result => { if (result) setMessage(result === 'OtherClientsOpen' ? 'Close other Trade Journal tabs before reloading to update.' : 'Update activation could not be verified. Please retry.'); }); }}>Reload to update</button></aside>}\n      {readOnly && <aside aria-label=\"Recovery Only\" className={styles.warning}><h2>Recovery Only</h2><p>Reading and history remain available; writing is disabled. Another browser has separate storage. Backup and Restore are not installed in this release.</p><button onClick={() => void open()}>Retry startup</button></aside>}\n      {protection !== 'Protected' && <aside aria-label=\"Storage protection\" className={styles.warning}><strong>Storage is {protection === 'BestEffort' ? 'Best Effort' : 'Unavailable'}.</strong> This browser may clear your data. Backup is not installed until a later release. <button onClick={() => { void services.workspace.requestDurability().then(result => { setProtection(result.currentProtection); setMessage(result.status === 'NotImproved' ? 'The host did not grant stronger storage protection.' : 'Storage protection confirmed.'); }); }}>Request storage protection</button></aside>}\n      {route === 'Workspace' && <p className={styles.install}>Where your browser offers installation, use Install or Add to Home Screen. This tab is usable after startup verification. Installation does not transfer or synchronize data.</p>}\n      {message && <p role=\"status\">{message}</p>}{!panelOpen && errorSummary}\n      {readOnly && route === 'Workspace' ? <section className={styles.card}><h2>Workspace</h2><p>Time zone: {root?.timeZone}</p><p>Reference changes are disabled in Recovery Only.</p></section> : !accounts.length || route === 'Workspace' ? <section className={styles.card}><h2>{accounts.length ? 'Workspace' : 'Add your brokerage records'}</h2><p>Use your real Institution and Account. They are trading records; there is no application login.</p>{root && <p>Time zone: {root.timeZone}</p>}\n        <form onSubmit={event => void saveReference(event, 'Institution')}><label>Institution name<input value={institution} onChange={event => setInstitution(event.target.value)} required /></label><button disabled={saving || readOnly}>Add Institution</button></form>\n        {institutions.length > 0 && <form onSubmit={event => void saveReference(event, 'Account')}><h3>Add Account</h3><p>Create a separate Account under the selected Institution.</p><label>Institution<select value={parentId} onChange={event => setParentId(event.target.value)}>{institutions.map(record => <option key={record.id} value={record.id}>{record.label}</option>)}</select></label><label>New Account name<input value={account} onChange={event => setAccount(event.target.value)} required /></label><button disabled={saving || readOnly}>Add Account</button></form>}\n      </section> : route === 'New Plan' ? <form className={styles.planForm} onChange={() => setPlanDirty(true)} onSubmit={event => void confirm(event)} noValidate><p className={styles.eyebrow}>STEP {planStage} OF 2</p><section className={styles.card}><h2>Long Stock Plan</h2><p>Freeze your intended entry, original management and Plan Reflection before entering.</p><label>Account<select value={accountId} onChange={event => setAccountId(event.target.value)}>{accounts.map(record => <option key={record.id} value={record.id}>{record.label} · {institutions.find(institution => institution.id === record.parentId)?.label}</option>)}</select></label>\n        {textField('symbol', 'Stock symbol')}</section>{planStage === 1 ? <div className={styles.actions}><button type=\"button\" onClick={() => setPlanStage(2)}>Next: Plan and reflection</button><button type=\"button\" onClick={() => { setPlanDirty(false); setPlan(emptyPlan); setRoute('Trades'); }}>Cancel</button></div> : <><section className={styles.card}><h2>Risk parameters</h2><div className={styles.fieldGrid}>{textField('quantity', 'Quantity (shares)')}{textField('entry', 'Intended entry (USD)')}{textField('stop', 'Stop (underlying price, USD)')}{textField('target', 'Target (underlying price, USD)')}</div></section><section className={styles.card}>\n        <h2>Plan Reflection</h2>{definition?.prompts.filter(prompt => prompt.id === 'thesis' || prompt.id === 'invalidation').map(prompt => textField(prompt.id as 'thesis' | 'invalidation', prompt.wording, true))}\n        <label>Conviction (optional, 1–5)<select value={plan.conviction} onChange={event => setPlan({ ...plan, conviction: event.target.value })}><option value=\"\">Unanswered</option>{[1,2,3,4,5].map(value => <option key={value}>{value}</option>)}</select></label>\n        <fieldset><legend>Primary emotion (optional)</legend><label><input type=\"radio\" name=\"emotion\" checked={!plan.emotion} onChange={() => setPlan({ ...plan, emotion: '' })} />Unanswered</label>{definition?.prompts.find(prompt => prompt.id === 'emotion')?.options?.map(option => <label key={option.id}><input type=\"radio\" name=\"emotion\" value={option.id} checked={plan.emotion === option.id} onChange={() => setPlan({ ...plan, emotion: option.id })} />{option.label}</label>)}</fieldset>\n        </section><div className={styles.actions}><button type=\"button\" onClick={() => setPlanStage(1)}>Back to instrument</button><button type=\"submit\" disabled={saving || readOnly}>{saving ? 'Saving…' : 'Confirm Plan'}</button><button type=\"button\" onClick={() => { setPlanDirty(false); setPlanStage(1); setPlan(emptyPlan); setIssues([]); setRoute('Trades'); }}>Cancel</button></div>\n      </>}</form> : viewRoute === 'Journal Debt' ? <section className={styles.card}><h2>Outstanding Journal Debt</h2><p>Deferred reflection is separate from trading facts. Open a moment to answer its original form or explicitly decline.</p>{debtError ? <><p role=\"alert\">Journal Debt could not be read.</p><button onClick={() => void showDebtQueue()}>Retry Journal Debt</button></> : !debtPage ? <p role=\"status\">Loading Journal Debt…</p> : debtPage.obligations.length === 0 ? <p>No outstanding Journal Debt.</p> : debtPage.obligations.map(obligation => <section className={styles.card} key={obligation.id}><h3>{obligation.definition.label} · Outstanding</h3><p>Trade {obligation.anchor.tradeId} · Due {displayInstant(obligation.dueTime)}</p><button disabled={readOnly} onClick={() => beginDebt(obligation)}>Answer reflection</button><button onClick={() => void showTrade(obligation.anchor.tradeId)}>View Trade</button></section>)}</section> : route === 'Debt outcome' && debtOutcome ? <section className={styles.card}><h2>Journal Debt settled</h2><p>{debtOutcome.obligation.status === 'Completed' ? 'Completed Entry' : 'Explicit decline'} · Source {debtOutcome.obligation.source.label}</p><p>Trade Anchor {debtOutcome.obligation.anchor.tradeId} · Position Change {debtOutcome.obligation.origin.factId}</p><p>Original moment: {displayInstant(debtOutcome.obligation.momentTime)}</p><p>Saved: {displayInstant(debtOutcome.obligation.saveTime)}</p>{debtOutcome.entry && debtOutcome.entry.definition.prompts.map(prompt => { const response = debtOutcome.entry?.responses[prompt.id]; return <div key={prompt.id}><h3>{prompt.wording}</h3><p>{!response || response.kind === 'Unanswered' ? 'Unanswered' : prompt.options?.find(option => option.id === response.value)?.label ?? response.value}</p></div>; })}{debtOutcome.decline?.reason && <p>{debtOutcome.decline.reason}</p>}<button onClick={() => void showTrade(debtOutcome.obligation.anchor.tradeId)}>View Trade</button></section> : viewRoute === 'Detail' && detail ? <><section className={styles.card}><span className={styles.badge}>{detail.trade.lifecycle} · {detail.trade.lifecycle === 'Planned' ? 'Unfilled' : 'Filled as Planned'}</span><h2>Frozen Plan Baseline</h2><div className={styles.hero}><p>ORIGINAL PLANNED RISK · 1R<strong title={detail.trade.baseline.oneR}>{money(detail.trade.baseline.oneR)}</strong></p><p>ORIGINAL PLANNED REWARD<strong title={detail.trade.baseline.reward}>{money(detail.trade.baseline.reward)}</strong></p><p>REWARD / RISK<strong>{detail.trade.baseline.ratio.numerator}/{detail.trade.baseline.ratio.denominator}</strong></p></div><p>{detail.labels.institution} · {detail.labels.account} · {detail.labels.strategy}</p><dl><dt>Intended entry</dt><dd>${detail.trade.plan.entry} × {detail.trade.plan.quantity} shares</dd><dt>Stop · underlying price</dt><dd>${detail.trade.plan.stop}</dd><dt>Target · underlying price</dt><dd>${detail.trade.plan.target}</dd></dl>{detail.trade.lifecycle === 'Planned' ? <><p>No exposure has been entered.</p>{openingDrafts[detail.trade.tradeId] && <p className={styles.badge}>Unsaved entry draft</p>}<button disabled={readOnly} onClick={startOpening}>{openingDrafts[detail.trade.tradeId] ? 'Continue unsaved entry' : 'Record initial Position Change'}</button></> : null}</section>\n        {detail.trade.opening && <section className={styles.card}><h2>Recorded Executions</h2>{detail.trade.opening.executions.map((execution, index) => <div className={styles.recorded} key={execution.id}><strong>Execution {index + 1} · Recorded · Buy {execution.instrument.symbol}</strong><p>{execution.quantity} shares × ${execution.price} · Fee {money(execution.fee)}</p><small>Economic Time: {displayInstant(execution.economicTime)}</small></div>)}</section>}\n        {detail.analysis?.status === 'Derived' && 'quantity' in detail.analysis && <section className={styles.card}><h2>Open Position</h2><dl><dt>Quantity</dt><dd>{detail.analysis.quantity} shares</dd><dt>Gross basis</dt><dd>{money(detail.analysis.grossBasis)}</dd><dt>Opening fees</dt><dd>{money(detail.analysis.openingFees)}</dd><dt>Weighted entry</dt><dd title={`${detail.analysis.weightedEntry.numerator}/${detail.analysis.weightedEntry.denominator}`}>{quotientText(detail.analysis.weightedEntry)} USD <small>(exact {detail.analysis.weightedEntry.numerator}/{detail.analysis.weightedEntry.denominator})</small></dd><dt>Actual entry risk</dt><dd>{money(detail.analysis.entryQuality.risk)}</dd><dt>Actual entry reward</dt><dd>{money(detail.analysis.entryQuality.reward)}</dd><dt>Actual entry reward/risk</dt><dd>{'status' in detail.analysis.entryQuality.ratio ? `Unavailable: ${detail.analysis.entryQuality.ratio.reason}` : <>{quotientText(detail.analysis.entryQuality.ratio, 2)} <small>(exact {detail.analysis.entryQuality.ratio.numerator}/{detail.analysis.entryQuality.ratio.denominator})</small></>}</dd><dt>Entry Quality</dt><dd>{detail.analysis.entryQuality.comparison === 'BelowPlan' ? 'Below Plan' : detail.analysis.entryQuality.comparison === 'Unavailable' ? 'Unavailable: nonpositive actual entry risk' : 'Met or Exceeded Plan'}</dd></dl><h3>Open Lots</h3>{detail.analysis.positions.flatMap(position => position.lots.map(lot => <p key={lot.openingId}>{lot.quantity} shares at ${lot.price} · opening fee {money(lot.openingFees)}</p>))}</section>}\n        {detail.journal?.obligations.map(obligation => <section className={styles.card} key={obligation.id}><h2>Position Change Reflection · {obligation.status === 'Outstanding' ? 'Journal Debt' : obligation.status === 'Declined' ? 'Explicit decline' : 'Completed'}</h2><p>{obligation.status === 'Outstanding' ? 'Outstanding · Due ' + displayInstant(obligation.dueTime) : obligation.status}</p><p>Trade Anchor · Source {obligation.source.label} · Position Change {obligation.origin.factId}</p>{obligation.status === 'Outstanding' && <button disabled={readOnly} onClick={() => beginDebt(obligation, { generation: detail.binding?.generation, workspaceRevision: detail.binding?.workspaceRevision })}>Answer reflection</button>}{detail.journal?.declines.filter(decline => decline.obligationKey === obligation.key).map(decline => <p key={decline.id}>Declined {displayInstant(decline.saveTime)}{decline.reason ? ` · ${decline.reason}` : ''}</p>)}</section>)}\n        {detail.entries.map(entry => <section className={styles.card} key={entry.id}><h2>{entry.definition.label}</h2><p>Trade Anchor · <span>{entry.source.label}</span></p><p>Moment: {displayInstant(entry.momentTime)} · First authored: {displayInstant(entry.firstAuthoredTime)}</p>{entry.definition.prompts.map(prompt => {\n          const response = entry.responses[prompt.id];\n          const value = !response || response.kind === 'Unanswered' ? 'Unanswered' : response.kind === 'SingleSelect' ? prompt.options?.find(option => option.id === response.value)?.label ?? response.value : response.value;\n          return <div key={prompt.id}><h3>{prompt.wording}</h3><p>{value}</p></div>;\n        })}</section>)}\n        <button onClick={() => { setIssues([]); setRoute('Trade Journal'); }}>View Trade Journal</button><details className={styles.card}><summary>View history</summary>{detail.history.map(trade => <div key={trade.stateVersionId ?? trade.planVersionId}><p>Confirmed: {displayInstant(trade.economicTime)}</p><p>Saved: {displayInstant(trade.saveTime)}</p><p>Recorded Sequence: {trade.sequence}</p><p>Plan fact: {trade.planFactId}</p><p>Version: {trade.stateVersionId ?? trade.planVersionId}</p>{trade.opening && <><p>Position Change: {trade.opening.positionChange.id} · {displayInstant(trade.opening.positionChange.economicTime)}</p>{trade.opening.executions.map(execution => <p key={execution.id}>Execution {execution.id}: {execution.quantity} shares at ${execution.price}, fee ${execution.fee} · {displayInstant(execution.economicTime)} · Saved {displayInstant(execution.saveTime)} · Recorded Sequence {execution.sequence}</p>)}</>}</div>)}</details></> : <section className={styles.browse}><h2>{lifecycle} Trades</h2><div className={styles.filters}><button aria-pressed={lifecycle === 'Planned'} onClick={() => void browse(undefined, 'Planned')}>Planned</button><button aria-pressed={lifecycle === 'Open'} onClick={() => void browse(undefined, 'Open')}>Open</button></div>{!page ? <p role=\"status\">Loading {lifecycle} Trades…</p> : page.status === 'Empty' ? <p>No confirmed Plans match this view.</p> : page.status === 'Ready' ? <><ul className={styles.tradeList}>{page.items.map(item => <li key={item.trade.tradeId}><button data-symbol={item.trade.plan.instrument?.symbol?.slice(0, 2)} onClick={() => void showTrade(item.trade.tradeId)}><strong>{item.trade.plan.instrument?.symbol} · {item.trade.lifecycle}</strong> {item.status === 'Derived' ? 'quantity' in item ? <span>{item.quantity} shares · {money(item.openingFees)} opening fees · Entry Quality: {item.entryQuality.comparison === 'BelowPlan' ? 'Below Plan' : item.entryQuality.comparison === 'Unavailable' ? 'Unavailable' : 'Met or Exceeded Plan'}</span> : <span>{records.find(record => record.id === item.trade.accountId)?.label} · {records.find(record => record.id === item.trade.strategyId)?.label} · {item.entryReadiness} · {money(item.baseline.oneR)} risk · {money(item.baseline.reward)} reward · {item.baseline.ratio.numerator}/{item.baseline.ratio.denominator} reward/risk</span> : <span>Integrity blocked</span>}</button></li>)}</ul>{page.nextCursor && <button onClick={() => void browse(page.nextCursor)}>Next 50 Trades</button>}</> : <><p role=\"alert\">{page.status}</p><button onClick={() => void browse()}>Retry list</button></>}</section>}\n    </main>\n  </div>\n  {route === 'Opening' && detail && openingDrafts[detail.trade.tradeId] && <ContextPanel title=\"Opening entry\" busy={saving} onClose={() => { setIssues([]); setRoute('Detail'); }}>{updateAvailable && <p role=\"status\">Update deferred while this form has unsaved values. Save or Cancel before reloading.</p>}{errorSummary}<OpeningForm busy={saving} plannedQuantity={detail.trade.plan.quantity} draft={openingDrafts[detail.trade.tradeId]} onChange={draft => setOpeningDrafts(previous => ({ ...previous, [draft.command.tradeId]: draft }))} onSubmit={event => void saveOpening(event)} issues={issues} disabled={saving || readOnly || detail.trade.lifecycle !== 'Planned'} onCancel={() => { setOpeningDrafts(previous => { const next = { ...previous }; delete next[detail.trade.tradeId]; return next; }); setIssues([]); setRoute('Detail'); }} /></ContextPanel>}\n  {route === 'Answer Journal Debt' && debtDrafts[selectedDebtId] && <ContextPanel title=\"Answer Journal Debt\" busy={saving} onClose={() => { setIssues([]); setRoute(debtReturnRoute); }}>{updateAvailable && <p role=\"status\">Update deferred while this form has unsaved values. Save or Cancel before reloading.</p>}{errorSummary}<DebtForm busy={saving} draft={debtDrafts[selectedDebtId]} onChange={draft => setDebtDrafts(previous => ({ ...previous, [draft.obligation.id]: draft }))} onSubmit={event => void saveDebt(event)} issues={issues} disabled={saving || readOnly || debtDrafts[selectedDebtId].obligation.status !== 'Outstanding'} onCancel={() => { setDebtDrafts(previous => { const next = { ...previous }; delete next[selectedDebtId]; return next; }); void showDebtQueue(); }} /></ContextPanel>}\n  {route === 'Trade Journal' && detail && <ContextPanel title=\"Trade Journal\" busy={false} onClose={() => setRoute('Detail')}>{detail.entries.map(entry => <section className={styles.card} key={entry.id}><h2>{entry.definition.label}</h2><p>Trade Anchor · <span>{entry.source.label}</span></p><p>Moment: {displayInstant(entry.momentTime)} · First authored: {displayInstant(entry.firstAuthoredTime)}</p>{entry.definition.prompts.map(prompt => {\n          const response = entry.responses[prompt.id];\n          const value = !response || response.kind === 'Unanswered' ? 'Unanswered' : response.kind === 'SingleSelect' ? prompt.options?.find(option => option.id === response.value)?.label ?? response.value : response.value;\n          return <div key={prompt.id}><h3>{prompt.wording}</h3><p>{value}</p></div>;\n        })}</section>)}</ContextPanel>}\n  </>;\n}\n","src/presentation/ContextPanel.tsx":"import { useEffect, useRef, type ReactNode } from 'react';\nimport styles from './App.module.css';\n\nexport function ContextPanel({ title, busy, onClose, children }: { title: string; busy: boolean; onClose: () => void; children: ReactNode }) {\n  const panel = useRef<HTMLDivElement>(null);\n  useEffect(() => {\n    const invoker = document.activeElement as HTMLElement | null;\n    const overflow = document.body.style.overflow;\n    document.body.style.overflow = 'hidden'; panel.current?.focus();\n    const revealFocus = () => requestAnimationFrame(() => {\n      if (panel.current?.contains(document.activeElement)) (document.activeElement as HTMLElement)?.scrollIntoView?.({ block: 'nearest' });\n    });\n    window.addEventListener('resize', revealFocus);\n    return () => { document.body.style.overflow = overflow; window.removeEventListener('resize', revealFocus); queueMicrotask(() => { if (invoker?.isConnected) invoker.focus(); }); };\n  }, []);\n  return <div className={styles.backdrop}><div ref={panel} role=\"dialog\" aria-modal=\"true\" aria-label={title} tabIndex={-1} className={styles.panel} onKeyDown={event => {\n    if (event.key === 'Escape') { event.preventDefault(); if (!busy) onClose(); }\n    if (event.key === 'Tab') {\n      const controls = Array.from(panel.current?.querySelectorAll<HTMLElement>('button:not(:disabled), input:not(:disabled), select:not(:disabled), textarea:not(:disabled), a[href], summary, [tabindex=\"0\"]') ?? []).filter(element => !element.closest('[hidden]'));\n      const first = controls[0]; const last = controls.at(-1);\n      if (event.shiftKey && (document.activeElement === first || document.activeElement === panel.current)) { event.preventDefault(); last?.focus(); }\n      else if (!event.shiftKey && (document.activeElement === last || document.activeElement === panel.current)) { event.preventDefault(); first?.focus(); }\n    }\n  }}><header className={styles.panelHeader}><div><p className={styles.eyebrow}>TRADE JOURNAL</p><h2>{title}</h2></div><button type=\"button\" disabled={busy} aria-label={`Close ${title.toLowerCase()}`} onClick={onClose}>×</button></header>{children}</div></div>;\n}\n","src/presentation/DebtForm.tsx":"import type { FormEvent } from 'react';\nimport type { JournalObligation, PositionReflectionAnswers } from '../domain/journal/position-change-types';\nimport { ReflectionFields } from './OpeningForm';\nimport styles from './App.module.css';\nexport interface DebtDraft { issues?: string[]; obligation: JournalObligation; generation: string; workspaceRevision: string; answers: PositionReflectionAnswers; disposition: 'Complete' | 'Decline'; reason: string }\nexport function DebtForm({ draft, onChange, onSubmit, onCancel, disabled, busy = false, issues }: { draft: DebtDraft; onChange: (draft: DebtDraft) => void; onSubmit: (event: FormEvent) => void; onCancel: () => void; disabled: boolean; busy?: boolean; issues: string[] }) {\n  return <form className={styles.card} noValidate onSubmit={onSubmit}><h2>{draft.obligation.definition.label}</h2><p>Answer the original trigger-time form. This writing belongs to Trade {draft.obligation.anchor.tradeId}, Position Change {draft.obligation.origin.factId}.</p><p>Source: {draft.obligation.source.label} · Moment: {draft.obligation.momentTime} · Due: {draft.obligation.dueTime}</p>\n    <fieldset disabled={busy} className={styles.formFields}><legend>Owed reflection</legend><fieldset><legend>Debt outcome</legend><label><input type=\"radio\" name=\"debt-outcome\" checked={draft.disposition === 'Complete'} onChange={() => onChange({ ...draft, disposition: 'Complete' })} />Answer reflection</label><label><input type=\"radio\" name=\"debt-outcome\" checked={draft.disposition === 'Decline'} onChange={() => onChange({ ...draft, disposition: 'Decline' })} />Decline owed reflection</label></fieldset>\n    {draft.disposition === 'Complete' ? <ReflectionFields definition={draft.obligation.definition} answers={draft.answers} issues={issues} onChange={answers => onChange({ ...draft, answers })} /> : <label>Decline reason (optional)<textarea value={draft.reason} onChange={event => onChange({ ...draft, reason: event.target.value })} /></label>}\n    </fieldset><div className={styles.actions}><button type=\"submit\" disabled={disabled}>{busy ? 'Saving…' : 'Save Debt outcome'}</button><button disabled={busy} type=\"button\" onClick={onCancel}>Cancel</button></div>\n  </form>;\n}\n","src/presentation/OpeningForm.tsx":"import { useEffect, useRef, type FormEvent } from 'react';\nimport type { PositionChangeCommand } from '../application/trade-workflows/opening-types';\nimport { positionChangeDefinition, type PositionReflectionAnswers } from '../domain/journal/position-change-types';\nimport styles from './App.module.css';\nexport interface OpeningDraft { issues?: string[]; missingFields?: Record<string, ('quantity' | 'price')[]>; command: PositionChangeCommand; definition: typeof positionChangeDefinition; rowIds: string[]; answers: PositionReflectionAnswers }\nexport function ReflectionFields({ definition, answers, onChange, issues = [] }: { definition: typeof positionChangeDefinition; answers: PositionReflectionAnswers; onChange: (value: PositionReflectionAnswers) => void; issues?: string[] }) {\n  return <>{definition.prompts.map(prompt => {\n    const invalid = issues.some(issue => issue.startsWith(`${prompt.id}:`));\n    const validation = { 'aria-invalid': invalid || undefined, 'aria-describedby': invalid ? 'plan-issues' : undefined };\n    const key = prompt.id as keyof PositionReflectionAnswers;\n    if (prompt.kind === 'SingleSelect') return <fieldset key={prompt.id} {...validation}><legend>{prompt.wording}</legend>{prompt.options?.map(option => <label key={option.id}><input type=\"radio\" name={`reflection-${prompt.id}`} checked={answers[key] === option.id} onChange={() => onChange({ ...answers, [key]: option.id })} />{option.label}</label>)}</fieldset>;\n    if (prompt.kind === 'Scale') return <label key={prompt.id}>{prompt.wording}<select {...validation} aria-required={prompt.required} value={answers[key] ?? ''} onChange={event => onChange({ ...answers, [key]: event.target.value })}><option value=\"\">Choose 1–5</option>{[1,2,3,4,5].map(value => <option key={value}>{value}</option>)}</select></label>;\n    return <label key={prompt.id}>{prompt.wording}{!prompt.required && ' (optional)'}<textarea value={answers[key] ?? ''} onChange={event => onChange({ ...answers, [key]: event.target.value })} /></label>;\n  })}</>;\n}\nexport function OpeningForm({ draft, onChange, onSubmit, onCancel, disabled, busy = false, issues, plannedQuantity }: { draft: OpeningDraft; onChange: (value: OpeningDraft) => void; onSubmit: (event: FormEvent) => void; onCancel: () => void; disabled: boolean; busy?: boolean; issues: string[]; plannedQuantity: string }) {\n  const command = draft.command;\n  const focusAfterRemoval = useRef<string>('');\n  useEffect(() => { if (focusAfterRemoval.current) { document.getElementById(focusAfterRemoval.current)?.focus(); focusAfterRemoval.current = ''; } }, [draft.rowIds]);\n  return <form className={styles.card} onSubmit={onSubmit} noValidate><span className={styles.badge}>Unsaved entry draft</span><h2>One complete initial decision</h2><p>Frozen planned quantity: {plannedQuantity} shares.</p><p>Enter every broker buy Execution for this decision. Together they must equal the frozen planned quantity. No facts or reflection are saved until you press Save.</p>\n    <fieldset disabled={busy} className={styles.formFields}><legend>Opening Executions and reflection</legend><label>Position Change time (ISO 8601)<input value={command.economicTime} onChange={event => onChange({ ...draft, command: { ...command, economicTime: event.target.value } })} /></label>\n    {command.executions.map((execution, index) => <fieldset key={draft.rowIds[index]}><legend>Execution {index + 1} · Buy {execution.instrument.symbol} · Unsaved</legend><div className={styles.fieldGrid}>{(['quantity', 'price', 'fee', 'economicTime'] as const).map(key => <label key={key}>Execution {index + 1} {key === 'quantity' ? 'quantity (shares)' : key === 'price' ? 'price (USD)' : key === 'fee' ? 'fee (USD)' : 'time (ISO 8601)'}<input id={`execution-${draft.rowIds[index]}-${key}`} aria-required aria-invalid={((key === 'quantity' || key === 'price') && draft.missingFields?.[draft.rowIds[index] ?? '']?.includes(key)) || undefined} aria-describedby={issues.length ? 'plan-issues' : undefined} value={execution[key]} inputMode={key === 'economicTime' ? 'text' : 'decimal'} onChange={event => onChange({ ...draft, command: { ...command, executions: command.executions.map((row, at) => at === index ? { ...row, [key]: event.target.value } : row) } })} /></label>)}</div>{command.executions.length > 1 && <button type=\"button\" onClick={() => { const remaining = draft.rowIds.filter((_, at) => at !== index); focusAfterRemoval.current = `execution-${remaining[Math.min(index, remaining.length - 1)]}-quantity`; onChange({ ...draft, rowIds: remaining, command: { ...command, executions: command.executions.filter((_, at) => at !== index) } }); }}>Remove draft row {index + 1}</button>}</fieldset>)}\n    <button type=\"button\" onClick={() => { const first = command.executions[0]; if (first) onChange({ ...draft, rowIds: [...draft.rowIds, crypto.randomUUID()], command: { ...command, executions: [...command.executions, { ...first, quantity: '', price: '', fee: '0', economicTime: command.economicTime }] } }); }}>Add another execution</button>\n    <h2>{draft.definition.label}</h2><fieldset><legend>Reflection outcome</legend>{([{ kind: 'Complete', label: 'Complete reflection now' }, { kind: 'Defer', label: 'Defer reflection as Journal Debt' }, { kind: 'Decline', label: 'Decline reflection' }] as const).map(option => <label key={option.kind}><input type=\"radio\" name=\"reflection-outcome\" checked={command.reflection.kind === option.kind} onChange={() => onChange({ ...draft, command: { ...command, reflection: option.kind === 'Complete' ? { kind: 'Complete', answers: draft.answers } : { kind: option.kind } } })} />{option.label}</label>)}</fieldset>\n    {command.reflection.kind === 'Complete' && <ReflectionFields issues={issues} definition={draft.definition} answers={draft.answers} onChange={answers => onChange({ ...draft, answers, command: { ...command, reflection: { kind: 'Complete', answers } } })} />}\n    {command.reflection.kind === 'Decline' && <label>Decline reason (optional)<textarea value={command.reflection.reason ?? ''} onChange={event => onChange({ ...draft, command: { ...command, reflection: { kind: 'Decline', reason: event.target.value } } })} /></label>}\n    </fieldset><div className={styles.actions}><p>All Executions and the reflection outcome save together.</p><button type=\"submit\" disabled={disabled}>{busy ? 'Saving…' : 'Save opening entry'}</button><button type=\"button\" disabled={busy} onClick={onCancel}>Cancel</button></div>\n  </form>;\n}\n","src/vite-env.d.ts":"/// <reference types=\"vite/client\" />\ndeclare const __RELEASE_ID__: string;\n","tests/benchmark/d01-probe.spec.ts":"import { test } from '@playwright/test';\ntest('diagnose native command growth without replacing application results', async ({ playwright, baseURL }) => {\n  const profile = process.env.D1_PROBE_PROFILE;\n  if (!profile) { test.skip(true, 'Optional diagnostic requires an explicit preserved native profile'); return; }\n  const context = await playwright.webkit.launchPersistentContext(profile, { headless: true, baseURL });\n  try {\n    const page = await context.newPage(); await page.goto('/');\n    await page.getByRole('button', { name: 'Check for application updates' }).click();\n    if (await page.getByRole('button', { name: 'Reload to update' }).isVisible()) {\n      await page.getByRole('button', { name: 'Reload to update' }).click();\n      await page.getByRole('heading', { name: 'Trades', exact: true }).waitFor();\n    }\n    await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n    const result = await page.evaluate(async () => {\n      const observed: Record<string, { calls: number; ms: number; events: number }> = {};\n      function observe(prototype: object, key: string, label: string) {\n        const original = Reflect.get(prototype, key) as (...args: unknown[]) => unknown;\n        Reflect.set(prototype, key, function (this: unknown, ...args: unknown[]) {\n          const start = performance.now(); const result = original.apply(this, args);\n          const record = observed[label] ??= { calls: 0, ms: 0, events: 0 }; record.calls++;\n          if (result instanceof IDBRequest) result.addEventListener('success', () => { record.ms += performance.now() - start; record.events++; });\n          else if (result instanceof Promise) void result.then(() => { record.ms += performance.now() - start; record.events++; });\n          return result;\n        });\n      }\n      for (const key of ['openCursor', 'getAll', 'get', 'count']) observe(IDBIndex.prototype, key, `index.${key}`);\n      for (const key of ['get', 'put', 'add']) observe(IDBObjectStore.prototype, key, `store.${key}`);\n      observe(StorageManager.prototype, 'estimate', 'estimate');\n      const dataset = await window.d1Evidence.generate(10);\n      return { dataset, observed };\n    });\n    console.log(JSON.stringify(result, null, 2));\n  } finally { await context.close(); }\n});\n","tests/benchmark/d01-scale.spec.ts":"import { writeFile } from 'node:fs/promises';\nimport { platform, release, cpus, totalmem } from 'node:os';\nimport { test, expect } from '../browser/fixtures';\nimport { onboard } from '../browser/helpers';\ndeclare global { interface Window { d1Queries: Record<string, { calls: number; rows: number }> } }\n// This injected actor calls production commands with actual BrowserHost, IndexedDB and caches.\n// It adds no installed UI route or application mock. Values/clock are deterministic; opaque IDs are host generated.\ntest('D1-I05 command-created 25000 Planned Trades, 50 cold and 50 warm offline trials', async ({ page, context, playwright, browserName, profilePath, baseURL }) => {\n  test.setTimeout(1_800_000);\n  await onboard(page);\n  await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n  page.on('console', message => { if (message.text().startsWith('D1 command-created')) console.log(message.text()); });\n  const dataset = await page.evaluate(() => window.d1Evidence.generate(25000));\n  console.log('D1 dataset complete', dataset);\n  const before = await page.evaluate(() => window.d1Evidence.inspect());\n  expect(before.count).toBe(25000);\n  expect(dataset.counts).toEqual({ plans: 25000, entries: 25000, lifecycle: 25000, versions: 50007 });\n  await page.evaluate(() => window.d1Evidence.discardPrivateReceipts());\n  expect(await page.evaluate(() => window.d1Evidence.inspect())).toEqual(before);\n  const afterPrivateDiscard = await page.evaluate(() => window.d1Evidence.measure());\n  expect(afterPrivateDiscard).toMatchObject({ status: 'Writable', storageMeasurement: { activeSerializedBytes: 0, method: 'UnmeasuredConservative' } });\n  // Lists use authoritative membership and bounded source batches. The only\n  // private projection is the size receipt; deletion preserves domain results.\n  const browserVersion = context.browser()?.version();\n  await context.close();\n  const cold: number[] = []; const warm: number[] = [];\n  const queries: { cold: Window['d1Queries']; warm: Window['d1Queries'] }[] = [];\n  for (let i = 0; i < 50; i++) {\n    const browser = await playwright[browserName].launchPersistentContext(profilePath, { headless: true, baseURL, offline: true, viewport: { width: 1440, height: 900 } });\n    try {\n      const trial = await browser.newPage();\n      await trial.addInitScript(() => {\n        window.d1Queries = {};\n        for (const method of ['openCursor', 'getAll', 'count']) {\n          const original = Reflect.get(IDBIndex.prototype, method) as (...args: unknown[]) => IDBRequest;\n          Reflect.set(IDBIndex.prototype, method, function (this: IDBIndex, ...args: unknown[]) {\n            const record = window.d1Queries[`${this.name}.${method}`] ??= { calls: 0, rows: 0 };\n            record.calls++;\n            const request = original.apply(this, args);\n            request.addEventListener('success', () => { const value = request.result as unknown; record.rows += Array.isArray(value) ? value.length : value instanceof IDBCursor ? 1 : 0; });\n            return request;\n          });\n        }\n      });\n      const started = performance.now();\n      await trial.goto('/');\n      await expect(trial.locator('ul li button')).toHaveCount(50);\n      cold.push(performance.now() - started);\n      const coldQueries = await trial.evaluate(() => { const observed = window.d1Queries; window.d1Queries = {}; return observed; });\n      const warmStarted = performance.now();\n      await trial.getByRole('button', { name: 'Trades', exact: true }).click();\n      await expect(trial.locator('ul li button')).toHaveCount(50);\n      warm.push(performance.now() - warmStarted);\n      const warmQueries = await trial.evaluate(() => window.d1Queries);\n      queries.push({ cold: coldQueries, warm: warmQueries });\n      expect(Object.values(warmQueries).reduce((sum, query) => sum + query.calls, 0)).toBeGreaterThan(0);\n      expect(Object.values(coldQueries).reduce((sum, query) => sum + query.rows, 0)).toBeLessThanOrEqual(100);\n      if (i === 49) { await trial.addScriptTag({ path: '.cache/browser-generator/generator.js' }); expect(await trial.evaluate(() => window.d1Evidence.inspect())).toEqual(before); }\n    } finally { await browser.close(); }\n    console.log(`D1 benchmark trial ${i + 1}: cold ${cold.at(-1)} ms; warm ${warm.at(-1)} ms`);\n  }\n  const p95 = (values: number[]) => [...values].sort((a, b) => a - b)[Math.ceil(values.length * .95) - 1] ?? Infinity;\n  const evidence = { dataset, before, afterPrivateDiscard, queries, browserName, browserVersion, environment: { platform: platform(), osRelease: release(), cpu: cpus()[0]?.model, memoryBytes: totalmem(), node: process.version }, source: '25,000 confirmPlan commands, native browser store; no executions or market observations', futureCapacityReserves: 'D1 plan budgets only; not fabricated domain records', cold, warm, percentile: 'nearest rank ceil(0.95*n)', coldP95: p95(cold), warmP95: p95(warm) };\n  await writeFile('implementation/evidence/bug-001/cumulative/d02/d01-cumulative-benchmark.json', JSON.stringify(evidence, null, 2));\n  expect(p95(cold)).toBeLessThanOrEqual(2500);\n  expect(p95(warm)).toBeLessThanOrEqual(1500);\n});\n","tests/benchmark/d02-scale.spec.ts":"import { cp, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';\nimport { tmpdir, platform, release, cpus, totalmem } from 'node:os';\nimport { join } from 'node:path';\nimport { test, expect } from '../browser/fixtures';\nimport { onboard, confirmPlan } from '../browser/helpers';\nconst p95 = (values: number[]) => [...values].sort((a, b) => a - b)[Math.ceil(values.length * .95) - 1] ?? Infinity;\ntest('D2-T07 25000 historical command-created Plans, native staged migration, 200 Open Trades and 50+50 offline trials', async ({ page, context, playwright, profilePath, baseURL }) => {\n  test.setTimeout(1800000);\n  const targetRelease = (JSON.parse(await readFile('dist/offline-inventory.json', 'utf8')) as { releaseId: string }).releaseId;\n  const backup = await mkdtemp(join(tmpdir(), 'd02-scale-dist-')); await cp('dist', backup, { recursive: true });\n  const heap: unknown[] = []; let sample: ReturnType<typeof setInterval> | undefined;\n  let source: { digest: string; count: number; membership: number; serializedBytes: number; root: unknown } | undefined;\n  try {\n    await rm('dist', { recursive: true, force: true }); await cp('.cache/d1-release', 'dist', { recursive: true });\n    await onboard(page); await confirmPlan(page);\n    await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n    expect(await page.evaluate(() => window.d2Evidence.releaseId)).toBe(targetRelease);\n    await page.addScriptTag({ path: '.cache/d1-release-source/.cache/browser-generator/generator.js' });\n    page.on('console', message => { if (message.text().startsWith('D1 command-created')) console.log(message.text()); });\n    const d1 = await page.evaluate(() => window.d1Evidence.generate(24999)); expect(d1.counts.plans).toBe(25000);\n    await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n    source = await page.evaluate(async () => {\n      const raw = await window.d2Evidence.oldD1Digest();\n      const rows = (raw.rows as { id: string; kind: string; tradeId: string; economicTime: string; saveTime: string; sequence: number; commitOrdinal: number; value: unknown }[]).sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : a.kind.localeCompare(b.kind)).map(({ id, kind, tradeId, economicTime, saveTime, sequence, commitOrdinal, value }) => ({ id, kind, tradeId, economicTime, saveTime, sequence, commitOrdinal, value }));\n      const membership = (raw.membership as { tradeId: string; lifecycle: string; accountId: string; symbol: string; economicTime: string; economicOrder: string; sequence: number; revision: string }[]).sort((a, b) => a.tradeId < b.tradeId ? -1 : a.tradeId > b.tradeId ? 1 : 0).map(({ tradeId, lifecycle, accountId, symbol, economicTime, economicOrder, sequence, revision }) => ({ tradeId, lifecycle, accountId, symbol, economicTime, economicOrder, sequence, revision }));\n      const bytes = new TextEncoder().encode(JSON.stringify({ rows, membership })); const digest = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), value => value.toString(16).padStart(2, '0')).join('');\n      return { digest, count: rows.length, membership: membership.length, serializedBytes: bytes.length, root: raw.root };\n    });\n    expect(source.count).toBe(50005); expect(source.membership).toBe(25000);\n    const cdp = await context.newCDPSession(page); await cdp.send('HeapProfiler.collectGarbage');\n    sample = setInterval(() => { void cdp.send('Runtime.getHeapUsage').then((value: unknown) => heap.push({ at: Date.now(), value })).catch(() => {}); }, 100);\n    await rm('dist', { recursive: true, force: true }); await cp(backup, 'dist', { recursive: true });\n    await page.getByRole('button', { name: 'Check for application updates' }).click(); await expect(page.getByRole('button', { name: 'Reload to update' })).toBeVisible({ timeout: 20000 });\n    const migrationStarted = performance.now();\n    await Promise.all([page.waitForEvent('load'), page.getByRole('button', { name: 'Reload to update' }).click()]);\n    await expect(page.locator('ul li button')).toHaveCount(50, { timeout: 180000 });\n    const migrationElapsedMs = performance.now() - migrationStarted;\n    clearInterval(sample); sample = undefined;\n    await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n    const migrated = await page.evaluate(() => window.d2Evidence.d1Digest()); expect(migrated.digest).toBe(source.digest); expect(migrated.root.schema).toBe(2);\n    await writeFile('implementation/evidence/bug-001/cumulative/d02/d02-migration-scale.json', JSON.stringify({ source, migrated, d1, migrationElapsedMs, heap }, null, 2));\n    await context.close();\n    const phases: Record<string, unknown> = {};\n    for (const phase of ['Planned', 'Open'] as const) {\n      if (phase === 'Open') {\n        const population = await playwright.chromium.launchPersistentContext(profilePath, { headless: true, baseURL });\n        try { const actor = await population.newPage(); await actor.goto('/'); await expect(actor.locator('ul li button')).toHaveCount(50); await actor.addScriptTag({ path: '.cache/browser-generator/generator.js' }); const opened = await actor.evaluate(() => window.d2Evidence.openDataset(200)); expect(opened.counts.Execution).toBe(400); expect(opened.counts.PositionChange).toBe(200); const before = await actor.evaluate(() => window.d2Evidence.inspectOpen()); expect(before.items).toHaveLength(200); expect(before.debt).toHaveLength(33); await actor.evaluate(() => window.d1Evidence.discardPrivateReceipts()); expect(await actor.evaluate(() => window.d2Evidence.inspectOpen())).toEqual(before); await writeFile('implementation/evidence/bug-001/cumulative/d02/d02-scale-population.json', JSON.stringify({ opened, before }, null, 2)); } finally { await population.close(); }\n      }\n      const cold: number[] = []; const warm: number[] = []; const storage: unknown[] = [];\n      for (let trial = 0; trial < 50; trial++) {\n        const browser = await playwright.chromium.launchPersistentContext(profilePath, { headless: true, baseURL, offline: true, viewport: { width: 1440, height: 900 } });\n        try {\n          const tab = await browser.newPage(); const start = performance.now(); await tab.goto('/'); await expect(tab.locator('ul li button')).toHaveCount(50); cold.push(performance.now() - start);\n          if (phase === 'Open') await tab.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n          const warmStart = performance.now(); await tab.getByRole('button', { name: phase === 'Open' ? 'Open' : 'Trades', exact: true }).click(); await expect(tab.locator('ul li button')).toHaveCount(50);\n          if (phase === 'Open') expect((await tab.evaluate(() => window.d2Evidence.inspectOpen())).items).toHaveLength(200);\n          warm.push(performance.now() - warmStart);\n          if (trial === 0 || trial === 49) storage.push(await tab.evaluate(() => navigator.storage.estimate()));\n        } finally { await browser.close(); }\n        console.log(`D2 ${phase} trial ${trial + 1}: cold ${cold.at(-1)} ms warm ${warm.at(-1)} ms`);\n      }\n      phases[phase] = { cold, warm, storage, coldP95: p95(cold), warmP95: p95(warm) };\n      await writeFile(`implementation/evidence/bug-001/cumulative/d02/d02-${phase.toLowerCase()}-scale-trials.json`, JSON.stringify(phases[phase], null, 2));\n      expect(p95(cold)).toBeLessThanOrEqual(2500); expect(p95(warm)).toBeLessThanOrEqual(1500);\n    }\n    await writeFile('implementation/evidence/bug-001/cumulative/d02/d02-benchmark.json', JSON.stringify({ source, migrated, d1, migrationElapsedMs, heap, phases, profilePath, environment: { platform: platform(), os: release(), cpu: cpus()[0]?.model, memory: totalmem(), node: process.version }, provenance: 'Historical D1 commands under original release; normal verified D2 update; native generation migration; current D2 opening commands; stopped isolated Chromium and offline launches; nearest-rank percentiles. Open warm includes UI first page plus exhaustive 200-Trade public read.' }, null, 2));\n  } finally { if (sample) clearInterval(sample); await rm('dist', { recursive: true, force: true }); await cp(backup, 'dist', { recursive: true }); }\n});\n","tests/browser/d01-offline.spec.ts":"import { test, expect } from './fixtures';\nimport { onboard, confirmPlan } from './helpers';\ntest('D1-B01 D1-T09 stopped-browser offline reopening retains the Plan and history', async ({ page, context, playwright, browserName, profilePath, baseURL }) => {\n  await onboard(page); await confirmPlan(page);\n  await page.getByText('View history', { exact: true }).click();\n  const fact = await page.getByText(/^Plan fact:/).textContent();\n  await context.close();\n  const reopened = await playwright[browserName].launchPersistentContext(profilePath, { headless: true, baseURL, offline: true, viewport: { width: 390, height: 844 } });\n  try {\n    const offline = await reopened.newPage();\n    await offline.goto('/');\n    await expect(offline.getByRole('button', { name: /XYZ · Planned/ })).toBeVisible();\n    await offline.getByRole('button', { name: /XYZ · Planned/ }).click();\n    await offline.getByText('View history', { exact: true }).click();\n    await expect(offline.getByText(fact ?? 'Missing fact')).toBeVisible();\n    await expect(offline.getByText('Improving earnings', { exact: true })).toBeVisible();\n    expect(await offline.evaluate(() => isSecureContext)).toBe(true);\n  } finally { await reopened.close(); }\n});\n","tests/browser/d01-readiness.spec.ts":"import { test, expect } from './fixtures';\nimport { requireWritable, onboard, confirmPlan, fillPlan } from './helpers';\nfor (const failures of [['transaction'], ['capacity'], ['control'], ['inventory'], ['capacity', 'inventory']]) {\n  test(`D1-B03 D1-I03 fresh native readiness failures ${failures.join('+')}`, async ({ page }) => {\n    await requireWritable(page);\n    await page.addInitScript(modes => {\n      if (modes.includes('transaction')) {\n        const original = Object.getOwnPropertyDescriptor(IDBDatabase.prototype, 'transaction')?.value as IDBDatabase['transaction'];\n        Object.defineProperty(IDBDatabase.prototype, 'transaction', { value: function (this: IDBDatabase, names: string | string[], mode?: IDBTransactionMode, options?: IDBTransactionOptions) {\n          if ((typeof names === 'string' ? [names] : names).length === 1 && (typeof names === 'string' ? names : names[0]) === 'diagnostic') throw new DOMException('Injected quota fault', 'QuotaExceededError');\n          return original.call(this, names, mode, options);\n        } });\n      }\n      if (modes.includes('capacity')) {\n        const original = navigator.storage.estimate.bind(navigator.storage);\n        Object.defineProperty(StorageManager.prototype, 'estimate', { value: async () => ({ ...await original(), quota: 0 }) });\n      }\n      if (modes.includes('control')) Object.defineProperty(ServiceWorkerContainer.prototype, 'controller', { get: () => null });\n\n    }, failures);\n    if (failures.includes('inventory')) await page.evaluate(async () => {\n      const name = (await caches.keys()).find(name => name.startsWith('trade-journal-release-'));\n      if (!name) throw new Error('Installed cache required');\n      const cache = await caches.open(name); await cache.delete('/icon.svg');\n    });\n    await page.reload();\n    await expect(page.getByRole('heading', { name: 'Unsupported', exact: true })).toBeVisible({ timeout: 12000 });\n    for (const failure of failures) await expect(page.locator(`[data-issue=${failure}]`)).toBeVisible();\n    if (failures.length === 1) await expect(page.locator('main li')).toHaveCount(1);\n    const root = await page.evaluate(() => new Promise<unknown>((resolve, reject) => {\n      const request = indexedDB.open('trade-journal-v3');\n      request.onerror = () => reject(request.error ?? new Error('IndexedDB open failed'));\n      request.onsuccess = () => { const db = request.result; const read = db.transaction('roots').objectStore('roots').get('active'); read.onsuccess = () => { resolve(read.result); db.close(); }; read.onerror = () => reject(read.error ?? new Error('IndexedDB read failed')); };\n    }));\n    expect(root).toBeUndefined();\n  });\n}\ntest('D1-B03 D1-I03 native cache failure preserves Recovery Only reads and rejects next mutation', async ({ page }) => {\n  await onboard(page); await confirmPlan(page);\n  await fillPlan(page);\n  const before = await page.evaluate(() => new Promise<unknown>(resolve => {\n    const request = indexedDB.open('trade-journal-v3'); request.onsuccess = () => { const db = request.result; const read = db.transaction('roots').objectStore('roots').get('active'); read.onsuccess = () => { resolve(read.result); db.close(); }; };\n  }));\n  await page.evaluate(async () => {\n    const name = (await caches.keys()).find(name => name.startsWith('trade-journal-release-'));\n    if (!name) throw new Error('Installed cache required');\n    const cache = await caches.open(name); await cache.put('/icon.svg', new Response('corrupt asset'));\n  });\n  await page.getByRole('button', { name: 'Confirm Plan' }).click();\n  await expect(page.getByText('Recovery Only', { exact: true })).toBeVisible();\n  await expect(page.getByRole('button', { name: 'New Plan' })).toBeDisabled();\n  await page.getByRole('button', { name: 'Trades', exact: true }).click();\n  await page.getByRole('button', { name: /XYZ · Planned/ }).click();\n  await expect(page.getByText('View history', { exact: true })).toBeVisible();\n  const after = await page.evaluate(() => new Promise<unknown>(resolve => {\n    const request = indexedDB.open('trade-journal-v3'); request.onsuccess = () => { const db = request.result; const read = db.transaction('roots').objectStore('roots').get('active'); read.onsuccess = () => { resolve(read.result); db.close(); }; };\n  }));\n  expect(after).toEqual(before);\n});\ntest('D1-B03 unreadable existing storage is Integrity Blocked and never replaced', async ({ page, context, playwright, browserName, profilePath, baseURL }) => {\n  await onboard(page); await confirmPlan(page);\n  await page.getByText('View history', { exact: true }).click();\n  const fact = await page.getByText(/^Plan fact:/).textContent();\n  await page.addInitScript(() => { Object.defineProperty(IDBFactory.prototype, 'open', { value: () => { throw new DOMException('Injected unreadable existing storage', 'UnknownError'); } }); });\n  await page.reload();\n  await expect(page.getByRole('heading', { name: 'IntegrityBlocked', exact: true })).toBeVisible();\n  await expect(page.locator('[data-issue=UnreadableRoot]')).toBeVisible();\n  await expect(page.getByRole('button', { name: 'Create Workspace' })).toHaveCount(0);\n  await context.close();\n  const reopened = await playwright[browserName].launchPersistentContext(profilePath, { headless: true, baseURL });\n  try {\n    const recovered = await reopened.newPage(); await recovered.goto('/');\n    await recovered.getByRole('button', { name: /XYZ · Planned/ }).click();\n    await recovered.getByText('View history', { exact: true }).click();\n    await expect(recovered.getByText(fact ?? 'Missing retained fact')).toBeVisible();\n  } finally { await reopened.close(); }\n});\n","tests/browser/d01-release.spec.ts":"import { test, expect } from './fixtures';\ntest('D1-T09 withholds Writable until a complete verified release controls the page', async ({ page }) => {\n  await page.goto('/');\n  console.log('native host evidence', await page.evaluate(async () => ({ secure: isSecureContext, storage: await navigator.storage.estimate(), controller: navigator.serviceWorker.controller?.scriptURL, caches: await caches.keys() })));\n  await expect(page.getByLabel('Workspace time zone')).toBeVisible();\n  expect(await page.evaluate(() => isSecureContext)).toBe(true);\n  const manifest = await page.request.get('/manifest.webmanifest');\n  const identity = await manifest.json() as { display: string; icons: { src: string; sizes: string; type: string }[] };\n  expect(identity.display).toBe('standalone');\n  expect(identity.icons).toEqual(expect.arrayContaining([{ src: '/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' }, { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' }]));\n  expect(await page.evaluate(() => navigator.serviceWorker.controller?.scriptURL)).toContain('/sw.js');\n});\n","tests/browser/d01-resources.spec.ts":"import { test, expect } from './fixtures';\nimport { onboard, confirmPlan } from './helpers';\ntest('D1-T03 native resource receipt accounts for stored bytes and complete cache growth', async ({ page }) => {\n  await onboard(page); await confirmPlan(page);\n  await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n  const result = await page.evaluate(() => window.d1Evidence.measure());\n  expect(result).toMatchObject({ status: 'Writable', capacityEvidence: { method: 'SerializedActiveLowerBound' } });\n  const evidence = Reflect.get(result, 'capacityEvidence') as { M: number; L: number; C: number; Q: number; H: number; quota: number; usage: number } | undefined;\n  if (!evidence) throw new Error('Native capacity evidence required');\n  const { M, L, C, Q, H, quota, usage } = evidence;\n  expect(M).toBe(553648128); expect(L).toBeGreaterThan(1000); expect(C).toBeGreaterThan(500000);\n  expect(Q).toBe(quota - usage);\n  expect(H).toBe((Math.max(0, M - L) + C) * 1.25);\n  expect(Q).toBeGreaterThanOrEqual(H);\n  const before = await page.evaluate(() => window.d1Evidence.inspect());\n  await page.evaluate(() => window.d1Evidence.discardPrivateReceipts());\n  expect(await page.evaluate(() => window.d1Evidence.inspect())).toEqual(before);\n  console.log('Native resource receipt', evidence);\n});\n","tests/browser/d01-ui.spec.ts":"import AxeBuilder from '@axe-core/playwright';\nimport type { Locator, Page } from '@playwright/test';\nimport { test, expect } from './fixtures';\nimport { onboard, fillPlan, requireWritable } from './helpers';\nasync function tabTo(page: Page, target: Locator) {\n  await expect(target).toBeVisible();\n  await expect(target).toBeEnabled();\n  for (let i = 0; i < 50; i++) {\n    if (await target.evaluate(element => element === document.activeElement)) return;\n    // Traverse toward the target rather than relying on browser-chrome wrapping.\n    // Firefox leaves the last page control focused when Tab enters browser chrome.\n    const backwards = await target.evaluate(element => Boolean(document.activeElement && document.activeElement !== document.body && (element.compareDocumentPosition(document.activeElement) & Node.DOCUMENT_POSITION_FOLLOWING)));\n    const key = backwards ? 'Shift+Tab' : 'Tab';\n    // Option-Tab includes every native control under macOS's text-only preference.\n    await page.keyboard.press(page.context().browser()?.browserType().name() === 'webkit' ? `Alt+${key}` : key);\n  }\n  throw new Error('Control not reachable through the keyboard');\n}\ntest('D1-B02 invalid input, catalog conflict and Cancel preserve input and write no Plan', async ({ page, context }) => {\n  await onboard(page); await fillPlan(page);\n  await page.getByLabel('Stop (underlying price, USD)').fill('50');\n  await page.getByRole('button', { name: 'Confirm Plan' }).click();\n  await expect(page.getByRole('alert')).toContainText('Stop must be below intended entry so Planned risk is positive.');\n  await page.getByLabel('Stop (underlying price, USD)').fill('45');\n  const other = await context.newPage(); await other.goto('/');\n  await other.getByRole('button', { name: 'Workspace', exact: true }).click();\n  await other.getByLabel('Institution name').fill('Second brokerage');\n  await other.getByRole('button', { name: 'Add Institution' }).click();\n  await expect(other.getByLabel('Institution name')).toHaveValue('');\n  await other.close();\n  await page.getByRole('button', { name: 'Confirm Plan' }).click();\n  await expect(page.getByRole('alert')).toContainText('Brokerage records changed in another tab.');\n  await expect(page.getByLabel('Stock symbol')).toHaveValue('XYZ');\n  await page.getByRole('button', { name: 'Review current references' }).click();\n  await page.getByRole('button', { name: 'Cancel', exact: true }).click();\n  await page.getByRole('button', { name: 'Trades', exact: true }).click();\n  await expect(page.getByText('No confirmed Plans match this view.')).toBeVisible();\n  await expect(page.getByRole('button', { name: /Execution|Backup|Restore|Report/ })).toHaveCount(0);\n});\ntest('D1-B02 native transaction abort preserves every participant and entered Plan', async ({ page, context, playwright, browserName, profilePath, baseURL }) => {\n  await onboard(page);\n  const snapshot = () => page.evaluate(() => new Promise<unknown>((resolve, reject) => {\n    const request = indexedDB.open('trade-journal-v3');\n    request.onerror = () => reject(request.error ?? new Error('Open failed'));\n    request.onsuccess = () => {\n      const db = request.result; const transaction = db.transaction(['roots', 'versions', 'lifecycle']);\n      const root = transaction.objectStore('roots').getAll(); const versions = transaction.objectStore('versions').getAll(); const lifecycle = transaction.objectStore('lifecycle').getAll();\n      transaction.oncomplete = () => { resolve({ roots: root.result, versions: versions.result, lifecycle: lifecycle.result }); db.close(); };\n      transaction.onerror = () => reject(transaction.error ?? new Error('Read failed'));\n    };\n  }));\n  const before = await snapshot();\n  await page.addInitScript(() => {\n    const original = Object.getOwnPropertyDescriptor(IDBObjectStore.prototype, 'add')?.value as IDBObjectStore['add'];\n    IDBObjectStore.prototype.add = function (value: unknown, key?: IDBValidKey) {\n      if (this.name === 'versions' && typeof value === 'object' && value !== null && 'kind' in value && value.kind === 'JournalEntry') this.transaction.abort();\n      return original.call(this, value, key);\n    };\n  });\n  await page.reload(); await fillPlan(page);\n  await page.getByRole('button', { name: 'Confirm Plan' }).click();\n  await expect(page.getByRole('alert')).toContainText('Saving failed. Nothing was recorded.');\n  await expect(page.getByLabel('Stock symbol')).toHaveValue('XYZ');\n  await expect(page.getByText('Recovery Only', { exact: true })).toBeVisible();\n  await expect(page.getByRole('button', { name: 'Confirm Plan' })).toBeDisabled();\n  expect(await snapshot()).toEqual(before);\n  await context.close();\n  const reopened = await playwright[browserName].launchPersistentContext(profilePath, { headless: true, baseURL });\n  try {\n    const recovered = await reopened.newPage(); await recovered.goto('/');\n    await expect(recovered.getByText('No confirmed Plans match this view.')).toBeVisible();\n    await fillPlan(recovered); await recovered.getByRole('button', { name: 'Confirm Plan' }).click();\n    await expect(recovered.getByRole('heading', { name: 'XYZ · Planned' })).toBeVisible();\n  } finally { await reopened.close(); }\n});\nfor (const width of [390, 1440]) {\n  test(`D1-B05 keyboard-only onboarding and Plan, live resize, zoom and axe at ${width}px`, async ({ page }, testInfo) => {\n    await page.setViewportSize({ width, height: 900 });\n    await requireWritable(page);\n    await page.evaluate(() => { document.documentElement.style.zoom = '2'; });\n    expect(await page.getByRole('heading').evaluate(heading => heading.scrollWidth <= heading.clientWidth)).toBe(true);\n    await page.evaluate(() => { document.documentElement.style.zoom = ''; });\n    await tabTo(page, page.getByLabel('Workspace time zone')); await page.keyboard.type('America/New_York');\n    await tabTo(page, page.getByRole('button', { name: 'Create Workspace' })); await page.keyboard.press('Enter');\n    await expect(page.getByLabel('Institution name')).toBeVisible();\n    await tabTo(page, page.getByLabel('Institution name')); await page.keyboard.type('Fidelity');\n    await tabTo(page, page.getByRole('button', { name: 'Add Institution' })); await page.keyboard.press('Enter');\n    await expect(page.getByLabel('New Account name')).toBeVisible();\n    await tabTo(page, page.getByLabel('New Account name')); await page.keyboard.type('Taxable');\n    await tabTo(page, page.getByRole('button', { name: 'Add Account' })); await page.keyboard.press('Enter');\n    await tabTo(page, page.getByRole('button', { name: 'New Plan' })); await page.keyboard.press('Enter');\n    await tabTo(page, page.getByRole('button', { name: 'Next: Plan and reflection' })); await page.keyboard.press('Enter');\n    for (const [label, value] of [['Stock symbol', 'XYZ'], ['Quantity (shares)', '100'], ['Intended entry (USD)', '50'], ['Stop (underlying price, USD)', '45'], ['Target (underlying price, USD)', '60'], ['Why this trade, why now?', 'Improving earnings'], ['What would invalidate the thesis?', 'Thesis fails']]) { await tabTo(page, page.getByLabel(label)); await page.keyboard.type(value); }\n    for (const liveWidth of [767, 768, width]) {\n      await page.setViewportSize({ width: liveWidth, height: 900 });\n      await expect(page.getByLabel('Stock symbol')).toHaveValue('XYZ');\n      expect(await page.getByRole('navigation').evaluate(element => getComputedStyle(element).position)).toBe(liveWidth < 1024 ? 'fixed' : 'static');\n    }\n    await page.evaluate(() => { document.documentElement.style.zoom = '2'; });\n    expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n    for (const action of await page.getByRole('navigation').getByRole('button').all()) {\n      const bounds = await action.boundingBox();\n      expect(bounds).not.toBeNull();\n      if (!bounds) throw new Error('Navigation action must be rendered');\n      expect(bounds.x).toBeGreaterThanOrEqual(0);\n      expect(bounds.x + bounds.width).toBeLessThanOrEqual(width);\n      if (width < 1024) {\n        expect(bounds.y).toBeGreaterThanOrEqual(0);\n        expect(bounds.y + bounds.height).toBeLessThanOrEqual(900);\n      }\n      expect(await action.evaluate(button => button.scrollWidth <= button.clientWidth)).toBe(true);\n    }\n    await page.screenshot({ path: testInfo.outputPath(`D1-zoom-${width}.png`), fullPage: true });\n    await page.evaluate(() => { document.documentElement.style.zoom = ''; });\n    const accessibility = await new AxeBuilder({ page }).withTags(['wcag2a', 'wcag2aa', 'wcag21aa']).analyze();\n    expect(accessibility.violations).toEqual([]);\n    await tabTo(page, page.getByRole('button', { name: 'Confirm Plan' })); await page.keyboard.press('Enter');\n    await expect(page.getByRole('heading', { name: 'XYZ · Planned' })).toBeVisible();\n    await tabTo(page, page.getByText('View history', { exact: true })); await page.keyboard.press('Enter');\n    await expect(page.getByText(/^Plan fact:/)).toBeVisible();\n    await page.screenshot({ path: testInfo.outputPath(`D1-detail-${width}.png`), fullPage: true });\n  });\n}\ntest('D1-B01 explains missing or invalid time zones and creates the Workspace after correction', async ({ page }) => {\n  await requireWritable(page);\n  for (const zone of ['', 'Invalid/Zone', '-05:00']) {\n    await page.getByLabel('Workspace time zone').fill(zone);\n    await page.getByRole('button', { name: 'Create Workspace' }).click();\n    await expect(page.getByRole('alert')).toContainText('Enter a rules-based time zone, such as America/New_York.');\n    await expect(page.getByLabel('Workspace time zone')).toHaveValue(zone);\n    await expect(page.getByLabel('Workspace time zone')).toHaveAttribute('aria-invalid', 'true');\n    await expect(page.getByRole('heading', { name: 'Choose your time zone' })).toBeFocused();\n    expect((await new AxeBuilder({ page }).withTags(['wcag2a', 'wcag2aa', 'wcag21aa']).analyze()).violations).toEqual([]);\n  }\n  await page.getByLabel('Workspace time zone').fill('America/New_York');\n  await page.getByRole('button', { name: 'Create Workspace' }).click();\n  await expect(page.getByRole('heading', { name: 'Add your brokerage records' })).toBeVisible();\n  await expect(page.getByText('Time zone: America/New_York')).toBeVisible();\n});\ntest('D1-B01 Add Account clearly creates a second Account at the same Institution', async ({ page }) => {\n  await onboard(page);\n  await page.getByRole('button', { name: 'Workspace', exact: true }).click();\n  await expect(page.getByRole('heading', { name: 'Add Account', exact: true })).toBeVisible();\n  await expect(page.getByText('Create a separate Account under the selected Institution.')).toBeVisible();\n  await expect(page.getByLabel('New Account name')).toHaveValue('');\n  await page.getByLabel('New Account name').fill('Retirement');\n  await page.getByRole('button', { name: 'Add Account', exact: true }).click();\n  await expect(page.getByRole('heading', { name: 'Trades', exact: true })).toBeVisible();\n  await page.reload(); await fillPlan(page);\n  const accounts = page.getByRole('combobox', { name: /^Account/ });\n  await expect(accounts.getByRole('option')).toHaveText(['Retirement · Fidelity', 'Taxable · Fidelity']);\n  await accounts.selectOption({ label: 'Retirement · Fidelity' });\n  await page.getByRole('button', { name: 'Confirm Plan' }).click();\n  await expect(page.getByRole('heading', { name: 'XYZ · Planned' })).toBeVisible();\n  await expect(page.getByText(/Fidelity.*Retirement.*Long Stock/)).toBeVisible();\n});\n","tests/browser/d01-update.spec.ts":"import { cp, mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { test, expect } from './fixtures';\nimport { onboard, fillPlan } from './helpers';\ntest('D1-B04 D1-T09 stages a verified update and defers activation through an unsaved form', async ({ page }) => {\n  await onboard(page); await fillPlan(page);\n  await expect(page.getByRole('button', { name: 'Check for application updates' })).toBeVisible();\n  const before = await page.evaluate(async () => {\n    const channel = new MessageChannel();\n    return new Promise<string>(resolve => { channel.port1.onmessage = (event: MessageEvent<{ release: string }>) => resolve(event.data.release); navigator.serviceWorker.controller?.postMessage('VERIFY_RELEASE', [channel.port2]); });\n  });\n  const backup = await mkdtemp(join(tmpdir(), 'trade-journal-d1-dist-'));\n  await cp('dist', backup, { recursive: true });\n  try {\n    await cp('.cache/update-dist', 'dist', { recursive: true });\n    await page.getByRole('button', { name: 'Check for application updates' }).click();\n    await expect(page.getByText('Update available', { exact: true })).toBeVisible({ timeout: 15000 });\n    await expect(page.getByText(/Update deferred while this form has unsaved values/)).toBeVisible();\n    await expect(page.getByRole('button', { name: 'Reload to update' })).toBeDisabled();\n    await expect(page.getByLabel('Stock symbol')).toHaveValue('XYZ');\n    const active = await page.evaluate(async () => {\n      const channel = new MessageChannel();\n      return new Promise<string>(resolve => { channel.port1.onmessage = (event: MessageEvent<{ release: string }>) => resolve(event.data.release); navigator.serviceWorker.controller?.postMessage('VERIFY_RELEASE', [channel.port2]); });\n    });\n    expect(active).toBe(before);\n    await page.getByRole('button', { name: 'Cancel', exact: true }).click();\n    await Promise.all([page.waitForEvent('load'), page.getByRole('button', { name: 'Reload to update' }).click()]);\n    await expect(page.getByRole('heading', { name: 'Trades', exact: true })).toBeVisible();\n    const after = await page.evaluate(async () => {\n      const channel = new MessageChannel();\n      return new Promise<string>(resolve => { channel.port1.onmessage = (event: MessageEvent<{ release: string }>) => resolve(event.data.release); navigator.serviceWorker.controller?.postMessage('VERIFY_RELEASE', [channel.port2]); });\n    });\n    expect(after).not.toBe(before);\n    await page.context().setOffline(true); await page.reload();\n    await expect(page.getByRole('heading', { name: 'Trades', exact: true })).toBeVisible();\n  } finally { await rm('dist', { recursive: true, force: true }); await cp(backup, 'dist', { recursive: true }); }\n});\ntest('D1-B04 D1-T09 failed new-asset staging preserves the old offline release and unsaved input', async ({ page }) => {\n  await onboard(page); await fillPlan(page);\n  const before = await page.evaluate(async () => {\n    const channel = new MessageChannel();\n    return new Promise<string>(resolve => { channel.port1.onmessage = (event: MessageEvent<{ release: string }>) => resolve(event.data.release); navigator.serviceWorker.controller?.postMessage('VERIFY_RELEASE', [channel.port2]); });\n  });\n  const backup = await mkdtemp(join(tmpdir(), 'trade-journal-d1-dist-'));\n  await cp('dist', backup, { recursive: true });\n  try {\n    await cp('.cache/update-dist', 'dist', { recursive: true });\n    const { writeFile } = await import('node:fs/promises');\n    // Infrastructure fault: served bytes disagree with the real new release inventory.\n    await writeFile('dist/icon.svg', 'corrupt release asset');\n    const failedInstall = page.evaluate(async () => {\n      const registration = await navigator.serviceWorker.getRegistration();\n      if (!registration) throw new Error('Registration required');\n      return new Promise<string>(resolve => registration.addEventListener('updatefound', () => {\n        const worker = registration.installing;\n        worker?.addEventListener('statechange', () => { if (worker.state === 'redundant') resolve(worker.state); });\n      }, { once: true }));\n    });\n    await page.getByRole('button', { name: 'Check for application updates' }).click();\n    expect(await failedInstall).toBe('redundant');\n    await expect(page.getByText('Update available', { exact: true })).toHaveCount(0);\n    await expect(page.getByLabel('Stock symbol')).toHaveValue('XYZ');\n    const after = await page.evaluate(async () => {\n      const channel = new MessageChannel();\n      return new Promise<string>(resolve => { channel.port1.onmessage = (event: MessageEvent<{ release: string }>) => resolve(event.data.release); navigator.serviceWorker.controller?.postMessage('VERIFY_RELEASE', [channel.port2]); });\n    });\n    expect(after).toBe(before);\n    await page.context().setOffline(true); await page.reload();\n    await expect(page.getByRole('heading', { name: 'Trades', exact: true })).toBeVisible();\n  } finally { await rm('dist', { recursive: true, force: true }); await cp(backup, 'dist', { recursive: true }); }\n});\ntest('D1-B04 one tab cannot activate an update over another tab with an unsaved Plan', async ({ page, context }) => {\n  await onboard(page);\n  const other = await context.newPage(); await other.goto('/'); await fillPlan(other);\n  const before = await other.evaluate(() => navigator.serviceWorker.controller?.scriptURL);\n  const backup = await mkdtemp(join(tmpdir(), 'trade-journal-d1-dist-'));\n  await cp('dist', backup, { recursive: true });\n  try {\n    await cp('.cache/update-dist', 'dist', { recursive: true });\n    await page.getByRole('button', { name: 'Check for application updates' }).click();\n    await expect(page.getByText('Update available', { exact: true })).toBeVisible({ timeout: 15000 });\n    await page.getByRole('button', { name: 'Reload to update' }).click();\n    await expect(page.getByText('Close other Trade Journal tabs before reloading to update.')).toBeVisible();\n    await expect(other.getByLabel('Stock symbol')).toHaveValue('XYZ');\n    expect(await other.evaluate(() => navigator.serviceWorker.controller?.scriptURL)).toBe(before);\n    await other.getByRole('button', { name: 'Confirm Plan' }).click();\n    await expect(other.getByRole('heading', { name: 'XYZ · Planned' })).toBeVisible();\n  } finally { await other.close(); await rm('dist', { recursive: true, force: true }); await cp(backup, 'dist', { recursive: true }); }\n});\n","tests/browser/d02-helpers.ts":"import type { Page } from '@playwright/test';\nexport async function fillOpening(page: Page, disposition: 'Complete' | 'Defer' | 'Decline' = 'Complete') {\n  await page.getByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }).click();\n  await page.getByLabel('Execution 1 quantity (shares)').fill('40'); await page.getByLabel('Execution 1 price (USD)').fill('49'); await page.getByLabel('Execution 1 fee (USD)').fill('1');\n  await page.getByRole('button', { name: 'Add another execution' }).click();\n  await page.getByLabel('Execution 2 quantity (shares)').fill('60'); await page.getByLabel('Execution 2 price (USD)').fill('51'); await page.getByLabel('Execution 2 fee (USD)').fill('2');\n  if (disposition === 'Complete') { await page.getByLabel('Complete reflection now').check(); await page.getByLabel('As Planned', { exact: true }).check(); await page.getByLabel('Calm', { exact: true }).check(); await page.getByLabel('Decision confidence').selectOption('4'); }\n  if (disposition === 'Decline') await page.getByLabel('Decline reflection', { exact: true }).check();\n}\nexport async function authority(page: Page) {\n  return page.evaluate(() => new Promise<unknown>((resolve, reject) => {\n    const request = indexedDB.open('trade-journal-v3'); request.onerror = () => reject(request.error ?? new Error('Native authority read failed'));\n    request.onsuccess = () => { const db = request.result; const tx = db.transaction(['roots', 'versions', 'lifecycle']); const roots = tx.objectStore('roots').getAll(); const versions = tx.objectStore('versions').getAll(); const lifecycle = tx.objectStore('lifecycle').getAll(); tx.oncomplete = () => { resolve({ roots: roots.result, versions: versions.result, lifecycle: lifecycle.result }); db.close(); }; };\n  }));\n}\n","tests/browser/d02-migration.spec.ts":"import { mkdir, writeFile } from 'node:fs/promises';\nimport { test, expect } from './fixtures';\nimport { requireWritable } from './helpers';\nimport type { Root, Envelope, LifecycleRow } from '../../src/infrastructure/storage';\nimport type { TradeSnapshot } from '../../src/domain/trade-record';\ndeclare global { interface Window { d2Legacy: { createAt(name: string): Promise<{ root: Root; confirmed: { trade: TradeSnapshot }; versions: Envelope[]; lifecycle: LifecycleRow[] }> }; d2MigrationBlocker?: IDBDatabase; d2MigrationFault?: string } }\nasync function setup(page: import('@playwright/test').Page, name: string) {\n  await requireWritable(page); await page.addScriptTag({ path: '.cache/d2-legacy-native/legacy.js' }); await page.addScriptTag({ path: '.cache/browser-generator/generator.js' });\n  return page.evaluate(name => window.d2Legacy.createAt(name), name);\n}\nfor (const mode of ['candidate-seed', 'candidate-validation', 'activation-abort'] as const) test(`D2-I03 native ${mode} preserves source and activates only a complete retry`, async ({ page, browserName, context }) => {\n  const name = `d2-legacy-${crypto.randomUUID()}`; const before = await setup(page, name);\n  await page.evaluate(mode => {\n    window.d2MigrationFault = mode;\n    const add: IDBObjectStore['add'] = Reflect.get(IDBObjectStore.prototype, 'add');\n    IDBObjectStore.prototype.add = function (value: unknown, key?: IDBValidKey) { if (window.d2MigrationFault === 'candidate-seed' && value && typeof value === 'object' && 'id' in value && value.id === 'position-change-reflection') throw new DOMException('Injected candidate-seed failure', 'QuotaExceededError'); if (window.d2MigrationFault === 'candidate-validation' && value && typeof value === 'object' && 'kind' in value && value.kind === 'Plan') { const row = value as Envelope; const trade = row.value as TradeSnapshot; return add.call(this, { ...row, value: { ...trade, plan: { ...trade.plan, quantity: '99' } } }, key); } return add.call(this, value, key); };\n    const put: IDBObjectStore['put'] = Reflect.get(IDBObjectStore.prototype, 'put');\n    IDBObjectStore.prototype.put = function (value: unknown, key?: IDBValidKey) { if (window.d2MigrationFault === 'activation-abort' && this.name === 'roots' && value && typeof value === 'object' && 'schema' in value && value.schema === 2) this.transaction.abort(); return put.call(this, value, key); };\n  }, mode);\n  const failed = await page.evaluate(name => window.d2Evidence.migrateDatabase(name), name); expect(failed).toMatchObject({ status: 'MigrationBlocked', unchangedRevision: before.root.revision });\n  const afterFailure = await page.evaluate(name => new Promise<{ root: unknown; versions: unknown[]; lifecycle: unknown[] }>((resolve, reject) => { const request = indexedDB.open(name); request.onerror = () => reject(request.error ?? new Error('Source read failed')); request.onsuccess = () => { const db = request.result; const tx = db.transaction(['roots', 'versions', 'lifecycle']); const root = tx.objectStore('roots').get('active'); const versions = tx.objectStore('versions').getAll(); const lifecycle = tx.objectStore('lifecycle').getAll(); tx.oncomplete = () => { resolve({ root: root.result as unknown, versions: versions.result as unknown[], lifecycle: lifecycle.result as unknown[] }); db.close(); }; }; }), name);\n  expect(afterFailure.root).toEqual(before.root);\n  expect((afterFailure.versions as Envelope[]).filter(row => row.generation === before.root.generation)).toEqual(before.versions);\n  expect((afterFailure.lifecycle as LifecycleRow[]).filter(row => row.generation === before.root.generation)).toEqual(before.lifecycle);\n  await page.evaluate(() => { window.d2MigrationFault = ''; });\n  const retry = await page.evaluate(name => window.d2Evidence.migrateDatabase(name), name); expect(retry).toMatchObject({ status: 'Opened', root: { schema: 2 }, receipt: { migration: { sourceRows: 7, candidateRows: 9 } } });\n  await mkdir('implementation/evidence/bug-001/cumulative/d02/native', { recursive: true }); await writeFile(`implementation/evidence/bug-001/cumulative/d02/native/${browserName}-migration-${mode}.json`, JSON.stringify({ browser: context.browser()?.version(), before, failed, afterFailure, retry }, null, 2));\n});\ntest('D2-I03 native blocked physical upgrade rejects safely and retries after old connection closes', async ({ page, browserName, context }) => {\n  const name = `d2-blocked-${crypto.randomUUID()}`; const before = await setup(page, name);\n  await page.evaluate(name => new Promise<void>((resolve, reject) => { const request = indexedDB.open(name); request.onerror = () => reject(request.error ?? new Error('Old connection failed')); request.onsuccess = () => { window.d2MigrationBlocker = request.result; window.d2MigrationBlocker.onversionchange = () => {}; resolve(); }; }), name);\n  const failed = await page.evaluate(name => window.d2Evidence.migrateDatabase(name), name); expect(failed).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked' });\n  const retained = await page.evaluate(() => new Promise<unknown>((resolve, reject) => { const db = window.d2MigrationBlocker; if (!db) { reject(new Error('Held connection missing')); return; } const tx = db.transaction('roots'); const read = tx.objectStore('roots').get('active'); tx.oncomplete = () => resolve(read.result as unknown); })); expect(retained).toEqual(before.root);\n  await page.evaluate(() => { window.d2MigrationBlocker?.close(); delete window.d2MigrationBlocker; });\n  const retry = await page.evaluate(name => window.d2Evidence.migrateDatabase(name), name); expect(retry).toMatchObject({ status: 'Opened', root: { schema: 2 } });\n  await mkdir('implementation/evidence/bug-001/cumulative/d02/native', { recursive: true }); await writeFile(`implementation/evidence/bug-001/cumulative/d02/native/${browserName}-migration-blocked.json`, JSON.stringify({ browser: context.browser()?.version(), before, failed, retained, retry }, null, 2));\n});\n","tests/browser/d02-opening.spec.ts":"import AxeBuilder from '@axe-core/playwright';\nimport { writeFile, mkdir } from 'node:fs/promises';\nimport { fillOpening, authority } from './d02-helpers';\nimport { test, expect } from './fixtures';\nimport { onboard, confirmPlan } from './helpers';\ndeclare global { interface Window { d2Trace: { at: number; event: string; transaction: number; mode?: string; stores?: string[]; kind?: string }[] } }\ntest('D2-B01 complete two-Execution opening, native commit trace and fully stopped offline reopen', async ({ page, context, playwright, browserName, profilePath, baseURL }) => {\n  await page.addInitScript(() => {\n    window.d2Trace = []; let ordinal = 0; const ids = new WeakMap<IDBTransaction, number>();\n    const original: IDBDatabase['transaction'] = Reflect.get(IDBDatabase.prototype, 'transaction');\n    IDBDatabase.prototype.transaction = function (...args: Parameters<IDBDatabase['transaction']>) {\n      const tx = original.apply(this, args); const id = ++ordinal; ids.set(tx, id);\n      window.d2Trace.push({ at: performance.now(), event: 'begin', transaction: id, mode: tx.mode, stores: Array.from(tx.objectStoreNames) });\n      tx.addEventListener('complete', () => window.d2Trace.push({ at: performance.now(), event: 'complete', transaction: id }));\n      tx.addEventListener('abort', () => window.d2Trace.push({ at: performance.now(), event: 'abort', transaction: id })); return tx;\n    };\n    const add: IDBObjectStore['add'] = Reflect.get(IDBObjectStore.prototype, 'add');\n    IDBObjectStore.prototype.add = function (value: unknown, key?: IDBValidKey) {\n      if (value && typeof value === 'object' && 'kind' in value) window.d2Trace.push({ at: performance.now(), event: 'add', transaction: ids.get(this.transaction) ?? -1, kind: String(value.kind) });\n      return add.call(this, value, key);\n    };\n  });\n  await onboard(page); await confirmPlan(page); await fillOpening(page);\n  const sourceBefore = await authority(page) as { versions: { version: string; kind: string }[] };\n  const storageBefore = await page.evaluate(() => navigator.storage.estimate());\n  await page.evaluate(() => { window.d2Trace = []; new MutationObserver(() => { if (document.querySelector('h1')?.textContent === 'XYZ · Open' && !window.d2Trace.some(event => event.event === 'ui-success')) window.d2Trace.push({ at: performance.now(), event: 'ui-success', transaction: -1 }); }).observe(document.body, { childList: true, subtree: true }); });\n  await page.getByRole('button', { name: 'Save opening entry' }).click();\n  await expect(page.getByRole('heading', { name: 'XYZ · Open' })).toBeVisible(); await expect(page.getByText('$523.00', { exact: true })).toBeVisible(); await expect(page.getByText('$977.00', { exact: true })).toBeVisible();\n  const trace = await page.evaluate(() => window.d2Trace);\n  const write = trace.find(event => event.event === 'add' && event.kind === 'PositionChange'); if (!write) throw new Error('Native write trace required');\n  expect(trace.filter(event => event.transaction === write.transaction && event.event === 'add').map(event => event.kind).sort()).toEqual(['PositionChange', 'Execution', 'Execution', 'Agreement', 'TradeState', 'JournalObligation', 'JournalEntry'].sort());\n  const committed = trace.find(event => event.transaction === write.transaction && event.event === 'complete'); const rendered = trace.find(event => event.event === 'ui-success');\n  expect(committed).toBeTruthy(); expect(rendered).toBeTruthy(); expect(committed?.at).toBeLessThanOrEqual(rendered?.at ?? -1);\n  expect(trace.filter(event => event.event === 'begin' && event.mode === 'readonly' && event.stores?.includes('versions') && event.at > (committed?.at ?? Infinity))).toHaveLength(0);\n  const before = await authority(page);\n  const observed = before as { versions: { version: string; kind: string }[] };\n  const additions = observed.versions.filter(row => !sourceBefore.versions.some(prior => prior.version === row.version));\n  const resource = { storageBefore, storageAfter: await page.evaluate(() => navigator.storage.estimate()), additions: additions.map(row => ({ kind: row.kind, serializedBytes: new TextEncoder().encode(JSON.stringify(row)).byteLength })), totalAddedSerializedBytes: new TextEncoder().encode(JSON.stringify(additions)).byteLength };\n  await mkdir('implementation/evidence/bug-001/cumulative/d02/native', { recursive: true });\n  await writeFile(`implementation/evidence/bug-001/cumulative/d02/native/${browserName}-commit-trace.json`, JSON.stringify({ browser: context.browser()?.version(), secure: await page.evaluate(() => isSecureContext), trace, before, resource }, null, 2));\n  await context.close(); const offline = await playwright[browserName].launchPersistentContext(profilePath, { headless: true, baseURL, offline: true });\n  try { const reopened = await offline.newPage(); await reopened.goto('/'); await reopened.getByRole('button', { name: 'Open', exact: true }).click(); await reopened.getByRole('button', { name: /XYZ · Open/ }).click(); await expect(reopened.getByText('$523.00', { exact: true })).toBeVisible(); expect(await authority(reopened)).toEqual(before); } finally { await offline.close(); }\n});\ntest('D2-B02 Defer/Decline, original Debt answer/decline and cancelled facts', async ({ page }) => {\n  await onboard(page); await confirmPlan(page); await fillOpening(page, 'Defer'); const beforeCancel = await authority(page);\n  await page.getByRole('button', { name: 'Cancel', exact: true }).click(); await page.reload(); expect(await authority(page)).toEqual(beforeCancel);\n  await page.getByRole('button', { name: /XYZ · Planned/ }).click(); await fillOpening(page, 'Defer'); await page.getByRole('button', { name: 'Save opening entry' }).click();\n  await expect(page.getByRole('heading', { name: 'XYZ · Open' })).toBeVisible(); await expect(page.getByRole('heading', { name: 'Position Change Reflection · Journal Debt' })).toBeVisible();\n  await page.getByRole('button', { name: 'Journal Debt', exact: true }).click(); await page.getByRole('button', { name: 'Answer reflection', exact: true }).click();\n  await page.getByLabel('As Planned', { exact: true }).check(); await page.getByLabel('Calm', { exact: true }).check(); await page.getByLabel('Decision confidence').selectOption('5'); await page.getByRole('button', { name: 'Save Debt outcome' }).click();\n  await expect(page.getByText('Reflection completed. Journal Debt settled.')).toBeVisible();\n  await confirmPlan(page); await fillOpening(page, 'Decline'); await page.getByRole('button', { name: 'Save opening entry' }).click(); await expect(page.getByRole('heading', { name: 'Position Change Reflection · Explicit decline' })).toBeVisible();\n  await confirmPlan(page); await fillOpening(page, 'Defer'); await page.getByRole('button', { name: 'Save opening entry' }).click(); await page.getByRole('button', { name: 'Answer reflection', exact: true }).click(); await page.getByLabel('Decline owed reflection').check(); await page.getByRole('button', { name: 'Save Debt outcome' }).click(); await expect(page.getByText('Reflection explicitly declined. Journal Debt settled.')).toBeVisible();\n});\ntest('D2-B03 same-store competing tabs preserve losing input and explicit conflict review', async ({ page, context }) => {\n  await onboard(page); await confirmPlan(page);\n  const other = await context.newPage(); await other.goto('/'); await other.getByRole('button', { name: /XYZ · Planned/ }).click();\n  await fillOpening(page, 'Defer'); await fillOpening(other, 'Defer');\n  await page.getByRole('button', { name: 'Save opening entry' }).click(); await expect(page.getByRole('heading', { name: 'XYZ · Open' })).toBeVisible();\n  await other.getByRole('button', { name: 'Save opening entry' }).click(); await expect(other.getByRole('button', { name: 'Review current Trade' })).toBeVisible();\n  expect(await other.getByLabel('Execution 2 quantity (shares)').inputValue()).toBe('60'); expect(await authority(other)).toEqual(await authority(page));\n  await other.getByRole('button', { name: 'Review current Trade' }).click(); await expect(other.getByRole('button', { name: 'Save opening entry' })).toBeDisabled(); await other.close();\n});\ntest('D2-B04 accessible validation and live responsive preservation at 390/767/768/1440', async ({ page, browserName }) => {\n  await page.setViewportSize({ width: 390, height: 900 }); await onboard(page); await confirmPlan(page); await fillOpening(page);\n  await page.getByLabel('Execution 2 quantity (shares)').fill('59'); await page.getByRole('button', { name: 'Save opening entry' }).click(); await expect(page.getByText('Executions must total exactly the frozen planned quantity.')).toBeVisible();\n  expect(await page.evaluate(() => document.activeElement?.textContent)).toBe('Review before continuing');\n  for (const width of [1440, 767, 768, 390]) { await page.setViewportSize({ width, height: 900 }); expect(await page.getByLabel('Execution 2 quantity (shares)').inputValue()).toBe('59'); expect(await page.getByLabel('As Planned', { exact: true }).isChecked()).toBe(true); expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true); }\n  await page.getByLabel('Execution 2 quantity (shares)').fill('60');\n  const results = await new AxeBuilder({ page }).analyze(); expect(results.violations).toEqual([]);\n  await page.screenshot({ path: `implementation/evidence/bug-001/cumulative/d02/native/${browserName}-opening-390.png`, fullPage: true });\n  await page.getByRole('button', { name: 'Save opening entry' }).click(); await expect(page.getByRole('heading', { name: 'XYZ · Open' })).toBeVisible();\n});\n","tests/browser/d02-readiness.spec.ts":"import { mkdir, writeFile } from 'node:fs/promises';\nimport { test, expect } from './fixtures';\nimport { onboard, confirmPlan } from './helpers';\nimport { fillOpening, authority } from './d02-helpers';\ndeclare global { interface Window { d2Fault: string; d2RepairCache?: () => Promise<void> } }\nfor (const flow of ['Opening', 'Debt'] as const) test(`D2-B03 ${flow} native readiness, abort, unreadable-store and safe retry matrix`, async ({ page, browserName, context }) => {\n  test.setTimeout(120000);\n  await page.addInitScript(() => {\n    window.d2Fault = '';\n    const transaction: IDBDatabase['transaction'] = Reflect.get(IDBDatabase.prototype, 'transaction');\n    IDBDatabase.prototype.transaction = function (...args: Parameters<IDBDatabase['transaction']>) {\n      const names = typeof args[0] === 'string' ? [args[0]] : Array.from(args[0]);\n      if (window.d2Fault.includes('transaction') && names.length === 1 && names[0] === 'diagnostic') throw new DOMException('Injected diagnostic failure', 'QuotaExceededError');\n      if (window.d2Fault === 'unreadable' && names.includes('roots')) throw new DOMException('Injected unreadable existing root', 'UnknownError');\n      return transaction.apply(this, args);\n    };\n    const estimate = navigator.storage.estimate.bind(navigator.storage);\n    Object.defineProperty(StorageManager.prototype, 'estimate', { value: async () => window.d2Fault === 'missing-estimate' ? {} : window.d2Fault.includes('capacity') ? { ...await estimate(), quota: 0 } : estimate() });\n    const control = Object.getOwnPropertyDescriptor(ServiceWorkerContainer.prototype, 'controller');\n    if (!control?.get) throw new Error('Native service worker controller getter required');\n    Object.defineProperty(ServiceWorkerContainer.prototype, 'controller', { get: function (this: ServiceWorkerContainer) { return window.d2Fault.includes('control') ? null : control.get?.call(this) as ServiceWorker | null; } });\n    const add: IDBObjectStore['add'] = Reflect.get(IDBObjectStore.prototype, 'add');\n    IDBObjectStore.prototype.add = function (value: unknown, key?: IDBValidKey) {\n      if (window.d2Fault === 'abort' && value && typeof value === 'object' && 'kind' in value && value.kind === 'JournalObligation') this.transaction.abort();\n      return add.call(this, value, key);\n    };\n  });\n  await onboard(page); await confirmPlan(page); await fillOpening(page, 'Defer');\n  if (flow === 'Debt') { await page.getByRole('button', { name: 'Save opening entry' }).click(); await page.getByRole('button', { name: 'Answer reflection' }).click(); await page.getByLabel('As Planned', { exact: true }).check(); await page.getByLabel('Calm', { exact: true }).check(); await page.getByLabel('Decision confidence').selectOption('4'); }\n  const saveName = flow === 'Opening' ? 'Save initial Position Change' : 'Save Debt outcome';\n  const before = await authority(page); const results: unknown[] = [];\n  for (const fault of ['transaction', 'capacity', 'control', 'inventory', 'capacity+control', 'missing-estimate', 'abort']) {\n    if (fault === 'inventory') await page.evaluate(async () => {\n      const name = (await caches.keys()).find(name => name.startsWith('trade-journal-release-')); if (!name) throw new Error('Cache required');\n      const cache = await caches.open(name); const original = await cache.match('/icon.svg'); if (!original) throw new Error('Original asset required');\n      window.d2RepairCache = () => cache.put('/icon.svg', original); await cache.put('/icon.svg', new Response('Injected corrupt asset'));\n    });\n    await page.evaluate(value => { window.d2Fault = value; }, fault);\n    await page.getByRole('button', { name: saveName }).click(); await expect(page.getByRole('heading', { name: 'Recovery Only', exact: true })).toBeVisible({ timeout: 15000 });\n    const issues = await page.locator('[data-issue]').evaluateAll(elements => elements.map(element => element.getAttribute('data-issue')));\n    if (fault === 'capacity+control') expect(issues).toEqual(expect.arrayContaining(['capacity', 'control']));\n    else expect(issues).toContain(fault === 'missing-estimate' ? 'capacity' : fault === 'abort' ? 'StorageFailure' : fault);\n    expect(await authority(page)).toEqual(before);\n    results.push({ fault, issues, unchanged: true, controller: await page.evaluate(() => navigator.serviceWorker.controller?.scriptURL) });\n    await page.evaluate(async () => { window.d2Fault = ''; if (window.d2RepairCache) { await window.d2RepairCache(); delete window.d2RepairCache; } });\n    await page.getByRole('button', { name: 'Retry startup' }).click(); await expect(page.getByRole('button', { name: saveName })).toBeEnabled();\n  }\n  await page.evaluate(() => { window.d2Fault = 'unreadable'; }); await page.getByRole('button', { name: saveName }).click(); await expect(page.getByRole('heading', { name: 'IntegrityBlocked', exact: true })).toBeVisible(); await expect(page.getByRole('button', { name: 'Create Workspace' })).toHaveCount(0);\n  await page.evaluate(() => { window.d2Fault = ''; }); expect(await authority(page)).toEqual(before); results.push({ fault: 'unreadable', unchanged: true });\n  await page.getByRole('button', { name: 'Retry startup' }).click(); await expect(page.getByRole('button', { name: saveName })).toBeEnabled();\n  await page.getByRole('button', { name: saveName }).click(); await expect(page.getByRole('heading', { name: flow === 'Opening' ? 'XYZ · Open' : 'Journal Debt settled', exact: true })).toBeVisible();\n  await mkdir('implementation/evidence/bug-001/cumulative/d02/native', { recursive: true }); await writeFile(`implementation/evidence/bug-001/cumulative/d02/native/${browserName}-${flow.toLowerCase()}-failure-matrix.json`, JSON.stringify({ browser: context.browser()?.version(), before, results, after: await authority(page), quota: await page.evaluate(() => navigator.storage.estimate()) }, null, 2));\n});\n","tests/browser/d02-update.spec.ts":"import { cp, mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { test, expect } from './fixtures';\nimport { onboard, confirmPlan } from './helpers';\nimport { authority, fillOpening } from './d02-helpers';\nfor (const flow of ['Opening', 'Debt'] as const) test(`D2 safe verified update defers while ${flow} has retained unsaved values`, async ({ page }) => {\n  await onboard(page); await confirmPlan(page); await fillOpening(page, 'Defer');\n  if (flow === 'Debt') { await page.getByRole('button', { name: 'Save opening entry' }).click(); await page.getByRole('button', { name: 'Answer reflection' }).click(); await page.getByLabel('As Planned', { exact: true }).check(); await page.getByLabel('Decision confidence').selectOption('4'); }\n  const before = await authority(page);\n  const backup = await mkdtemp(join(tmpdir(), 'd02-update-')); await cp('dist', backup, { recursive: true });\n  try {\n    await cp('.cache/update-dist', 'dist', { recursive: true });\n    await page.getByRole('button', { name: flow === 'Opening' ? 'Close opening entry' : 'Close answer journal debt' }).click();\n    await page.getByRole('button', { name: 'Check for application updates' }).click(); await expect(page.getByRole('button', { name: 'Reload to update' })).toBeVisible({ timeout: 15000 }); await expect(page.getByRole('button', { name: 'Reload to update' })).toBeDisabled();\n    if (flow === 'Opening') await page.getByRole('button', { name: 'Continue unsaved entry' }).click(); else await page.getByRole('button', { name: 'Answer reflection', exact: true }).click();\n    await expect(page.getByRole('dialog')).toContainText('Update deferred');\n    if (flow === 'Opening') await expect(page.getByLabel('Execution 2 quantity (shares)')).toHaveValue('60'); else await expect(page.getByLabel('As Planned', { exact: true })).toBeChecked();\n    await page.getByRole('button', { name: flow === 'Opening' ? 'Close opening entry' : 'Close answer journal debt' }).click();\n    await page.getByRole('button', { name: 'Workspace', exact: true }).click(); await expect(page.getByRole('button', { name: 'Reload to update' })).toBeDisabled();\n    if (flow === 'Opening') { await page.getByRole('button', { name: 'Trades', exact: true }).click(); await page.getByRole('button', { name: /XYZ · Planned/ }).click(); await page.getByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }).click(); }\n    else { await page.getByRole('button', { name: 'Journal Debt', exact: true }).click(); await page.getByRole('button', { name: 'Answer reflection', exact: true }).click(); }\n    await page.getByRole('button', { name: 'Cancel', exact: true }).click(); await expect(page.getByRole('button', { name: 'Reload to update' })).toBeEnabled();\n    await Promise.all([page.waitForEvent('load'), page.getByRole('button', { name: 'Reload to update' }).click()]); await expect(page.getByRole('heading', { name: 'Trades', exact: true })).toBeVisible();\n    expect(await authority(page)).toEqual(before); await page.context().setOffline(true); await page.reload(); await expect(page.getByRole('heading', { name: 'Trades', exact: true })).toBeVisible(); expect(await authority(page)).toEqual(before);\n  } finally { await rm('dist', { recursive: true, force: true }); await cp(backup, 'dist', { recursive: true }); }\n});\n","tests/browser/fixtures.ts":"import { test as base, expect } from '@playwright/test';\nimport { mkdtemp } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nexport const test = base.extend<{ profilePath: string }>({\n  profilePath: async ({ browserName }, use) => { await use(await mkdtemp(join(tmpdir(), `trade-journal-d1-${browserName}-`))); },\n  context: async ({ playwright, browserName, profilePath, baseURL }, use) => {\n    const context = await playwright[browserName].launchPersistentContext(profilePath, { headless: true, baseURL, viewport: { width: 1440, height: 900 } });\n    await use(context);\n    await context.close();\n  },\n});\nexport { expect };\n","tests/browser/helpers.ts":"import type { Page } from '@playwright/test';\nimport { expect } from './fixtures';\nexport async function requireWritable(page: Page) {\n  await page.goto('/');\n  await expect(page.getByLabel('Workspace time zone')).toBeVisible();\n}\nexport async function onboard(page: Page) {\n  await requireWritable(page);\n  await page.getByLabel('Workspace time zone').fill('America/New_York');\n  await page.getByRole('button', { name: 'Create Workspace' }).click();\n  await page.getByLabel('Institution name').fill('Fidelity');\n  await page.getByRole('button', { name: 'Add Institution' }).click();\n  await page.getByLabel('New Account name').fill('Taxable');\n  await page.getByRole('button', { name: 'Add Account' }).click();\n  await expect(page.getByText('Account saved. You can now confirm a Plan.')).toBeVisible();\n}\nexport async function fillPlan(page: Page) {\n  await page.getByRole('button', { name: 'New Plan' }).click();\n  await page.getByRole('button', { name: 'Next: Plan and reflection' }).click();\n  for (const [label, value] of [['Stock symbol', 'XYZ'], ['Quantity (shares)', '100'], ['Intended entry (USD)', '50'], ['Stop (underlying price, USD)', '45'], ['Target (underlying price, USD)', '60'], ['Why this trade, why now?', 'Improving earnings'], ['What would invalidate the thesis?', 'Thesis fails']]) await page.getByLabel(label).fill(value);\n}\nexport async function confirmPlan(page: Page) {\n  await fillPlan(page);\n  await page.getByRole('button', { name: 'Confirm Plan' }).click();\n  await expect(page.getByRole('heading', { name: 'XYZ · Planned' })).toBeVisible();\n}\n","tests/d02-fixtures.ts":"import { workspaceFixture, economicTime } from './fixtures';\nimport type { PositionChangeCommand } from '../src/application/trade-workflows/opening-types';\nexport async function openingFixture() {\n  const f = await workspaceFixture(); const confirmed = await f.workflows.confirmPlan(f.command);\n  if (confirmed.status !== 'Confirmed') throw new Error('Plan fixture');\n  const root = await f.store.roots.get('active'); if (!root) throw new Error('Root fixture');\n  const command: PositionChangeCommand = { kind: 'InitialStockEntry', generation: root.generation, expectedWorkspaceRevision: root.revision, expectedCatalogRevision: root.catalogRevision, tradeId: confirmed.trade.tradeId, expectedTradeRevision: confirmed.trade.revision, plannedLegId: confirmed.trade.plannedLegId, definitionRevision: 'position-change-reflection-v1', economicTime, executions: [{ instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, action: 'Buy', quantity: '40', price: '49', fee: '1', economicTime, plannedLegId: confirmed.trade.plannedLegId }, { instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, action: 'Buy', quantity: '60', price: '51', fee: '2', economicTime, plannedLegId: confirmed.trade.plannedLegId }], reflection: { kind: 'Complete', answers: { 'decision-mode': 'as-planned', emotion: 'calm', confidence: '4' } } };\n  return { ...f, command, planCommand: f.command, confirmed, root };\n}\n","tests/fixtures.ts":"import { Store, Runtime, type Root } from '../src/infrastructure/storage';\nimport { Workspace } from '../src/application/workspace';\nimport { ReferenceCatalog } from '../src/domain/reference-catalog';\nimport { TradeWorkflows, type ConfirmPlanCommand } from '../src/application/trade-workflows';\nexport const economicTime = '2026-10-17T20:00:00Z';\nexport const saveTime = '2026-10-18T23:00:00Z';\nexport async function workspaceFixture() {\n  const store = new Store(`d1-${crypto.randomUUID()}`);\n  const runtime = new Runtime(store, { check: () => Promise.resolve({ transaction: true, capacity: true, control: true, inventory: true, protection: 'BestEffort' }), requestDurability: () => Promise.resolve('BestEffort') });\n  const workspace = new Workspace(runtime);\n  await workspace.initialize({ openingInstant: saveTime, timeZone: 'America/New_York' });\n  const catalog = new ReferenceCatalog(store, runtime);\n  const root = (await store.roots.get('active')) as Root;\n  const institution = await catalog.save({ kind: 'Institution', label: 'Broker', generation: root.generation, expectedCatalogRevision: root.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('Institution fixture failed');\n  const account = await catalog.save({ kind: 'Account', label: 'Trading', parentId: institution.record.id, generation: root.generation, expectedCatalogRevision: institution.catalogRevision });\n  if (account.status !== 'Saved') throw new Error('Account fixture failed');\n  const command: ConfirmPlanCommand = { generation: root.generation, expectedCatalogRevision: account.catalogRevision, definitionRevision: root.definitionRevision, accountId: account.record.id, strategyId: 'long-stock', economicTime, plan: { instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, quantity: '100', entry: '50', stop: '45', target: '60' }, reflection: { thesis: 'Improving earnings', invalidation: 'Thesis fails' } };\n  return { store, runtime, workspace, catalog, command, workflows: new TradeWorkflows(runtime, () => saveTime) };\n}\n","tests/integration/d01-workflow.test.ts":"import type { Transaction } from 'dexie';\nimport type { Envelope } from '../../src/infrastructure/storage';\nimport { describe, it, expect } from 'vitest';\nimport { workspaceFixture, economicTime, saveTime } from '../fixtures';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\nimport { Store } from '../../src/infrastructure/storage';\nimport { TradeRecord } from '../../src/domain/trade-record';\nimport { Journal } from '../../src/domain/journal';\n// Infrastructure replacements: fake-indexeddb only, explicit clock, and host capability evidence.\n// No application dependency is mocked or replaced.\ndescribe('D1 real-stack integration', () => {\n  it('D1-I01 creates, returns and durably reopens a complete Plan and Reflection', async () => {\n    const f = await workspaceFixture();\n    const saved = await f.workflows.confirmPlan(f.command);\n    if (saved.status !== 'Confirmed') throw new Error('Confirmation failed');\n    const name = f.store.name; f.store.close();\n    const reopened = new Store(name);\n    expect(await new TradeRecord(reopened).getRecord(saved.trade.tradeId)).toEqual(saved.trade);\n    expect(await new Journal(reopened).query(saved.trade.tradeId)).toEqual([saved.entry]);\n    const view = await new TradeViewsAndReporting(reopened).getTradeDetail(saved.trade.tradeId);\n    expect(view).toMatchObject({ status: 'Ready', trade: saved.trade, entries: [saved.entry] });\n    reopened.close();\n  });\n  it('D1-I02 rejects invalid commands and rolls back a native storage abort after Plan staging', async () => {\n    const f = await workspaceFixture();\n    const before = { root: await f.store.roots.toArray(), versions: await f.store.versions.toArray(), lifecycle: await f.store.lifecycle.toArray() };\n    for (const command of [\n      { ...f.command, reflection: { thesis: '', invalidation: '' } },\n      { ...f.command, plan: { ...f.command.plan, stop: '50' } },\n      { ...f.command, plan: { ...f.command.plan, instrument: undefined } },\n      { ...f.command, expectedCatalogRevision: 'stale', definitionRevision: 'stale' },\n      { ...f.command, reflection: { ...f.command.reflection, conviction: '6', emotion: 'unknown' } },\n    ]) expect((await f.workflows.confirmPlan(command)).status).not.toBe('Confirmed');\n    // Storage-boundary fault: an IndexedDB unique-key violation aborts the actual transaction.\n    const fault = (_key: unknown, row: Envelope, tx: Transaction) => { if (row.kind === 'JournalEntry') tx.abort(); };\n    f.store.versions.hook('creating', fault);\n    expect((await f.workflows.confirmPlan(f.command)).status).toBe('StorageFailure');\n    f.store.versions.hook('creating').unsubscribe(fault);\n    expect({ root: await f.store.roots.toArray(), versions: await f.store.versions.toArray(), lifecycle: await f.store.lifecycle.toArray() }).toEqual(before);\n    const name = f.store.name; f.store.close(); const reopened = new Store(name);\n    expect({ root: await reopened.roots.toArray(), versions: await reopened.versions.toArray(), lifecycle: await reopened.lifecycle.toArray() }).toEqual(before);\n    reopened.close();\n  });\n  it('D1-I06 retains economic/save time, sequence and complete Journal provenance', async () => {\n    const f = await workspaceFixture();\n    const first = await f.workflows.confirmPlan({ ...f.command, reflection: { ...f.command.reflection, conviction: '3', emotion: 'calm' } });\n    const second = await f.workflows.confirmPlan(f.command);\n    if (first.status !== 'Confirmed' || second.status !== 'Confirmed') throw new Error('Confirmation failed');\n    expect(first.trade).toMatchObject({ economicTime, saveTime, sequence: 1 });\n    expect(second.trade).toMatchObject({ economicTime, saveTime, sequence: 2 });\n    expect(first.trade.planFactId).not.toEqual(first.trade.planVersionId);\n    expect(first.entry).toMatchObject({ anchor: { kind: 'Trade', tradeId: first.trade.tradeId }, origin: { kind: 'Plan', factId: first.trade.planFactId }, momentTime: economicTime, firstAuthoredTime: saveTime, definition: { revision: 'plan-reflection-v1' }, responses: { conviction: { kind: 'Scale', value: '3' }, emotion: { kind: 'SingleSelect', value: 'calm' } } });\n    expect(second.entry.responses.conviction).toEqual({ kind: 'Unanswered' });\n    const name = f.store.name; f.store.close(); const reopened = new Store(name);\n    expect(await new TradeRecord(reopened).history(first.trade.tradeId)).toEqual([first.trade]);\n    expect(await new Journal(reopened).query(first.trade.tradeId)).toEqual([first.entry]);\n    reopened.close();\n  });\n});\n","tests/integration/d02-workflow.test.ts":"import { describe, expect, it } from 'vitest';\nimport type { Transaction } from 'dexie';\nimport { openingFixture } from '../d02-fixtures';\nimport { Store, type Envelope } from '../../src/infrastructure/storage';\nimport { TradeRecord } from '../../src/domain/trade-record';\nimport { Journal } from '../../src/domain/journal';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\n// Production modules/transactions; fake-indexeddb and explicit host/clock inputs only.\nasync function authority(store: Store) { return { roots: await store.roots.toArray(), versions: await store.versions.toArray(), lifecycle: await store.lifecycle.toArray() }; }\ndescribe('D2 production-stack integration', () => {\n  it('D2-I01 durably returns one owned decision and Complete, Defer or Decline with exact facts', async () => {\n    for (const kind of ['Complete', 'Defer', 'Decline'] as const) {\n      const f = await openingFixture();\n      const result = await f.workflows.recordPositionChange({ ...f.command, reflection: kind === 'Complete' ? f.command.reflection : { kind } });\n      if (result.status !== 'Recorded') throw new Error(result.status);\n      expect(result.receipt).toMatchObject({ factRevision: result.trade.revision, positionChangeId: result.trade.opening?.positionChange.id, executionIds: result.trade.opening?.executions.map(execution => execution.id), workspaceRevision: result.workspaceRevision });\n      const name = f.store.name; f.store.close(); const store = new Store(name);\n      const records = new TradeRecord(store); const journal = new Journal(store); const views = new TradeViewsAndReporting(store);\n      expect(await records.getRecord(result.trade.tradeId)).toEqual(result.trade);\n      expect(await records.history(result.trade.tradeId)).toEqual([f.confirmed.trade, result.trade]);\n      const narrative = await journal.query({ tradeId: result.trade.tradeId, scope: 'History' });\n      expect(narrative.obligations).toEqual([result.journalOutcome.obligation]);\n      expect(narrative.entries).toHaveLength(kind === 'Complete' ? 2 : 1);\n      expect(narrative.declines).toEqual(result.journalOutcome.decline ? [result.journalOutcome.decline] : []);\n      const detail = await views.getTradeDetail(result.trade.tradeId);\n      expect(detail).toMatchObject({ status: 'Ready', quantity: '100', grossBasis: '5020', openingFees: '3', entryQuality: { risk: '523', reward: '977', comparison: 'BelowPlan' } });\n      expect(await views.browseTrades({ lifecycle: 'Planned' })).toMatchObject({ status: 'Empty' });\n      expect(await views.browseTrades({ lifecycle: 'Open' })).toMatchObject({ status: 'Ready', items: [{ trade: result.trade }] });\n      store.close();\n    }\n  });\n  it('D2-I02 serializes competing saves and recovers wholly before an aborted Journal participant', async () => {\n    const f = await openingFixture(); const before = await authority(f.store);\n    const abort = (_key: unknown, row: Envelope, tx: Transaction) => { if (row.kind === 'JournalObligation') tx.abort(); };\n    f.store.versions.hook('creating', abort);\n    expect(await f.workflows.recordPositionChange(f.command)).toMatchObject({ status: 'StorageFailure' });\n    f.store.versions.hook('creating').unsubscribe(abort);\n    expect(await authority(f.store)).toEqual(before);\n    const results = await Promise.all([f.workflows.recordPositionChange(f.command), f.workflows.recordPositionChange(f.command)]);\n    expect(results.map(result => result.status).sort()).toEqual(['Conflict', 'Recorded']);\n    const saved = results.find(result => result.status === 'Recorded');\n    if (!saved || saved.status !== 'Recorded') throw new Error('Winner required');\n    const after = await authority(f.store); const name = f.store.name; f.store.close(); const reopened = new Store(name);\n    expect(await authority(reopened)).toEqual(after);\n    expect(await new TradeRecord(reopened).getRecord(saved.trade.tradeId)).toEqual(saved.trade);\n    reopened.close();\n  });\n  it('D2-I03 reconstructs Open membership, exact fees and Debt after all documented private state is discarded', async () => {\n    const f = await openingFixture(); const saved = await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n    if (saved.status !== 'Recorded') throw new Error(saved.status);\n    const views = new TradeViewsAndReporting(f.store); const journal = new Journal(f.store);\n    const before = { detail: await views.getTradeDetail(saved.trade.tradeId), open: await views.browseTrades({ lifecycle: 'Open' }), journal: await journal.query({ tradeId: saved.trade.tradeId }) };\n    const facts = await authority(f.store); await f.store.projections.clear();\n    expect({ detail: await views.getTradeDetail(saved.trade.tradeId), open: await views.browseTrades({ lifecycle: 'Open' }), journal: await journal.query({ tradeId: saved.trade.tradeId }) }).toEqual(before);\n    expect(await authority(f.store)).toEqual(facts);\n    expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable' });\n    f.store.close();\n  });\n  it('D2-I04 atomically answers or declines original Debt, rejects stale retry and retains full history after restart', async () => {\n    for (const kind of ['Complete', 'Decline'] as const) {\n      const f = await openingFixture(); const opening = await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n      if (opening.status !== 'Recorded') throw new Error(opening.status);\n      const journal = new Journal(f.store, f.runtime);\n      const command = { kind: 'ResolveDebt' as const, generation: f.command.generation, expectedWorkspaceRevision: opening.workspaceRevision, obligationId: opening.journalOutcome.obligation.id, expectedRevision: opening.journalOutcome.obligation.revision, disposition: kind === 'Complete' ? { kind, answers: { 'decision-mode': 'as-planned', emotion: 'calm', confidence: '5' } } : { kind } };\n      const result = await journal.save(command);\n      if (result.status !== 'Saved') throw new Error(result.status);\n      expect(result.obligation).toMatchObject({ definition: opening.journalOutcome.obligation.definition, origin: opening.journalOutcome.obligation.origin, source: opening.journalOutcome.obligation.source, momentTime: f.command.economicTime, dueTime: f.command.economicTime, debtId: opening.journalOutcome.obligation.debtId });\n      const before = await authority(f.store); expect(await journal.save(command)).toMatchObject({ status: 'Conflict' }); expect(await authority(f.store)).toEqual(before);\n      const name = f.store.name; f.store.close(); const reopened = new Store(name);\n      const read = await new Journal(reopened).query({ tradeId: f.command.tradeId, scope: 'History' });\n      expect(read.obligations).toEqual([result.obligation]); expect(read.obligationHistory).toEqual([opening.journalOutcome.obligation, result.obligation]);\n      expect(read.entries).toEqual(result.entry ? [f.confirmed.entry, result.entry] : [f.confirmed.entry]);\n      expect(read.declines).toEqual(result.decline ? [result.decline] : []);\n      reopened.close();\n    }\n  });\n});\n","tests/setup.ts":"import 'fake-indexeddb/auto';\n","tests/unit/bug001-ui.test.tsx":"import 'fake-indexeddb/auto';\nimport { afterEach, expect, it } from 'vitest';\nimport { cleanup, render, screen } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport { workspaceFixture } from '../fixtures';\nimport { App } from '../../src/presentation/App';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\nimport { Journal } from '../../src/domain/journal';\nafterEach(cleanup);\nasync function draftFixture() {\n  const f = await workspaceFixture();\n  const confirmed = await f.workflows.confirmPlan({ ...f.command, plan: { ...f.command.plan, quantity: '10' } });\n  if (confirmed.status !== 'Confirmed') throw new Error(confirmed.status);\n  const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  await user.click(await screen.findByRole('button', { name: 'Record initial Position Change' }));\n  await user.type(screen.getByLabelText('Execution 1 quantity (shares)'), '10');\n  await user.type(screen.getByLabelText('Execution 1 price (USD)'), '50');\n  await user.click(screen.getByRole('button', { name: /Add (Execution|another execution)/ }));\n  return { ...f, user, confirmed };\n}\nit('labels retained rows and removal as unsaved while authoritative Trade stays Planned', async () => {\n  const f = await draftFixture();\n  expect(screen.getAllByText(/Execution \\d · Buy XYZ · Unsaved/)).toHaveLength(2);\n  expect(screen.getByRole('button', { name: 'Remove draft row 2' })).toBeTruthy();\n  expect(await new TradeViewsAndReporting(f.store).getTradeDetail(f.confirmed.trade.tradeId)).toMatchObject({ status: 'Ready', trade: { lifecycle: 'Planned' } });\n  cleanup(); f.store.close();\n});\nit('identifies blank Execution 2 fields and Nothing saved with all authority unchanged', async () => {\n  const f = await draftFixture();\n  const before = { roots: await f.store.roots.toArray(), versions: await f.store.versions.toArray(), lifecycle: await f.store.lifecycle.toArray() };\n  await f.user.click(screen.getByRole('button', { name: /Save (initial Position Change|opening entry)/ }));\n  expect(await screen.findByText('Nothing saved — Execution 2 needs a quantity and price')).toBeTruthy();\n  expect(screen.getByLabelText('Execution 2 quantity (shares)').getAttribute('aria-invalid')).toBe('true');\n  expect(screen.getByLabelText('Execution 2 price (USD)').getAttribute('aria-invalid')).toBe('true');\n  expect({ roots: await f.store.roots.toArray(), versions: await f.store.versions.toArray(), lifecycle: await f.store.lifecycle.toArray() }).toEqual(before);\n  cleanup(); f.store.close();\n});\nit('returns to Detail with draft continuation and restores identical rejected input and form errors', async () => {\n  const f = await draftFixture();\n  await f.user.click(screen.getByRole('button', { name: /Save (initial Position Change|opening entry)/ }));\n  await screen.findByText('Nothing saved — Execution 2 needs a quantity and price');\n  await f.user.click(screen.getByRole('button', { name: 'Close opening entry' }));\n  await f.user.click(screen.getByRole('button', { name: 'Trades' }));\n  await f.user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  expect(await screen.findByText('Unsaved entry draft')).toBeTruthy();\n  expect(screen.queryByText('Nothing saved — Execution 2 needs a quantity and price')).toBeNull();\n  await f.user.click(screen.getByRole('button', { name: 'Continue unsaved entry' }));\n  expect(screen.getByLabelText<HTMLInputElement>('Execution 1 quantity (shares)').value).toBe('10');\n  expect(screen.getByLabelText<HTMLInputElement>('Execution 2 quantity (shares)').value).toBe('');\n  expect(screen.getByText('Nothing saved — Execution 2 needs a quantity and price')).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('opens one named contextual dialog and Close retains its draft with one active navigation destination', async () => {\n  const f = await draftFixture();\n  expect(screen.getByRole('dialog', { name: 'Opening entry' }).getAttribute('aria-modal')).toBe('true');\n  await f.user.click(screen.getByRole('button', { name: 'Close opening entry' }));\n  expect(screen.queryByRole('dialog')).toBeNull();\n  expect(screen.getByRole('button', { name: 'Continue unsaved entry' })).toBeTruthy();\n  expect(document.querySelectorAll('nav [aria-current=\"page\"]')).toHaveLength(1);\n  await f.user.click(screen.getByRole('button', { name: 'Continue unsaved entry' }));\n  expect(screen.getByLabelText<HTMLInputElement>('Execution 1 quantity (shares)').value).toBe('10');\n  cleanup(); f.store.close();\n});\nit('shows recorded Executions and saved count only after the complete opening commits', async () => {\n  const f = await draftFixture();\n  await f.user.click(screen.getByRole('button', { name: 'Remove draft row 2' }));\n  await f.user.click(screen.getByRole('button', { name: /Save (initial Position Change|opening entry)/ }));\n  expect(await screen.findByRole('heading', { name: 'XYZ · Open' })).toBeTruthy();\n  expect(screen.getByText('Opening entry saved · 1 Executions')).toBeTruthy();\n  expect(screen.getByRole('heading', { name: 'Recorded Executions' })).toBeTruthy();\n  expect(screen.queryByText('Unsaved entry draft')).toBeNull();\n  expect(screen.queryByRole('button', { name: 'Continue unsaved entry' })).toBeNull();\n  cleanup(); f.store.close();\n});\nit('links row-specific blank errors to stable inputs and focuses a surviving row after removal', async () => {\n  const f = await draftFixture();\n  await f.user.click(screen.getByRole('button', { name: /Save (initial Position Change|opening entry)/ }));\n  await screen.findByText('Nothing saved — Execution 2 needs a quantity and price');\n  await f.user.click(screen.getByRole('button', { name: 'Go to Execution 2 quantity' }));\n  expect(document.activeElement).toBe(screen.getByLabelText('Execution 2 quantity (shares)'));\n  expect(screen.getByLabelText('Execution 1 quantity (shares)').getAttribute('aria-invalid')).not.toBe('true');\n  await f.user.click(screen.getByRole('button', { name: 'Remove draft row 1' }));\n  expect(document.activeElement).toBe(screen.getByLabelText('Execution 1 quantity (shares)'));\n  expect(screen.getByLabelText('Execution 1 quantity (shares)').getAttribute('aria-invalid')).toBe('true');\n  cleanup(); f.store.close();\n});\nit('freezes conflicting editing and dismissal while Saving and only then shows committed Open state', async () => {\n  const f = await draftFixture();\n  await f.user.click(screen.getByRole('button', { name: 'Remove draft row 2' }));\n  const check = f.runtime.host.check;\n  let release = () => {};\n  const gate = new Promise<void>(resolve => { release = resolve; });\n  f.runtime.host.check = async () => { await gate; return check(f.store); };\n  try {\n    await f.user.click(screen.getByRole('button', { name: /Save (initial Position Change|opening entry)/ }));\n    expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Saving…' }).disabled).toBe(true);\n    expect(screen.getByLabelText<HTMLInputElement>('Execution 1 quantity (shares)').matches(':disabled')).toBe(true);\n    expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Cancel' }).disabled).toBe(true);\n    expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Close opening entry' }).disabled).toBe(true);\n    expect(screen.queryByRole('heading', { name: 'XYZ · Open' })).toBeNull();\n  } finally { release(); }\n  expect(await screen.findByRole('heading', { name: 'XYZ · Open' })).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('moves Plan stages without writing facts or losing the chosen instrument and reflection', async () => {\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'New Plan' }));\n  await user.type(screen.getByLabelText('Stock symbol'), 'XYZ');\n  expect(screen.queryByLabelText('Quantity (shares)')).toBeNull();\n  const before = await f.store.versions.toArray();\n  await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  await user.type(screen.getByLabelText('Why this trade, why now?'), 'Retained thesis');\n  await user.click(screen.getByRole('button', { name: 'Back to instrument' }));\n  expect(screen.getByLabelText<HTMLInputElement>('Stock symbol').value).toBe('XYZ');\n  await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  expect(screen.getByLabelText<HTMLTextAreaElement>('Why this trade, why now?').value).toBe('Retained thesis');\n  expect(await f.store.versions.toArray()).toEqual(before);\n  cleanup(); f.store.close();\n});\nit('retains owed answers and rejected form errors across Close and resume from Journal Debt', async () => {\n  const f = await workspaceFixture(); const saved = await f.workflows.confirmPlan(f.command);\n  if (saved.status !== 'Confirmed') throw new Error(saved.status);\n  const root = await f.store.roots.get('active'); if (!root) throw new Error('Missing Workspace');\n  await f.workflows.recordPositionChange({ kind: 'InitialStockEntry', generation: root.generation, expectedWorkspaceRevision: root.revision, expectedCatalogRevision: root.catalogRevision, tradeId: saved.trade.tradeId, expectedTradeRevision: saved.trade.revision, plannedLegId: saved.trade.plannedLegId, definitionRevision: 'position-change-reflection-v1', economicTime: '2026-10-18T20:00:00Z', executions: [{ instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, action: 'Buy', quantity: '100', price: '50', fee: '0', economicTime: '2026-10-18T20:00:00Z', plannedLegId: saved.trade.plannedLegId }], reflection: { kind: 'Defer' } });\n  const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'Journal Debt' }));\n  await user.click(await screen.findByRole('button', { name: 'Answer reflection' }));\n  await user.type(screen.getByLabelText('Note (optional)'), 'Retained answer');\n  await user.click(screen.getByRole('button', { name: 'Save Debt outcome' }));\n  await screen.findByRole('alert');\n  await user.click(screen.getByRole('button', { name: 'Close answer journal debt' }));\n  await user.click(screen.getByRole('button', { name: 'Answer reflection' }));\n  expect(screen.getByLabelText<HTMLTextAreaElement>('Note (optional)').value).toBe('Retained answer');\n  expect(screen.getByRole('alert').textContent).toContain('Nothing saved');\n  cleanup(); f.store.close();\n});\nit('opens saved Trade Journal in a contextual panel with original source and moment', async () => {\n  const f = await draftFixture();\n  await f.user.click(screen.getByRole('button', { name: 'Cancel' }));\n  await f.user.click(screen.getByRole('button', { name: 'View Trade Journal' }));\n  expect(screen.getByRole('dialog', { name: 'Trade Journal' }).textContent).toContain('Plan Confirmation');\n  expect(screen.getByRole('dialog', { name: 'Trade Journal' }).textContent).toContain('Moment:');\n  await f.user.click(screen.getByRole('button', { name: 'Close trade journal' }));\n  expect(screen.getByRole('heading', { name: 'XYZ · Planned' })).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('freezes owed answers and Cancel during the atomic Debt Save', async () => {\n  const { openingFixture } = await import('../d02-fixtures'); const f = await openingFixture();\n  await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n  const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'Journal Debt' }));\n  await user.click(await screen.findByRole('button', { name: 'Answer reflection' }));\n  await user.click(screen.getByLabelText('Decline owed reflection'));\n  const check = f.runtime.host.check; let release = () => {};\n  const gate = new Promise<void>(resolve => { release = resolve; });\n  f.runtime.host.check = async store => { await gate; return check(store); };\n  try {\n    await user.click(screen.getByRole('button', { name: 'Save Debt outcome' }));\n    expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Saving…' }).disabled).toBe(true);\n    expect(screen.getByLabelText<HTMLInputElement>('Decline reason (optional)').matches(':disabled')).toBe(true);\n    expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Cancel' }).disabled).toBe(true);\n  } finally { release(); }\n  await screen.findByRole('heading', { name: 'Journal Debt settled' });\n  cleanup(); f.store.close();\n});\n","tests/unit/d01-analysis.test.ts":"import { describe, it, expect } from 'vitest';\nimport { derive, assessPlan, type PlanInput } from '../../src/domain/trade-analysis';\nexport const plan: PlanInput = { instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, quantity: '100', entry: '50', stop: '45', target: '60', thesis: 'Improving earnings', invalidation: 'Earnings thesis fails' };\ndescribe('frozen Long Stock Plan assessment', () => {\n  it('should accept fixture P and freeze exact risk, reward and ratio', () => {\n    expect(assessPlan(plan)).toMatchObject({ status: 'Accepted', plan, baseline: { risk: '500', oneR: '500', reward: '1000', ratio: { numerator: '2', denominator: '1' }, conditions: [{ kind: 'Stop', price: '45', amount: '500' }, { kind: 'Target', price: '60', amount: '1000' }] } });\n  });\n});\n\nit('should report every incoherent or missing Plan issue without a baseline', () => {\n  expect(assessPlan({ ...plan, instrument: undefined, quantity: '-1', thesis: ' ', invalidation: '', stop: '50', target: '40' })).toEqual({ status: 'Rejected', issues: ['ExactStockRequired', 'PositiveQuantityRequired', 'ThesisRequired', 'InvalidationRequired', 'PositiveRiskRequired', 'ForwardRewardRequired'] });\n  expect(assessPlan({ ...plan, entry: 'NaN', stop: '-2', target: 'Infinity' })).toEqual({ status: 'Rejected', issues: ['InvalidEntry', 'InvalidStop', 'InvalidTarget'] });\n});\nit('should classify Stock expiration internally without advertising payoff', () => {\n  expect(assessPlan(plan)).toMatchObject({ status: 'Accepted', expirationMethod: { status: 'NotApplicable', reason: 'NoOptionExpirationAnchor' } });\n});\nit('should preserve tiny positive risk and a repeating quotient exactly', () => {\n  expect(assessPlan({ ...plan, stop: '49.99999999999999999999' })).toMatchObject({ status: 'Accepted', baseline: { risk: '0.000000000000000001', oneR: '0.000000000000000001' } });\n  expect(assessPlan({ ...plan, quantity: '1', stop: '47', target: '51' })).toMatchObject({ status: 'Accepted', baseline: { ratio: { numerator: '1', denominator: '3' } } });\n});\n\nit('should bind Planned reconciliation to the exact candidate and surface disagreement', () => {\n  const candidate = { candidateId: 'candidate-1', revision: 'r1', digest: 'digest-1', plan, storedLifecycle: 'Planned', exposureFacts: [] };\n  expect(derive(candidate)).toMatchObject({ status: 'Derived', reconciliation: { candidateId: 'candidate-1', revision: 'r1', digest: 'digest-1', expectedLifecycle: 'Planned' }, baseline: { oneR: '500' }, entryReadiness: 'Unfilled', positions: [], lotMatches: [], deviations: [], terminalDisposition: null });\n  expect(derive({ ...candidate, storedLifecycle: 'Open' })).toEqual({ status: 'IntegrityBlocked', findings: ['LifecycleDisagreement'] });\n  expect(derive({ ...candidate, plan: { ...plan, stop: '50' } })).toMatchObject({ status: 'IntegrityBlocked', findings: ['PositiveRiskRequired'] });\n});\nit('should reject blank and malformed decimal inputs as typed issues', () => {\n  expect(assessPlan({ ...plan, entry: '', quantity: 'one', target: '12x' })).toEqual({ status: 'Rejected', issues: ['PositiveQuantityRequired', 'InvalidEntry', 'InvalidTarget'] });\n});\nit('should normalize decimal sign, zero and formatting without native-number conversion', () => {\n  expect(assessPlan({ ...plan, quantity: '00100.00', entry: '+50.000', stop: '-0', target: '6e1' })).toMatchObject({ status: 'Accepted', plan: { quantity: '100', entry: '50', stop: '0', target: '60' }, baseline: { oneR: '5000', reward: '1000', conditions: [{ price: '0', amount: '5000' }, { price: '60', amount: '1000' }] } });\n});\n","tests/unit/d01-catalog.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, it, expect } from 'vitest';\nimport { Runtime, Store, type Root } from '../../src/infrastructure/storage';\nimport { Workspace } from '../../src/application/workspace';\nimport { ReferenceCatalog } from '../../src/domain/reference-catalog';\nasync function fixture() {\n  const store = new Store(`d1-${crypto.randomUUID()}`);\n  const runtime = new Runtime(store, { check: () => Promise.resolve({ transaction: true, capacity: true, control: true, inventory: true, protection: 'BestEffort' }), requestDurability: () => Promise.resolve('BestEffort') });\n  const workspace = new Workspace(runtime);\n  await workspace.initialize({ openingInstant: '2026-10-18T22:00:00Z', timeZone: 'UTC' });\n  return { store, runtime, workspace, catalog: new ReferenceCatalog(store, runtime), root: (await store.roots.get('active')) as Root };\n}\ndescribe('real brokerage onboarding references', () => {\n  it('should create Institution and Account with complete returned identities and onboarding', async () => {\n    const f = await fixture();\n    const institution = await f.catalog.save({ kind: 'Institution', label: 'Fidelity', generation: f.root.generation, expectedCatalogRevision: f.root.catalogRevision });\n    expect(institution).toMatchObject({ status: 'Saved', record: { kind: 'Institution', label: 'Fidelity', active: true, origin: 'Trader' } });\n    if (institution.status !== 'Saved') throw new Error('Institution failed');\n    const account = await f.catalog.save({ kind: 'Account', label: 'Taxable', parentId: institution.record.id, generation: f.root.generation, expectedCatalogRevision: institution.catalogRevision });\n    expect(account).toMatchObject({ status: 'Saved', record: { kind: 'Account', parentId: institution.record.id, label: 'Taxable' }, onboarding: 'ReadyForTradePlanning' });\n    const queried = await f.catalog.query({ family: 'Institution' });\n    expect(queried.status).toBe('Ready');\n    expect(queried.records).toContainEqual(institution.record);\n    f.store.close();\n  });\n});\nit('should reject normalized duplicates, wrong or inactive parents and stale catalog without writes', async () => {\n  const f = await fixture();\n  const institution = await f.catalog.save({ kind: 'Institution', label: '  Élite   Broker ', generation: f.root.generation, expectedCatalogRevision: f.root.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('Institution failed');\n  const base = { generation: f.root.generation, expectedCatalogRevision: institution.catalogRevision };\n  const before = await f.store.versions.toArray();\n  expect(await f.catalog.save({ ...base, kind: 'Institution', label: 'e\\u0301lite broker' })).toMatchObject({ status: 'Rejected', issues: ['DuplicateLabel'] });\n  expect(await f.catalog.save({ ...base, kind: 'Account', label: 'Taxable', parentId: 'long-stock' })).toMatchObject({ status: 'Rejected', issues: ['SelectableInstitutionRequired'] });\n  expect(await f.catalog.save({ ...base, kind: 'Institution', label: 'New', expectedCatalogRevision: 'stale' })).toMatchObject({ status: 'Conflict' });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  expect(institution.record.label).toBe('  Élite   Broker ');\n  f.store.close();\n});\nit('should resolve stable Account and Strategy under one snapshot and reject changed selection', async () => {\n  const f = await fixture();\n  const institution = await f.catalog.save({ kind: 'Institution', label: 'Broker', generation: f.root.generation, expectedCatalogRevision: f.root.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('Institution failed');\n  const account = await f.catalog.save({ kind: 'Account', label: 'Trading', parentId: institution.record.id, generation: f.root.generation, expectedCatalogRevision: institution.catalogRevision });\n  if (account.status !== 'Saved') throw new Error('Account failed');\n  expect(await f.catalog.resolve({ ids: [account.record.id, 'long-stock'], expectedCatalogRevision: account.catalogRevision, use: 'NewSelection' })).toMatchObject({ status: 'Resolved', records: [account.record, { id: 'long-stock', label: 'Long Stock' }], catalogRevision: account.catalogRevision });\n  expect(await f.catalog.resolve({ ids: [account.record.id], expectedCatalogRevision: institution.catalogRevision, use: 'NewSelection' })).toMatchObject({ status: 'Conflict' });\n  f.store.close();\n});\nit('should query one requested Catalog family under a bound snapshot', async () => {\n  const f = await fixture();\n  const institution = await f.catalog.save({ kind: 'Institution', label: 'Broker', generation: f.root.generation, expectedCatalogRevision: f.root.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('Institution required');\n  const result = await f.catalog.query({ family: 'Institution' });\n  expect(result.records).toEqual([institution.record]);\n  expect(result).toMatchObject({ catalogRevision: institution.catalogRevision, generation: f.root.generation });\n  f.store.close();\n});\nit('should return StorageFailure and invalidate readiness after an aborted reference save', async () => {\n  const f = await fixture();\n  const before = await f.store.versions.toArray();\n  const root = await f.store.roots.get('active');\n  f.store.versions.hook('creating', (_key, value) => { if (value.kind === 'Institution') throw new DOMException('Injected reference abort', 'QuotaExceededError'); });\n  expect(await f.catalog.save({ kind: 'Institution', label: 'Broker', generation: f.root.generation, expectedCatalogRevision: f.root.catalogRevision })).toMatchObject({ status: 'StorageFailure' });\n  expect(f.runtime.current()).toMatchObject({ status: 'RuntimeNotWritable', failedChecks: ['transaction'] });\n  expect(await f.store.roots.get('active')).toEqual(root);\n  expect(await f.store.versions.toArray()).toEqual(before);\n  f.store.close();\n});\n","tests/unit/d01-confirmation.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, it, expect, vi } from 'vitest';\nimport { workspaceFixture, economicTime, saveTime } from '../fixtures';\ndescribe('durable Plan confirmation', () => {\n  it('should commit fixture P and its exact entered-once Plan Reflection atomically', async () => {\n    const f = await workspaceFixture();\n    const result = await f.workflows.confirmPlan(f.command);\n    expect(result).toMatchObject({ status: 'Confirmed', trade: { accountId: f.command.accountId, lifecycle: 'Planned', plan: { thesis: f.command.reflection.thesis, invalidation: f.command.reflection.invalidation }, baseline: { oneR: '500', reward: '1000' } }, entry: { source: { id: 'plan-confirmation', label: 'Plan Confirmation' }, definition: { revision: 'plan-reflection-v1' } } });\n    expect(await f.store.lifecycle.count()).toBe(1);\n    expect(await f.store.versions.where('[generation+kind]').equals([f.command.generation, 'JournalEntry']).count()).toBe(1);\n    f.store.close();\n  });\n});\nit('should return a complete commit receipt and saved projections without a follow-up read', async () => {\n  const f = await workspaceFixture();\n  const result = await f.workflows.confirmPlan(f.command);\n  if (result.status !== 'Confirmed') throw new Error('Confirmation failed');\n  expect(result).toMatchObject({ receipt: { tradeId: result.trade.tradeId, factRevision: result.trade.revision, factId: result.trade.planFactId, factVersionId: result.trade.planVersionId, entryId: result.entry.id, entryVersion: result.entry.version, lifecycle: 'Planned', workspaceRevision: result.workspaceRevision } });\n  expect(result.entry.anchor).toEqual({ kind: 'Trade', tradeId: result.trade.tradeId });\n  expect(result.entry.origin).toEqual({ kind: 'Plan', factId: result.trade.planFactId });\n  f.store.close();\n});\nit('should reject invalid reflection and stale catalog, definition or generation without identities', async () => {\n  const f = await workspaceFixture();\n  const before = await f.store.versions.toArray();\n  const root = await f.store.roots.get('active');\n  expect(await f.workflows.confirmPlan({ ...f.command, reflection: { thesis: '', invalidation: '' }, plan: { ...f.command.plan, stop: '50' } })).toMatchObject({ status: 'Rejected', issues: ['ThesisRequired', 'InvalidationRequired', 'PositiveRiskRequired'] });\n  expect(await f.workflows.confirmPlan({ ...f.command, expectedCatalogRevision: 'old', definitionRevision: 'old' })).toMatchObject({ status: 'Conflict', issues: ['CatalogChanged', 'DefinitionChanged'] });\n  expect(await f.workflows.confirmPlan({ ...f.command, accountId: 'long-stock' })).toMatchObject({ status: 'Rejected', issues: ['SelectableAccountRequired'] });\n  expect(await f.workflows.confirmPlan({ ...f.command, generation: 'retired' })).toMatchObject({ status: 'Conflict' });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  expect(await f.store.roots.get('active')).toEqual(root);\n  f.store.close();\n});\n\nit('should roll back every participant and ordinal on Journal abort or late gate failure', async () => {\n  const f = await workspaceFixture();\n  const before = await f.store.versions.toArray();\n  const root = await f.store.roots.get('active');\n  const { Journal } = await import('../../src/domain/journal');\n  const failure = vi.spyOn(Journal.prototype, 'applyPreparedEffects').mockRejectedValue(new Error('InjectedJournalAbort'));\n  expect(await f.workflows.confirmPlan(f.command)).toMatchObject({ status: 'StorageFailure' });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  expect(await f.store.roots.get('active')).toEqual(root);\n  expect(await f.store.lifecycle.count()).toBe(0);\n  failure.mockRestore();\n  let calls = 0;\n  vi.spyOn(f.runtime.host, 'check').mockImplementation(() => Promise.resolve({ transaction: true, capacity: true, inventory: ++calls === 1, control: true, protection: 'BestEffort' }));\n  expect(await f.workflows.confirmPlan(f.command)).toMatchObject({ status: 'RuntimeNotWritable', failedChecks: ['inventory'] });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  f.store.close();\n});\nit('should reject reconciliation for altered candidate content, digest or revision before staging', async () => {\n  const f = await workspaceFixture();\n  const { TradeRecord } = await import('../../src/domain/trade-record');\n  const { assessPlan, derive } = await import('../../src/domain/trade-analysis');\n  const root = await f.store.roots.get('active');\n  if (!root) throw new Error('Root required');\n  const assessment = assessPlan({ ...f.command.plan, ...f.command.reflection });\n  if (assessment.status !== 'Accepted') throw new Error('Assessment required');\n  const records = new TradeRecord(f.store);\n  const candidate = records.prepareChange({ accountId: f.command.accountId, strategyId: f.command.strategyId, economicTime, assessment, revision: root.revision });\n  const reconciliation = derive(candidate);\n  await expect(f.store.transaction('rw', [f.store.versions, f.store.lifecycle], () => records.applyPreparedChange({ ...candidate, plan: { ...candidate.plan, quantity: '999' } }, reconciliation, root, saveTime))).rejects.toThrow('ReconciliationConflict');\n  await expect(f.store.transaction('rw', [f.store.versions, f.store.lifecycle], () => records.applyPreparedChange({ ...candidate, digest: 'other' }, reconciliation, root, saveTime))).rejects.toThrow('ReconciliationConflict');\n  await expect(f.store.transaction('rw', [f.store.versions, f.store.lifecycle], () => records.applyPreparedChange(candidate, reconciliation, { ...root, revision: 'other' }, saveTime))).rejects.toThrow('ReconciliationConflict');\n  expect(await f.store.lifecycle.count()).toBe(0);\n  f.store.close();\n});\nit('should retain distinct economic and save times and sequence order after reopening', async () => {\n  const f = await workspaceFixture();\n  const { TradeRecord } = await import('../../src/domain/trade-record');\n  const { Store } = await import('../../src/infrastructure/storage');\n  let counter = 999999;\n  const identity = vi.spyOn(crypto, 'randomUUID').mockImplementation(() => `ffffffff-ffff-ffff-ffff-${String(counter--).padStart(12, '0')}`);\n  const first = await f.workflows.confirmPlan(f.command);\n  const second = await f.workflows.confirmPlan(f.command);\n  identity.mockRestore();\n  if (first.status !== 'Confirmed' || second.status !== 'Confirmed') throw new Error('Confirmation failed');\n  expect(first.trade.tradeId > second.trade.tradeId).toBe(true);\n  expect(first.trade.sequence).toBe(1);\n  expect(second.trade.sequence).toBe(2);\n  expect(first.trade.planFactId).not.toBe(first.trade.planVersionId);\n  expect(first.trade).toMatchObject({ economicTime, saveTime });\n  expect(first.entry).toMatchObject({ momentTime: economicTime, firstAuthoredTime: saveTime, origin: { kind: 'Plan', factId: first.trade.planFactId }, anchor: { kind: 'Trade', tradeId: first.trade.tradeId } });\n  const name = f.store.name;\n  f.store.close();\n  const reopened = new Store(name);\n  const records = new TradeRecord(reopened);\n  expect(await records.getRecord(first.trade.tradeId)).toEqual(first.trade);\n  expect(await records.history(second.trade.tradeId)).toEqual([second.trade]);\n  reopened.close();\n});\nit('should reject an assessment baseline that disagrees with candidate-bound derivation', async () => {\n  const f = await workspaceFixture();\n  const { TradeRecord } = await import('../../src/domain/trade-record');\n  const { assessPlan, derive } = await import('../../src/domain/trade-analysis');\n  const root = await f.store.roots.get('active');\n  const assessment = assessPlan({ ...f.command.plan, ...f.command.reflection });\n  if (!root || assessment.status !== 'Accepted') throw new Error('Fixture required');\n  const records = new TradeRecord(f.store);\n  const candidate = records.prepareChange({ accountId: f.command.accountId, strategyId: f.command.strategyId, economicTime, assessment: { ...assessment, baseline: { ...assessment.baseline, oneR: '900' } }, revision: root.revision });\n  await expect(f.store.transaction('rw', [f.store.versions, f.store.lifecycle], () => records.applyPreparedChange(candidate, derive(candidate), root, saveTime))).rejects.toThrow('ReconciliationConflict');\n  expect(await f.store.lifecycle.count()).toBe(0);\n  f.store.close();\n});\nit('should validate optional stable answers and retain explicit Unanswered snapshots', async () => {\n  const f = await workspaceFixture();\n  const before = await f.store.versions.toArray();\n  expect(await f.workflows.confirmPlan({ ...f.command, reflection: { ...f.command.reflection, conviction: '6', emotion: 'unknown' } })).toMatchObject({ status: 'Rejected', issues: ['InvalidConviction', 'UnknownEmotion'] });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  const result = await f.workflows.confirmPlan({ ...f.command, reflection: { ...f.command.reflection, conviction: '4', emotion: 'calm' } });\n  expect(result).toMatchObject({ status: 'Confirmed', entry: { responses: { conviction: { kind: 'Scale', value: '4' }, emotion: { kind: 'SingleSelect', value: 'calm' } } } });\n  const omitted = await f.workflows.confirmPlan(f.command);\n  expect(omitted).toMatchObject({ status: 'Confirmed', entry: { responses: { conviction: { kind: 'Unanswered' }, emotion: { kind: 'Unanswered' } } } });\n  f.store.close();\n});\nit('should reject an unknown-newer root at the mutation gate without staging facts', async () => {\n  const f = await workspaceFixture();\n  await f.store.roots.update('active', { schema: 999 });\n  const root = await f.store.roots.get('active'); const versions = await f.store.versions.toArray();\n  expect(await f.workflows.confirmPlan(f.command)).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked', failedChecks: ['UnsupportedSchema'] });\n  expect(await f.store.roots.get('active')).toEqual(root);\n  expect(await f.store.versions.toArray()).toEqual(versions);\n  f.store.close();\n});\n","tests/unit/d01-readiness.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, it, expect, vi } from 'vitest';\nimport { Runtime, Store, type HostChecks, type RuntimeHost } from '../../src/infrastructure/storage';\nimport { Workspace } from '../../src/application/workspace';\nconst passing: HostChecks = { transaction: true, capacity: true, control: true, inventory: true, protection: 'BestEffort' };\nfunction fixture() {\n  let checks = { ...passing };\n  const store = new Store(`d1-${crypto.randomUUID()}`);\n  const host: RuntimeHost = { check: () => Promise.resolve(checks), requestDurability: () => Promise.resolve(checks.protection) };\n  const runtime = new Runtime(store, host);\n  return { store, runtime, workspace: new Workspace(runtime), set: (patch: Partial<HostChecks>) => { checks = { ...checks, ...patch }; } };\n}\ndescribe('functional Runtime Readiness', () => {\n  it('should allow Writable with advisory BestEffort or Unavailable protection', async () => {\n    const f = fixture();\n    expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable', protection: 'BestEffort' });\n    f.set({ protection: 'Unavailable' });\n    expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable', protection: 'Unavailable' });\n    f.store.close();\n  });\n});\nit('should report each failure and simultaneous failures without creating authoritative data', async () => {\n  for (const failures of [['transaction'], ['capacity'], ['control'], ['inventory'], ['capacity', 'inventory']]) {\n    const f = fixture();\n    f.set(Object.fromEntries(failures.map(key => [key, false])));\n    expect(await f.workspace.getStatus()).toMatchObject({ status: 'RuntimeNotWritable', runtimeReadiness: 'Unsupported', failedChecks: failures, workspaceStatus: 'None' });\n    expect(await f.runtime.mutate(undefined, () => Promise.reject(new Error('Must not run')))).toMatchObject({ status: 'RuntimeNotWritable' });\n    expect(await f.store.roots.count()).toBe(0);\n    expect(await f.store.versions.count()).toBe(0);\n    f.store.close();\n  }\n});\n\nit('should preserve readable recovery and reject every mutation at persistence', async () => {\n  const f = fixture();\n  const initialized = await f.workspace.initialize({ openingInstant: '2026-10-18T22:00:00Z', timeZone: 'America/New_York' });\n  if (initialized.status !== 'Opened') throw new Error('Workspace required');\n  f.set({ inventory: false });\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'RuntimeNotWritable', runtimeReadiness: 'RecoveryOnly', workspaceStatus: 'RecoveryOnly', failedChecks: ['inventory'] });\n  expect(await f.runtime.mutate(initialized.root.generation, () => Promise.reject(new Error('Must not run')))).toMatchObject({ status: 'RuntimeNotWritable' });\n  expect(await f.store.versions.count()).toBe(5);\n  f.store.close();\n});\nit('should block an unreadable possible root even when host checks pass', async () => {\n  const f = fixture();\n  vi.spyOn(f.store, 'inspect').mockResolvedValue({ status: 'IntegrityBlocked' });\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'RuntimeNotWritable', runtimeReadiness: 'Unsupported', workspaceStatus: 'IntegrityBlocked', failedChecks: ['UnreadableRoot'] });\n  expect(await f.runtime.mutate(undefined, () => Promise.reject(new Error('Must not run')))).toMatchObject({ status: 'RuntimeNotWritable' });\n  f.store.close();\n});\nit('should recheck each launch and invalidate the next mutation after a runtime failure', async () => {\n  const f = fixture();\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable', epoch: 1 });\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable', epoch: 2 });\n  f.set({ transaction: false, control: false });\n  f.runtime.invalidate('transaction');\n  expect(f.runtime.current()).toMatchObject({ status: 'RuntimeNotWritable', failedChecks: ['transaction'] });\n  expect(await f.runtime.mutate(undefined, () => Promise.resolve('unsafe'))).toMatchObject({ status: 'RuntimeNotWritable', failedChecks: ['transaction', 'control'] });\n  expect(f.runtime.current()).toMatchObject({ status: 'RuntimeNotWritable' });\n  f.set({ transaction: true, control: true });\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable' });\n  f.store.close();\n});\n\nit('should report explicit durability outcomes without authoritative changes', async () => {\n  const f = fixture();\n  expect(await f.workspace.requestDurability()).toEqual({ status: 'NotImproved', currentProtection: 'BestEffort' });\n  f.set({ protection: 'Protected' });\n  expect(await f.workspace.requestDurability()).toEqual({ status: 'AlreadyProtected', currentProtection: 'Protected' });\n  f.set({ protection: 'BestEffort' });\n  vi.spyOn(f.runtime.host, 'requestDurability').mockResolvedValue('Protected');\n  expect(await f.workspace.requestDurability()).toEqual({ status: 'Improved', currentProtection: 'Protected' });\n  expect(await f.store.versions.count()).toBe(0);\n  f.store.close();\n});\n","tests/unit/d01-reads.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, it, expect } from 'vitest';\nimport { workspaceFixture } from '../fixtures';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\ndescribe('coherent Planned Trade reads', () => {\n  it('should expose retained baseline, readiness and exact reflection once with a coherent binding', async () => {\n    const f = await workspaceFixture();\n    const saved = await f.workflows.confirmPlan(f.command);\n    if (saved.status !== 'Confirmed') throw new Error('Confirmation failed');\n    const views = new TradeViewsAndReporting(f.store);\n    expect(await views.browseTrades()).toMatchObject({ status: 'Ready', items: [{ trade: saved.trade, entryReadiness: 'Unfilled' }], totalInPage: 1, binding: { workspaceRevision: saved.workspaceRevision } });\n    expect(await views.getTradeDetail(saved.trade.tradeId)).toMatchObject({ status: 'Ready', trade: saved.trade, entries: [saved.entry], history: [saved.trade], entryReadiness: 'Unfilled', labels: { account: 'Trading', institution: 'Broker', strategy: 'Long Stock' } });\n    f.store.close();\n  });\n});\nit('should distinguish successful Empty from query failure and allow safe retry', async () => {\n  const f = await workspaceFixture();\n  const views = new TradeViewsAndReporting(f.store);\n  expect(await views.browseTrades()).toMatchObject({ status: 'Empty', items: [] });\n  const { vi } = await import('vitest');\n  const failure = vi.spyOn(f.store.roots, 'get').mockRejectedValue(new Error('Storage read failed'));\n  expect(await views.browseTrades()).toMatchObject({ status: 'Error', reason: 'StorageReadFailed' });\n  failure.mockRestore();\n  expect(await views.browseTrades()).toMatchObject({ status: 'Empty' });\n  f.store.close();\n});\nit('should page a snapshot-bound Planned index in stable economic and sequence order', async () => {\n  const f = await workspaceFixture();\n  for (let i = 0; i < 53; i++) await f.workflows.confirmPlan(f.command);\n  const views = new TradeViewsAndReporting(f.store);\n  const first = await views.browseTrades();\n  if (first.status !== 'Ready') throw new Error('Page required');\n  expect(first.items).toHaveLength(50);\n  expect(first.items[0]?.trade.sequence).toBe(53);\n  expect(first.nextCursor).toEqual(expect.any(String));\n  const second = await views.browseTrades({ cursor: first.nextCursor });\n  if (second.status !== 'Ready') throw new Error('Page required');\n  expect(second.items.map(item => item.trade.sequence)).toEqual([3, 2, 1]);\n  await f.workflows.confirmPlan(f.command);\n  expect(await views.browseTrades({ cursor: first.nextCursor })).toMatchObject({ status: 'ChangedDuringAssembly' });\n  f.store.close();\n});\nit('should surface lifecycle disagreement without repairing authoritative records', async () => {\n  const f = await workspaceFixture();\n  const saved = await f.workflows.confirmPlan(f.command);\n  if (saved.status !== 'Confirmed') throw new Error('Confirmation failed');\n  const key = `${f.command.generation}:${saved.trade.tradeId}`;\n  // Controlled integrity fixture: change only the authoritative lifecycle agreement.\n  await f.store.lifecycle.update(key, { lifecycle: 'Open' });\n  const before = await f.store.lifecycle.get(key);\n  expect(await new TradeViewsAndReporting(f.store).getTradeDetail(saved.trade.tradeId)).toMatchObject({ status: 'IntegrityBlocked', findings: ['LifecycleDisagreement'] });\n  expect(await f.store.lifecycle.get(key)).toEqual(before);\n  f.store.close();\n});\nit('should batch-resolve retained Trade anchors without redirecting unknown identities', async () => {\n  const { TradeRecord } = await import('../../src/domain/trade-record');\n  const f = await workspaceFixture();\n  const saved = await f.workflows.confirmPlan(f.command);\n  if (saved.status !== 'Confirmed') throw new Error('Confirmation required');\n  const resolved = await new TradeRecord(f.store).resolveAnchors([{ kind: 'Trade', tradeId: saved.trade.tradeId }, { kind: 'Trade', tradeId: 'unknown' }]);\n  expect(resolved).toMatchObject({ resolutions: [{ anchor: { kind: 'Trade', tradeId: saved.trade.tradeId }, status: 'Effective', owningTradeId: saved.trade.tradeId }, { anchor: { kind: 'Trade', tradeId: 'unknown' }, status: 'Unknown' }], workspaceRevision: saved.workspaceRevision });\n  f.store.close();\n});\nit('should sort equivalent-offset and submillisecond Economic Times by instant then Recorded Sequence', async () => {\n  const f = await workspaceFixture();\n  for (const economicTime of ['2026-10-17T20:00:00Z', '2026-10-17T16:00:00-04:00', '2026-10-17T20:00:00.000000001Z']) expect((await f.workflows.confirmPlan({ ...f.command, economicTime })).status).toBe('Confirmed');\n  const page = await new TradeViewsAndReporting(f.store).browseTrades();\n  if (page.status !== 'Ready') throw new Error('List required');\n  expect(page.items.map(item => item.trade.sequence)).toEqual([3, 2, 1]);\n  expect(page.items[1]?.trade.economicTime).toBe('2026-10-17T16:00:00-04:00');\n  f.store.close();\n});\n","tests/unit/d01-ui.test.tsx":"import 'fake-indexeddb/auto';\nimport { Journal } from '../../src/domain/journal';\nimport { describe, it, expect, afterEach } from 'vitest';\nimport { render, screen, waitFor, cleanup } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport { App, type Services } from '../../src/presentation/App';\nimport { Runtime, Store } from '../../src/infrastructure/storage';\nimport { Workspace } from '../../src/application/workspace';\nimport { ReferenceCatalog } from '../../src/domain/reference-catalog';\nimport { TradeWorkflows } from '../../src/application/trade-workflows';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\nafterEach(cleanup);\nfunction fixture() {\n  const store = new Store(`d1-${crypto.randomUUID()}`);\n  const runtime = new Runtime(store, { check: () => Promise.resolve({ transaction: true, capacity: true, control: true, inventory: true, protection: 'BestEffort' }), requestDurability: () => Promise.resolve('BestEffort') });\n  const services: Services = { workspace: new Workspace(runtime), catalog: new ReferenceCatalog(store, runtime), workflows: new TradeWorkflows(runtime), views: new TradeViewsAndReporting(store), journal: new Journal(store, runtime) };\n  return { store, services };\n}\ndescribe('Long Stock Plan production UI', () => {\n  it('should complete first-run onboarding and confirm fixture P using accessible controls', async () => {\n    const f = fixture(); const user = userEvent.setup();\n    render(<App services={f.services} />);\n    await user.type(await screen.findByLabelText('Workspace time zone'), 'America/New_York');\n    await user.click(screen.getByRole('button', { name: 'Create Workspace' }));\n    await user.type(await screen.findByLabelText('Institution name'), 'Fidelity');\n    await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n    await user.type(await screen.findByLabelText('New Account name'), 'Taxable');\n    await user.click(screen.getByRole('button', { name: 'Add Account' }));\n    await user.click(await screen.findByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n    for (const [label, value] of [['Stock symbol', 'XYZ'], ['Quantity (shares)', '100'], ['Intended entry (USD)', '50'], ['Stop (underlying price, USD)', '45'], ['Target (underlying price, USD)', '60'], ['Why this trade, why now?', 'Improving earnings'], ['What would invalidate the thesis?', 'Thesis fails']]) await user.type(screen.getByLabelText(label), value);\n    await user.click(screen.getByLabelText('Calm'));\n    await user.click(screen.getByRole('button', { name: 'Confirm Plan' }));\n    await waitFor(() => expect(screen.getByRole('heading', { name: 'XYZ · Planned' })).toBeTruthy());\n    expect(screen.getByText('$500.00')).toBeTruthy();\n    expect(screen.getByText('Improving earnings')).toBeTruthy();\n    expect(screen.getByText('Plan Confirmation')).toBeTruthy();\n    expect(screen.getByText('Calm')).toBeTruthy();\n    expect(screen.queryByRole('button', { name: 'Record Execution' })).toBeNull();\n    cleanup(); f.store.close();\n  });\n});\nit('should preserve entered values through validation, navigation and a catalog conflict', async () => {\n  const f = fixture(); const user = userEvent.setup();\n  await f.services.workspace.initialize({ openingInstant: '2026-10-18T20:00:00Z', timeZone: 'UTC' });\n  const catalog = await f.services.catalog.query({ family: 'Institution' });\n  if (catalog.status !== 'Ready') throw new Error('Catalog required');\n  const institution = await f.services.catalog.save({ kind: 'Institution', label: 'Broker', generation: catalog.generation, expectedCatalogRevision: catalog.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('Institution required');\n  await f.services.catalog.save({ kind: 'Account', label: 'Trading', parentId: institution.record.id, generation: catalog.generation, expectedCatalogRevision: institution.catalogRevision });\n  render(<App services={f.services} />);\n  await user.click(await screen.findByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  await user.type(screen.getByLabelText('Stock symbol'), 'XYZ');\n  await user.click(screen.getByRole('button', { name: 'Confirm Plan' }));\n  expect(await screen.findByRole('alert')).toBeTruthy();\n  expect(document.activeElement?.textContent).toContain('Review before continuing');\n  expect(screen.getByText('Enter a quantity greater than zero.')).toBeTruthy();\n  expect(screen.getByLabelText('Quantity (shares)').getAttribute('aria-invalid')).toBe('true');\n  await user.click(screen.getByRole('button', { name: 'Workspace' }));\n  await user.click(screen.getByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  expect((screen.getByLabelText<HTMLInputElement>('Stock symbol')).value).toBe('XYZ');\n  for (const [label, value] of [['Quantity (shares)', '100'], ['Intended entry (USD)', '50'], ['Stop (underlying price, USD)', '45'], ['Target (underlying price, USD)', '60'], ['Why this trade, why now?', 'Thesis'], ['What would invalidate the thesis?', 'Invalidation']]) await user.type(screen.getByLabelText(label), value);\n  const current = await f.services.catalog.query({ family: 'Institution' });\n  if (current.status !== 'Ready') throw new Error('Catalog required');\n  await f.services.catalog.save({ kind: 'Institution', label: 'Second broker', generation: current.generation, expectedCatalogRevision: current.catalogRevision });\n  await user.click(screen.getByRole('button', { name: 'Confirm Plan' }));\n  expect(await screen.findByText('Brokerage records changed in another tab. Review your selections before confirming again.')).toBeTruthy();\n  await user.click(screen.getByRole('button', { name: 'Review current references' }));\n  expect((screen.getByLabelText<HTMLInputElement>('Stock symbol')).value).toBe('XYZ');\n  await user.click(screen.getByRole('button', { name: 'Cancel' }));\n  expect(await f.store.lifecycle.count()).toBe(0);\n  cleanup(); f.store.close();\n});\nit('should keep recovery reads and history available while every mutation is disabled', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const { vi } = await import('vitest');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  await f.workflows.confirmPlan(f.command);\n  vi.spyOn(f.runtime.host, 'check').mockResolvedValue({ transaction: true, capacity: false, control: true, inventory: false, protection: 'BestEffort' });\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  expect(await screen.findByText('Recovery Only')).toBeTruthy();\n  expect((screen.getByRole<HTMLButtonElement>('button', { name: 'New Plan' })).disabled).toBe(true);\n  expect(await screen.findByRole('button', { name: /XYZ · Planned/ })).toBeTruthy();\n  await user.click(screen.getByRole('button', { name: 'Trades' }));\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  expect(await screen.findByText('View history')).toBeTruthy();\n  expect(screen.getByText(/Backup and Restore are not installed/)).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('should offer honest storage and installation guidance without disabling writable planning', async () => {\n  const f = fixture(); const user = userEvent.setup();\n  render(<App services={f.services} />);\n  await user.type(await screen.findByLabelText('Workspace time zone'), 'UTC');\n  await user.click(screen.getByRole('button', { name: 'Create Workspace' }));\n  expect(await screen.findByText(/This browser may clear your data/)).toBeTruthy();\n  await user.click(screen.getByRole('button', { name: 'Request storage protection' }));\n  expect(await screen.findByText('The host did not grant stronger storage protection.')).toBeTruthy();\n  expect((screen.getByRole<HTMLButtonElement>('button', { name: 'Add Institution' })).disabled).toBe(false);\n  await user.click(screen.getByRole('button', { name: 'Workspace' }));\n  expect(screen.getByText(/Add to Home Screen/)).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('should keep update activation disabled while a retained Plan survives a reference save', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} delivery={{ getUpdate: () => Promise.resolve({ available: true }), activateUpdate: () => Promise.resolve() }} />);\n  await user.click(await screen.findByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  await user.type(screen.getByLabelText('Stock symbol'), 'XYZ');\n  await user.click(screen.getByRole('button', { name: 'Workspace' }));\n  await user.type(screen.getByLabelText('Institution name'), 'Second broker');\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  await waitFor(() => expect(screen.getByLabelText<HTMLInputElement>('Institution name').value).toBe(''));\n  await user.click(screen.getByRole('button', { name: 'Check for application updates' }));\n  expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Reload to update' }).disabled).toBe(true);\n  await user.click(screen.getByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  expect(screen.getByLabelText<HTMLInputElement>('Stock symbol').value).toBe('XYZ');\n  cleanup(); f.store.close();\n});\nit('should disable mutation controls when reference saving discovers failed readiness', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const { vi } = await import('vitest');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'Workspace' }));\n  await user.type(screen.getByLabelText('Institution name'), 'Second broker');\n  vi.spyOn(f.runtime.host, 'check').mockResolvedValue({ transaction: true, capacity: false, control: true, inventory: true, protection: 'BestEffort' });\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  expect(await screen.findByText('Recovery Only')).toBeTruthy();\n  expect(screen.getByRole<HTMLButtonElement>('button', { name: 'New Plan' }).disabled).toBe(true);\n  expect(screen.queryByRole('button', { name: 'Add Institution' })).toBeNull();\n  cleanup(); f.store.close();\n});\nit('should show Loading rather than an empty view while a list read is pending', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const { vi } = await import('vitest');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  const views = new TradeViewsAndReporting(f.store);\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views, journal: new Journal(f.store, f.runtime) }} />);\n  await screen.findByText('No confirmed Plans match this view.');\n  let releaseRead = () => {};\n  const pending = new Promise<void>(resolve => { releaseRead = resolve; });\n  const realRead = views.browseTrades.bind(views);\n  vi.spyOn(views, 'browseTrades').mockImplementation(async request => { await pending; return realRead(request); });\n  await user.click(screen.getByRole('button', { name: 'Trades' }));\n  expect(screen.getByText('Loading Planned Trades…')).toBeTruthy();\n  expect(screen.queryByText('No Plans are displayed yet.')).toBeNull();\n  releaseRead();\n  await screen.findByText('No confirmed Plans match this view.');\n  cleanup(); f.store.close();\n});\nit('should enter Recovery Only and retain a reference draft after a storage abort', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'Workspace' }));\n  await user.type(screen.getByLabelText('Institution name'), 'Second broker');\n  const fault = (_key: unknown, row: { kind: string }) => { if (row.kind === 'Institution') throw new DOMException('Injected storage abort', 'QuotaExceededError'); };\n  f.store.versions.hook('creating', fault);\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  expect(await screen.findByText('Recovery Only')).toBeTruthy();\n  expect(screen.getByRole<HTMLButtonElement>('button', { name: 'New Plan' }).disabled).toBe(true);\n  f.store.versions.hook('creating').unsubscribe(fault);\n  await user.click(screen.getByRole('button', { name: 'Retry startup' }));\n  expect((await screen.findByLabelText<HTMLInputElement>('Institution name')).value).toBe('Second broker');\n  cleanup(); f.store.close();\n});\nit('should display retained instants in the Workspace time zone without changing their values', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  await f.workflows.confirmPlan(f.command);\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  await user.click(await screen.findByText('View history'));\n  expect(screen.getByText('Confirmed: 2026-10-17 16:00:00 America/New_York')).toBeTruthy();\n  expect(screen.getByText('Saved: 2026-10-18 19:00:00 America/New_York')).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('should distinguish same-named Accounts by their immutable Institution in Plan selection', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  const root = await f.store.roots.get('active');\n  if (!root) throw new Error('Workspace required');\n  const institution = await f.catalog.save({ kind: 'Institution', label: 'Other broker', generation: root.generation, expectedCatalogRevision: root.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('Institution required');\n  await f.catalog.save({ kind: 'Account', label: 'Trading', parentId: institution.record.id, generation: root.generation, expectedCatalogRevision: institution.catalogRevision });\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  expect(screen.getByRole('option', { name: 'Trading · Broker' })).toBeTruthy();\n  expect(screen.getByRole('option', { name: 'Trading · Other broker' })).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('should refresh conflicting reference bindings without losing the reference draft', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'Workspace' }));\n  await user.type(screen.getByLabelText('Institution name'), 'My new broker');\n  const current = await f.catalog.query({ family: 'Institution' });\n  if (current.status !== 'Ready') throw new Error('Catalog required');\n  await f.catalog.save({ kind: 'Institution', label: 'Concurrent broker', generation: current.generation, expectedCatalogRevision: current.catalogRevision });\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  await user.click(await screen.findByRole('button', { name: 'Review current references' }));\n  await screen.findByText('References refreshed. Review your selections and confirm again.');\n  expect(screen.getByLabelText<HTMLInputElement>('Institution name').value).toBe('My new broker');\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  await waitFor(() => expect(screen.getByLabelText<HTMLInputElement>('Institution name').value).toBe(''));\n  cleanup(); f.store.close();\n});\nit('should show the frozen Plan Baseline and entry readiness in each Planned list row', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture();\n  await f.workflows.confirmPlan(f.command);\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  const row = await screen.findByRole('button', { name: /XYZ · Planned/ });\n  expect(row.textContent).toContain('Unfilled');\n  expect(row.textContent).toContain('$500.00 risk');\n  expect(row.textContent).toContain('$1000.00 reward');\n  expect(row.textContent).toContain('2/1 reward/risk');\n  cleanup(); f.store.close();\n});\nit('should recommend another browser when startup is Unsupported without implying Workspace transfer', async () => {\n  const { vi } = await import('vitest');\n  const f = fixture();\n  vi.spyOn(f.services.workspace.runtime.host, 'check').mockResolvedValue({ transaction: true, capacity: false, control: true, inventory: true, protection: 'BestEffort' });\n  render(<App services={f.services} />);\n  await screen.findByRole('heading', { name: 'Unsupported' });\n  expect(screen.getByText(/Try another browser/)).toBeTruthy();\n  expect(screen.getByText(/Another browser has separate storage and does not transfer this Workspace/)).toBeTruthy();\n  expect(screen.getByText(/Backup and Restore are not installed/)).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('should distinguish update, recovery and storage advisory landmarks after a late readiness failure', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const { vi } = await import('vitest');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} delivery={{ getUpdate: () => Promise.resolve({ available: true }), activateUpdate: () => Promise.resolve() }} />);\n  await user.click(await screen.findByRole('button', { name: 'Workspace' }));\n  await user.click(screen.getByRole('button', { name: 'Check for application updates' }));\n  await screen.findByText('Update available');\n  await user.click(await screen.findByRole('button', { name: 'Workspace' }));\n  await user.type(screen.getByLabelText('Institution name'), 'Another broker');\n  vi.spyOn(f.runtime.host, 'check').mockResolvedValue({ transaction: true, capacity: false, control: true, inventory: true, protection: 'BestEffort' });\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  await screen.findByText('Recovery Only');\n  expect(screen.getByRole('complementary', { name: 'Update available' })).toBeTruthy();\n  expect(screen.getByRole('complementary', { name: 'Recovery Only' })).toBeTruthy();\n  expect(screen.getByRole('complementary', { name: 'Storage protection' })).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit.each(['', 'Invalid/Zone', '-05:00'])('should explain a rejected Workspace time zone %j and allow correction without initializing data', async zone => {\n  const f = fixture(); const user = userEvent.setup();\n  render(<App services={f.services} />);\n  const input = await screen.findByLabelText<HTMLInputElement>('Workspace time zone');\n  if (zone) await user.type(input, zone);\n  await user.click(screen.getByRole('button', { name: 'Create Workspace' }));\n  const error = await screen.findByRole('alert');\n  expect(error.textContent).toContain('Enter a rules-based time zone, such as America/New_York.');\n  expect(screen.getByLabelText('Workspace time zone').getAttribute('aria-invalid')).toBe('true');\n  expect(document.activeElement?.textContent).toContain('Choose your time zone');\n  expect(await f.store.roots.count()).toBe(0);\n  expect(await f.store.versions.count()).toBe(0);\n  const correction = screen.getByLabelText('Workspace time zone');\n  await user.clear(correction); await user.type(correction, 'America/New_York');\n  await user.click(screen.getByRole('button', { name: 'Create Workspace' }));\n  await screen.findByLabelText('Institution name');\n  expect((await f.store.roots.get('active'))?.timeZone).toBe('America/New_York');\n  cleanup(); f.store.close();\n});\nit('should add a second Account at an existing Institution and retain both for Plan selection after reopening', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture(); const user = userEvent.setup();\n  await f.workflows.confirmPlan(f.command);\n  const services = { workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) };\n  const view = render(<App services={services} />);\n  await user.click(await screen.findByRole('button', { name: 'Workspace' }));\n  await user.type(screen.getByLabelText('New Account name'), 'Retirement');\n  await user.click(screen.getByRole('button', { name: 'Add Account' }));\n  await screen.findByText('Account saved. You can now confirm a Plan.');\n  const catalog = await f.catalog.query({ family: 'Account' });\n  expect(catalog.records.map(record => record.label).sort()).toEqual(['Retirement', 'Trading']);\n  expect(new Set(catalog.records.map(record => record.parentId)).size).toBe(1);\n  view.unmount();\n  render(<App services={services} />);\n  await user.click(await screen.findByRole('button', { name: 'New Plan' }));\n  if (screen.queryByRole('button', { name: 'Next: Plan and reflection' })) await user.click(screen.getByRole('button', { name: 'Next: Plan and reflection' }));\n  expect(screen.getByRole('option', { name: 'Trading · Broker' })).toBeTruthy();\n  expect(screen.getByRole('option', { name: 'Retirement · Broker' })).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('should identify the Workspace Account form as creation and clear its name after adding an Account', async () => {\n  const f = fixture(); const user = userEvent.setup();\n  render(<App services={f.services} />);\n  await user.type(await screen.findByLabelText('Workspace time zone'), 'America/New_York');\n  await user.click(screen.getByRole('button', { name: 'Create Workspace' }));\n  await user.type(await screen.findByLabelText('Institution name'), 'Broker');\n  await user.click(screen.getByRole('button', { name: 'Add Institution' }));\n  await screen.findByRole('heading', { name: 'Add Account' });\n  await user.type(screen.getByLabelText('New Account name'), 'Taxable');\n  await user.click(screen.getByRole('button', { name: 'Add Account' }));\n  await screen.findByText('Account saved. You can now confirm a Plan.');\n  await user.click(screen.getByRole('button', { name: 'Workspace' }));\n  expect(screen.getByLabelText<HTMLInputElement>('New Account name').value).toBe('');\n  await user.type(screen.getByLabelText('New Account name'), 'Retirement');\n  await user.click(screen.getByRole('button', { name: 'Add Account' }));\n  await screen.findByRole('heading', { name: 'Trades' });\n  expect((await f.services.catalog.query({ family: 'Account' })).records.map(record => record.label).sort()).toEqual(['Retirement', 'Taxable']);\n  cleanup(); f.store.close();\n});\n","tests/unit/d01-workspace.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, it, expect, vi } from 'vitest';\nimport { Runtime, Store, type RuntimeHost } from '../../src/infrastructure/storage';\nimport { Workspace } from '../../src/application/workspace';\nconst host: RuntimeHost = { check: () => Promise.resolve({ transaction: true, capacity: true, control: true, inventory: true, protection: 'BestEffort' }), requestDurability: () => Promise.resolve('BestEffort') };\nconst instant = '2026-10-18T22:00:00Z';\nfunction fixture() {\n  const store = new Store(`d1-${crypto.randomUUID()}`);\n  return { store, workspace: new Workspace(new Runtime(store, host)) };\n}\ndescribe('atomic initialized Workspace', () => {\n  it('should initialize installed D1 and D2 seeds and return onboarding from the committed result', async () => {\n    const f = fixture();\n    const result = await f.workspace.initialize({ openingInstant: instant, timeZone: 'America/New_York' });\n    expect(result).toMatchObject({ status: 'Opened', onboarding: 'NeedsInstitutionAndAccount', root: { timeZone: 'America/New_York', schema: 2 }, receipt: { fresh: true, seeds: ['long-stock', 'plan-reflection', 'plan-confirmation', 'position-change-reflection', 'position-change'] } });\n    expect((await f.store.versions.toArray()).map(row => row.kind).sort()).toEqual(['Definition', 'Definition', 'Source', 'Source', 'Strategy']);\n    f.store.close();\n  });\n});\nit('should require a rules-based time zone and preserve explicit instants', async () => {\n  const f = fixture();\n  expect(await f.workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'TimeZoneSelectionRequired' });\n  expect(await f.workspace.initialize({ openingInstant: instant, timeZone: '-05:00' })).toMatchObject({ status: 'TimeZoneSelectionRequired' });\n  expect(await f.workspace.initialize({ openingInstant: instant, timeZone: 'Invalid/Zone' })).toMatchObject({ status: 'TimeZoneSelectionRequired' });\n  expect(await f.store.roots.count()).toBe(0);\n  const saved = await f.workspace.initialize({ openingInstant: instant, timeZone: 'America/Los_Angeles' });\n  expect(saved).toMatchObject({ status: 'Opened', root: { timeZone: 'America/Los_Angeles' } });\n  expect((await f.store.versions.toArray()).every(row => row.saveTime === instant)).toBe(true);\n  f.store.close();\n});\nit('should reopen idempotently with stable seeds and unchanged metadata', async () => {\n  const f = fixture();\n  const first = await f.workspace.initialize({ openingInstant: instant, timeZone: 'America/New_York' });\n  const before = await f.store.versions.toArray();\n  const second = await f.workspace.initialize({ openingInstant: '2026-10-19T01:00:00Z', timeZone: 'UTC' });\n  expect(second).toMatchObject({ ...first, receipt: { fresh: false, seeds: [] } });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  f.store.close();\n});\n\nit('should roll back metadata and both seeds after storage failure and return SeedConflict', async () => {\n  const f = fixture();\n  const original = f.store.versions.add.bind(f.store.versions);\n  let calls = 0;\n  vi.spyOn(f.store.versions, 'add').mockImplementation((...args) => { if (++calls === 2) return Promise.reject(new Error('SeedConflict')) as ReturnType<typeof original>; return original(...args); });\n  expect(await f.workspace.initialize({ openingInstant: instant, timeZone: 'UTC' })).toMatchObject({ status: 'SeedConflict' });\n  expect(await f.store.roots.count()).toBe(0);\n  expect(await f.store.versions.count()).toBe(0);\n  f.store.close();\n});\nit('should reject unknown newer and integrity-invalid roots unchanged', async () => {\n  const f = fixture();\n  await f.workspace.initialize({ openingInstant: instant, timeZone: 'UTC' });\n  // Controlled integrity fixture: change only the declared schema compatibility byte.\n  await f.store.roots.update('active', { schema: 999 });\n  const before = await f.store.roots.get('active');\n  expect(await f.workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked', failedChecks: ['UnsupportedSchema'] });\n  expect(await f.store.roots.get('active')).toEqual(before);\n  await f.store.roots.update('active', { schema: 1, timeZone: 'Invalid/Zone' });\n  expect(await f.workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked', failedChecks: ['InvalidRoot'] });\n  f.store.close();\n});\nit('should publish complete generation and reject a stale generation before mutation', async () => {\n  const f = fixture();\n  const opened = await f.workspace.initialize({ openingInstant: instant, timeZone: 'UTC' });\n  expect(opened).toMatchObject({ status: 'Opened', receipt: { candidateSealed: true, authoritativeCount: 5 } });\n  const before = await f.store.versions.toArray();\n  expect(await f.workspace.runtime.mutate('retired-generation', () => Promise.reject(new Error('Must not run')))).toEqual({ status: 'Conflict', reason: 'GenerationChanged' });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  f.store.close();\n});\nit('should block reopening incomplete authoritative data without publishing Ready or repairing it', async () => {\n  const f = fixture();\n  const opened = await f.workspace.initialize({ openingInstant: instant, timeZone: 'UTC' });\n  if (opened.status !== 'Opened') throw new Error('Workspace required');\n  await f.store.versions.delete(`${opened.root.generation}:plan-reflection-v1`);\n  const before = await f.store.versions.toArray();\n  expect(await f.workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'IntegrityBlocked' });\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked', failedChecks: ['InvalidRoot'] });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  f.store.close();\n});\nit('should retain a bounded measured size receipt and safely disregard a deleted private receipt', async () => {\n  const f = fixture();\n  await f.workspace.initialize({ openingInstant: instant, timeZone: 'UTC' });\n  const status = await f.workspace.getStatus();\n  expect(status).toMatchObject({ status: 'Writable', storageMeasurement: { method: 'SerializedActiveLowerBound' } });\n  if (!('storageMeasurement' in status)) throw new Error('Measurement required');\n  expect(status.storageMeasurement.activeSerializedBytes).toBeGreaterThan(1000);\n  const root = await f.store.roots.get('active');\n  await f.store.projections.clear();\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'Writable', storageMeasurement: { activeSerializedBytes: 0, method: 'UnmeasuredConservative' } });\n  expect(await f.store.roots.get('active')).toEqual(root);\n  f.store.close();\n});\nit('should bind an existing initialization receipt to the complete retained authoritative count', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture();\n  await f.workflows.confirmPlan(f.command);\n  expect(await f.workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'Opened', receipt: { fresh: false, authoritativeCount: 9 }, root: { recordedSequence: 1 } });\n  f.store.close();\n});\nit('should report integrity failure together with failed readiness instead of opening invalid recovery data', async () => {\n  const { workspaceFixture } = await import('../fixtures');\n  const f = await workspaceFixture();\n  await f.store.roots.update('active', { timeZone: 'Invalid/Zone' });\n  const before = await f.store.roots.get('active');\n  vi.spyOn(f.runtime.host, 'check').mockResolvedValue({ transaction: true, capacity: true, control: true, inventory: false, protection: 'BestEffort' });\n  expect(await f.workspace.getStatus()).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked', failedChecks: ['inventory', 'InvalidRoot'] });\n  expect(await f.store.roots.get('active')).toEqual(before);\n  f.store.close();\n});\nit('should preserve complete RuntimeNotWritable context from initialization when root validation fails', async () => {\n  const f = fixture();\n  await f.workspace.initialize({ openingInstant: instant, timeZone: 'UTC' });\n  await f.store.roots.update('active', { timeZone: 'Invalid/Zone' });\n  expect(await f.workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'RuntimeNotWritable', runtimeReadiness: 'Unsupported', workspaceStatus: 'IntegrityBlocked', failedChecks: ['InvalidRoot'], safeActions: ['Retry', 'Try another browser; its storage is separate'] });\n  f.store.close();\n});\n","tests/unit/d02-analysis.test.ts":"import { describe, expect, it } from 'vitest';\nimport { derive, assessChange, type PlannedCandidate } from '../../src/domain/trade-analysis';\nconst plan = { instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, quantity: '100', entry: '50', stop: '45', target: '60', thesis: 'Improving earnings', invalidation: 'Earnings thesis fails' };\nexport function openingCandidate(): PlannedCandidate {\n  const economicTime = '2026-10-21T14:00:00Z';\n  return { candidateId: 'trade', revision: 'r2', digest: 'digest', plan, storedLifecycle: 'Open', exposureFacts: [], opening: {\n    recordedAgreement: { factRevision: 'r2', lotMatches: [], deviations: [], entryResolution: { positionChangeId: 'change', economicTime } },\n    plannedLegId: 'leg', positionChange: { id: 'change', version: 'change-v1', tradeId: 'trade', originTradeId: 'trade', kind: 'InitialStockEntry', economicTime, saveTime: economicTime, sequence: 2, executionIds: ['e1', 'e2'] },\n    executions: [{ id: 'e1', version: 'e1-v1', tradeId: 'trade', positionChangeId: 'change', instrument: plan.instrument, action: 'Buy', quantity: '40', price: '49', fee: '1', economicTime, saveTime: economicTime, sequence: 3, plannedLegId: 'leg' }, { id: 'e2', version: 'e2-v1', tradeId: 'trade', positionChangeId: 'change', instrument: plan.instrument, action: 'Buy', quantity: '60', price: '51', fee: '2', economicTime, saveTime: economicTime, sequence: 4, plannedLegId: 'leg' }],\n  } };\n}\ndescribe('complete Stock entry derivation', () => {\n  it('case01 derives complete opening quantity, gross basis and actual fees while retaining frozen 1R', () => {\n    expect(derive(openingCandidate())).toMatchObject({ status: 'Derived', reconciliation: { expectedLifecycle: 'Open' }, quantity: '100', grossBasis: '5020', openingFees: '3', realizedResult: { status: 'NotApplicable', reason: 'NoDisposal' }, baseline: { oneR: '500' } });\n  });\n});\n\nit('case02 resolves actual risk/reward and weighted entry below the frozen ratio', () => {\n  expect(derive(openingCandidate())).toMatchObject({ weightedEntry: { numerator: '251', denominator: '5' }, entryQuality: { status: 'Resolved', comparison: 'BelowPlan', risk: '523', reward: '977', ratio: { numerator: '977', denominator: '523' } }, entryResolution: { positionChangeId: 'change', economicTime: '2026-10-21T14:00:00Z' } });\n});\nit('case03 orders distinct Lots by economic instant and Recorded Sequence rather than input order', () => {\n  const candidate = openingCandidate(); candidate.opening!.executions.reverse();\n  expect(derive(candidate)).toMatchObject({ positions: [{ instrument: plan.instrument, quantity: '100', lots: [{ openingId: 'e1', quantity: '40', price: '49', openingFees: '1' }, { openingId: 'e2', quantity: '60', price: '51', openingFees: '2' }] }] });\n});\n\nit('case04 records all exact served-leg mismatches once but rejects uncovered management', () => {\n  const candidate = openingCandidate();\n  candidate.opening!.executions.forEach(execution => { execution.instrument = { kind: 'Stock', symbol: 'OTHER', currency: 'EUR' }; });\n  candidate.opening!.recordedAgreement!.deviations = [{ kind: 'PlannedLegTerms', plannedLegId: 'leg', mismatches: ['symbol', 'currency'] }];\n  expect(derive(candidate)).toMatchObject({ status: 'Derived', fulfillment: 'FilledWithDeviation', deviations: [{ kind: 'PlannedLegTerms', plannedLegId: 'leg', mismatches: ['symbol', 'currency'] }] });\n  expect(assessChange({ ...candidate, storedLifecycle: 'Planned' })).toMatchObject({ status: 'Rejected', issues: ['MissingManagementCoverage'] });\n});\nit('case05 rejects every invalid decimal, incomplete quantity, instant and ownership without reconciliation', () => {\n  for (const value of ['0', '-1', 'NaN', 'Infinity', '', '1x']) {\n    const candidate = openingCandidate(); candidate.opening!.executions[0].quantity = value;\n    const result = derive(candidate); expect(result.status).toBe('IntegrityBlocked');\n    if (result.status === 'IntegrityBlocked') expect(result.findings).toContain('PositiveExecutionQuantityRequired');\n  }\n  const candidate = openingCandidate(); const execution = candidate.opening!.executions[0];\n  execution.fee = '-1'; execution.price = 'NaN'; execution.economicTime = 'bad'; execution.tradeId = 'other'; execution.plannedLegId = 'other';\n  const result = derive(candidate);\n  expect(result.status).toBe('IntegrityBlocked');\n  if (result.status === 'IntegrityBlocked') for (const issue of ['NonnegativeExecutionFeeRequired', 'NonnegativeExecutionPriceRequired', 'InvalidExecutionTime', 'ExecutionOwnershipMismatch', 'PlannedLegIntentMismatch']) expect(result.findings).toContain(issue);\n  expect(result).not.toHaveProperty('reconciliation');\n  const incomplete = openingCandidate(); incomplete.opening!.executions[0].quantity = '39';\n  expect(derive(incomplete)).toMatchObject({ status: 'IntegrityBlocked', findings: ['CompletePlannedQuantityRequired'] });\n});\nit('case06 preserves repeating weighted entry and fee shares with exact conservation and tiny ratio comparisons', () => {\n  const candidate = openingCandidate(); candidate.plan = { ...plan, quantity: '3', entry: '2', stop: '0', target: '4' };\n  const [first, second] = candidate.opening!.executions; Object.assign(first, { quantity: '1', price: '1', fee: '0' }); Object.assign(second, { quantity: '2', price: '2', fee: '1' });\n  expect(derive(candidate)).toMatchObject({ weightedEntry: { numerator: '5', denominator: '3' }, grossBasis: '5', openingFees: '1', entryQuality: { risk: '6', reward: '6', comparison: 'AsPlanned' }, positions: [{ lots: [{ openingFees: '0', feePerShare: { numerator: '0', denominator: '1' } }, { openingFees: '1', feePerShare: { numerator: '1', denominator: '2' } }] }] });\n  candidate.plan = { ...plan, quantity: '3', entry: '2', stop: '0', target: '4' }; Object.assign(first, { fee: '1', quantity: '3', price: '2' }); candidate.opening!.executions = [first]; candidate.opening!.positionChange.executionIds = ['e1'];\n  expect(derive(candidate)).toMatchObject({ openingFees: '1', positions: [{ lots: [{ feePerShare: { numerator: '1', denominator: '3' } }] }] });\n  Object.assign(first, { fee: '0', price: '2.0000000000000000000000000000000000000001' });\n  expect(derive(candidate)).toMatchObject({ entryQuality: { comparison: 'BelowPlan' } });\n});\n\nit('case05 agreement requires bound authoritative lifecycle, membership, lot links and deviations', () => {\n  const candidate = openingCandidate(); delete candidate.opening!.recordedAgreement;\n  expect(derive(candidate)).toMatchObject({ status: 'IntegrityBlocked', findings: ['MissingOpeningAgreement'] });\n  expect(assessChange({ ...candidate, storedLifecycle: 'Planned' })).toMatchObject({ status: 'Accepted' });\n  candidate.opening!.recordedAgreement = { factRevision: 'old', lotMatches: [], deviations: [], entryResolution: { positionChangeId: 'wrong', economicTime: '2026-10-21T14:00:00Z' } };\n  expect(derive(candidate)).toMatchObject({ status: 'IntegrityBlocked', findings: ['OpeningAgreementDisagreement'] });\n  const duplicate = openingCandidate(); duplicate.opening!.executions[1].id = 'e1';\n  expect(derive(duplicate).status).toBe('IntegrityBlocked');\n});\nit('case06 nonpositive actual entry risk preserves dollars and returns an unavailable ratio', () => {\n  for (const price of ['45', '44']) {\n    const candidate = openingCandidate(); candidate.opening!.executions.forEach(execution => { execution.price = price; execution.fee = '0'; });\n    expect(derive(candidate)).toMatchObject({ status: 'Derived', entryQuality: { status: 'Resolved', comparison: 'Unavailable', risk: price === '45' ? '0' : '-100', reward: price === '45' ? '1500' : '1600', ratio: { status: 'Unavailable', reason: 'NonpositiveEntryRisk' } } });\n  }\n});\nit('verifies decimal rejection, instant ordering, intact membership and exact fee conservation at the public seam', () => {\n  for (const field of ['fee', 'price'] as const) for (const value of ['-1', 'NaN', 'Infinity', '', '1x']) {\n    const candidate = openingCandidate(); candidate.opening!.executions[0][field] = value;\n    expect(derive(candidate).status).toBe('IntegrityBlocked');\n  }\n  for (const mutate of [\n    (candidate: PlannedCandidate) => { candidate.opening!.positionChange.tradeId = 'other'; },\n    (candidate: PlannedCandidate) => { candidate.opening!.positionChange.economicTime = 'bad'; },\n    (candidate: PlannedCandidate) => { candidate.opening!.positionChange.executionIds = ['e1']; },\n    (candidate: PlannedCandidate) => { candidate.opening!.executions[1].sequence = 3; },\n    (candidate: PlannedCandidate) => { candidate.opening!.recordedAgreement!.lotMatches = [{ openingId: 'e1', disposingId: 'invented', quantity: '1' }]; },\n    (candidate: PlannedCandidate) => { candidate.opening!.recordedAgreement!.entryResolution.economicTime = 'bad'; },\n  ]) { const candidate = openingCandidate(); mutate(candidate); expect(derive(candidate).status).toBe('IntegrityBlocked'); }\n  const candidate = openingCandidate(); candidate.opening!.executions[0].economicTime = '2026-10-21T14:00:00.000000001Z';\n  const ordered = derive(candidate);\n  expect(ordered.status).toBe('Derived');\n  if (ordered.status === 'Derived') expect(ordered.positions[0]?.lots.map(lot => lot.openingId)).toEqual(['e2', 'e1']);\n  candidate.plan = { ...plan, quantity: '3' }; candidate.opening!.executions = [{ ...candidate.opening!.executions[0], quantity: '3', fee: '1' }]; candidate.opening!.positionChange.executionIds = ['e1'];\n  const result = derive(candidate);\n  expect(result.status).toBe('Derived');\n  if (result.status === 'Derived') {\n    const share = result.positions[0]?.lots[0]?.feePerShare;\n    expect(share).toEqual({ numerator: '1', denominator: '3' });\n    // Independent integer arithmetic proves all three unrounded shares conserve the actual fee.\n    expect(BigInt(share.numerator) * 3n).toBe(BigInt(share.denominator));\n  }\n});\n","tests/unit/d02-journal.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, it, expect } from 'vitest';\nimport { Journal } from '../../src/domain/journal';\nimport { positionChangeDefinition } from '../../src/domain/journal/position-change-types';\nimport { Store, Runtime, addedRecords, type Root } from '../../src/infrastructure/storage';\nconst answers = { 'decision-mode': 'as-planned', emotion: 'calm', confidence: '4' };\ndescribe('Position Change reflection outcomes', () => {\n  it('validates all required responses and stable options', () => {\n    const journal = new Journal(new Store(crypto.randomUUID()));\n    for (const invalid of [{ ...answers, 'decision-mode': '' }, { ...answers, emotion: 'unknown' }, { ...answers, confidence: '6' }, { ...answers, confidence: '' }]) {\n      expect(journal.prepareEffects({ kind: 'PositionChange', definition: positionChangeDefinition, disposition: { kind: 'Complete', answers: invalid } }).status).toBe('Rejected');\n    }\n    expect(journal.prepareEffects({ kind: 'PositionChange', definition: positionChangeDefinition, disposition: { kind: 'Complete', answers } }).status).toBe('Prepared');\n  });\n});\n\nconst root: Root = { key: 'active', generation: 'g', revision: 'r', schema: 2, timeZone: 'America/New_York', catalogRevision: 'c', definitionRevision: 'plan-reflection-v1', commitOrdinal: 1, recordedSequence: 0, recordCounts: { versions: 0, lifecycle: 0 } };\nconst trigger = { tradeId: 't', positionChangeId: 'pc', economicTime: '2026-10-21T12:00:00Z', saveTime: '2026-10-21T13:00:00Z', sequence: 1 };\nit('prepares Defer inertly then commits one original-snapshot Debt without Entry', async () => {\n  const store = new Store(crypto.randomUUID()); const journal = new Journal(store);\n  const prepared = journal.prepareEffects({ kind: 'PositionChange', definition: positionChangeDefinition, disposition: { kind: 'Defer' } });\n  expect(JSON.stringify(prepared)).not.toContain('debtId');\n  if (prepared.status !== 'Prepared') throw new Error('Preparation failed');\n  const result = await store.transaction('rw', store.versions, () => journal.applyPreparedEffects(prepared, trigger, root));\n  expect(result.obligation).toMatchObject({ status: 'Outstanding', dueTime: trigger.economicTime, definition: positionChangeDefinition });\n  expect(result.entry).toBeUndefined(); expect(result.addedRecords).toBe(1);\n});\nit('records Decline distinctly from optional unanswered Note and Debt', async () => {\n  const store = new Store(crypto.randomUUID()); const journal = new Journal(store);\n  for (const disposition of [{ kind: 'Decline' as const, reason: 'No reflection' }, { kind: 'Complete' as const, answers }]) {\n    const prepared = journal.prepareEffects({ kind: 'PositionChange', definition: positionChangeDefinition, disposition });\n    if (prepared.status !== 'Prepared') throw new Error('Preparation failed');\n    const result = await store.transaction('rw', store.versions, () => journal.applyPreparedEffects(prepared, { ...trigger, positionChangeId: disposition.kind }, root));\n    expect(result.obligation.status).toBe(disposition.kind === 'Decline' ? 'Declined' : 'Completed');\n    expect(result.obligation.debtId).toBeUndefined();\n    if (disposition.kind === 'Complete') expect(result.entry?.responses.note).toEqual({ kind: 'Unanswered' });\n    else { expect(result.decline?.reason).toBe('No reflection'); expect(result.entry).toBeUndefined(); }\n    expect(result.addedRecords).toBe(2);\n  }\n});\n\nasync function debtFixture() {\n  const store = new Store(crypto.randomUUID());\n  const runtime = new Runtime(store, { check: () => Promise.resolve({ transaction: true, capacity: true, control: true, inventory: true, protection: 'BestEffort' }), requestDurability: () => Promise.resolve('BestEffort') });\n  const journal = new Journal(store, runtime);\n  await store.roots.add(root);\n  const prepared = journal.prepareEffects({ kind: 'PositionChange', definition: positionChangeDefinition, disposition: { kind: 'Defer' } });\n  if (prepared.status !== 'Prepared') throw new Error('Preparation failed');\n  const result = await store.transaction('rw', store.versions, store.roots, async () => {\n    const applied = await journal.applyPreparedEffects(prepared, trigger, root);\n    await store.roots.put({ ...root, commitOrdinal: 2, recordCounts: addedRecords(root, applied.addedRecords) });\n    return applied;\n  });\n  return { store, journal, obligation: result.obligation };\n}\nit('settles original-form Debt atomically with Entry or explicit decline and returns projections', async () => {\n  for (const disposition of [{ kind: 'Complete' as const, answers }, { kind: 'Decline' as const }]) {\n    const { journal, obligation } = await debtFixture();\n    const result = await journal.save({ kind: 'ResolveDebt', generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition });\n    expect(result.status).toBe('Saved');\n    if (result.status !== 'Saved') throw new Error('Save failed');\n    expect(result.obligation.debtId).toBe(obligation.debtId);\n    expect(result.obligation.definition).toEqual(obligation.definition);\n    const query = await journal.query({ scope: 'History' });\n    expect(query.obligationHistory).toHaveLength(2); expect(query.obligations[0]?.status).toBe(disposition.kind === 'Complete' ? 'Completed' : 'Declined');\n    expect(query.entries).toHaveLength(disposition.kind === 'Complete' ? 1 : 0);\n    expect(query.declines).toHaveLength(disposition.kind === 'Decline' ? 1 : 0);\n  }\n});\nit('rejects stale and competing completions without duplicating outcomes', async () => {\n  const { journal, obligation } = await debtFixture();\n  const command = { kind: 'ResolveDebt' as const, generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition: { kind: 'Complete' as const, answers } };\n  expect((await journal.save({ ...command, expectedRevision: 'stale' })).status).toBe('Conflict');\n  const results = await Promise.all([journal.save(command), journal.save(command)]);\n  expect(results.map(result => result.status).sort()).toEqual(['Conflict', 'Saved']);\n  const query = await journal.query({}); expect(query.entries).toHaveLength(1); expect(query.obligationHistory).toHaveLength(2);\n});\nit('returns the exact stored TradeWorkflow route for workflow-only Debt', async () => {\n  const { store, journal, obligation } = await debtFixture();\n  // Explicit future-compatible infrastructure fixture, never produced by D2 UI.\n  const route = { kind: 'TradeWorkflow' as const, tradeId: 'original-trade', operation: 'ManagementRevision' };\n  await store.versions.where('[generation+id]').equals(['g', obligation.id]).modify(row => { row.value = { ...obligation, route }; });\n  const result = await journal.save({ kind: 'ResolveDebt', generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition: { kind: 'Complete', answers } });\n  expect(result).toEqual({ status: 'NeedsTradeWorkflow', route });\n  const query = await journal.query({ scope: 'Outstanding' }); expect(query.obligations).toHaveLength(1); expect(query.entries).toHaveLength(0);\n});\nit('keeps trigger-time wording, source, origin and owed prompt identities after settlement', async () => {\n  const { store, journal, obligation } = await debtFixture();\n  const definition = structuredClone(obligation.definition);\n  definition.label = 'Original trigger form';\n  definition.prompts[0].wording = 'Original decision wording';\n  await store.versions.where('[generation+id]').equals(['g', obligation.id]).modify(row => { row.value = { ...obligation, definition }; });\n  const result = await journal.save({ kind: 'ResolveDebt', generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition: { kind: 'Complete', answers } });\n  expect(result.status).toBe('Saved');\n  if (result.status !== 'Saved') throw new Error('Save failed');\n  expect(result.entry?.definition).toEqual(definition);\n  expect(result.entry?.source).toEqual({ id: 'position-change', label: 'Position Change' });\n  expect(result.entry?.origin).toEqual({ kind: 'PositionChange', factId: 'pc' });\n  expect(result.entry?.momentTime).toBe(trigger.economicTime);\n  expect(result.entry?.settledDebtId).toBe(obligation.debtId);\n});\nit('rejects invalid answers and stale Workspace/generation without changing Debt', async () => {\n  const { journal, obligation } = await debtFixture();\n  const command = { kind: 'ResolveDebt' as const, generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition: { kind: 'Complete' as const, answers } };\n  expect((await journal.save({ ...command, generation: 'old' })).status).toBe('Conflict');\n  expect((await journal.save({ ...command, expectedWorkspaceRevision: 'old' })).status).toBe('Conflict');\n  expect((await journal.save({ ...command, disposition: { kind: 'Complete', answers: { ...answers, confidence: '0' } } })).status).toBe('Rejected');\n  const query = await journal.query({}); expect(query.obligationHistory).toEqual([obligation]); expect(query.entries).toEqual([]);\n});\nit('returns all readiness failures and leaves outstanding Debt unchanged', async () => {\n  const { store, obligation } = await debtFixture();\n  const runtime = new Runtime(store, { check: () => Promise.resolve({ transaction: false, capacity: false, control: false, inventory: false, protection: 'BestEffort' }), requestDurability: () => Promise.resolve('BestEffort') });\n  const journal = new Journal(store, runtime);\n  const result = await journal.save({ kind: 'ResolveDebt', generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition: { kind: 'Complete', answers } });\n  expect(result).toMatchObject({ status: 'RuntimeNotWritable', failedChecks: ['transaction', 'capacity', 'control', 'inventory'] });\n  expect((await journal.query({})).obligationHistory).toEqual([obligation]);\n});\nit('rolls back Entry and settlement when durable writes abort', async () => {\n  const { store, journal, obligation } = await debtFixture();\n  const fail = (_key: unknown, row: { kind: string }) => { if (row.kind === 'JournalObligation') throw new Error('Injected storage abort'); };\n  store.versions.hook('creating', fail);\n  const result = await journal.save({ kind: 'ResolveDebt', generation: 'g', expectedWorkspaceRevision: 'r', obligationId: obligation.id, expectedRevision: obligation.revision, disposition: { kind: 'Complete', answers } });\n  store.versions.hook('creating').unsubscribe(fail);\n  expect(result.status).toBe('StorageFailure');\n  const query = await journal.query({}); expect(query.obligationHistory).toEqual([obligation]); expect(query.entries).toEqual([]); expect(query.workspaceRevision).toBe('r');\n});\n","tests/unit/d02-migration.test.ts":"import 'fake-indexeddb/auto';\nimport { expect, it } from 'vitest';\nimport { Store, Runtime, type RuntimeHost } from '../../src/infrastructure/storage';\nimport { Workspace } from '../../src/application/workspace';\nimport { TradeRecord } from '../../src/domain/trade-record';\nimport { Journal } from '../../src/domain/journal';\nimport { ReferenceCatalog } from '../../src/domain/reference-catalog';\nimport { TradeWorkflows } from '../../src/application/trade-workflows';\nconst path = '../../.cache/d1-fixture/d1-fixture.mjs';\nconst old = await import(path) as { Store: typeof Store; Runtime: typeof Runtime; Workspace: typeof Workspace; ReferenceCatalog: typeof ReferenceCatalog; TradeWorkflows: typeof TradeWorkflows; TradeRecord: typeof TradeRecord; Journal: typeof Journal };\nconst host: RuntimeHost = { check: async store => ({ transaction: await store.diagnosticTransaction(), capacity: true, control: true, inventory: true, protection: 'BestEffort' }), migrationCapacity: () => Promise.resolve(true), requestDurability: () => Promise.resolve('BestEffort') };\nconst instant = '2026-10-17T20:00:00Z';\nasync function d1() {\n  const name = `d2-migration-${crypto.randomUUID()}`;\n  const store = new old.Store(name); const runtime = new old.Runtime(store, host);\n  const opened = await new old.Workspace(runtime).initialize({ openingInstant: instant, timeZone: 'America/New_York' });\n  if (opened.status !== 'Opened') throw new Error('D1 initialization');\n  const catalog = new old.ReferenceCatalog(store, runtime);\n  const institution = await catalog.save({ kind: 'Institution', label: 'Real broker', generation: opened.root.generation, expectedCatalogRevision: opened.root.catalogRevision });\n  if (institution.status !== 'Saved') throw new Error('D1 Institution');\n  const account = await catalog.save({ kind: 'Account', label: 'Trading', parentId: institution.record.id, generation: opened.root.generation, expectedCatalogRevision: institution.catalogRevision });\n  if (account.status !== 'Saved') throw new Error('D1 Account');\n  const plan = await new old.TradeWorkflows(runtime, () => '2026-10-18T20:00:00Z').confirmPlan({ generation: opened.root.generation, expectedCatalogRevision: account.catalogRevision, definitionRevision: 'plan-reflection-v1', accountId: account.record.id, strategyId: 'long-stock', economicTime: instant, plan: { instrument: { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, quantity: '100', entry: '50', stop: '45', target: '60' }, reflection: { thesis: 'Thesis', invalidation: 'Invalidation' } });\n  if (plan.status !== 'Confirmed') throw new Error('D1 confirmation');\n  const before = await store.versions.toArray(); const root = await store.roots.get('active'); store.close();\n  return { name, before, root, plan };\n}\nit('migrates actual historical command-created D1 data without changing any domain value or identity', async () => {\n  const f = await d1(); const store = new Store(f.name); const runtime = new Runtime(store, host); const workspace = new Workspace(runtime);\n  const opened = await workspace.initialize({ openingInstant: instant });\n  expect(opened).toMatchObject({ status: 'Opened', root: { schema: 2 }, receipt: { migration: { from: 1, to: 2, sourceRows: 7, candidateRows: 9 } } });\n  expect(await new TradeRecord(store).getRecord(f.plan.trade.tradeId)).toEqual(f.plan.trade);\n  expect(await new Journal(store).query(f.plan.trade.tradeId)).toEqual([f.plan.entry]);\n  expect(await store.versions.bulkGet(f.before.map(row => row.version))).toEqual(f.before);\n  expect(await runtime.mutate(f.root?.generation, () => Promise.reject(new Error('stale apply')))).toEqual({ status: 'Conflict', reason: 'GenerationChanged' });\n  expect(await workspace.getStatus()).toMatchObject({ status: 'Writable', workspaceStatus: 'Ready' });\n  store.close();\n});\nit('preserves the complete D1 root/history on migration storage failure and retries safely', async () => {\n  const f = await d1(); const store = new Store(f.name); const runtime = new Runtime(store, host); const workspace = new Workspace(runtime);\n  const fail = () => { throw new Error('Injected candidate storage failure'); };\n  store.versions.hook('creating', fail);\n  expect(await workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'MigrationBlocked', reason: 'StorageFailure' });\n  expect(await store.roots.get('active')).toEqual(f.root);\n  expect(await store.versions.bulkGet(f.before.map(row => row.version))).toEqual(f.before);\n  store.versions.hook('creating').unsubscribe(fail);\n  expect(await workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'Opened', root: { schema: 2 } });\n  store.close();\n});\n\nit('leaves D1 active after activation abort, cleans orphan staging on retry and preserves stable Catalog versions', async () => {\n  const f = await d1(); const store = new Store(f.name); const runtime = new Runtime(store, host); const workspace = new Workspace(runtime);\n  const fail = () => { throw new Error('Injected activation abort'); };\n  store.roots.hook('updating', fail);\n  expect(await workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'MigrationBlocked' });\n  expect(await store.roots.get('active')).toEqual(f.root);\n  expect(await new TradeRecord(store).getRecord(f.plan.trade.tradeId)).toEqual(f.plan.trade);\n  store.roots.hook('updating').unsubscribe(fail);\n  const before = await new ReferenceCatalog(store).query({ family: 'Account' });\n  expect(await workspace.initialize({ openingInstant: instant })).toMatchObject({ status: 'Opened' });\n  const after = await new ReferenceCatalog(store).query({ family: 'Account' });\n  expect(after.records).toEqual(before.records);\n  expect(await store.projections.where('key').startsWith('migration-staging:').count()).toBe(0);\n  store.close();\n});\nit('rejects invalid populated source and missing migration headroom without touching old authority', async () => {\n  const f = await d1(); const store = new Store(f.name);\n  const runtime = new Runtime(store, { ...host, migrationCapacity: () => Promise.resolve(false) });\n  expect(await new Workspace(runtime).initialize({ openingInstant: instant })).toMatchObject({ status: 'MigrationBlocked', reason: 'MigrationCapacity' });\n  expect(await store.roots.get('active')).toEqual(f.root);\n  expect(await store.versions.toArray()).toEqual(f.before);\n  // Controlled invalid-history fixture; this is not normal domain creation.\n  await store.lifecycle.update(`${f.root?.generation}:${f.plan.trade.tradeId}`, { lifecycle: 'Open' });\n  const before = await store.versions.toArray();\n  expect(await new Workspace(new Runtime(store, host)).initialize({ openingInstant: instant })).toMatchObject({ status: 'MigrationBlocked', reason: 'InvalidSource' });\n  expect(await store.versions.toArray()).toEqual(before);\n  expect(await store.roots.get('active')).toEqual(f.root);\n  store.close();\n});\nit('rejects every ordinary mutation against an unmigrated D1 generation while preserving readable history', async () => {\n  const f = await d1(); const store = new Store(f.name);\n  const runtime = new Runtime(store, { ...host, migrationCapacity: () => Promise.resolve(false) });\n  expect(await new Workspace(runtime).initialize({ openingInstant: instant })).toMatchObject({ status: 'MigrationBlocked' });\n  const before = await store.roots.get('active');\n  expect(await runtime.mutate(f.root?.generation, () => Promise.resolve({ status: 'WronglyAccepted' }))).toMatchObject({ status: 'RuntimeNotWritable', runtimeReadiness: 'RecoveryOnly', failedChecks: ['MigrationRequired'] });\n  expect(await store.roots.get('active')).toEqual(before);\n  expect(await new TradeRecord(store).history(f.plan.trade.tradeId)).toEqual([f.plan.trade]);\n  store.close();\n});\nit('rejects contradictory retained Journal semantics rather than sealing an invalid source candidate', async () => {\n  const f = await d1(); const store = new Store(f.name); const entry = f.plan.entry;\n  await store.versions.update(entry.version, { value: { ...entry, responses: { ...entry.responses, thesis: { kind: 'Text', value: 'Contradicts the frozen Plan' } } } });\n  const before = await store.versions.toArray();\n  expect(await new Workspace(new Runtime(store, host)).initialize({ openingInstant: instant })).toMatchObject({ status: 'MigrationBlocked', reason: 'InvalidSource' });\n  expect(await store.roots.get('active')).toEqual(f.root); expect(await store.versions.toArray()).toEqual(before);\n  store.close();\n});\nit('returns a bounded no-write result when a real old connection blocks physical upgrade', async () => {\n  const f = await d1();\n  const held = await new Promise<IDBDatabase>((resolve, reject) => { const request = indexedDB.open(f.name); request.onerror = () => reject(request.error ?? new Error('Held open failed')); request.onsuccess = () => resolve(request.result); });\n  held.onversionchange = () => {};\n  const store = new Store(f.name); const workspace = new Workspace(new Runtime(store, host));\n  const pending = workspace.initialize({ openingInstant: instant });\n  const result = await Promise.race([pending, new Promise<{ status: 'BlockedTimeout' }>(resolve => setTimeout(() => resolve({ status: 'BlockedTimeout' }), 250))]);\n  held.close();\n  await pending;\n  expect(result).toMatchObject({ status: 'RuntimeNotWritable', workspaceStatus: 'IntegrityBlocked' });\n  store.close();\n});\n","tests/unit/d02-opening.test.ts":"import 'fake-indexeddb/auto';\nimport { describe, expect, it } from 'vitest';\nimport { openingFixture } from '../d02-fixtures';\ndescribe('atomic complete initial Stock entry', () => {\n  it('commits the 40/60 opening and returns authoritative Open facts and reflection after commit', async () => {\n    const f = await openingFixture();\n    const result = await f.workflows.recordPositionChange(f.command);\n    expect(result).toMatchObject({ status: 'Recorded', trade: { lifecycle: 'Open', opening: { executions: [{ quantity: '40' }, { quantity: '60' }] } }, derivation: { quantity: '100', grossBasis: '5020', openingFees: '3' }, journalOutcome: { obligation: { status: 'Completed' } } });\n    f.store.close();\n  });\n});\nit('reopens the complete committed opening with the same stable membership, versions and agreement', async () => {\n  const f = await openingFixture();\n  const result = await f.workflows.recordPositionChange(f.command);\n  if (result.status !== 'Recorded') throw new Error(result.status);\n  const { Store } = await import('../../src/infrastructure/storage');\n  const { TradeRecord } = await import('../../src/domain/trade-record');\n  const name = f.store.name; f.store.close(); const reopened = new Store(name);\n  expect(await new TradeRecord(reopened).getRecord(result.trade.tradeId)).toEqual(result.trade);\n  reopened.close();\n});\nit('allows exactly one competing initial save and returns a typed no-write conflict for the other', async () => {\n  const f = await openingFixture();\n  const results = await Promise.all([f.workflows.recordPositionChange(f.command), f.workflows.recordPositionChange(f.command)]);\n  expect(results.map(result => result.status).sort()).toEqual(['Conflict', 'Recorded']);\n  const { Journal } = await import('../../src/domain/journal');\n  expect((await new Journal(f.store).query({ tradeId: f.command.tradeId })).obligations).toHaveLength(1);\n  const before = await f.store.versions.toArray(); const root = await f.store.roots.get('active');\n  expect(await f.workflows.recordPositionChange(f.command)).toMatchObject({ status: 'Conflict' });\n  expect(await f.workflows.recordPositionChange({ ...f.command, executions: f.command.executions.map(execution => ({ ...execution, instrument: { ...execution.instrument, symbol: 'OTHER' } })), expectedWorkspaceRevision: root?.revision ?? '' })).toMatchObject({ status: 'Conflict' });\n  expect(await f.store.versions.toArray()).toEqual(before);\n  f.store.close();\n});\nit('captures Defer and Decline while preserving unrelated outstanding Debt unchanged', async () => {\n  const f = await openingFixture();\n  const first = await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n  if (first.status !== 'Recorded') throw new Error(first.status);\n  const { Journal } = await import('../../src/domain/journal');\n  const owed = (await new Journal(f.store).query({ scope: 'Outstanding' })).obligations;\n  const secondPlan = await f.workflows.confirmPlan(f.planCommand);\n  if (secondPlan.status !== 'Confirmed') throw new Error(secondPlan.status);\n  const root = await f.store.roots.get('active');\n  const second = await f.workflows.recordPositionChange({ ...f.command, expectedWorkspaceRevision: root?.revision ?? '', tradeId: secondPlan.trade.tradeId, expectedTradeRevision: secondPlan.trade.revision, plannedLegId: secondPlan.trade.plannedLegId, executions: f.command.executions.map(execution => ({ ...execution, plannedLegId: secondPlan.trade.plannedLegId })), reflection: { kind: 'Decline', reason: 'No reflection now' } });\n  expect(second).toMatchObject({ status: 'Recorded', journalOutcome: { obligation: { status: 'Declined' }, decline: { reason: 'No reflection now' } } });\n  expect((await new Journal(f.store).query({ scope: 'Outstanding' })).obligations).toEqual(owed);\n  expect((await new Journal(f.store).query(first.trade.tradeId))).toHaveLength(1);\n  expect(owed).toHaveLength(1);\n  f.store.close();\n});\n\nit('rolls back every opening participant and sequence after Journal staging aborts', async () => {\n  const f = await openingFixture();\n  const before = { root: await f.store.roots.get('active'), versions: await f.store.versions.toArray(), lifecycle: await f.store.lifecycle.toArray() };\n  const abort = (_key: unknown, row: { kind: string }) => { if (row.kind === 'JournalObligation') throw new Error('Injected Journal storage abort'); };\n  f.store.versions.hook('creating', abort);\n  expect(await f.workflows.recordPositionChange(f.command)).toMatchObject({ status: 'StorageFailure' });\n  f.store.versions.hook('creating').unsubscribe(abort);\n  expect({ root: await f.store.roots.get('active'), versions: await f.store.versions.toArray(), lifecycle: await f.store.lifecycle.toArray() }).toEqual(before);\n  const { Store } = await import('../../src/infrastructure/storage');\n  const name = f.store.name; f.store.close(); const reopened = new Store(name);\n  expect({ root: await reopened.roots.get('active'), versions: await reopened.versions.toArray(), lifecycle: await reopened.lifecycle.toArray() }).toEqual(before);\n  reopened.close();\n});\nit('reports all failed readiness checks before apply and records no opening or Journal outcome', async () => {\n  const f = await openingFixture(); const before = await f.store.versions.toArray(); const root = await f.store.roots.get('active');\n  const { vi } = await import('vitest');\n  vi.spyOn(f.runtime.host, 'check').mockResolvedValue({ transaction: false, capacity: false, control: false, inventory: false, protection: 'Unavailable' });\n  expect(await f.workflows.recordPositionChange(f.command)).toMatchObject({ status: 'RuntimeNotWritable', failedChecks: ['transaction', 'capacity', 'control', 'inventory'], workspaceStatus: 'RecoveryOnly' });\n  expect(await f.store.versions.toArray()).toEqual(before); expect(await f.store.roots.get('active')).toEqual(root);\n  f.store.close();\n});\n","tests/unit/d02-reads.test.ts":"import 'fake-indexeddb/auto';\nimport { expect, it } from 'vitest';\nimport { openingFixture } from '../d02-fixtures';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\nit('returns coherent Open Lots, Entry Quality and Journal outcomes without installed valuation', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange(f.command);\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  const detail = await new TradeViewsAndReporting(f.store).getTradeDetail(saved.trade.tradeId);\n  expect(detail).toMatchObject({ status: 'Ready', trade: saved.trade, quantity: '100', grossBasis: '5020', openingFees: '3', entryQuality: { comparison: 'BelowPlan', risk: '523', reward: '977' }, journal: { obligations: [{ status: 'Completed' }] } });\n  expect(detail).not.toHaveProperty('valuation');\n  f.store.close();\n});\nit('selects only authoritative Open membership and resolves original Execution Anchors to their Trade', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange(f.command);\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  const views = new TradeViewsAndReporting(f.store);\n  expect(await views.browseTrades({ lifecycle: 'Open' })).toMatchObject({ status: 'Ready', items: [{ trade: { tradeId: saved.trade.tradeId, lifecycle: 'Open' }, quantity: '100' }] });\n  expect(await views.browseTrades({ lifecycle: 'Planned' })).toMatchObject({ status: 'Empty' });\n  const { TradeRecord } = await import('../../src/domain/trade-record');\n  const records = new TradeRecord(f.store);\n  expect(await records.resolveAnchors( saved.trade.opening?.executions.map(execution => ({ kind: 'Execution', executionId: execution.id })) ?? [])).toMatchObject({ status: 'Ready', resolutions: [{ status: 'Effective', owningTradeId: saved.trade.tradeId }, { status: 'Effective', owningTradeId: saved.trade.tradeId }] });\n  f.store.close();\n});\nit('blocks lifecycle, lot and deviation disagreement without repairing any authority on read', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange(f.command);\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  const views = new TradeViewsAndReporting(f.store);\n  const key = `${f.command.generation}:${saved.trade.tradeId}`;\n  await f.store.lifecycle.update(key, { lifecycle: 'Planned' });\n  const before = await f.store.lifecycle.toArray();\n  expect(await views.browseTrades({ lifecycle: 'Planned' })).toMatchObject({ status: 'IntegrityBlocked', findings: ['LifecycleDisagreement'] });\n  expect(await f.store.lifecycle.toArray()).toEqual(before);\n  await f.store.lifecycle.update(key, { lifecycle: 'Open' });\n  const agreement = (await f.store.versions.where('[generation+tradeId]').equals([f.command.generation, saved.trade.tradeId]).filter(row => row.kind === 'Agreement').toArray())[0];\n  if (!agreement) throw new Error('Agreement fixture');\n  for (const value of [{ ...saved.trade.opening?.recordedAgreement, lotMatches: [{ openingId: 'bad', disposingId: 'bad', quantity: '1' }] }, { ...saved.trade.opening?.recordedAgreement, deviations: [{ kind: 'PlannedLegTerms', plannedLegId: 'bad', mismatches: ['symbol'] }] }]) {\n    await f.store.versions.update(agreement.version, { value });\n    const bad = await f.store.versions.toArray();\n    expect(await views.getTradeDetail(saved.trade.tradeId)).toMatchObject({ status: 'IntegrityBlocked', findings: ['OpeningAgreementDisagreement'] });\n    expect(await f.store.versions.toArray()).toEqual(bad);\n  }\n  f.store.close();\n});\nit('returns ChangedDuringAssembly for a detail binding invalidated by a Debt answer', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  const { Journal } = await import('../../src/domain/journal');\n  const settled = await new Journal(f.store, f.runtime).save({ kind: 'ResolveDebt', generation: f.command.generation, expectedWorkspaceRevision: saved.workspaceRevision, obligationId: saved.journalOutcome.obligation.id, expectedRevision: saved.journalOutcome.obligation.revision, disposition: { kind: 'Complete', answers: { 'decision-mode': 'as-planned', emotion: 'calm', confidence: '5' } } });\n  expect(settled).toMatchObject({ status: 'Saved' });\n  const views = new TradeViewsAndReporting(f.store);\n  expect(await views.getTradeDetail(saved.trade.tradeId, saved.workspaceRevision)).toMatchObject({ status: 'ChangedDuringAssembly' });\n  expect(await views.getTradeDetail(saved.trade.tradeId)).toMatchObject({ status: 'Ready', journal: { obligations: [{ status: 'Completed' }] } });\n  f.store.close();\n});\nit('rejects a stale authoritative lifecycle FactRevision consistently in detail and opening preparation', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange(f.command);\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  await f.store.lifecycle.update(`${f.command.generation}:${saved.trade.tradeId}`, { revision: 'stale-fact-revision' });\n  const before = await f.store.lifecycle.toArray();\n  expect(await new TradeViewsAndReporting(f.store).getTradeDetail(saved.trade.tradeId)).toMatchObject({ status: 'IntegrityBlocked', findings: ['FactRevisionDisagreement'] });\n  expect(await f.workflows.recordPositionChange(f.command)).toMatchObject({ status: 'IntegrityBlocked', findings: ['FactRevisionDisagreement'] });\n  expect(await f.store.lifecycle.toArray()).toEqual(before);\n  f.store.close();\n});\n","tests/unit/d02-ui.test.tsx":"import 'fake-indexeddb/auto';\nimport { afterEach, expect, it, vi } from 'vitest';\nimport { cleanup, render, screen, waitFor } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport { openingFixture } from '../d02-fixtures';\nimport { App } from '../../src/presentation/App';\nimport { TradeViewsAndReporting } from '../../src/application/trade-views-and-reporting';\nimport { Journal } from '../../src/domain/journal';\nafterEach(cleanup);\nit('records several Executions through the production UI and renders the returned Open outcome without read-back', async () => {\n  const f = await openingFixture(); const user = userEvent.setup(); const views = new TradeViewsAndReporting(f.store);\n  const services = { workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views, journal: new Journal(f.store, f.runtime) };\n  render(<App services={services} />);\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  await user.click(await screen.findByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }));\n  await user.type(screen.getByLabelText('Execution 1 quantity (shares)'), '40');\n  await user.type(screen.getByLabelText('Execution 1 price (USD)'), '49');\n  await user.clear(screen.getByLabelText('Execution 1 fee (USD)')); await user.type(screen.getByLabelText('Execution 1 fee (USD)'), '1');\n  await user.click(screen.getByRole('button', { name: 'Add another execution' }));\n  await user.type(screen.getByLabelText('Execution 2 quantity (shares)'), '60');\n  await user.type(screen.getByLabelText('Execution 2 price (USD)'), '51');\n  await user.clear(screen.getByLabelText('Execution 2 fee (USD)')); await user.type(screen.getByLabelText('Execution 2 fee (USD)'), '2');\n  await user.click(screen.getByLabelText('Complete reflection now'));\n  await user.click(screen.getByLabelText('As Planned')); await user.click(screen.getByLabelText('Calm'));\n  await user.selectOptions(screen.getByLabelText('Decision confidence'), '4');\n  const readback = vi.spyOn(views, 'getTradeDetail');\n  await user.click(screen.getByRole('button', { name: 'Save opening entry' }));\n  await waitFor(() => expect(screen.getByRole('heading', { name: 'XYZ · Open' })).toBeTruthy());\n  expect(screen.getByText('$523.00')).toBeTruthy(); expect(screen.getByText('$977.00')).toBeTruthy();\n  expect(readback).not.toHaveBeenCalled();\n  expect(await services.journal.query(f.command.tradeId)).toHaveLength(2);\n  cleanup(); f.store.close();\n});\nit('preserves multiple Executions and reflection answers across navigation, validation and Cancel without writing', async () => {\n  const f = await openingFixture(); const user = userEvent.setup();\n  const services = { workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) };\n  render(<App services={services} />);\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  await user.click(await screen.findByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }));\n  await user.type(screen.getByLabelText('Execution 1 quantity (shares)'), '40'); await user.type(screen.getByLabelText('Execution 1 price (USD)'), '49');\n  await user.click(screen.getByRole('button', { name: 'Add another execution' }));\n  await user.type(screen.getByLabelText('Execution 2 quantity (shares)'), '59'); await user.type(screen.getByLabelText('Execution 2 price (USD)'), '51');\n  await user.click(screen.getByLabelText('Complete reflection now')); await user.click(screen.getByLabelText('As Planned'));\n  const before = await f.store.versions.toArray();\n  await user.click(screen.getByRole('button', { name: 'Save opening entry' }));\n  expect(await screen.findByText('Executions must total exactly the frozen planned quantity.')).toBeTruthy();\n  expect(document.activeElement?.textContent).toBe('Review before continuing');\n  await user.click(screen.getByRole('button', { name: 'Close opening entry' }));\n  await user.click(screen.getByRole('button', { name: 'Workspace' }));\n  await user.click(screen.getByRole('button', { name: 'Trades' }));\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  await user.click(await screen.findByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }));\n  expect(screen.getByLabelText<HTMLInputElement>('Execution 2 quantity (shares)').value).toBe('59');\n  expect(screen.getByLabelText<HTMLInputElement>('As Planned').checked).toBe(true);\n  await user.click(screen.getByRole('button', { name: 'Cancel' }));\n  expect(await f.store.versions.toArray()).toEqual(before);\n  cleanup(); f.store.close();\n});\nit('opens the owed trigger-time form from global Journal Debt and renders settlement without a query read-back', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  const user = userEvent.setup(); const journal = new Journal(f.store, f.runtime);\n  const services = { workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal };\n  render(<App services={services} />);\n  await user.click(await screen.findByRole('button', { name: 'Journal Debt' }));\n  await user.click(await screen.findByRole('button', { name: 'Answer reflection' }));\n  await user.click(screen.getByLabelText('As Planned')); await user.click(screen.getByLabelText('Calm')); await user.selectOptions(screen.getByLabelText('Decision confidence'), '5');\n  const query = vi.spyOn(journal, 'query');\n  await user.click(screen.getByRole('button', { name: 'Save Debt outcome' }));\n  expect(await screen.findByText('Reflection completed. Journal Debt settled.')).toBeTruthy();\n  expect(query).not.toHaveBeenCalled();\n  expect((await journal.query({ tradeId: f.command.tradeId })).obligations).toMatchObject([{ status: 'Completed', debtId: saved.journalOutcome.obligation.debtId }]);\n  cleanup(); f.store.close();\n});\nit('preserves an opening draft through conflict and explicitly refreshes the current Trade binding for retry', async () => {\n  const f = await openingFixture(); const user = userEvent.setup();\n  const services = { workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) };\n  render(<App services={services} />);\n  await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ }));\n  await user.click(await screen.findByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }));\n  await user.type(screen.getByLabelText('Execution 1 quantity (shares)'), '100'); await user.type(screen.getByLabelText('Execution 1 price (USD)'), '50');\n  await f.workflows.confirmPlan(f.planCommand);\n  await user.click(screen.getByRole('button', { name: 'Save opening entry' }));\n  await user.click(await screen.findByRole('button', { name: 'Review current Trade' }));\n  expect(screen.getByLabelText<HTMLInputElement>('Execution 1 quantity (shares)').value).toBe('100');\n  await user.click(screen.getByRole('button', { name: 'Save opening entry' }));\n  expect(await screen.findByRole('heading', { name: 'XYZ · Open' })).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('preserves Debt answers through a Workspace conflict and permits an explicit binding review before retry', async () => {\n  const f = await openingFixture(); const saved = await f.workflows.recordPositionChange({ ...f.command, reflection: { kind: 'Defer' } });\n  if (saved.status !== 'Recorded') throw new Error(saved.status);\n  const user = userEvent.setup(); const journal = new Journal(f.store, f.runtime);\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal }} />);\n  await user.click(await screen.findByRole('button', { name: 'Journal Debt' })); await user.click(await screen.findByRole('button', { name: 'Answer reflection' }));\n  await user.click(screen.getByLabelText('As Planned')); await user.click(screen.getByLabelText('Calm')); await user.selectOptions(screen.getByLabelText('Decision confidence'), '5');\n  await f.workflows.confirmPlan(f.planCommand);\n  await user.click(screen.getByRole('button', { name: 'Save Debt outcome' }));\n  await user.click(await screen.findByRole('button', { name: 'Review current Debt' }));\n  expect(screen.getByLabelText<HTMLInputElement>('As Planned').checked).toBe(true);\n  await user.click(screen.getByRole('button', { name: 'Save Debt outcome' }));\n  expect(await screen.findByText('Reflection completed. Journal Debt settled.')).toBeTruthy();\n  cleanup(); f.store.close();\n});\nit('enters Integrity Blocked if an existing root becomes unreadable during opening Save', async () => {\n  const f = await openingFixture(); const user = userEvent.setup(); const services = { workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) };\n  render(<App services={services} />); await user.click(await screen.findByRole('button', { name: /XYZ · Planned/ })); await user.click(await screen.findByRole('button', { name: /Record initial Position Change|Continue unsaved entry/ }));\n  await user.type(screen.getByLabelText('Execution 1 quantity (shares)'), '100'); await user.type(screen.getByLabelText('Execution 1 price (USD)'), '50');\n  const read = vi.spyOn(f.store.roots, 'get').mockRejectedValue(new Error('Injected unreadable existing root'));\n  await user.click(screen.getByRole('button', { name: 'Save opening entry' }));\n  expect(await screen.findByRole('heading', { name: 'IntegrityBlocked' })).toBeTruthy();\n  read.mockRestore(); cleanup(); f.store.close();\n});\nit('shows holdings, opening fees and Entry Quality in the Open list instead of an ambiguous planned risk label', async () => {\n  const f = await openingFixture(); await f.workflows.recordPositionChange(f.command); const user = userEvent.setup();\n  render(<App services={{ workspace: f.workspace, catalog: f.catalog, workflows: f.workflows, views: new TradeViewsAndReporting(f.store), journal: new Journal(f.store, f.runtime) }} />);\n  await user.click(await screen.findByRole('button', { name: 'Open' }));\n  expect(await screen.findByRole('button', { name: /XYZ · Open.*100 shares.*\\$3.00 opening fees.*Below Plan/ })).toBeTruthy();\n  cleanup(); f.store.close();\n});\n","tools/browser-generator.ts":"import './d02-browser-generator';\nimport { Store, Runtime } from '../src/infrastructure/storage';\nimport { BrowserHost } from '../src/infrastructure/browser-host';\nimport { Workspace } from '../src/application/workspace';\nimport { TradeWorkflows } from '../src/application/trade-workflows';\nimport { TradeViewsAndReporting } from '../src/application/trade-views-and-reporting';\nimport { ReferenceCatalog } from '../src/domain/reference-catalog';\ninterface DatasetReceipt { count: number; serializedBytes: number; elapsedMs: number; samples: string[]; storage: StorageEstimate; readiness: Awaited<ReturnType<Workspace['getStatus']>>; counts: Record<string, number> }\nasync function generate(count: number): Promise<DatasetReceipt> {\n  const store = new Store('trade-journal-v3');\n  const runtime = new Runtime(store, new BrowserHost());\n  const opened = await new Workspace(runtime).initialize({ openingInstant: '2026-10-18T22:00:00Z', timeZone: 'America/New_York' });\n  if (opened.status !== 'Opened') throw new Error(`Dataset initialization: ${opened.status}`);\n  const catalog = await new ReferenceCatalog(store).query({ family: 'Account' });\n  const account = catalog.records.find(record => record.kind === 'Account' && record.active);\n  if (!account || catalog.status !== 'Ready') throw new Error('Command-created Account required');\n  const workflows = new TradeWorkflows(runtime, () => '2026-10-18T23:00:00Z');\n  const start = performance.now(); let serializedBytes = 0; const samples: string[] = [];\n  for (let i = 0; i < count; i++) {\n    const date = new Date(Date.UTC(2021, 0, 4 + Math.floor(i / 20) * 7 / 5));\n    const result = await workflows.confirmPlan({ generation: opened.root.generation, expectedCatalogRevision: catalog.catalogRevision, definitionRevision: opened.root.definitionRevision, accountId: account.id, strategyId: 'long-stock', economicTime: date.toISOString(), plan: { instrument: { kind: 'Stock', currency: 'USD', symbol: ['XYZ', 'ABC', 'DEF'][i % 3] ?? 'XYZ' }, quantity: '100', entry: '50', stop: '45', target: '60' }, reflection: { thesis: `Deterministic D1 Plan ${i}: earnings thesis`, invalidation: `Earnings evidence reverses for Plan ${i}`, conviction: String(1 + i % 5), emotion: 'calm' } });\n    if (result.status !== 'Confirmed') throw new Error(`Dataset command ${i}: ${result.status}`);\n    serializedBytes += new TextEncoder().encode(JSON.stringify(result.trade) + JSON.stringify(result.entry)).byteLength;\n    if (i === 0 || i === Math.floor(count / 2) || i === count - 1) samples.push(result.trade.tradeId);\n    if ((i + 1) % 1000 === 0) console.log(`D1 command-created Plans: ${i + 1}; elapsed ${Math.round(performance.now() - start)} ms`);\n  }\n  const storage = await navigator.storage.estimate();\n  const readiness = await new Workspace(runtime).getStatus();\n  const counts = { plans: await store.versions.where('[generation+kind]').equals([opened.root.generation, 'Plan']).count(), entries: await store.versions.where('[generation+kind]').equals([opened.root.generation, 'JournalEntry']).count(), lifecycle: await store.lifecycle.count(), versions: await store.versions.count() };\n  store.close();\n  return { count, serializedBytes, elapsedMs: performance.now() - start, samples, storage, readiness, counts };\n}\nasync function inspect() {\n  const store = new Store('trade-journal-v3');\n  const views = new TradeViewsAndReporting(store);\n  let count = 0; let cursor: string | undefined; let first: string | undefined;\n  do {\n    const page = await views.browseTrades({ cursor });\n    if (page.status !== 'Ready' && page.status !== 'Empty') throw new Error(`Dataset read: ${page.status}`);\n    if (!first) first = page.items[0]?.trade.tradeId;\n    for (const item of page.items) if (item.trade.baseline.oneR !== '500' || item.entryReadiness !== 'Unfilled') throw new Error('Dataset correctness mismatch');\n    count += page.items.length; cursor = page.nextCursor;\n  } while (cursor);\n  const detail = first ? await views.getTradeDetail(first) : undefined;\n  store.close();\n  return { count, first, detail };\n}\nasync function measure() {\n  const store = new Store('trade-journal-v3');\n  try { return await new Workspace(new Runtime(store, new BrowserHost())).getStatus(); }\n  finally { store.close(); }\n}\nasync function discardPrivateReceipts() {\n  const store = new Store('trade-journal-v3');\n  try { await store.projections.clear(); } finally { store.close(); }\n}\ndeclare global { interface Window { d1Evidence: { generate: typeof generate; inspect: typeof inspect; measure: typeof measure; discardPrivateReceipts: typeof discardPrivateReceipts } } }\nwindow.d1Evidence = { generate, inspect, measure, discardPrivateReceipts };\n","tools/bug001-evidence.mjs":"import { spawn, spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';\nimport { join } from 'node:path';\nconst [id, stage, command, ...args] = process.argv.slice(2);\nif (!id || !stage || !command) throw new Error('Usage: evidence.mjs ID STAGE COMMAND [ARGUMENTS]');\nfunction files(path) { return readdirSync(path, { withFileTypes: true }).filter(entry => !entry.name.endsWith('.tsbuildinfo')).flatMap(entry => entry.isDirectory() ? files(join(path, entry.name)) : [join(path, entry.name)]); }\nconst paths = [...files('src'), ...files('worker'), ...files('tests'), ...files('tools'), ...files('public'), ...readdirSync('.').filter(path => /\\.config\\.(ts|mjs)$/.test(path)), 'package.json', 'package-lock.json', 'tsconfig.json', 'index.html'].sort();\nconst snapshot = Object.fromEntries(paths.map(path => [path, path.endsWith('.png') ? { encoding: 'base64', data: readFileSync(path).toString('base64') } : readFileSync(path, 'utf8')]));\nconst digest = createHash('sha256').update(JSON.stringify(snapshot)).digest('hex');\nconst directory = 'implementation/evidence/bug-001';\nmkdirSync(`${directory}/source-snapshots`, { recursive: true });\nwriteFileSync(`${directory}/source-snapshots/${digest}.json`, JSON.stringify(snapshot));\nconst inputPaths = true ? ['implementation/plan/bug-001-ui-mockup-fidelity.md', 'implementation/plan/bug-001-baseline.md', 'implementation/plan/d02-implementation-baseline.md', 'implementation/plan/d02-initial-stock-entry.md', 'implementation/plan/d01-capacity-policy-revision.md', 'implementation/plan/d02-capacity-evidence.md', 'specs/evaluation/kickoff-prompt.md'] : [];\nconst inputs = Object.fromEntries(inputPaths.map(path => [path, createHash('sha256').update(readFileSync(path)).digest('hex')]));\nconst baseline = spawnSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).stdout.trim();\nconst result = await new Promise(resolve => {\n  const child = spawn(command, args, { env: process.env });\n  const stdout = []; const stderr = []; let error;\n  child.stdout.on('data', chunk => { stdout.push(chunk); process.stdout.write(chunk); });\n  child.stderr.on('data', chunk => { stderr.push(chunk); process.stderr.write(chunk); });\n  child.on('error', failure => { error = failure; });\n  child.on('close', status => resolve({ status, stdout: Buffer.concat(stdout).toString('utf8'), stderr: Buffer.concat(stderr).toString('utf8'), error }));\n});\nconst log = { id, stage, baseline, inputs, sourceDigest: digest, command: [command, ...args], exit: result.status, stdout: result.stdout, stderr: result.stderr, error: result.error?.message };\nlet output = `${directory}/${id}-${stage}.json`;\nfor (let attempt = 2; existsSync(output); attempt++) output = `${directory}/${id}-${stage}-attempt${attempt}.json`;\nwriteFileSync(output, JSON.stringify(log, null, 2));\nprocess.exit(result.status ?? 1);\n","tools/build-browser-generator.mjs":"import { build } from 'vite';\nimport { resolve } from 'node:path';\nimport { releaseId } from './release.ts';\nawait build({ configFile: false, publicDir: false, define: { __RELEASE_ID__: JSON.stringify(releaseId) }, build: { outDir: '.cache/browser-generator', target: 'es2023', lib: { entry: resolve('tools/browser-generator.ts'), formats: ['iife'], name: 'D1Evidence', fileName: () => 'generator.js' } } });\n","tools/build-d1-fixture.mjs":"import { execFileSync } from 'node:child_process';\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { dirname } from 'node:path';\nimport { build } from 'vite';\nconst revision = 'f36c52df0fdc101498067aaed1f5ffdc46185438';\nconst paths = execFileSync('git', ['ls-tree', '-r', '--name-only', revision, 'src', 'public/capabilities.json'], { encoding: 'utf8' }).trim().split('\\n');\nfor (const path of paths) {\n  const target = `.cache/d1-source/${path}`;\n  mkdirSync(dirname(target), { recursive: true });\n  writeFileSync(target, execFileSync('git', ['show', `${revision}:${path}`]));\n}\nwriteFileSync('.cache/d1-source/entry.ts', `export { Store, Runtime } from './src/infrastructure/storage';\nexport { Workspace } from './src/application/workspace';\nexport { ReferenceCatalog } from './src/domain/reference-catalog';\nexport { TradeWorkflows } from './src/application/trade-workflows';\nexport { TradeRecord } from './src/domain/trade-record';\nexport { Journal } from './src/domain/journal';\n`);\nawait build({ configFile: false, build: { lib: { entry: '.cache/d1-source/entry.ts', formats: ['es'], fileName: () => 'd1-fixture.mjs' }, outDir: '.cache/d1-fixture', emptyOutDir: true, rolldownOptions: { external: ['dexie', 'decimal.js', '@js-temporal/polyfill'] } } });\n","tools/build-d1-release.mjs":"import { execFileSync } from 'node:child_process';\nimport { mkdirSync, writeFileSync, existsSync, symlinkSync } from 'node:fs';\nimport { dirname, resolve } from 'node:path';\nconst revision = 'f36c52df0fdc101498067aaed1f5ffdc46185438';\nconst source = resolve('.cache/d1-release-source');\nconst output = resolve('.cache/d1-release');\nconst paths = execFileSync('git', ['ls-tree', '-r', '--name-only', revision], { encoding: 'utf8' }).trim().split('\\n').filter(path => /^(src\\/|worker\\/|tools\\/|public\\/)/.test(path) || ['package.json', 'package-lock.json', 'index.html', 'vite.config.ts', 'playwright.config.ts', 'playwright.benchmark.config.ts', 'vitest.config.ts'].includes(path));\nfor (const path of paths) { const target = `${source}/${path}`; mkdirSync(dirname(target), { recursive: true }); writeFileSync(target, execFileSync('git', ['show', `${revision}:${path}`])); }\nif (!existsSync(`${source}/node_modules`)) symlinkSync(resolve('node_modules'), `${source}/node_modules`, 'dir');\n// Only the documented public port; never copy a user or sibling environment file.\nwriteFileSync(`${source}/.env.local`, 'DEV_PORT=5174\\n');\nconst env = { ...process.env, D1_BUILD_DIR: output };\nexecFileSync(process.execPath, [resolve('node_modules/vite/bin/vite.js'), 'build'], { cwd: source, env, stdio: 'inherit' });\nexecFileSync(process.execPath, ['tools/inventory.mjs'], { cwd: source, env, stdio: 'inherit' });\nexecFileSync(process.execPath, ['tools/build-browser-generator.mjs'], { cwd: source, env, stdio: 'inherit' });\nconsole.log(`Historical D1 production release: ${output}; source ${revision}`);\n","tools/build-d2-legacy-native.mjs":"import { writeFileSync, mkdirSync } from 'node:fs';\nimport { build } from 'vite';\nimport { releaseId } from './release.ts';\nmkdirSync('.cache/d1-source', { recursive: true });\nwriteFileSync('.cache/d1-source/native-entry.ts', `\nimport { Store, Runtime } from './src/infrastructure/storage';\nimport { BrowserHost } from './src/infrastructure/browser-host';\nimport { Workspace } from './src/application/workspace';\nimport { ReferenceCatalog } from './src/domain/reference-catalog';\nimport { TradeWorkflows } from './src/application/trade-workflows';\nwindow.d2Legacy = { async createAt(name) {\n  const store = new Store(name); const runtime = new Runtime(store, new BrowserHost());\n  try {\n    const opened = await new Workspace(runtime).initialize({openingInstant:'2026-10-17T20:00:00Z',timeZone:'America/New_York'});\n    if(opened.status!=='Opened')throw new Error('Legacy init '+opened.status);\n    const catalog = new ReferenceCatalog(store,runtime);\n    const institution=await catalog.save({kind:'Institution',label:'Historical broker',generation:opened.root.generation,expectedCatalogRevision:opened.root.catalogRevision});\n    if(institution.status!=='Saved')throw new Error('Legacy Institution');\n    const account=await catalog.save({kind:'Account',label:'Trading',parentId:institution.record.id,generation:opened.root.generation,expectedCatalogRevision:institution.catalogRevision});\n    if(account.status!=='Saved')throw new Error('Legacy Account');\n    const confirmed=await new TradeWorkflows(runtime,()=>'2026-10-18T20:00:00Z').confirmPlan({generation:opened.root.generation,expectedCatalogRevision:account.catalogRevision,definitionRevision:'plan-reflection-v1',accountId:account.record.id,strategyId:'long-stock',economicTime:'2026-10-17T20:00:00Z',plan:{instrument:{kind:'Stock',symbol:'XYZ',currency:'USD'},quantity:'100',entry:'50',stop:'45',target:'60'},reflection:{thesis:'Historical thesis',invalidation:'Historical invalidation'}});\n    if(confirmed.status!=='Confirmed')throw new Error('Legacy Plan');\n    return { root:await store.roots.get('active'),confirmed,versions:await store.versions.toArray(),lifecycle:await store.lifecycle.toArray() };\n  } finally {store.close();}\n} };\n`);\nawait build({ configFile: false, define: { __RELEASE_ID__: JSON.stringify(releaseId) }, build: { lib: { entry: '.cache/d1-source/native-entry.ts', formats: ['iife'], name: 'D2LegacyFixture', fileName: () => 'legacy.js' }, outDir: '.cache/d2-legacy-native', emptyOutDir: true } });\n","tools/d02-browser-generator.ts":"import { Workspace } from '../src/application/workspace';\nimport { Store, Runtime } from '../src/infrastructure/storage';\nimport { BrowserHost } from '../src/infrastructure/browser-host';\nimport { TradeWorkflows } from '../src/application/trade-workflows';\nimport { TradeViewsAndReporting } from '../src/application/trade-views-and-reporting';\nimport { Journal } from '../src/domain/journal';\nasync function openDataset(count: number) {\n  const store = new Store('trade-journal-v3'); const runtime = new Runtime(store, new BrowserHost());\n  try {\n    const views = new TradeViewsAndReporting(store); const openingInstant = new Date().toISOString(); const workflows = new TradeWorkflows(runtime, () => openingInstant); const journal = new Journal(store, runtime);\n    const selected: string[] = []; let cursor: string | undefined;\n    do { const page = await views.browseTrades({ cursor }); if (page.status !== 'Ready') throw new Error(`Plan selection ${page.status}`); selected.push(...page.items.map(item => item.trade.tradeId)); cursor = page.nextCursor; } while (selected.length < count && cursor);\n    const receipts: unknown[] = [];\n    for (const [index, id] of selected.slice(0, count).entries()) {\n      const detail = await views.getTradeDetail(id); if (detail.status !== 'Ready') throw new Error(`Plan detail ${detail.status}`);\n      const root = await store.roots.get('active'); if (!root) throw new Error('Workspace required');\n      const kind = (['Complete', 'Defer', 'Decline'] as const)[index % 3] ?? 'Complete';\n      const result = await workflows.recordPositionChange({ kind: 'InitialStockEntry', generation: root.generation, expectedWorkspaceRevision: root.revision, expectedCatalogRevision: root.catalogRevision, tradeId: id, expectedTradeRevision: detail.trade.revision, plannedLegId: detail.trade.plannedLegId, definitionRevision: 'position-change-reflection-v1', economicTime: openingInstant, executions: [{ quantity: '40', price: '49', fee: '1' }, { quantity: '60', price: '51', fee: '2' }].map(execution => ({ ...execution, instrument: detail.trade.plan.instrument ?? { kind: 'Stock', symbol: 'XYZ', currency: 'USD' }, action: 'Buy', plannedLegId: detail.trade.plannedLegId, economicTime: openingInstant })), reflection: kind === 'Complete' ? { kind, answers: { 'decision-mode': 'as-planned', emotion: 'calm', confidence: '4' } } : { kind } });\n      if (result.status !== 'Recorded') throw new Error(`Opening ${index} ${JSON.stringify(result)}`);\n      receipts.push(result.receipt);\n      if (kind === 'Defer' && index % 6 === 1) {\n        const settlement = await journal.save({ kind: 'ResolveDebt', generation: root.generation, expectedWorkspaceRevision: result.workspaceRevision, obligationId: result.journalOutcome.obligation.id, expectedRevision: result.journalOutcome.obligation.revision, disposition: { kind: 'Complete', answers: { 'decision-mode': 'as-planned', emotion: 'calm', confidence: '5' } } });\n        if (settlement.status !== 'Saved') throw new Error(`Debt ${index} ${settlement.status}`);\n      }\n    }\n    return { count: selected.slice(0, count).length, receipts, counts: await counts(store) };\n  } finally { store.close(); }\n}\nasync function counts(store: Store) {\n  const root = await store.roots.get('active'); if (!root) throw new Error('Workspace required');\n  const kinds = ['Plan', 'Execution', 'PositionChange', 'Agreement', 'TradeState', 'JournalEntry', 'JournalDecline', 'JournalObligation'];\n  return Object.fromEntries(await Promise.all(kinds.map(async kind => [kind, await store.versions.where('[generation+kind]').equals([root.generation, kind]).count()] as const)));\n}\nasync function inspectOpen() {\n  const store = new Store('trade-journal-v3');\n  try {\n    const views = new TradeViewsAndReporting(store); const items: unknown[] = []; let cursor: string | undefined;\n    do {\n      const page = await views.browseTrades({ lifecycle: 'Open', cursor });\n      if (page.status !== 'Ready' && page.status !== 'Empty') throw new Error(`Open read ${page.status}`);\n      for (const item of page.items) {\n        if (item.status !== 'Derived' || !('quantity' in item) || item.quantity !== '100' || item.grossBasis !== '5020' || item.openingFees !== '3' || item.entryQuality.risk !== '523' || item.trade.lifecycle !== 'Open') throw new Error('Open correctness disagreement');\n        items.push(item);\n      }\n      cursor = page.nextCursor;\n    } while (cursor);\n    const debt = await new Journal(store).query({ scope: 'Outstanding' });\n    return { items, debt: debt.obligations, counts: await counts(store) };\n  } finally { store.close(); }\n}\nasync function d1Digest() {\n  const store = new Store('trade-journal-v3');\n  try {\n    const snapshot = await store.transaction('r', [store.roots, store.versions, store.lifecycle], async () => {\n      const root = await store.roots.get('active'); if (!root) throw new Error('Workspace required');\n      const rows = (await Promise.all(['Plan', 'JournalEntry', 'Institution', 'Account', 'Strategy', 'Definition', 'Source'].map(kind => store.versions.where('[generation+kind]').equals([root.generation, kind]).toArray()))).flat().filter(row => !['position-change-reflection', 'position-change'].includes(row.id));\n      rows.sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : a.kind.localeCompare(b.kind));\n      const membership = await store.lifecycle.where('[generation+tradeId]').between([root.generation, ''], [root.generation, '\\uffff']).toArray();\n      return { root, rows: rows.map(({ id, kind, tradeId, economicTime, saveTime, sequence, commitOrdinal, value }) => ({ id, kind, tradeId, economicTime, saveTime, sequence, commitOrdinal, value })), membership: membership.map(({ tradeId, lifecycle, accountId, symbol, economicTime, economicOrder, sequence, revision }) => ({ tradeId, lifecycle, accountId, symbol, economicTime, economicOrder, sequence, revision })) };\n    });\n    const bytes = new TextEncoder().encode(JSON.stringify({ rows: snapshot.rows, membership: snapshot.membership }));\n    const digest = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), value => value.toString(16).padStart(2, '0')).join('');\n    return { digest, serializedBytes: bytes.length, count: snapshot.rows.length, membership: snapshot.membership.length, root: snapshot.root, storage: await navigator.storage.estimate() };\n  } finally { store.close(); }\n}\nasync function oldD1Digest() {\n  // Raw read-only evidence reader for a physical D1 database: opening a D2 Store\n  // would itself request a physical upgrade before the update flow under test.\n  return new Promise<{ root: unknown; rows: unknown[]; membership: unknown[] }>((resolve, reject) => {\n    const request = indexedDB.open('trade-journal-v3'); request.onerror = () => reject(request.error ?? new Error('D1 read failed'));\n    request.onsuccess = () => { const db = request.result; const tx = db.transaction(['roots', 'versions', 'lifecycle']); const roots = tx.objectStore('roots').get('active'); const versions = tx.objectStore('versions').getAll(); const membership = tx.objectStore('lifecycle').getAll(); tx.oncomplete = () => { resolve({ root: roots.result as unknown, rows: versions.result as unknown[], membership: membership.result as unknown[] }); db.close(); }; };\n  });\n}\nasync function migrateDatabase(name: string) {\n  const store = new Store(name);\n  try { return await new Workspace(new Runtime(store, new BrowserHost())).initialize({ openingInstant: '2026-10-21T20:00:00Z' }); } finally { store.close(); }\n}\ndeclare global { interface Window { d2Evidence: { releaseId: string; migrateDatabase: typeof migrateDatabase; openDataset: typeof openDataset; inspectOpen: typeof inspectOpen; d1Digest: typeof d1Digest; oldD1Digest: typeof oldD1Digest } } }\nwindow.d2Evidence = { releaseId: __RELEASE_ID__, migrateDatabase, openDataset, inspectOpen, d1Digest, oldD1Digest };\n","tools/evidence.mjs":"import { spawn, spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';\nimport { join } from 'node:path';\nconst [id, stage, command, ...args] = process.argv.slice(2);\nif (!id || !stage || !command) throw new Error('Usage: evidence.mjs ID STAGE COMMAND [ARGUMENTS]');\nfunction files(path) { return readdirSync(path, { withFileTypes: true }).filter(entry => !entry.name.endsWith('.tsbuildinfo')).flatMap(entry => entry.isDirectory() ? files(join(path, entry.name)) : [join(path, entry.name)]); }\nconst paths = [...files('src'), ...files('worker'), ...files('tests'), ...files('tools'), ...files('public'), ...readdirSync('.').filter(path => /\\.config\\.(ts|mjs)$/.test(path)), 'package.json', 'package-lock.json', 'tsconfig.json', 'index.html'].sort();\nconst snapshot = Object.fromEntries(paths.map(path => [path, path.endsWith('.png') ? { encoding: 'base64', data: readFileSync(path).toString('base64') } : readFileSync(path, 'utf8')]));\nconst digest = createHash('sha256').update(JSON.stringify(snapshot)).digest('hex');\nconst directory = id.startsWith('D2') ? 'implementation/evidence/d02' : 'implementation/evidence/d01';\nmkdirSync(`${directory}/source-snapshots`, { recursive: true });\nwriteFileSync(`${directory}/source-snapshots/${digest}.json`, JSON.stringify(snapshot));\nconst inputPaths = id.startsWith('D2') ? ['implementation/plan/d02-implementation-baseline.md', 'implementation/plan/d02-initial-stock-entry.md', 'implementation/plan/d01-capacity-policy-revision.md', 'implementation/plan/d02-capacity-evidence.md', 'specs/evaluation/kickoff-prompt.md'] : [];\nconst inputs = Object.fromEntries(inputPaths.map(path => [path, createHash('sha256').update(readFileSync(path)).digest('hex')]));\nconst baseline = spawnSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).stdout.trim();\nconst result = await new Promise(resolve => {\n  const child = spawn(command, args, { env: process.env });\n  const stdout = []; const stderr = []; let error;\n  child.stdout.on('data', chunk => { stdout.push(chunk); process.stdout.write(chunk); });\n  child.stderr.on('data', chunk => { stderr.push(chunk); process.stderr.write(chunk); });\n  child.on('error', failure => { error = failure; });\n  child.on('close', status => resolve({ status, stdout: Buffer.concat(stdout).toString('utf8'), stderr: Buffer.concat(stderr).toString('utf8'), error }));\n});\nconst log = { id, stage, baseline, inputs, sourceDigest: digest, command: [command, ...args], exit: result.status, stdout: result.stdout, stderr: result.stderr, error: result.error?.message };\nlet output = `${directory}/${id}-${stage}.json`;\nfor (let attempt = 2; existsSync(output); attempt++) output = `${directory}/${id}-${stage}-attempt${attempt}.json`;\nwriteFileSync(output, JSON.stringify(log, null, 2));\nprocess.exit(result.status ?? 1);\n","tools/inventory.mjs":"import { createHash } from 'node:crypto';\nimport { readdir, readFile, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { releaseId } from './release.ts';\nasync function files(path) {\n  const entries = await readdir(path, { withFileTypes: true });\n  const nested = await Promise.all(entries.map(entry => entry.isDirectory() ? files(join(path, entry.name)) : [join(path, entry.name)]));\n  return nested.flat().sort();\n}\nconst output = process.env.D1_BUILD_DIR ?? 'dist';\nconst paths = (await files(output)).filter(path => !path.endsWith('/offline-inventory.json'));\nconst assets = await Promise.all(paths.map(async path => {\n  const bytes = await readFile(path);\n  return { url: `/${path.slice(output.length + 1)}`, bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') };\n}));\nconst worker = await readFile(join(output, 'sw.js'), 'utf8');\nconst literal = worker.match(/\\[(?:\\{[^{}]*\"url\"[^{}]*\\},?)+\\]/)?.[0];\nif (!literal) throw new Error('Missing embedded precache manifest');\nconst entries = JSON.parse(literal);\nconst expected = new Map();\nfor (const entry of entries) expected.set(`/${entry.url.replace(/^\\//, '')}`, entry.revision?.length === 64 ? entry.revision : expected.get(`/${entry.url.replace(/^\\//, '')}`) ?? null);\nfor (const asset of assets.filter(asset => asset.url !== '/sw.js')) {\n  if (!expected.has(asset.url) || expected.get(asset.url) !== asset.sha256) throw new Error(`Precache omission or incorrect SHA-256: ${asset.url}`);\n}\nif (expected.size !== assets.length - 1) throw new Error('Precache inventory has unexpected assets');\nif (!assets.some(asset => asset.url === '/sw.js') || !assets.some(asset => asset.url === '/index.html')) throw new Error('Incomplete release');\nawait writeFile(join(output, 'offline-inventory.json'), JSON.stringify({ version: 1, releaseId, assets }));\nconsole.log(`Inventoried ${assets.length} emitted assets with SHA-256 digests`);\n","tools/release.ts":"import { createHash } from 'node:crypto';\nimport { readdirSync, readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nfunction files(path: string): string[] {\n  return readdirSync(path, { withFileTypes: true }).filter(entry => !entry.name.endsWith('.tsbuildinfo')).flatMap(entry => entry.isDirectory() ? files(join(path, entry.name)) : [join(path, entry.name)]).sort();\n}\nexport const releaseId = createHash('sha256').update([...files('src'), ...files('worker'), ...files('tools'), ...files('public'), ...readdirSync('.').filter(path => path.endsWith('.config.ts')).sort(), 'index.html', 'package-lock.json'].map(path => `${path}\\n${createHash('sha256').update(readFileSync(path)).digest('hex')}`).join('\\n')).update(process.env.D1_RELEASE_LABEL ?? '').digest('hex');\n","tsconfig.json":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"allowImportingTsExtensions\": true,\n    \"skipLibCheck\": true,\n    \"jsx\": \"react-jsx\",\n    \"lib\": [\n      \"ES2023\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"types\": [\n      \"node\"\n    ],\n    \"resolveJsonModule\": true\n  },\n  \"include\": [\n    \"src\",\n    \"tests\",\n    \"tools\",\n    \"*.config.ts\"\n  ],\n  \"exclude\": [\n    \"worker\"\n  ],\n  \"references\": [\n    {\n      \"path\": \"./worker\"\n    }\n  ]\n}\n","vite.config.ts":"import { createHash } from 'node:crypto';\nimport { readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { releaseId } from './tools/release.ts';\nimport { defineConfig, loadEnv } from 'vite';\nimport react from '@vitejs/plugin-react';\nimport { VitePWA } from 'vite-plugin-pwa';\nexport default defineConfig(({ mode }) => {\n  const port = Number(loadEnv(mode, process.cwd(), 'DEV_').DEV_PORT);\n  if (port !== 5174) throw new Error('This worktree requires DEV_PORT=5174');\n  const output = process.env.D1_BUILD_DIR ?? 'dist';\n  return { build: { outDir: output }, define: { __RELEASE_ID__: JSON.stringify(releaseId) }, plugins: [react(), VitePWA({ strategies: 'injectManifest', srcDir: 'worker', filename: 'sw.ts', injectRegister: false, registerType: 'prompt', manifest: { id: '/', name: 'Trade Journal', short_name: 'Trade Journal', start_url: '/', scope: '/', display: 'standalone', theme_color: '#f6f4ed', background_color: '#f6f4ed', icons: [{ src: '/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' }, { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' }, { src: '/icon.svg', sizes: 'any', type: 'image/svg+xml', purpose: 'any' }] }, injectManifest: { globPatterns: ['**/*.{js,css,html,svg,webmanifest,json,png,woff2,ttf,txt}'], maximumFileSizeToCacheInBytes: 5242880, manifestTransforms: [(entries) => Promise.resolve({ manifest: entries.map(entry => ({ ...entry, revision: createHash('sha256').update(readFileSync(join(output, entry.url))).digest('hex') })), warnings: [] })] } })], server: { port, strictPort: true, host: 'localhost' }, preview: { port, strictPort: true, host: 'localhost' } };\n});\n","vitest.config.ts":"import { defineConfig } from 'vitest/config';\nexport default defineConfig({ test: { projects: [\n  { test: { name: 'unit', include: ['tests/unit/**/*.test.{ts,tsx}'], environment: 'jsdom' } },\n  { test: { name: 'integration', include: ['tests/integration/**/*.test.ts'], environment: 'node', setupFiles: ['tests/setup.ts'] } },\n] } });\n","worker/sw.ts":"declare const __RELEASE_ID__: string;\ndeclare const self: ServiceWorkerGlobalScope & { __WB_MANIFEST: { url: string; revision: string | null }[] };\ninterface Inventory { version: number; releaseId: string; assets: { url: string; bytes: number; sha256: string }[] }\nconst precacheEntries = self.__WB_MANIFEST;\nconst release = __RELEASE_ID__;\nconst cacheName = `trade-journal-release-${release}`;\nconst expected = new Map<string, string | null>();\nfor (const entry of precacheEntries) {\n  const path = new URL(entry.url, self.location.origin).pathname;\n  expected.set(path, entry.revision?.length === 64 ? entry.revision : expected.get(path) ?? null);\n}\nexpected.set('/sw.js', null);\nasync function sha256(response: Response): Promise<string> {\n  const bytes = await response.arrayBuffer();\n  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), byte => byte.toString(16).padStart(2, '0')).join('');\n}\nfunction complete(inventory: Inventory) {\n  return inventory.version === 1 && inventory.releaseId === release && inventory.assets.length === expected.size && new Set(inventory.assets.map(asset => asset.url)).size === expected.size && inventory.assets.every(asset => expected.has(asset.url) && (!expected.get(asset.url) || expected.get(asset.url) === asset.sha256));\n}\nasync function verify(cache: Cache) {\n  const manifest = await cache.match('/offline-inventory.json');\n  if (!manifest) return false;\n  const inventory = await manifest.json() as Inventory;\n  if (!complete(inventory)) return false;\n  for (const asset of inventory.assets) {\n    const response = await cache.match(asset.url);\n    if (!response || (await response.clone().arrayBuffer()).byteLength !== asset.bytes || await sha256(response) !== asset.sha256) return false;\n  }\n  return true;\n}\nself.addEventListener('install', event => {\n  event.waitUntil((async () => {\n    const beforeUsage = (await navigator.storage.estimate().catch((): StorageEstimate => ({}))).usage;\n    const cache = await caches.open(cacheName);\n    try {\n      const response = await fetch('/offline-inventory.json', { cache: 'no-store' });\n      if (!response.ok) throw new Error('Inventory unavailable');\n      const inventory = await response.clone().json() as Inventory;\n      if (!complete(inventory)) throw new Error('Incomplete release inventory');\n      for (const asset of inventory.assets) {\n        const resource = await fetch(asset.url, { cache: 'no-store' });\n        if (!resource.ok || (await resource.clone().arrayBuffer()).byteLength !== asset.bytes || await sha256(resource.clone()) !== asset.sha256) throw new Error(`Invalid release asset: ${asset.url}`);\n        await cache.put(asset.url, resource);\n      }\n      await cache.put('/offline-inventory.json', response);\n      if (!await verify(cache)) throw new Error('Release verification failed');\n      const afterUsage = (await navigator.storage.estimate().catch((): StorageEstimate => ({}))).usage;\n      const observedBytes = typeof beforeUsage === 'number' && typeof afterUsage === 'number' ? Math.max(0, afterUsage - beforeUsage) : 0;\n      await cache.put('/__release-size', new Response(JSON.stringify({ release, observedBytes }), { headers: { 'Content-Type': 'application/json' } }));\n    } catch (error) { await caches.delete(cacheName); throw error; }\n  })());\n});\nself.addEventListener('activate', event => { event.waitUntil(self.clients.claim()); });\nself.addEventListener('message', event => {\n  if (event.data === 'ACTIVATE_AT_SAFE_RELOAD') event.waitUntil((async () => {\n    const clients = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });\n    if (clients.length !== 1 || !event.source || !('id' in event.source) || clients[0]?.id !== event.source.id) {\n      event.ports[0]?.postMessage('OtherClientsOpen'); return;\n    }\n    event.ports[0]?.postMessage('Activating');\n    await self.skipWaiting();\n  })());\n  if (event.data === 'VERIFY_RELEASE') event.waitUntil((async () => {\n    let verified = false;\n    try { verified = await verify(await caches.open(cacheName)); } catch { /* Failed cache is never Writable. */ }\n    event.ports[0]?.postMessage({ release, verified, assetCount: expected.size });\n  })());\n});\nself.addEventListener('fetch', event => {\n  if (event.request.method !== 'GET' || new URL(event.request.url).origin !== self.location.origin) return;\n  event.respondWith((async () => {\n    const cache = await caches.open(cacheName);\n    // Every cached response is a digest-verified, same-origin release asset.\n    // Server negotiation headers must not hide those fixed bytes offline.\n    const response = await cache.match(event.request, { ignoreVary: true });\n    if (response) return response;\n    if (event.request.mode === 'navigate') { const index = await cache.match('/index.html'); if (index) return index; }\n    return fetch(event.request);\n  })());\n});\nexport {};\n","worker/tsconfig.json":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"composite\": true,\n    \"skipLibCheck\": true,\n    \"lib\": [\n      \"ES2023\",\n      \"WebWorker\"\n    ],\n    \"types\": [],\n    \"declaration\": true,\n    \"emitDeclarationOnly\": true,\n    \"outDir\": \"../.cache/worker-types\"\n  },\n  \"include\": [\n    \"*.ts\"\n  ]\n}\n"}